{
  "manifest_version": 3,
  "name": "Fortress Password Manager",
  "version": "1.1.0",
  "description": "Fortress - beautiful, secure, and blazing-fast password manager.",

  "icons": {
    "16":  "assets/icons/icon16.png",
    "32":  "assets/icons/icon32.png",
    "48":  "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  },

  "action": {
    "default_title": "Fortress",
    "default_icon": {
      "16":  "assets/icons/icon16.png",
      "32":  "assets/icons/icon32.png",
      "48":  "assets/icons/icon48.png",
      "128": "assets/icons/icon128.png"
    }
  },

  "side_panel": {
    "default_path": "popup/popup.html"
  },

  "background": {
    "service_worker": "background/background.js",
    "type": "module"
  },

  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": ["content/content.js"],
      "run_at": "document_idle"
    }
  ],

  "permissions": [
    "nativeMessaging",
    "storage",
    "identity",
    "sidePanel",
    "tabs",
    "activeTab",
    "contextMenus",
    "clipboardWrite",
    "alarms",
    "notifications",
    "scripting"
  ],

  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],

  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },

  "web_accessible_resources": [
    {
      "resources": [
        "assets/icons/*",
        "assets/fonts/*"
      ],
      "matches": ["http://*/*", "https://*/*"]
    }
  ],

  "content_security_policy": {
    "extension_pages": "script-src 'self'; default-src 'self'; img-src 'self' data: https:; style-src 'self' 'unsafe-inline'; font-src 'self' data:;"
  }
}
