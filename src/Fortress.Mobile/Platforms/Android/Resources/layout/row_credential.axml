<?xml version="1.0" encoding="utf-8"?>
<!--
  Fortress – Credential Row
  Card-style item: favicon circle · domain + username · OTP ring
-->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="16dp"
    android:layout_marginEnd="16dp"
    android:layout_marginBottom="8dp"
    android:layout_marginTop="4dp"
    android:foreground="?attr/selectableItemBackground"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:strokeWidth="1dp"
    app:strokeColor="@color/gk_gray_200"
    app:cardBackgroundColor="@color/gk_surface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
 android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="12dp"
        android:paddingTop="14dp"
        android:paddingBottom="14dp">

 <!-- ── ICON / INITIALS AVATAR ── -->
        <FrameLayout
            android:layout_width="46dp"
     android:layout_height="46dp"
            android:layout_marginEnd="14dp">

    <!-- Coloured initials background circle -->
            <com.google.android.material.card.MaterialCardView
         android:id="@+id/initialsContainer"
    android:layout_width="46dp"
             android:layout_height="46dp"
    app:cardCornerRadius="23dp"
    app:cardElevation="0dp"
      app:strokeWidth="0dp"
           app:cardBackgroundColor="@color/gk_primary_lightest">

              <TextView
       android:id="@+id/initialsText"
     android:layout_width="match_parent"
   android:layout_height="match_parent"
        android:gravity="center"
  android:textSize="17sp"
 android:textStyle="bold"
 android:textColor="@color/colorPrimary" />
     </com.google.android.material.card.MaterialCardView>

            <!-- Favicon image (overlays initials when loaded) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/iconContainer"
      android:layout_width="46dp"
         android:layout_height="46dp"
                app:cardCornerRadius="23dp"
          app:cardElevation="1dp"
 app:strokeWidth="1dp"
        app:strokeColor="@color/gk_gray_200"
        app:cardBackgroundColor="@color/white">

<ImageView
 android:id="@+id/siteIcon"
   android:layout_width="28dp"
           android:layout_height="28dp"
   android:layout_gravity="center"
  android:scaleType="centerInside"
          android:visibility="gone" />
            </com.google.android.material.card.MaterialCardView>
        </FrameLayout>

        <!-- ── TEXT COLUMN ── -->
    <LinearLayout
            android:id="@+id/textContainer"
     android:layout_width="0dp"
          android:layout_height="wrap_content"
  android:layout_weight="1"
          android:orientation="vertical">

    <TextView
     android:id="@+id/domain"
     android:layout_width="match_parent"
  android:layout_height="wrap_content"
     android:textSize="15sp"
  android:textStyle="bold"
      android:maxLines="1"
      android:ellipsize="end"
        android:includeFontPadding="false"
    android:textColor="@color/gk_gray_800" />

       <TextView
              android:id="@+id/username"
   android:layout_width="match_parent"
     android:layout_height="wrap_content"
             android:layout_marginTop="2dp"
              android:textSize="13sp"
         android:maxLines="1"
    android:ellipsize="end"
     android:includeFontPadding="false"
    android:textColor="@color/gk_gray_500" />

		<!-- "Verified by Fortress AI" badge — hidden by default, shown when risk check passes -->
		<LinearLayout
			android:id="@+id/aiBadge"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_marginTop="4dp"
			android:orientation="horizontal"
			android:gravity="center_vertical"
			android:visibility="gone">

			<com.google.android.material.card.MaterialCardView
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				app:cardCornerRadius="6dp"
				app:cardElevation="0dp"
				app:strokeWidth="0dp"
				app:cardBackgroundColor="#E8F5E9">

				<LinearLayout
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:orientation="horizontal"
					android:gravity="center_vertical"
					android:paddingStart="6dp"
					android:paddingEnd="8dp"
					android:paddingTop="2dp"
					android:paddingBottom="2dp">

					<ImageView
						android:layout_width="12dp"
						android:layout_height="12dp"
						android:layout_marginEnd="4dp"
						android:src="@android:drawable/ic_secure"
						android:tint="#2E7D32"
						android:scaleType="centerInside" />

					<TextView
						android:id="@+id/aiBadgeText"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:text="Verified by AI"
						android:textSize="10sp"
						android:textStyle="bold"
						android:textColor="#2E7D32"
						android:includeFontPadding="false" />

				</LinearLayout>
			</com.google.android.material.card.MaterialCardView>
		</LinearLayout>

    <!-- OTP code badge -->
            <com.google.android.material.card.MaterialCardView
       android:id="@+id/otpBadge"
     android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginTop="6dp"
     app:cardCornerRadius="8dp"
                app:cardElevation="0dp"
        app:strokeWidth="0dp"
       app:cardBackgroundColor="@color/gk_primary_lightest"
    android:visibility="gone">

   <TextView
        android:id="@+id/otpText"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
  android:paddingStart="10dp"
          android:paddingEnd="10dp"
    android:paddingTop="3dp"
        android:paddingBottom="3dp"
       android:text="000 000"
          android:textSize="18sp"
    android:textStyle="bold"
                    android:letterSpacing="0.08"
          android:textColor="@color/colorPrimary"
   android:includeFontPadding="false" />
            </com.google.android.material.card.MaterialCardView>
   </LinearLayout>

        <!-- ── RIGHT SIDE: OTP ring or options button ── -->
        <FrameLayout
       android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="8dp">

   <!-- OTP countdown ring -->
    <com.google.android.material.progressindicator.CircularProgressIndicator
          android:id="@+id/otpProgress"
     android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_gravity="center"
                app:indicatorSize="36dp"
      app:trackThickness="4dp"
         app:indicatorInset="0dp"
      app:indicatorDirectionCircular="counterclockwise"
         app:trackColor="@color/gk_gray_200"
     app:indicatorColor="@color/colorPrimary"
      android:visibility="gone" />

            <!-- Options menu button -->
     <com.google.android.material.card.MaterialCardView
    android:id="@+id/optionsCard"
        android:layout_width="36dp"
     android:layout_height="36dp"
           android:layout_gravity="center"
      app:cardCornerRadius="10dp"
  app:cardElevation="0dp"
       app:strokeWidth="0dp"
           app:cardBackgroundColor="@color/gk_gray_100">

         <ImageButton
      android:id="@+id/optionsButton"
     android:layout_width="match_parent"
     android:layout_height="match_parent"
          android:src="@drawable/ic_more_vert"
          android:tint="@color/gk_gray_500"
              android:scaleType="center"
    android:background="@android:color/transparent"
       android:contentDescription="Options" />
  </com.google.android.material.card.MaterialCardView>
        </FrameLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
