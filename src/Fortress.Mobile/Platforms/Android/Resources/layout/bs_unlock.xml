<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/gk_bg">

    <!-- GRADIENT HERO -->
    <LinearLayout
        android:layout_width="match_parent"
      android:layout_height="wrap_content"
   android:orientation="vertical"
        android:background="@drawable/bg_autofill_header"
    android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="28dp"
        android:paddingBottom="32dp"
        android:gravity="center">

   <ImageView
      android:layout_width="80dp"
  android:layout_height="80dp"
      android:src="@drawable/logowhite"
            android:scaleType="fitCenter"
          android:contentDescription="FORTRESS" />

<TextView
    android:id="@+id/fortressTitle"
    android:tag="fortressTitle"
 android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginTop="14dp"
    android:text="FORTRESS"
  android:textSize="22sp"
    android:textStyle="bold"
    android:letterSpacing="0.15"
    android:textColor="@color/white" />

        <TextView
            android:layout_width="wrap_content"
 android:layout_height="wrap_content"
          android:layout_marginTop="4dp"
   android:text="Password Manager"
            android:textSize="13sp"
       android:textColor="#BFDBFF" />

 <View
        android:layout_width="40dp"
            android:layout_height="2dp"
     android:layout_marginTop="14dp"
            android:background="#40FFFFFF" />
    </LinearLayout>

    <!-- LOCK ICON + TITLE -->
    <LinearLayout
  android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingStart="28dp"
        android:paddingEnd="28dp"
        android:paddingTop="28dp"
        android:paddingBottom="0dp">

        <com.google.android.material.card.MaterialCardView
      android:layout_width="68dp"
            android:layout_height="68dp"
  app:cardCornerRadius="34dp"
  app:cardElevation="4dp"
            app:strokeWidth="0dp"
            app:cardBackgroundColor="@color/gk_primary_lightest">

            <ImageView
          android:layout_width="34dp"
      android:layout_height="34dp"
         android:layout_gravity="center"
    android:src="@drawable/ic_lock"
     android:tint="@color/colorPrimary" />
    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Vault is Locked"
     android:textSize="20sp"
            android:textStyle="bold"
    android:textColor="@color/gk_gray_800"
     android:gravity="center" />

   <TextView
      android:id="@+id/unlockSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
         android:layout_marginTop="6dp"
            android:text="Authenticate to fill your credentials."
       android:textSize="14sp"
            android:textColor="@color/gk_gray_500"
        android:gravity="center"
    android:lineSpacingMultiplier="1.4" />
    </LinearLayout>

    <!-- ERROR BANNER -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/errorBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
     android:layout_marginEnd="24dp"
 android:layout_marginTop="16dp"
        android:visibility="gone"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp"
        app:strokeWidth="0dp"
        app:cardBackgroundColor="#FEE2E2">

        <TextView
         android:id="@+id/errorText"
      android:layout_width="match_parent"
            android:layout_height="wrap_content"
        android:padding="14dp"
            android:text="Authentication failed. Please try again."
            android:textSize="13sp"
            android:textColor="#B91C1C"
     android:gravity="center" />
    </com.google.android.material.card.MaterialCardView>

    <!-- PIN ENTRY SECTION -->
 <LinearLayout
        android:id="@+id/pinSection"
   android:layout_width="match_parent"
        android:layout_height="wrap_content"
  android:orientation="vertical"
      android:gravity="center"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="24dp"
        android:paddingBottom="8dp"
        android:visibility="gone">

     <!-- Styled PIN input box matching UnlockPage -->
        <LinearLayout
            android:layout_width="200dp"
            android:layout_height="56dp"
 android:orientation="horizontal"
      android:gravity="center"
        android:background="@drawable/pin_entry_bg"
     android:paddingStart="14dp"
       android:paddingEnd="14dp">

<EditText
       android:id="@+id/pinEditText"
       android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="numberPassword"
      android:maxLength="4"
                android:textSize="22sp"
 android:textStyle="bold"
              android:textColor="@color/gk_gray_800"
      android:hint="● ● ● ●"
           android:textColorHint="@color/gk_gray_300"
        android:gravity="center"
                android:background="@android:color/transparent"
      android:imeOptions="actionDone"
                android:singleLine="true" />
        </LinearLayout>

  </LinearLayout>

    <!-- BUTTON BAR -->
    <LinearLayout
      android:layout_width="match_parent"
 android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="20dp"
      android:paddingBottom="32dp"
        android:gravity="center">

        <!-- UNLOCK button (PIN mode) -->
        <com.google.android.material.button.MaterialButton
          android:id="@+id/unlockPinButton"
      android:layout_width="match_parent"
      android:layout_height="54dp"
      android:text="UNLOCK"
            android:textSize="16sp"
   android:textStyle="bold"
       android:textColor="@color/white"
            android:letterSpacing="0.05"
 app:backgroundTint="@color/colorPrimary"
          app:cornerRadius="14dp"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
   android:id="@+id/biometricButton"
   android:layout_width="match_parent"
   android:layout_height="54dp"
     android:text="Use Biometrics"
    android:textSize="16sp"
            android:textStyle="bold"
          android:textColor="@color/white"
     android:letterSpacing="0.02"
      app:backgroundTint="@color/colorPrimary"
    app:cornerRadius="14dp"
            app:icon="@drawable/ic_fingerprint"
      app:iconTint="@color/white"
    app:iconGravity="textStart"
            app:iconPadding="10dp"
      android:visibility="gone" />

     <com.google.android.material.button.MaterialButton
     android:id="@+id/pinButton"
  android:layout_width="match_parent"
       android:layout_height="48dp"
        android:layout_marginTop="8dp"
            android:text="Use PIN instead"
         android:textSize="15sp"
            android:textColor="@color/colorPrimary"
            style="@style/Widget.MaterialComponents.Button.TextButton"
      app:backgroundTint="@android:color/transparent"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
 android:id="@+id/cancelButton"
  android:layout_width="match_parent"
            android:layout_height="48dp"
       android:layout_marginTop="4dp"
            android:text="Cancel"
            android:textSize="15sp"
        android:textColor="@color/gk_gray_500"
        style="@style/Widget.MaterialComponents.Button.TextButton"
        app:backgroundTint="@android:color/transparent" />
    </LinearLayout>

</LinearLayout>
