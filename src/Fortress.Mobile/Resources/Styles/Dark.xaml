    <Color x:Key="InfoColor">#60A5FA</Color>
    <Color x:Key="InfoLightColor">#172554</Color>
    <Color x:Key="WarningColor">#FBBF24</Color>
    <Color x:Key="WarningLightColor">#422006</Color>

    <!--  Surface Colors  -->
    <Color x:Key="PageBackgroundColor">#0F172A</Color>
    <Color x:Key="CardBackgroundColor">#1E293B</Color>
    <Color x:Key="CardBackgroundColorAlt">#334155</Color>
    <Color x:Key="SurfaceColor">#1E293B</Color>
    <Color x:Key="SurfaceElevatedColor">#334155</Color>

    <!--  UI Elements  -->
    <Color x:Key="MutedColor">#94A3B8</Color>
    <Color x:Key="PasswordNumberColor">#5a9be0</Color>
    <Color x:Key="PasswordSpecialColor">#F87171</Color>
    <Color x:Key="ButtonColor">#5a9be0</Color>
    <Color x:Key="InputPlaceholderColor">#64748B</Color>
