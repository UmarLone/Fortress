<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary
    x:Class="Fortress.Styles.Dark"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!--  ═══════════════════════════════════════════════════════════════════  -->
    <!--  THEME - Dark Mode (Brand Color: #407cca)  -->
    <!--  ═══════════════════════════════════════════════════════════════════  -->

    <!--  Text Colors  -->
    <Color x:Key="TextColor">#F8FAFC</Color>
    <Color x:Key="TextSecondaryColor">#94A3B8</Color>
    <Color x:Key="TextTertiaryColor">#64748B</Color>

    <!--  Primary Color Family - Keep brand blue for accents/buttons  -->
    <Color x:Key="PrimaryColor">#5a9be0</Color>
    <Color x:Key="PrimaryDarkColor">#407cca</Color>
    <Color x:Key="PrimaryDarkenColor">#3569b0</Color>
    <Color x:Key="PrimaryLighterColor">#7ba3db</Color>
    <Color x:Key="PrimaryLightestColor">#1e3a5f</Color>
    <Color x:Key="PrimaryGradient">#5a9be0</Color>
    <Color x:Key="PrimaryLight">#1e3a5f</Color>

    <!--  Accent Color  -->
    <Color x:Key="AccentColor">#5a9be0</Color>
    <Color x:Key="AccentDarkColor">#407cca</Color>

    <!--  Secondary - Teal  -->
    <Color x:Key="SecondaryColor">#2DD4BF</Color>
    <Color x:Key="SecondaryGradient">#22D3EE</Color>
    <Color x:Key="Secondary">#2DD4BF</Color>

    <!--  Accent Colors  -->
    <Color x:Key="AccentPink">#F472B6</Color>
    <Color x:Key="AccentOrange">#FB923C</Color>
    <Color x:Key="AccentYellow">#FACC15</Color>
    <Color x:Key="AccentCyan">#22D3EE</Color>

    <!--  Semantic Colors  -->
    <Color x:Key="DangerColor">#F87171</Color>
    <Color x:Key="DangerLightColor">#450A0A</Color>
    <Color x:Key="SuccessColor">#4ADE80</Color>
