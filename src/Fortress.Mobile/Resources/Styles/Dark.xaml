    <Color x:Key="SliderTrackMinColor">#5a9be0</Color>
    <Color x:Key="SliderTrackMaxColor">#334155</Color>

    <!--  Switch  -->
    <Color x:Key="SwitchOnColor">#5a9be0</Color>
    <Color x:Key="SwitchThumbColor">#F8FAFC</Color>

    <!--  Stepper  -->
    <Color x:Key="StepperBackgroundColor">#334155</Color>
    <Color x:Key="StepperForegroundColor">#F8FAFC</Color>

