    <Color x:Key="NavigationBarBackgroundColor">#1E293B</Color>
    <Color x:Key="NavigationBarTextColor">#F8FAFC</Color>

    <!--  Hero Header Gradient (VaultHealthPage, etc.)  -->
    <Color x:Key="HeroGradientStart">#1E293B</Color>
    <Color x:Key="HeroGradientEnd">#0F172A</Color>

    <!--  Section Tile Accent Colours (theme-aware)  -->
    <!--  Authenticators / Indigo  -->
    <Color x:Key="AuthTileBackground">#252047</Color>
    <Color x:Key="AuthTileIcon">#818cf8</Color>
    <Color x:Key="AuthHeroGradientStart">#312e81</Color>
    <Color x:Key="AuthHeroGradientEnd">#1e1b4b</Color>
    <!--  Identities / Purple  -->
    <Color x:Key="IdTileBackground">#2e1065</Color>
    <Color x:Key="IdTileIcon">#c084fc</Color>
    <Color x:Key="IdHeroGradientStart">#3b0764</Color>
    <Color x:Key="IdHeroGradientEnd">#2e1065</Color>
    <!--  Logs / Neutral slate  -->
    <Color x:Key="LogsHeroGradientStart">#334155</Color>
    <Color x:Key="LogsHeroGradientEnd">#1E293B</Color>
    <!--  Secure Notes / Teal  -->
    <Color x:Key="NotesTileBackground">#042f2e</Color>
    <Color x:Key="NotesTileIcon">#2dd4bf</Color>
    <Color x:Key="NotesHeroGradientStart">#134e4a</Color>
    <Color x:Key="NotesHeroGradientEnd">#042f2e</Color>

