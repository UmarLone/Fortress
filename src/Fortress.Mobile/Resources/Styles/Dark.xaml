    <Color x:Key="ButtonPrimaryBackgroundColor">#5a9be0</Color>
    <Color x:Key="ButtonPrimaryBackgroundColorPressed">#407cca</Color>
    <Color x:Key="ButtonPrimaryBackgroundColorDisabled">#475569</Color>
    <Color x:Key="ButtonPrimaryTextColor">#0F172A</Color>
