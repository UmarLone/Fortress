    <Color x:Key="CardsTileBackground">#3d2b00</Color>
    <Color x:Key="CardsTileIcon">#FBBF24</Color>
    <!--  Generator / Pink  -->
    <Color x:Key="GeneratorTileBackground">#3d0f26</Color>
    <Color x:Key="GeneratorTileIcon">#F472B6</Color>
    <!--  Passkeys / Purple  -->
    <Color x:Key="PasskeysTileBackground">#2e1065</Color>
    <Color x:Key="PasskeysTileIcon">#a78bfa</Color>
    <!--  2FA stat / Cyan  -->
    <Color x:Key="TwoFAStatBackground">#0a2a30</Color>
    <Color x:Key="TwoFAStatIcon">#22D3EE</Color>

    <!--  Hyperlinks  -->
    <Color x:Key="HyperlinkColor">#5a9be0</Color>
    <Color x:Key="HyperLink">#5a9be0</Color>

    <!--  Neutral Palette - Proper dark mode values  -->
    <Color x:Key="White">#F8FAFC</Color>
    <Color x:Key="Gray-50">#0F172A</Color>
    <Color x:Key="Gray-100">#1E293B</Color>
    <Color x:Key="Gray-200">#334155</Color>
    <Color x:Key="Gray-300">#475569</Color>
    <Color x:Key="Gray-400">#64748B</Color>
    <Color x:Key="Gray-500">#94A3B8</Color>
    <Color x:Key="Gray-600">#CBD5E1</Color>
    <Color x:Key="Gray-700">#E2E8F0</Color>
    <Color x:Key="Gray-800">#F1F5F9</Color>
    <Color x:Key="Gray-900">#F8FAFC</Color>
    <Color x:Key="Gray-Black">#F8FAFC</Color>
    <Color x:Key="Gray-White">#0F172A</Color>
    <Color x:Key="Gray-Bg">#0F172A</Color>

    <!--  Shadows  -->
    <Color x:Key="GrayShadowColor">#000000</Color>
    <Color x:Key="GrayShadowBackgroundColor">#1E293B</Color>

    <!--  Card Category Colors  -->
    <Color x:Key="CategoryWebColor">#5a9be0</Color>
    <Color x:Key="CategoryAppColor">#4ADE80</Color>
    <Color x:Key="CategoryCardColor">#FBBF24</Color>
    <Color x:Key="CategoryNoteColor">#A78BFA</Color>
    <Color x:Key="CategoryIdentityColor">#F472B6</Color>

</ResourceDictionary>
