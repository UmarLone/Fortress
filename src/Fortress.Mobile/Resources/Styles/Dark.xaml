    <Color x:Key="SplashBackgroundColor">#1E293B</Color>
    <Color x:Key="BorderColor">#334155</Color>
    <Color x:Key="DisabledIconColor">#475569</Color>
    <Color x:Key="SeparatorColor">#334155</Color>
    <Color x:Key="TouchColor">#5a9be0</Color>
    <Color x:Key="SoftBackgroundColor">#1E293B</Color>

    <!--  Box Styles  -->
    <Color x:Key="BoxBorderColor">#334155</Color>
    <Color x:Key="BoxHeaderTextColor">#5a9be0</Color>

    <!--  Title Colors  -->
    <Color x:Key="TitleTextColor">#F8FAFC</Color>
    <Color x:Key="TitleEntryTextColor">#F8FAFC</Color>
    <Color x:Key="TitleEntryPlaceholderColor">#64748B</Color>

    <!--  List Styles  -->
    <Color x:Key="ListItemBorderColor">#334155</Color>
    <Color x:Key="ListSectionBorderColor">#334155</Color>
