<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary
    x:Class="Fortress.Styles.CustomStyles"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:Fortress.Controls"
    xmlns:inputLayout="clr-namespace:Syncfusion.Maui.Toolkit.TextInputLayout;assembly=Syncfusion.Maui.Toolkit"
    xmlns:sfProgress="clr-namespace:Syncfusion.Maui.Toolkit.ProgressBar;assembly=Syncfusion.Maui.Toolkit"
    xmlns:skia="clr-namespace:SkiaSharp.Extended.UI.Controls;assembly=SkiaSharp.Extended.UI">

    <!--  🌀 Authenticator circular progress - using Toolkit SfCircularProgressBar  -->
    <Style x:Key="AuthenticatorProgressBarStyle" TargetType="sfProgress:SfCircularProgressBar">
        <Setter Property="ProgressFill" Value="{DynamicResource PrimaryColor}" />
        <Setter Property="TrackFill" Value="{DynamicResource Gray-300}" />
        <Setter Property="VerticalOptions" Value="Start" />
        <Setter Property="HorizontalOptions" Value="Start" />
        <Setter Property="HeightRequest" Value="40" />
        <Setter Property="WidthRequest" Value="40" />
    </Style>

    <Style x:Key="PageBackgroundColor" TargetType="ContentPage">
        <Setter Property="Background" Value="#fff" />
    </Style>




 
    <!--  🏷️ Label styles  -->
    <Style x:Key="ListViewTotpCodeLabelStyle" TargetType="Label">
        <Setter Property="FontSize" Value="32" />
        <Setter Property="TextColor" Value="{DynamicResource PrimaryColor}" />
        <Setter Property="HorizontalOptions" Value="Start" />
        <Setter Property="VerticalOptions" Value="Start" />
        <Setter Property="VerticalTextAlignment" Value="Start" />
        <Setter Property="HorizontalTextAlignment" Value="Start" />
        <Setter Property="LineHeight" Value="{OnPlatform Android=1.5, Default=-1}" />
    </Style>

    <Style x:Key="ListViewMainLabelStyle" TargetType="Label">
        <Setter Property="FontSize" Value="18" />
        <Setter Property="TextColor" Value="{DynamicResource Gray-900}" />
        <Setter Property="HorizontalOptions" Value="Start" />
        <Setter Property="VerticalOptions" Value="Start" />
        <Setter Property="LineHeight" Value="{OnPlatform Android=1.5, Default=-1}" />
    </Style>
    <!--  Common style for GKListView Description labels  -->
    <Style x:Key="ListViewDescriptionLabelStyle" TargetType="Label">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="TextColor" Value="{DynamicResource Gray-800}" />
        <Setter Property="VerticalOptions" Value="Start" />
        <Setter Property="HorizontalOptions" Value="Start" />
        <Setter Property="LineHeight" Value="{OnPlatform Android=1.5, Default=-1}" />
    </Style>

    <Style x:Key="ListViewHorizontalSeparatorStyle" TargetType="BoxView">
        <Setter Property="VerticalOptions" Value="End" />
        <Setter Property="HeightRequest" Value="1" />
        <Setter Property="Color" Value="{DynamicResource Gray-300}" />
        <Setter Property="Background" Value="{DynamicResource Gray-400}" />
    </Style>

    <Style x:Key="CountLabelStyle" TargetType="Label">
        <Setter Property="FontSize" Value="24" />
        <Setter Property="TextColor" Value="{DynamicResource PrimaryColor}" />
        <Setter Property="HorizontalOptions" Value="Center" />
        <Setter Property="HorizontalTextAlignment" Value="Center" />
    </Style>

    

   
  

    

    <!--  🃏 Card Button — used on HomePage tappable cards  -->
    <Style x:Key="CardButtonStyle" TargetType="Button">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="BorderWidth" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="HorizontalOptions" Value="Fill" />
        <Setter Property="VerticalOptions" Value="Fill" />
        <Setter Property="ContentLayout" Value="Top, 0" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal">
                        <VisualState.Setters>
                            <Setter Property="Opacity" Value="1" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Property="Opacity" Value="0.75" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="Opacity" Value="0.5" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <!--  🔍 Search Entry — no Android underline  -->
    <Style x:Key="SearchEntryStyle" TargetType="Entry">
        <Setter Property="PlaceholderColor" Value="{DynamicResource TextTertiaryColor}" />
      <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{DynamicResource TextColor}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="ReturnType" Value="Search" />
  <Setter Property="ClearButtonVisibility" Value="WhileEditing" />
 <!--  Android: suppress the default underline drawn by the Material theme  -->
        <Setter Property="VisualStateManager.VisualStateGroups">
<VisualStateGroupList>
     <VisualStateGroup x:Name="CommonStates">
      <VisualState x:Name="Normal" />
                    <VisualState x:Name="Focused" />
  <VisualState x:Name="Disabled" />
       </VisualStateGroup>
     </VisualStateGroupList>
        </Setter>
    </Style>

</ResourceDictionary>
