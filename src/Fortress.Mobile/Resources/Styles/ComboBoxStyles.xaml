<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary
    x:Class="Fortress.Styles.ComboBoxStyles"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:Fortress.Controls">

    <!-- Native MAUI Picker Style (replacing SfComboBox) -->
    <Style x:Key="SimplePickerStyle" TargetType="Picker">
        <Setter Property="TextColor" Value="{DynamicResource Gray-900}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>

    <Style x:Key="TextInputLayoutPickerStyle" TargetType="Picker">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="TextColor" Value="{DynamicResource Gray-700}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
    </Style>

</ResourceDictionary>