<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary
    x:Class="Fortress.Styles.BorderStyles"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <Color x:Key="BorderBackgroundColor">#20FFFFFF</Color>

    <!--  Common style for theme borders  -->
    <Style x:Key="LoginFormBorderlessEntryBorderStyle" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{StaticResource BorderBackgroundColor}" />

    </Style>

    <!--  Common style for entry borders  -->
    <Style x:Key="ThemeBorderStyle" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{DynamicResource Gray-Bg}" />

        <Setter Property="HorizontalOptions" Value="FillAndExpand" />
    </Style>

    <!--  Common style for forms borders  -->
    <Style x:Key="DataFormBorderlessEntryBorderStyle" TargetType="Border">

        <Setter Property="VerticalOptions" Value="CenterAndExpand" />
        <Setter Property="BackgroundColor" Value="{DynamicResource Gray-Bg}" />
    </Style>

    <!--  Common style for profile border style  -->
    <Style x:Key="ProfileBorderStyle" TargetType="Border">
        <Setter Property="HorizontalOptions" Value="Center" />
        <Setter Property="VerticalOptions" Value="Center" />

    </Style>
</ResourceDictionary>