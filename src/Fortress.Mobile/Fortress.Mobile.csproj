  <!-- ── Pre-build: train and bundle the ML.NET intent model ──────────────────
       Skipped when Fortress.ModelTrainer project is not present in the solution.
  ──────────────────────────────────────────────────────────────────────── -->
  <PropertyGroup>
    <IntentModelAsset>Resources\Raw\intent_classifier_v1.zip</IntentModelAsset>
    <TrainerProject>$(MSBuildThisFileDirectory)..\Fortress.ModelTrainer\Fortress.ModelTrainer.csproj</TrainerProject>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Release|net10.0-android|AnyCPU'">
    <AndroidPackageFormat>apk</AndroidPackageFormat>
  </PropertyGroup>

  <Target Name="TrainIntentModel" BeforeTargets="BeforeBuild" Condition="Exists('$(TrainerProject)')" Inputs="$(TrainerProject)" Outputs="$(MSBuildThisFileDirectory)$(IntentModelAsset)">
    <Message Importance="high" Text="[TrainIntentModel] Restoring trainer packages..." />
    <MSBuild Projects="$(TrainerProject)" Targets="Restore" Properties="Configuration=Release;TargetFramework=net10.0" BuildInParallel="false" />
    <Message Importance="high" Text="[TrainIntentModel] Building trainer..." />
    <MSBuild Projects="$(TrainerProject)" Targets="Build" Properties="Configuration=Release;TargetFramework=net10.0" BuildInParallel="false" />
    <Exec Command="dotnet run --project &quot;$(TrainerProject)&quot; --configuration Release --framework net10.0 -- &quot;$(MSBuildThisFileDirectory)$(IntentModelAsset)&quot;" ConsoleToMSBuild="true" IgnoreExitCode="false" />
    <Message Importance="high" Text="[TrainIntentModel] Model written to $(IntentModelAsset)" />
  </Target>

  <!-- Register the generated zip as a MauiAsset so it is bundled into the app -->
  <ItemGroup>
    <MauiAsset Include="$(IntentModelAsset)" LogicalName="intent_classifier_v1.zip" />
  </ItemGroup>
  <ItemGroup>
    <MauiIcon Include="Resources\AppIcon\appicon.svg" />
    <MauiSplashScreen Include="Resources\Splash\appsplash.svg" Color="#548ce8" BaseSize="512,512" />
  </ItemGroup>
