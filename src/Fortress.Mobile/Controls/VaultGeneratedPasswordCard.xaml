<?xml version="1.0" encoding="utf-8" ?>
<!--
    VaultGeneratedPasswordCard
    Frosted card inside the hero that shows the generated password text plus
    Refresh and Copy icon buttons.

    Bindable properties
    Password string   - the generated password to display
    RefreshCommand  ICommand - wired to the Refresh button
    CopyCommand     ICommand - wired to the Copy button

    Usage
    <ctrl:VaultGeneratedPasswordCard
     Password="{Binding GeneratedPassword}"
        RefreshCommand="{Binding GenerateCommand}"
        CopyCommand="{Binding CopyToClipboardCommand}" />
-->
<ContentView
    x:Class="Fortress.Controls.VaultGeneratedPasswordCard"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:mi="http://www.aathifmahir.com/dotnet/2022/maui/icons"
    x:Name="This">

    <Border
        Padding="18,16"
     BackgroundColor="#20FFFFFF"
        StrokeThickness="1">
        <Border.Stroke>
         <SolidColorBrush Color="#30FFFFFF" />
        </Border.Stroke>
        <Border.StrokeShape>
     <RoundRectangle CornerRadius="18" />
  </Border.StrokeShape>

     <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">

      <!--  Password text  -->
<Label
     Grid.Column="0"
           FontAttributes="Bold"
     FontFamily="Monospace"
    FontSize="18"
         LineBreakMode="CharacterWrap"
         Text="{Binding Password, Source={x:Reference This}}"
        TextColor="White"
        VerticalOptions="Center" />

      <!--  Refresh  -->
            <Border
                Grid.Column="1"
Padding="0"
            BackgroundColor="#25FFFFFF"
                HeightRequest="42"
     StrokeThickness="0"
 VerticalOptions="Center"
           WidthRequest="42">
           <Border.StrokeShape>
          <RoundRectangle CornerRadius="12" />
        </Border.StrokeShape>
        <Grid>
        <mi:MauiIcon
        HorizontalOptions="Center"
    Icon="{mi:Material Icon=Refresh}"
    IconColor="White"
      IconSize="22"
           InputTransparent="True"
  VerticalOptions="Center" />
      <Button
    Padding="0"
    BackgroundColor="Transparent"
     BorderWidth="0"
       Command="{Binding RefreshCommand, Source={x:Reference This}}"
             HorizontalOptions="Fill"
  VerticalOptions="Fill" />
         </Grid>
      </Border>

 <!--  Copy  -->
            <Border
      Grid.Column="2"
   Padding="0"
      BackgroundColor="#25FFFFFF"
     HeightRequest="42"
   StrokeThickness="0"
      VerticalOptions="Center"
      WidthRequest="42">
         <Border.StrokeShape>
     <RoundRectangle CornerRadius="12" />
 </Border.StrokeShape>
 <Grid>
      <mi:MauiIcon
        HorizontalOptions="Center"
     Icon="{mi:Material Icon=ContentCopy}"
             IconColor="White"
          IconSize="22"
      InputTransparent="True"
        VerticalOptions="Center" />
  <Button
         Padding="0"
         BackgroundColor="Transparent"
  BorderWidth="0"
          Command="{Binding CopyCommand, Source={x:Reference This}}"
          HorizontalOptions="Fill"
    VerticalOptions="Fill" />
        </Grid>
  </Border>

      </Grid>
    </Border>
</ContentView>
