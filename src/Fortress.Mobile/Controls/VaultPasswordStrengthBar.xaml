<?xml version="1.0" encoding="utf-8" ?>
<!--
    VaultPasswordStrengthBar
    A 5-segment strength bar + labelled score row.
    Bindable: Score (int) = 20|40|60|80|100
-->
<ContentView
    x:Class="Fortress.Controls.VaultPasswordStrengthBar"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Name="This">

    <VerticalStackLayout Spacing="8">

        <!--  Score label row  -->
        <Grid ColumnDefinitions="*,Auto">
            <Label
                Grid.Column="0"
                FontAttributes="Bold"
                FontSize="13"
                Opacity="0.9"
                Text="Password Strength"
                TextColor="White" />
            <Label
                Grid.Column="1"
                FontAttributes="Bold"
                FontSize="13"
                Text="{Binding Score, Source={x:Reference This}}"
                TextColor="White">
                <Label.Triggers>
                    <DataTrigger
                        Binding="{Binding Score, Source={x:Reference This}}"
                        TargetType="Label"
                        Value="20">
                        <Setter Property="Text" Value="Very Weak" />
                        <Setter Property="TextColor" Value="#FCA5A5" />
                    </DataTrigger>
                    <DataTrigger
                        Binding="{Binding Score, Source={x:Reference This}}"
                        TargetType="Label"
                        Value="40">
                        <Setter Property="Text" Value="Weak" />
                        <Setter Property="TextColor" Value="#FCD34D" />
                    </DataTrigger>
                    <DataTrigger
                        Binding="{Binding Score, Source={x:Reference This}}"
                        TargetType="Label"
                        Value="60">
                        <Setter Property="Text" Value="Medium" />
                        <Setter Property="TextColor" Value="#FDE68A" />
                    </DataTrigger>
                    <DataTrigger
                        Binding="{Binding Score, Source={x:Reference This}}"
                        TargetType="Label"
                        Value="80">
                        <Setter Property="Text" Value="Strong" />
                        <Setter Property="TextColor" Value="#86EFAC" />
                    </DataTrigger>
                    <DataTrigger
                        Binding="{Binding Score, Source={x:Reference This}}"
                        TargetType="Label"
                        Value="100">
                        <Setter Property="Text" Value="Very Strong ?" />
                        <Setter Property="TextColor" Value="#FFFFFF" />
                    </DataTrigger>
                </Label.Triggers>
            </Label>
        </Grid>

        <!--  5-segment strength bar  -->
        <Grid
            ColumnDefinitions="*,4,*,4,*,4,*,4,*"
            ColumnSpacing="0"
            HeightRequest="6">

            <!--  Seg 1  -->
            <BoxView
                Grid.Column="0"
                CornerRadius="3"
                Color="#FFFFFF30">
                <BoxView.Triggers>
                    <DataTrigger
                        Binding="{Binding Score, Source={x:Reference This}}"
                        TargetType="BoxView"
                        Value="20">
                        <Setter Property="Color" Value="#EF4444" />
                    </DataTrigger>
                    <DataTrigger
                        Binding="{Binding Score, Source={x:Reference This}}"
                        TargetType="BoxView"
                        Value="40">
                        <Setter Property="Color" Value="#F97316" />
                    </DataTrigger>
                    <DataTrigger
                        Binding="{Binding Score, Source={x:Reference This}}"
                        TargetType="BoxView"
                        Value="60">
                        <Setter Property="Color" Value="#EAB308" />
                    </DataTrigger>
                    <DataTrigger
                        Binding="{Binding Score, Source={x:Reference This}}"
                        TargetType="BoxView"
                        Value="80">
                        <Setter Property="Color" Value="#22C55E" />
                    </DataTrigger>
                    <DataTrigger
                        Binding="{Binding Score, Source={x:Reference This}}"
                        TargetType="BoxView"
                        Value="100">
                        <Setter Property="Color" Value="#60A5FA" />
                    </DataTrigger>
                </BoxView.Triggers>
            </BoxView>

            <!--  Seg 2  -->
            <BoxView
                Grid.Column="2"
                CornerRadius="3"
                Color="#FFFFFF30">
                <BoxView.Triggers>
                    <DataTrigger
                        Binding="{Binding Score, Source={x:Reference This}}"
                        TargetType="BoxView"
                        Value="40">
                        <Setter Property="Color" Value="#F97316" />
                    </DataTrigger>
                    <DataTrigger
                        Binding="{Binding Score, Source={x:Reference This}}"
                        TargetType="BoxView"
                        Value="60">
                        <Setter Property="Color" Value="#EAB308" />
                    </DataTrigger>
                    <DataTrigger
                        Binding="{Binding Score, Source={x:Reference This}}"
                        TargetType="BoxView"
                        Value="80">
                        <Setter Property="Color" Value="#22C55E" />
                    </DataTrigger>
                    <DataTrigger
                        Binding="{Binding Score, Source={x:Reference This}}"
                        TargetType="BoxView"
                        Value="100">
                        <Setter Property="Color" Value="#60A5FA" />
                    </DataTrigger>
                </BoxView.Triggers>
            </BoxView>

            <!--  Seg 3  -->
            <BoxView
                Grid.Column="4"
                CornerRadius="3"
                Color="#FFFFFF30">
                <BoxView.Triggers>
                    <DataTrigger
                        Binding="{Binding Score, Source={x:Reference This}}"
                        TargetType="BoxView"
                        Value="60">
                        <Setter Property="Color" Value="#EAB308" />
                    </DataTrigger>
                    <DataTrigger
                        Binding="{Binding Score, Source={x:Reference This}}"
                        TargetType="BoxView"
                        Value="80">
                        <Setter Property="Color" Value="#22C55E" />
                    </DataTrigger>
                    <DataTrigger
                        Binding="{Binding Score, Source={x:Reference This}}"
                        TargetType="BoxView"
                        Value="100">
                        <Setter Property="Color" Value="#60A5FA" />
                    </DataTrigger>
                </BoxView.Triggers>
            </BoxView>

            <!--  Seg 4  -->
            <BoxView
                Grid.Column="6"
                CornerRadius="3"
                Color="#FFFFFF30">
                <BoxView.Triggers>
                    <DataTrigger
                        Binding="{Binding Score, Source={x:Reference This}}"
                        TargetType="BoxView"
                        Value="80">
                        <Setter Property="Color" Value="#22C55E" />
                    </DataTrigger>
                    <DataTrigger
                        Binding="{Binding Score, Source={x:Reference This}}"
                        TargetType="BoxView"
                        Value="100">
                        <Setter Property="Color" Value="#60A5FA" />
                    </DataTrigger>
                </BoxView.Triggers>
            </BoxView>

            <!--  Seg 5  -->
            <BoxView
                Grid.Column="8"
                CornerRadius="3"
                Color="#FFFFFF30">
                <BoxView.Triggers>
                    <DataTrigger
                        Binding="{Binding Score, Source={x:Reference This}}"
                        TargetType="BoxView"
                        Value="100">
                        <Setter Property="Color" Value="#60A5FA" />
                    </DataTrigger>
                </BoxView.Triggers>
            </BoxView>

        </Grid>
    </VerticalStackLayout>
</ContentView>
