<?xml version="1.0" encoding="utf-8" ?>

<ContentView
    x:Class="Fortress.Controls.IconActionButton"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Name="This">

    <Border
        Padding="0"
        BackgroundColor="{Binding BackgroundColor, Source={x:Reference This}}"
        HeightRequest="{Binding Size, Source={x:Reference This}}"
        StrokeThickness="0"
        WidthRequest="{Binding Size, Source={x:Reference This}}">
        <Border.StrokeShape>
            <RoundRectangle CornerRadius="{Binding CornerRadius, Source={x:Reference This}}" />
        </Border.StrokeShape>

        <Grid>
            <!--  Icon layer  -->
            <Label
                FontFamily="MaterialIconsRegular"
                FontSize="{Binding IconSize, Source={x:Reference This}}"
                HorizontalOptions="Center"
                InputTransparent="True"
                Text="{Binding IconGlyph, Source={x:Reference This}}"
                TextColor="{Binding IconColor, Source={x:Reference This}}"
                VerticalOptions="Center" />

            <!--  Tap layer  -->
            <Button
                Padding="0"
                BackgroundColor="Transparent"
                BorderWidth="0"
                Command="{Binding Command, Source={x:Reference This}}"
                CommandParameter="{Binding CommandParameter, Source={x:Reference This}}"
                HorizontalOptions="Fill"
                VerticalOptions="Fill" />
        </Grid>
    </Border>
</ContentView>
