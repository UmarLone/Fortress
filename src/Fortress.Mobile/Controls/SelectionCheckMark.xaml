<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="Fortress.Controls.SelectionCheckMark"
xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    HeightRequest="28"
    WidthRequest="28">

    <Grid>
  <!--  Unchecked state: subtle ring  -->
        <Border
            x:Name="UncheckedBorder"
    BackgroundColor="Transparent"
  HeightRequest="28"
         IsVisible="True"
   Stroke="{DynamicResource BorderColor}"
       StrokeThickness="2"
  WidthRequest="28">
         <Border.StrokeShape>
           <RoundRectangle CornerRadius="14" />
       </Border.StrokeShape>
   </Border>

      <!--  Checked state: filled circle with checkmark  -->
  <Border
            x:Name="CheckedBorder"
       BackgroundColor="{DynamicResource PrimaryColor}"
            HeightRequest="28"
  IsVisible="False"
 StrokeThickness="0"
   WidthRequest="28">
  <Border.StrokeShape>
     <RoundRectangle CornerRadius="14" />
  </Border.StrokeShape>
            <Border.Shadow>
   <Shadow
       Brush="{DynamicResource PrimaryColor}"
 Opacity="0.3"
     Radius="6"
        Offset="0,2" />
    </Border.Shadow>
            <Label
        FontFamily="MaterialIconsRegular"
            FontSize="18"
     HorizontalOptions="Center"
 Text="&#xE876;"
 TextColor="White"
        VerticalOptions="Center" />
     </Border>
    </Grid>

</ContentView>
