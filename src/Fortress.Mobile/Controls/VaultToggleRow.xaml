<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="Fortress.Controls.VaultToggleRow"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Name="This">

    <VerticalStackLayout Spacing="0">

        <Grid
          Padding="12,14"
            ColumnDefinitions="Auto,*,Auto"
            ColumnSpacing="12">

         <Grid.GestureRecognizers>
       <TapGestureRecognizer Tapped="Row_Tapped" />
</Grid.GestureRecognizers>

   <!--  Icon badge  -->
            <Border
  Grid.Column="0"
        Padding="8"
    BackgroundColor="{Binding IconBackgroundColor, Source={x:Reference This}}"
      HeightRequest="40"
              StrokeThickness="0"
      WidthRequest="40">
                <Border.StrokeShape>
     <RoundRectangle CornerRadius="10" />
                </Border.StrokeShape>
            <Label
      FontFamily="MaterialIconsRegular"
            FontSize="20"
HorizontalOptions="Center"
 Text="{Binding IconGlyph, Source={x:Reference This}}"
         TextColor="{Binding IconColor, Source={x:Reference This}}"
                    VerticalOptions="Center" />
            </Border>

  <!--  Title + optional subtitle  -->
            <VerticalStackLayout
        Grid.Column="1"
        Spacing="2"
      VerticalOptions="Center">
    <Label
      FontSize="15"
                  Text="{Binding Title, Source={x:Reference This}}"
     TextColor="{DynamicResource TextColor}" />
                <Label
             FontSize="12"
      IsVisible="{Binding HasSubtitle, Source={x:Reference This}}"
          Text="{Binding Subtitle, Source={x:Reference This}}"
          TextColor="{DynamicResource TextSecondaryColor}" />
     </VerticalStackLayout>

      <!--  Custom pill toggle — driven entirely by IsToggled bindable property  -->
          <Grid
 Grid.Column="2"
        HeightRequest="30"
  InputTransparent="True"
                VerticalOptions="Center"
    WidthRequest="52">

 <!--  Track  -->
          <BoxView
CornerRadius="15"
     HeightRequest="30"
  HorizontalOptions="Fill"
         VerticalOptions="Fill"
     WidthRequest="52"
   Color="#CBD5E1">
  <BoxView.Triggers>
          <DataTrigger
 Binding="{Binding IsToggled, Source={x:Reference This}}"
       TargetType="BoxView"
  Value="True">
        <Setter Property="Color" Value="{DynamicResource PrimaryColor}" />
       </DataTrigger>
     </BoxView.Triggers>
          </BoxView>

  <!--  Knob  -->
       <Border
          Margin="3,0,0,0"
                    BackgroundColor="White"
           HeightRequest="24"
  HorizontalOptions="Start"
        StrokeThickness="0"
        VerticalOptions="Center"
   WidthRequest="24">
   <Border.StrokeShape>
<Ellipse />
              </Border.StrokeShape>
        <Border.Shadow>
     <Shadow
            Brush="Black"
            Opacity="0.25"
       Radius="4"
      Offset="0,1" />
         </Border.Shadow>
      <Border.Triggers>
      <DataTrigger
Binding="{Binding IsToggled, Source={x:Reference This}}"
    TargetType="Border"
       Value="True">
          <Setter Property="HorizontalOptions" Value="End" />
      <Setter Property="Margin" Value="0,0,3,0" />
           </DataTrigger>
        </Border.Triggers>
   </Border>

       </Grid>

</Grid>

        <!--  Optional separator  -->
        <BoxView
        Margin="16,0"
            HeightRequest="1"
            IsVisible="{Binding ShowSeparator, Source={x:Reference This}}"
    Color="{DynamicResource Gray-100}" />

    </VerticalStackLayout>
</ContentView>
