<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Fortress.Views.AuthenticatorDetailPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:mi="http://www.aathifmahir.com/dotnet/2022/maui/icons"
    xmlns:prism="http://prismlibrary.com"
    xmlns:sfProgress="clr-namespace:Syncfusion.Maui.Toolkit.ProgressBar;assembly=Syncfusion.Maui.Toolkit"
    prism:ViewModelLocator.AutowireViewModel="Automatic"
    BackgroundColor="{DynamicResource PageBackgroundColor}"
    NavigationPage.HasNavigationBar="False">

    <Grid RowDefinitions="Auto,*">

        <!--  ═══ HERO HEADER ═══  -->
        <Border
            Grid.Row="0"
            Padding="20,16,20,28"
            StrokeThickness="0">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Offset="0.0" Color="#6366F1" />
                    <GradientStop Offset="1.0" Color="#8B5CF6" />
                </LinearGradientBrush>
            </Border.Background>
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="0,0,28,28" />
            </Border.StrokeShape>

            <Grid RowDefinitions="Auto,Auto" RowSpacing="24">

                <!--  Nav row  -->
                <Grid
                    Grid.Row="0"
                    ColumnDefinitions="Auto,*,Auto,Auto"
                    ColumnSpacing="12">

                    <!--  Back  -->
                    <Border
                        Grid.Column="0"
                        Padding="0"
                        BackgroundColor="#30FFFFFF"
                        HeightRequest="40"
                        StrokeThickness="0"
                        VerticalOptions="Center"
                        WidthRequest="40">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12" />
                        </Border.StrokeShape>
                        <Button
                            Padding="0"
                            BackgroundColor="Transparent"
                            BorderWidth="0"
                            Command="{Binding GoBackCommand}"
                            HeightRequest="40"
                            WidthRequest="40">
                            <Button.ImageSource>
                                <FontImageSource
                                    FontFamily="MaterialIconsRegular"
                                    Glyph="&#xE5C4;"
                                    Size="22"
                                    Color="White" />
                            </Button.ImageSource>
                        </Button>
                    </Border>

                    <!--  Title  -->
                    <VerticalStackLayout
                        Grid.Column="1"
                        Spacing="2"
                        VerticalOptions="Center">
                        <Label
                            FontSize="12"
                            Opacity="0.75"
                            Text="VAULT"
                            TextColor="White" />
                        <Label
                            FontAttributes="Bold"
                            FontSize="20"
                            LineBreakMode="TailTruncation"
                            Text="{Binding Issuer}"
                            TextColor="White" />
                    </VerticalStackLayout>

                    <!--  Share button  -->
                    <Border
                        Grid.Column="2"
                        Padding="0"
                        BackgroundColor="#30FFFFFF"
                        HeightRequest="40"
                        StrokeThickness="0"
                        VerticalOptions="Center"
                        WidthRequest="40">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12" />
                        </Border.StrokeShape>
                        <Grid>
                            <Label
                                FontFamily="MaterialIconsRegular"
                                FontSize="20"
                                HorizontalOptions="Center"
                                InputTransparent="True"
                                Text="&#xE80D;"
                                TextColor="White"
                                VerticalOptions="Center" />
                            <Button
                                Padding="0"
                                BackgroundColor="Transparent"
                                BorderWidth="0"
                                Command="{Binding ShareCommand}"
                                HeightRequest="40"
                                WidthRequest="40" />
                        </Grid>
                    </Border>

                    <!--  Edit button  -->
                    <Border
                        Grid.Column="3"
                        Padding="0"
                        BackgroundColor="#30FFFFFF"
                        HeightRequest="40"
                        StrokeThickness="0"
                        VerticalOptions="Center"
                        WidthRequest="40">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12" />
                        </Border.StrokeShape>
                        <Grid>
                            <Label
                                FontFamily="MaterialIconsRegular"
                                FontSize="20"
                                HorizontalOptions="Center"
                                InputTransparent="True"
                                Text="&#xE3C9;"
                                TextColor="White"
                                VerticalOptions="Center" />
                            <Button
                                Padding="0"
                                BackgroundColor="Transparent"
                                BorderWidth="0"
                                Command="{Binding EditCommand}"
                                HeightRequest="40"
                                WidthRequest="40" />
                        </Grid>
                    </Border>
                </Grid>

                <!--  Live OTP display card  -->
                <Border
                    Grid.Row="1"
                    Padding="20,16"
                    BackgroundColor="#20FFFFFF"
                    StrokeThickness="0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="20" />
                    </Border.StrokeShape>

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">

                        <!--  Code label + account + copy button  -->
                        <Grid
                            Grid.Column="0"
                            ColumnDefinitions="*,Auto"
                            ColumnSpacing="12"
                            RowDefinitions="Auto,Auto,Auto"
                            RowSpacing="4">

                            <Label
                                Grid.Row="0"
                                Grid.Column="0"
                                FontSize="12"
                                Opacity="0.75"
                                Text="CURRENT CODE"
                                TextColor="White" />

                            <Label
                                Grid.Row="1"
                                Grid.Column="0"
                                CharacterSpacing="8"
                                FontAttributes="Bold"
                                FontSize="25"
                                Text="{Binding OtpCode}"
                                TextColor="White" />

                            <Label
                                Grid.Row="2"
                                Grid.Column="0"
                                FontSize="12"
                                Opacity="0.7"
                                Text="{Binding Account}"
                                TextColor="White" />

                            <!--  Copy button — aligned with the code label  -->
                            <Border
                                Grid.Row="1"
                                Grid.Column="1"
                                Padding="0"
                                BackgroundColor="#30FFFFFF"
                                HeightRequest="30"
                                StrokeThickness="0"
                                VerticalOptions="Center"
                                WidthRequest="30">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12" />
                                </Border.StrokeShape>
                                <Grid>
                                    <mi:MauiIcon
                                        HorizontalOptions="Center"
                                        Icon="{mi:Material Icon=ContentCopy}"
                                        IconColor="White"
                                        IconSize="18"
                                        InputTransparent="True"
                                        VerticalOptions="Center" />
                                    <Button
                                        Padding="0"
                                        BackgroundColor="Transparent"
                                        BorderWidth="0"
                                        Command="{Binding CopyOtpCommand}"
                                        HeightRequest="40"
                                        HorizontalOptions="Fill"
                                        VerticalOptions="Fill"
                                        WidthRequest="40" />
                                </Grid>
                            </Border>
                        </Grid>

                        <!--  Countdown ring  -->
                        <Grid
                            Grid.Column="1"
                            HeightRequest="44"
                            WidthRequest="44">
                            <sfProgress:SfCircularProgressBar
                                Background="Transparent"
                                HorizontalOptions="Fill"
                                IndeterminateAnimationDuration="0"
                                Maximum="{Binding OtpDuration}"
                                Minimum="0"
                                Progress="{Binding OtpProgress}"
                                ProgressFill="White"
                                StartAngle="-90"
                                TrackFill="#40FFFFFF"
                                VerticalOptions="Fill" />
                            <Label
                                FontAttributes="Bold"
                                FontSize="13"
                                HorizontalOptions="Center"
                                Text="{Binding OtpProgress, StringFormat='{0:F0}'}"
                                TextColor="White"
                                VerticalOptions="Center" />
                        </Grid>

                    </Grid>
                </Border>

            </Grid>
        </Border>

        <!--  ═══ CONTENT ═══  -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="16,20,16,40" Spacing="12">

                <!--  ── NOTES ──  -->
                <Border
                    Padding="16,14"
                    BackgroundColor="{DynamicResource CardBackgroundColor}"
                    IsVisible="{Binding HasNotes}"
                    StrokeThickness="0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16" />
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow
                            Brush="Black"
                            Opacity="0.05"
                            Radius="8"
                            Offset="0,3" />
                    </Border.Shadow>
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                        <Border
                            Grid.Column="0"
                            Padding="8"
                            BackgroundColor="{DynamicResource WarningLightColor}"
                            HeightRequest="36"
                            StrokeThickness="0"
                            VerticalOptions="Start"
                            WidthRequest="36">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="10" />
                            </Border.StrokeShape>
                            <mi:MauiIcon
                                HorizontalOptions="Center"
                                Icon="{mi:Material Icon=StickyNote2}"
                                IconColor="{DynamicResource WarningColor}"
                                IconSize="18"
                                VerticalOptions="Center" />
                        </Border>
                        <VerticalStackLayout
                            Grid.Column="1"
                            Spacing="4"
                            VerticalOptions="Center">
                            <Label
                                FontSize="11"
                                Text="NOTES"
                                TextColor="{DynamicResource TextTertiaryColor}" />
                            <Label
                                FontSize="14"
                                LineBreakMode="WordWrap"
                                Text="{Binding Notes}"
                                TextColor="{DynamicResource TextColor}" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <!--  ── ITEM INFO ──  -->
                <Label
                    Margin="4,4,0,0"
                    FontAttributes="Bold"
                    FontSize="13"
                    Opacity="0.55"
                    Text="ITEM INFO"
                    TextColor="{DynamicResource TextSecondaryColor}" />

                <Border
                    Padding="0"
                    BackgroundColor="{DynamicResource CardBackgroundColor}"
                    StrokeThickness="0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16" />
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow
                            Brush="Black"
                            Opacity="0.05"
                            Radius="8"
                            Offset="0,3" />
                    </Border.Shadow>
                    <VerticalStackLayout Spacing="0">

                        <!--  Date added  -->
                        <Grid
                            Padding="16,12"
                            ColumnDefinitions="Auto,*,Auto"
                            ColumnSpacing="14">
                            <mi:MauiIcon
                                Grid.Column="0"
                                Icon="{mi:Material Icon=AddCircleOutline}"
                                IconColor="{DynamicResource TextTertiaryColor}"
                                IconSize="18"
                                VerticalOptions="Center" />
                            <Label
                                Grid.Column="1"
                                FontSize="14"
                                Text="Date Added"
                                TextColor="{DynamicResource TextColor}"
                                VerticalOptions="Center" />
                            <Label
                                Grid.Column="2"
                                FontSize="13"
                                Text="{Binding CreatedDisplay}"
                                TextColor="{DynamicResource TextSecondaryColor}"
                                VerticalOptions="Center" />
                        </Grid>

                        <BoxView
                            Margin="16,0"
                            HeightRequest="1"
                            Color="{DynamicResource DividerColor}" />

                        <!--  Last modified  -->
                        <Grid
                            Padding="16,12"
                            ColumnDefinitions="Auto,*,Auto"
                            ColumnSpacing="14">
                            <mi:MauiIcon
                                Grid.Column="0"
                                Icon="{mi:Material Icon=EditCalendar}"
                                IconColor="{DynamicResource TextTertiaryColor}"
                                IconSize="18"
                                VerticalOptions="Center" />
                            <Label
                                Grid.Column="1"
                                FontSize="14"
                                Text="Last Modified"
                                TextColor="{DynamicResource TextColor}"
                                VerticalOptions="Center" />
                            <Label
                                Grid.Column="2"
                                FontSize="13"
                                Text="{Binding UpdatedDisplay}"
                                TextColor="{DynamicResource TextSecondaryColor}"
                                VerticalOptions="Center" />
                        </Grid>

                        <BoxView
                            Margin="16,0"
                            HeightRequest="1"
                            Color="{DynamicResource DividerColor}" />

                        <!--  Account  -->
                        <Grid
                            Padding="16,12"
                            ColumnDefinitions="Auto,*,Auto"
                            ColumnSpacing="14">
                            <mi:MauiIcon
                                Grid.Column="0"
                                Icon="{mi:Material Icon=Person}"
                                IconColor="{DynamicResource TextTertiaryColor}"
                                IconSize="18"
                                VerticalOptions="Center" />
                            <Label
                                Grid.Column="1"
                                FontSize="14"
                                Text="Account"
                                TextColor="{DynamicResource TextColor}"
                                VerticalOptions="Center" />
                            <Label
                                Grid.Column="2"
                                FontSize="13"
                                LineBreakMode="TailTruncation"
                                Text="{Binding Account}"
                                TextColor="{DynamicResource TextSecondaryColor}"
                                VerticalOptions="Center" />
                        </Grid>

                        <BoxView
                            Margin="16,0"
                            HeightRequest="1"
                            Color="{DynamicResource DividerColor}" />

                        <!--  Refresh Period  -->
                        <Grid
                            Padding="16,12"
                            ColumnDefinitions="Auto,*,Auto"
                            ColumnSpacing="14">
                            <mi:MauiIcon
                                Grid.Column="0"
                                Icon="{mi:Material Icon=Timer}"
                                IconColor="{DynamicResource TextTertiaryColor}"
                                IconSize="18"
                                VerticalOptions="Center" />
                            <Label
                                Grid.Column="1"
                                FontSize="14"
                                Text="Refresh Period"
                                TextColor="{DynamicResource TextColor}"
                                VerticalOptions="Center" />
                            <Label
                                Grid.Column="2"
                                FontSize="13"
                                Text="{Binding Period, StringFormat='{0}s'}"
                                TextColor="{DynamicResource TextSecondaryColor}"
                                VerticalOptions="Center" />
                        </Grid>

                        <BoxView
                            Margin="16,0"
                            HeightRequest="1"
                            Color="{DynamicResource DividerColor}" />

                        <!--  Algorithm  -->
                        <Grid
                            Padding="16,12"
                            ColumnDefinitions="Auto,*,Auto"
                            ColumnSpacing="14">
                            <mi:MauiIcon
                                Grid.Column="0"
                                Icon="{mi:Material Icon=Functions}"
                                IconColor="{DynamicResource TextTertiaryColor}"
                                IconSize="18"
                                VerticalOptions="Center" />
                            <Label
                                Grid.Column="1"
                                FontSize="14"
                                Text="Algorithm"
                                TextColor="{DynamicResource TextColor}"
                                VerticalOptions="Center" />
                            <Label
                                Grid.Column="2"
                                FontSize="13"
                                Text="{Binding Algorithm}"
                                TextColor="{DynamicResource TextSecondaryColor}"
                                VerticalOptions="Center" />
                        </Grid>

                        <BoxView
                            Margin="16,0"
                            HeightRequest="1"
                            Color="{DynamicResource DividerColor}" />

                        <!--  Code Length  -->
                        <Grid
                            Padding="16,12"
                            ColumnDefinitions="Auto,*,Auto"
                            ColumnSpacing="14">
                            <mi:MauiIcon
                                Grid.Column="0"
                                Icon="{mi:Material Icon=Pin}"
                                IconColor="{DynamicResource TextTertiaryColor}"
                                IconSize="18"
                                VerticalOptions="Center" />
                            <Label
                                Grid.Column="1"
                                FontSize="14"
                                Text="Code Length"
                                TextColor="{DynamicResource TextColor}"
                                VerticalOptions="Center" />
                            <Label
                                Grid.Column="2"
                                FontSize="13"
                                Text="{Binding Digits, StringFormat='{0} digits'}"
                                TextColor="{DynamicResource TextSecondaryColor}"
                                VerticalOptions="Center" />
                        </Grid>

                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

    </Grid>
</ContentPage>
