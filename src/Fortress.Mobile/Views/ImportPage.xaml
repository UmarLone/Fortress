                                            TextColor="{DynamicResource PrimaryColor}" />
                                    </Border>
                                </Grid>
                                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                                    <Border
                                        Grid.Column="0"
                                        Padding="10,12"
                                        BackgroundColor="{DynamicResource PrimaryLightestColor}"
                                        StrokeThickness="0">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="12" />
                                        </Border.StrokeShape>
                                        <VerticalStackLayout HorizontalOptions="Center" Spacing="3">
                                            <Label
                                                FontAttributes="Bold"
                                                FontSize="22"
                                                HorizontalOptions="Center"
                                                Text="{Binding AuthPreview.TotalParsed}"
                                                TextColor="{DynamicResource PrimaryColor}" />
                                            <Label
                                                FontSize="10"
                                                HorizontalOptions="Center"
                                                Text="Total"
                                                TextColor="{DynamicResource PrimaryColor}" />
                                        </VerticalStackLayout>
                                    </Border>
                                    <Border
                                        Grid.Column="1"
                                        Padding="10,12"
                                        BackgroundColor="#DCFCE7"
                                        StrokeThickness="0">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="12" />
                                        </Border.StrokeShape>
                                        <VerticalStackLayout HorizontalOptions="Center" Spacing="3">
                                            <Label
                                                FontAttributes="Bold"
                                                FontSize="22"
                                                HorizontalOptions="Center"
                                                Text="{Binding AuthPreview.ValidCount}"
                                                TextColor="#16A34A" />
                                            <Label
                                                FontSize="10"
                                                HorizontalOptions="Center"
                                                Text="Valid"
                                                TextColor="#16A34A" />
                                        </VerticalStackLayout>
                                    </Border>
                                    <Border
                                        Grid.Column="2"
                                        Padding="10,12"
                                        BackgroundColor="#FCE7F3"
                                        StrokeThickness="0">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="12" />
                                        </Border.StrokeShape>
                                        <VerticalStackLayout HorizontalOptions="Center" Spacing="3">
                                            <Label
                                                FontAttributes="Bold"
                                                FontSize="22"
                                                HorizontalOptions="Center"
                                                Text="{Binding AuthPreview.DuplicateCount}"
                                                TextColor="#B45309" />
                                            <Label
                                                FontSize="10"
                                                HorizontalOptions="Center"
                                                Text="Dupes"
                                                TextColor="#B45309" />
                                        </VerticalStackLayout>
                                    </Border>
                                </Grid>
                                <!--  Ready pill  -->
                                <Border
                                    Padding="14,10"
                                    BackgroundColor="#DCFCE7"
                                    HorizontalOptions="Center"
                                    StrokeThickness="0">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="20" />
                                    </Border.StrokeShape>
                                    <HorizontalStackLayout Spacing="6">
                                        <mi:MauiIcon
                                            Icon="{mi:Material Icon=CheckCircle}"
                                            IconColor="#16A34A"
                                            IconSize="16"
                                            VerticalOptions="Center" />
                                        <Label
                                            FontAttributes="Bold"
                                            FontSize="13"
                                            TextColor="#16A34A"
                                            VerticalOptions="Center">
                                            <Label.FormattedText>
                                                <FormattedString>
                                                    <Span
                                                        FontAttributes="Bold"
                                                        Text="{Binding AuthPreview.ValidCount}"
                                                        TextColor="#16A34A" />
                                                    <Span Text=" accounts ready to import" TextColor="#16A34A" />
                                                </FormattedString>
                                            </Label.FormattedText>
                                        </Label>
                                    </HorizontalStackLayout>
                                </Border>
                            </VerticalStackLayout>
                        </Border>

                        <!--  Auth warnings  -->
                        <Border
                            Padding="16,14"
                            BackgroundColor="#FFFBEB"
                            IsVisible="{Binding AuthPreview.Warnings.Count, Converter={StaticResource IsPositive}}"
                            Stroke="#FDE68A"
                            StrokeThickness="1">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="14" />
                            </Border.StrokeShape>
                            <VerticalStackLayout Spacing="8">
                                <HorizontalStackLayout Spacing="8">
                                    <mi:MauiIcon
                                        Icon="{mi:Material Icon=WarningAmber}"
                                        IconColor="#B45309"
                                        IconSize="20"
                                        VerticalOptions="Center" />
                                    <Label
                                        FontAttributes="Bold"
                                        FontSize="14"
                                        Text="Heads up"
                                        TextColor="#B45309"
                                        VerticalOptions="Center" />
                                </HorizontalStackLayout>
                                <VerticalStackLayout BindableLayout.ItemsSource="{Binding AuthPreview.Warnings}" Spacing="5">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="x:String">
                                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                                <Label
                                                    Grid.Column="0"
                                                    FontSize="12"
                                                    Text="•"
                                                    TextColor="#92400E"
                                                    VerticalOptions="Start" />
                                                <Label
                                                    Grid.Column="1"
                                                    FontSize="12"
                                                    LineBreakMode="WordWrap"
                                                    Text="{Binding .}"
                                                    TextColor="#92400E" />
                                            </Grid>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </VerticalStackLayout>
                            </VerticalStackLayout>
                        </Border>

                        <!--  Auth action buttons  -->
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <Button
                                Grid.Column="0"
                                Padding="18,0"
                                BackgroundColor="{DynamicResource Gray-100}"
                                Command="{Binding CancelAuthPreviewCommand}"
                                CornerRadius="14"
                                HeightRequest="52"
                                Text="← Start Over"
                                TextColor="{DynamicResource TextSecondaryColor}" />
                            <Grid Grid.Column="1" HeightRequest="52">
                                <Border
                                    Padding="0"
                                    Opacity="{Binding HasAuthValidRows, Converter={StaticResource BoolToOpacity}}"
                                    StrokeThickness="0">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Offset="0.0" Color="{DynamicResource HeroGradientStart}" />
                                            <GradientStop Offset="1.0" Color="{DynamicResource PrimaryGradient}" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="14" />
                                    </Border.StrokeShape>
                                </Border>
                                <Button
                                    Padding="0"
                                    BackgroundColor="Transparent"
                                    BorderWidth="0"
                                    Command="{Binding CommitAuthCommand}"
                                    FontAttributes="Bold"
                                    FontSize="16"
                                    IsEnabled="{Binding HasAuthValidRows}"
                                    Text="Import Now →"
                                    TextColor="White" />
                            </Grid>
                        </Grid>

                    </VerticalStackLayout>
                    <!--  END AUTHENTICATORS PREVIEW  -->

                </VerticalStackLayout>
                <!--  END STEP 2  -->

                <!--  ═══ STEP 3 ═══  -->
                <VerticalStackLayout
                    x:Name="Step3View"
                    IsVisible="{Binding IsResultStep}"
                    Spacing="20">
                    <!--  Success hero  -->
                    <Border Padding="0" StrokeThickness="0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Offset="0.0" Color="{DynamicResource HeroGradientStart}" />
                                <GradientStop Offset="1.0" Color="{DynamicResource PrimaryGradient}" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="20" />
                        </Border.StrokeShape>
                        <VerticalStackLayout
                            Padding="28,32"
                            HorizontalOptions="Center"
                            Spacing="16">
                            <Border
                                Padding="18"
                                BackgroundColor="#25FFFFFF"
                                HeightRequest="84"
                                HorizontalOptions="Center"
                                StrokeThickness="0"
                                WidthRequest="84">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="42" />
                                </Border.StrokeShape>
                                <mi:MauiIcon
                                    HorizontalOptions="Center"
                                    Icon="{mi:Material Icon=CheckCircle}"
                                    IconColor="White"
                                    IconSize="44"
                                    VerticalOptions="Center" />
                            </Border>
                            <Label
                                FontAttributes="Bold"
                                FontSize="22"
                                HorizontalOptions="Center"
                                HorizontalTextAlignment="Center"
                                Text="Import Complete!"
                                TextColor="White" />
                            <Label
                                FontSize="15"
                                HorizontalOptions="Center"
                                HorizontalTextAlignment="Center"
                                Opacity="0.9"
                                Text="{Binding FinalResultSummary}"
                                TextColor="White" />
                        </VerticalStackLayout>
                    </Border>

                    <!--  Result tiles  -->
                    <Border
                        Padding="20,18"
                        BackgroundColor="{DynamicResource CardBackgroundColor}"
                        StrokeThickness="0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="16" />
                        </Border.StrokeShape>
                        <Border.Shadow>
                            <Shadow
                                Brush="{DynamicResource GrayShadowColor}"
                                Opacity="0.06"
                                Radius="12"
                                Offset="0,4" />
                        </Border.Shadow>
                        <VerticalStackLayout Spacing="14">
                            <Label
                                FontAttributes="Bold"
                                FontSize="15"
                                Text="Import Summary"
                                TextColor="{DynamicResource TextColor}" />
                            <Grid
                                ColumnDefinitions="*,*"
                                ColumnSpacing="10"
                                IsVisible="{Binding IsPasswordResult}"
                                RowDefinitions="Auto,Auto"
                                RowSpacing="10">
                                <Border
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    Padding="14,12"
                                    BackgroundColor="#DCFCE7"
                                    StrokeThickness="0">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="14" />
                                    </Border.StrokeShape>
                                    <HorizontalStackLayout Spacing="10">
                                        <mi:MauiIcon
                                            Icon="{mi:Material Icon=CheckCircle}"
                                            IconColor="#16A34A"
                                            IconSize="22"
                                            VerticalOptions="Center" />
                                        <VerticalStackLayout Spacing="1" VerticalOptions="Center">
                                            <Label
                                                FontAttributes="Bold"
                                                FontSize="20"
                                                Text="{Binding Result.Imported}"
                                                TextColor="#16A34A" />
                                            <Label
                                                FontSize="11"
                                                Text="Imported"
                                                TextColor="#16A34A" />
                                        </VerticalStackLayout>
                                    </HorizontalStackLayout>
                                </Border>
                                <Border
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    Padding="14,12"
                                    BackgroundColor="#FEF3C7"
                                    StrokeThickness="0">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="14" />
                                    </Border.StrokeShape>
                                    <HorizontalStackLayout Spacing="10">
                                        <mi:MauiIcon
                                            Icon="{mi:Material Icon=SkipNext}"
                                            IconColor="#B45309"
                                            IconSize="22"
                                            VerticalOptions="Center" />
                                        <VerticalStackLayout Spacing="1" VerticalOptions="Center">
                                            <Label
                                                FontAttributes="Bold"
                                                FontSize="20"
                                                Text="{Binding Result.Skipped}"
                                                TextColor="#B45309" />
                                            <Label
                                                FontSize="11"
                                                Text="Skipped"
                                                TextColor="#B45309" />
                                        </VerticalStackLayout>
                                    </HorizontalStackLayout>
                                </Border>
                                <Border
                                    Grid.Row="1"
                                    Grid.Column="0"
                                    Padding="14,12"
                                    BackgroundColor="{DynamicResource PrimaryLightestColor}"
                                    StrokeThickness="0">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="14" />
                                    </Border.StrokeShape>
                                    <HorizontalStackLayout Spacing="10">
                                        <mi:MauiIcon
                                            Icon="{mi:Material Icon=Sync}"
                                            IconColor="{DynamicResource PrimaryColor}"
                                            IconSize="22"
                                            VerticalOptions="Center" />
                                        <VerticalStackLayout Spacing="1" VerticalOptions="Center">
                                            <Label
                                                FontAttributes="Bold"
                                                FontSize="20"
                                                Text="{Binding Result.Replaced}"
                                                TextColor="{DynamicResource PrimaryColor}" />
                                            <Label
                                                FontSize="11"
                                                Text="Replaced"
                                                TextColor="{DynamicResource PrimaryColor}" />
                                        </VerticalStackLayout>
                                    </HorizontalStackLayout>
                                </Border>
                                <Border
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    Padding="14,12"
                                    BackgroundColor="#FEE2E2"
                                    StrokeThickness="0">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="14" />
                                    </Border.StrokeShape>
                                    <HorizontalStackLayout Spacing="10">
                                        <mi:MauiIcon
                                            Icon="{mi:Material Icon=ErrorOutline}"
                                            IconColor="#DC2626"
                                            IconSize="22"
                                            VerticalOptions="Center" />
                                        <VerticalStackLayout Spacing="1" VerticalOptions="Center">
                                            <Label
                                                FontAttributes="Bold"
                                                FontSize="20"
                                                Text="{Binding Result.Failed}"
                                                TextColor="#DC2626" />
                                            <Label
                                                FontSize="11"
                                                Text="Failed"
                                                TextColor="#DC2626" />
                                        </VerticalStackLayout>
                                    </HorizontalStackLayout>
                                </Border>
                            </Grid>

                            <!--  Auth result tiles  -->
                            <Grid
                                ColumnDefinitions="*,*"
                                ColumnSpacing="10"
                                IsVisible="{Binding IsAuthResult}"
                                RowDefinitions="Auto,Auto"
                                RowSpacing="10">
                                <Border
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    Padding="14,12"
                                    BackgroundColor="#DCFCE7"
                                    StrokeThickness="0">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="14" />
                                    </Border.StrokeShape>
                                    <HorizontalStackLayout Spacing="10">
                                        <mi:MauiIcon
                                            Icon="{mi:Material Icon=CheckCircle}"
                                            IconColor="#16A34A"
                                            IconSize="22"
                                            VerticalOptions="Center" />
                                        <VerticalStackLayout Spacing="1" VerticalOptions="Center">
                                            <Label
                                                FontAttributes="Bold"
                                                FontSize="20"
                                                Text="{Binding AuthResult.Imported}"
                                                TextColor="#16A34A" />
                                            <Label
                                                FontSize="11"
                                                Text="Imported"
                                                TextColor="#16A34A" />
                                        </VerticalStackLayout>
                                    </HorizontalStackLayout>
                                </Border>
                                <Border
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    Padding="14,12"
                                    BackgroundColor="#FEF3C7"
                                    StrokeThickness="0">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="14" />
                                    </Border.StrokeShape>
                                    <HorizontalStackLayout Spacing="10">
                                        <mi:MauiIcon
                                            Icon="{mi:Material Icon=SkipNext}"
                                            IconColor="#B45309"
                                            IconSize="22"
                                            VerticalOptions="Center" />
                                        <VerticalStackLayout Spacing="1" VerticalOptions="Center">
                                            <Label
                                                FontAttributes="Bold"
                                                FontSize="20"
                                                Text="{Binding AuthResult.Skipped}"
                                                TextColor="#B45309" />
                                            <Label
                                                FontSize="11"
                                                Text="Skipped"
                                                TextColor="#B45309" />
                                        </VerticalStackLayout>
                                    </HorizontalStackLayout>
                                </Border>
                                <Border
                                    Grid.Row="1"
                                    Grid.Column="0"
                                    Grid.ColumnSpan="2"
                                    Padding="14,12"
                                    BackgroundColor="#FEE2E2"
                                    StrokeThickness="0">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="14" />
                                    </Border.StrokeShape>
                                    <HorizontalStackLayout Spacing="10">
                                        <mi:MauiIcon
                                            Icon="{mi:Material Icon=ErrorOutline}"
                                            IconColor="#DC2626"
                                            IconSize="22"
                                            VerticalOptions="Center" />
                                        <VerticalStackLayout Spacing="1" VerticalOptions="Center">
                                            <Label
                                                FontAttributes="Bold"
                                                FontSize="20"
                                                Text="{Binding AuthResult.Failed}"
                                                TextColor="#DC2626" />
                                            <Label
                                                FontSize="11"
                                                Text="Failed"
                                                TextColor="#DC2626" />
                                        </VerticalStackLayout>
                                    </HorizontalStackLayout>
                                </Border>
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                    <!--  Weak nudge  -->
                    <Border
                        Padding="16,14"
                        BackgroundColor="#FFFBEB"
                        IsVisible="{Binding Preview.WeakCount, Converter={StaticResource IsPositive}}"
                        Stroke="#FDE68A"
                        StrokeThickness="1">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="14" />
                        </Border.StrokeShape>

                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <mi:MauiIcon
                                Grid.Column="0"
                                Icon="{mi:Material Icon=HealthAndSafety}"
                                IconColor="#B45309"
                                IconSize="24"
                                VerticalOptions="Start" />

                            <Label
                                Grid.Column="1"
                                FontSize="13"
                                LineBreakMode="WordWrap"

                                Text="Some imported passwords are weak. Visit Vault Health to review and strengthen them."
                                TextColor="#92400E"
                                VerticalOptions="Center" />
                        </Grid>
                    </Border>

                    <!--  Import Another button  -->
                    <Grid HeightRequest="52">
                        <Border Padding="0" StrokeThickness="0">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Offset="0.0" Color="{DynamicResource HeroGradientStart}" />
                                    <GradientStop Offset="1.0" Color="{DynamicResource PrimaryGradient}" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="14" />
                            </Border.StrokeShape>
                        </Border>
                        <Button
                            Padding="0"
                            BackgroundColor="Transparent"
                            BorderWidth="0"
                            Command="{Binding StartOverCommand}"
                            FontAttributes="Bold"
                            FontSize="16"
                            Text="Import Another File"
                            TextColor="White" />
                    </Grid>
                </VerticalStackLayout>
                <!--  END STEP 3  -->

                <!--  BUSY OVERLAY  -->
                <Grid
                    BackgroundColor="{DynamicResource PageBackgroundColor}"
                    HorizontalOptions="Fill"
                    IsVisible="{Binding IsBusy}"
                    Opacity="0.94"
                    VerticalOptions="Fill" />
                <VerticalStackLayout
                    HorizontalOptions="Center"
                    IsVisible="{Binding IsBusy}"
                    Spacing="20"
                    VerticalOptions="Center">
                    <Border
                        Padding="28,24"
                        BackgroundColor="{DynamicResource CardBackgroundColor}"
                        HorizontalOptions="Center"
                        StrokeThickness="0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="24" />
                        </Border.StrokeShape>
                        <Border.Shadow>
                            <Shadow
                                Brush="{DynamicResource GrayShadowColor}"
                                Opacity="0.14"
                                Radius="24"
                                Offset="0,8" />
                        </Border.Shadow>
                        <VerticalStackLayout HorizontalOptions="Center" Spacing="16">
                            <ActivityIndicator
                                HeightRequest="48"
                                HorizontalOptions="Center"
                                IsRunning="{Binding IsBusy}"
                                WidthRequest="48"
                                Color="{DynamicResource PrimaryColor}" />
                            <Label
                                FontAttributes="Bold"
                                FontSize="15"
                                HorizontalOptions="Center"
                                HorizontalTextAlignment="Center"
                                Text="{Binding StatusText}"
                                TextColor="{DynamicResource TextColor}" />
                            <Label
                                FontSize="12"
                                HorizontalOptions="Center"
                                Opacity="0.6"
                                Text="This may take a moment…"
                                TextColor="{DynamicResource TextSecondaryColor}" />
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

            </Grid>
        </ScrollView>

    </Grid>
</ContentPage>
