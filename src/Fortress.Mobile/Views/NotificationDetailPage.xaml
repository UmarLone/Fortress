<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Fortress.Views.NotificationDetailPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:mi="http://www.aathifmahir.com/dotnet/2022/maui/icons"
    xmlns:prism="http://prismlibrary.com"
    BackgroundColor="{DynamicResource PageBackgroundColor}"
 NavigationPage.HasNavigationBar="False">

    <Grid RowDefinitions="Auto,*">

 <!--  ??? HERO HEADER ???  -->
  <Border
      Grid.Row="0"
   Padding="20,20,20,28"
          StrokeThickness="0">
       <Border.Background>
   <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
         <GradientStop Offset="0.0" Color="{DynamicResource PrimaryColor}" />
   <GradientStop Offset="1.0" Color="{DynamicResource PrimaryGradient}" />
      </LinearGradientBrush>
       </Border.Background>
       <Border.StrokeShape>
              <RoundRectangle CornerRadius="0,0,28,28" />
            </Border.StrokeShape>

          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">

        <!--  Back button  -->
        <Border
        Grid.Column="0"
        Padding="0"
               BackgroundColor="#20FFFFFF"
          HeightRequest="42"
             StrokeThickness="0"
        VerticalOptions="Center"
       WidthRequest="42">
       <Border.StrokeShape>
  <RoundRectangle CornerRadius="13" />
 </Border.StrokeShape>
   <Grid HorizontalOptions="Fill" VerticalOptions="Fill">
       <mi:MauiIcon
 HorizontalOptions="Center"
              Icon="{mi:Material Icon=ArrowBack}"
        IconColor="White"
             IconSize="20"
     InputTransparent="True"
              VerticalOptions="Center" />
      <Button
           Padding="0"
 BackgroundColor="Transparent"
     BorderWidth="0"
             Command="{Binding GoBackCommand}"
    HorizontalOptions="Fill"
              VerticalOptions="Fill" />
        </Grid>
                </Border>

            <!--  Title block  -->
        <VerticalStackLayout
                Grid.Column="1"
   Spacing="2"
    VerticalOptions="Center">
      <Label
            FontSize="12"
    Opacity="0.75"
         Text="VAULT"
                TextColor="White" />
           <Label
   FontAttributes="Bold"
             FontSize="26"
    Text="Notification"
       TextColor="White" />
             <Label
            FontSize="13"
  Opacity="0.85"
      Text="{Binding FormattedDate}"
   TextColor="White" />
       </VerticalStackLayout>

  </Grid>
     </Border>

        <!--  ??? CONTENT ???  -->
        <ScrollView Grid.Row="1" Padding="16,16,16,24">
            <VerticalStackLayout Spacing="14">

      <!--  Type badge + title card  -->
       <Border
  Padding="18"
       BackgroundColor="{DynamicResource CardBackgroundColor}"
        StrokeThickness="0">
        <Border.StrokeShape>
    <RoundRectangle CornerRadius="16" />
        </Border.StrokeShape>
            <Border.Shadow>
    <Shadow
           Brush="Black"
    Opacity="0.05"
         Radius="10"
         Offset="0,3" />
              </Border.Shadow>

         <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">

           <!--  Icon  -->
    <Border
         Grid.Column="0"
            Padding="0"
         BackgroundColor="{Binding TypeBadgeColor}"
   HeightRequest="52"
      StrokeThickness="0"
      VerticalOptions="Start"
     WidthRequest="52">
   <Border.StrokeShape>
            <RoundRectangle CornerRadius="16" />
    </Border.StrokeShape>
     <Label
           FontFamily="MaterialIcons"
   FontSize="26"
    HorizontalOptions="Center"
         HorizontalTextAlignment="Center"
     Text="{Binding TypeIconGlyph}"
      TextColor="{Binding TypeIconColor}"
           VerticalOptions="Center"
      VerticalTextAlignment="Center" />
          </Border>

       <!--  Badge + Title  -->
                <VerticalStackLayout
      Grid.Column="1"
       Spacing="6"
          VerticalOptions="Center">

   <Border
     Padding="10,4"
        BackgroundColor="{Binding TypeBadgeColor}"
  HorizontalOptions="Start"
      StrokeThickness="0">
          <Border.StrokeShape>
     <RoundRectangle CornerRadius="20" />
      </Border.StrokeShape>
 <Label
   FontAttributes="Bold"
      FontSize="11"
       Text="{Binding TypeLabel}"
              TextColor="{Binding TypeTextColor}" />
  </Border>

        <Label
       FontAttributes="Bold"
         FontSize="18"
  LineBreakMode="WordWrap"
        Text="{Binding Notification.Title}"
             TextColor="{DynamicResource TextColor}" />

       </VerticalStackLayout>
            </Grid>
     </Border>

   <!--  Message body  -->
       <Border
      Padding="18"
    BackgroundColor="{DynamicResource CardBackgroundColor}"
         StrokeThickness="0">
       <Border.StrokeShape>
               <RoundRectangle CornerRadius="16" />
    </Border.StrokeShape>
 <Border.Shadow>
       <Shadow
  Brush="Black"
         Opacity="0.05"
           Radius="10"
     Offset="0,3" />
        </Border.Shadow>
   <VerticalStackLayout Spacing="8">
             <Label
        FontAttributes="Bold"
       FontSize="12"
              Text="MESSAGE"
   TextColor="{DynamicResource TextTertiaryColor}" />
              <Label
     FontSize="15"
                 LineBreakMode="WordWrap"
     Text="{Binding Notification.Message}"
       TextColor="{DynamicResource TextColor}" />
</VerticalStackLayout>
           </Border>

         <!--  Timestamp card  -->
             <Border
         Padding="18"
   BackgroundColor="{DynamicResource CardBackgroundColor}"
        StrokeThickness="0">
       <Border.StrokeShape>
                 <RoundRectangle CornerRadius="16" />
      </Border.StrokeShape>
   <Border.Shadow>
       <Shadow
       Brush="Black"
       Opacity="0.05"
         Radius="10"
             Offset="0,3" />
     </Border.Shadow>
   <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
  <Border
       Grid.Column="0"
 Padding="0"
          BackgroundColor="{DynamicResource PrimaryLightestColor}"
          HeightRequest="36"
   StrokeThickness="0"
             WidthRequest="36">
         <Border.StrokeShape>
    <RoundRectangle CornerRadius="10" />
    </Border.StrokeShape>
     <mi:MauiIcon
       HorizontalOptions="Center"
       Icon="{mi:Material Icon=Schedule}"
 IconColor="{DynamicResource PrimaryColor}"
     IconSize="18"
    VerticalOptions="Center" />
      </Border>
   <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
  <Label
               FontSize="11"
  Text="Received"
     TextColor="{DynamicResource TextTertiaryColor}" />
         <Label
           FontAttributes="Bold"
   FontSize="14"
         Text="{Binding FormattedDate}"
      TextColor="{DynamicResource TextColor}" />
  </VerticalStackLayout>
          </Grid>
    </Border>

            </VerticalStackLayout>
        </ScrollView>

    </Grid>
</ContentPage>
