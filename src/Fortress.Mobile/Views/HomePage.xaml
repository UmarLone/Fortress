<ContentPage
    x:Class="Fortress.Views.HomePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:converter="clr-namespace:Fortress.Converters"
    xmlns:mi="http://www.aathifmahir.com/dotnet/2022/maui/icons"
    xmlns:models="clr-namespace:Fortress.Mobile.Core.Models;assembly=Fortress.Mobile.Core"
    xmlns:prism="http://prismlibrary.com"
    x:Name="MainPage"
    BackgroundColor="{DynamicResource PageBackgroundColor}"
    NavigationPage.HasBackButton="False">

    <NavigationPage.TitleView>
        <Grid
            Padding="12,0"
            BackgroundColor="{DynamicResource HeroGradientStart}"
            ColumnDefinitions="Auto,*,Auto,Auto"
            ColumnSpacing="12">
            <!--
                Solid flat colour — exactly matches BarBackgroundColor set in OnAppearing.
                The gradient is only on the hero below, flowing downward from this colour.
            -->

            <HorizontalStackLayout Grid.Column="0" Spacing="10">
                <Border
                    Padding="1"
                    BackgroundColor="#20FFFFFF"
                    HeightRequest="45"
                    StrokeThickness="0"
                    WidthRequest="45">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="10" />
                    </Border.StrokeShape>
                    <Image Aspect="AspectFit" Source="logowhite.png" />
                </Border>
                <Label
                    CharacterSpacing="3"
                    FontAttributes="Bold"
                    FontFamily="Audiowide"
                    FontSize="22"
                    Text="FORTRESS"
                    TextColor="White"
                    VerticalOptions="Center" />
            </HorizontalStackLayout>

            <!--  Notifications button  -->
            <Grid
                Grid.Column="2"
                HeightRequest="40"
                WidthRequest="40">
                <Border
                    Padding="0"
                    BackgroundColor="#20FFFFFF"
                    HeightRequest="40"
                    StrokeThickness="0"
                    WidthRequest="40">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12" />
                    </Border.StrokeShape>
                    <Button
                        Padding="0"
                        BackgroundColor="Transparent"
                        BorderWidth="0"
                        Command="{Binding NavigateCommand}"
                        CommandParameter="NotificationPage"
                        HeightRequest="40"
                        WidthRequest="40">
                        <Button.ImageSource>
                            <FontImageSource
                                FontFamily="MaterialIconsRegular"
                                Glyph="&#xE7F4;"
                                Size="20"
                                Color="White" />
                        </Button.ImageSource>
                    </Button>
                </Border>

                <!--  Unread badge  -->
                <Border
                    Padding="0"
                    BackgroundColor="#EF4444"
                    HorizontalOptions="End"
                    IsVisible="{Binding HasUnreadNotifications}"
                    MinimumHeightRequest="18"
                    MinimumWidthRequest="18"
                    StrokeThickness="0"
                    VerticalOptions="Start">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="9" />
                    </Border.StrokeShape>
                    <Label
                        Padding="3,1"
                        FontAttributes="Bold"
                        FontSize="10"
                        HorizontalOptions="Center"
                        HorizontalTextAlignment="Center"
                        Text="{Binding UnreadNotificationCount}"
                        TextColor="White"
                        VerticalOptions="Center" />
                </Border>
            </Grid>

            <!--  Settings button  -->
            <Border
                Grid.Column="3"
                Padding="0"
                BackgroundColor="#20FFFFFF"
                HeightRequest="40"
                StrokeThickness="0"
                WidthRequest="40">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12" />
                </Border.StrokeShape>
                <Button
                    Padding="0"
                    BackgroundColor="Transparent"
                    BorderWidth="0"
                    Command="{Binding NavigateCommand}"
                    CommandParameter="MenuPage"
                    HeightRequest="40"
                    WidthRequest="40">
                    <Button.ImageSource>
                        <FontImageSource
                            FontFamily="MaterialIconsRegular"
                            Glyph="&#xE8B8;"
                            Size="20"
                            Color="White" />
                    </Button.ImageSource>
                </Button>
            </Border>
        </Grid>
    </NavigationPage.TitleView>

    <Grid>
        <ScrollView Padding="0,0,0,90">
            <VerticalStackLayout Spacing="0">

                <!--  ═══ VAULT HEALTH HERO ═══  -->
                <Border Padding="20,0,20,28" StrokeThickness="0">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Offset="0.0" Color="{DynamicResource HeroGradientStart}" />
                            <GradientStop Offset="1.0" Color="{DynamicResource HeroGradientEnd}" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="0,0,28,28" />
                    </Border.StrokeShape>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                        <VerticalStackLayout
                            Grid.Column="0"
                            Spacing="6"
                            VerticalOptions="Center">
                            <Label
                                FontSize="13"
                                Opacity="0.75"
                                Text="VAULT HEALTH"
                                TextColor="White" />
                            <HorizontalStackLayout Spacing="2" VerticalOptions="Center">
                                <Label
                                    FontAttributes="Bold"
                                    FontSize="52"
                                    LineHeight="1"
                                    Text="{Binding PasswordHealthScore, StringFormat='{0:F0}'}"
                                    TextColor="White"
                                    VerticalOptions="Center" />
                                <Label
                                    Margin="0,0,0,8"
                                    FontAttributes="Bold"
                                    FontSize="24"
                                    Text="%"
                                    TextColor="White"
                                    VerticalOptions="End" />
                            </HorizontalStackLayout>
                            <HorizontalStackLayout Spacing="12">
                                <HorizontalStackLayout Spacing="4">
                                    <mi:MauiIcon
                                        Icon="{mi:Material Icon=Warning}"
                                        IconColor="#FCD34D"
                                        IconSize="14"
                                        VerticalOptions="Center" />
                                    <Label
                                        FontSize="12"
                                        Opacity="0.9"
                                        Text="{Binding WeakPasswordsCount, StringFormat='{0} weak'}"
                                        TextColor="White"
                                        VerticalOptions="Center" />
                                </HorizontalStackLayout>
                                <HorizontalStackLayout Spacing="4">
                                    <mi:MauiIcon
                                        Icon="{mi:Material Icon=ContentCopy}"
                                        IconColor="#F87171"
                                        IconSize="14"
                                        VerticalOptions="Center" />
                                    <Label
                                        FontSize="12"
                                        Opacity="0.9"
                                        Text="{Binding ReusedPasswordsCount, StringFormat='{0} reused'}"
                                        TextColor="White"
                                        VerticalOptions="Center" />
                                </HorizontalStackLayout>
                                <!--  Health trend indicator  -->
                                <HorizontalStackLayout IsVisible="{Binding HasHealthTrend}" Spacing="3">
                                    <Label
                                        FontFamily="MaterialIconsRegular"
                                        FontSize="13"
                                        Text="{Binding HealthTrendIcon}"
                                        TextColor="{Binding HealthTrendColor}"
                                        VerticalOptions="Center" />
                                    <Label
                                        FontAttributes="Bold"
                                        FontSize="11"
                                        Text="{Binding HealthTrendText}"
                                        TextColor="{Binding HealthTrendColor}"
                                        VerticalOptions="Center" />
                                </HorizontalStackLayout>
                            </HorizontalStackLayout>

                            <!--  View Details pill  -->
                            <Border
                                Margin="0,4,0,0"
                                Padding="0"
                                BackgroundColor="#30FFFFFF"
                                HorizontalOptions="Start"
                                StrokeThickness="0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="20" />
                                </Border.StrokeShape>
                                <Button
                                    Padding="14,8"
                                    BackgroundColor="Transparent"
                                    BorderWidth="0"
                                    Command="{Binding NavigateCommand}"
                                    CommandParameter="VaultHealthPage"
                                    FontAttributes="Bold"
                                    FontSize="12"
                                    Text="View Details →"
                                    TextColor="White" />
                            </Border>
                        </VerticalStackLayout>
                        <Border
                            Grid.Column="1"
                            Padding="14"
                            BackgroundColor="#35FFFFFF"
                            HeightRequest="96"
                            StrokeThickness="2"
                            VerticalOptions="Center"
                            WidthRequest="96">
                            <Border.Stroke>
                                <SolidColorBrush Color="#70FFFFFF" />
                            </Border.Stroke>
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="48" />
                            </Border.StrokeShape>
                            <mi:MauiIcon
                                HorizontalOptions="Center"
                                Icon="{mi:Material Icon=Shield}"
                                IconColor="White"
                                IconSize="44"
                                VerticalOptions="Center" />
                        </Border>
                    </Grid>
                </Border>




                <!--  ═══ AI INSIGHT CARD ═══  -->
                <Border
                    Margin="16,14,16,0"
                    Padding="0"
                    BackgroundColor="{DynamicResource CardBackgroundColor}"
                    IsVisible="{Binding HasAiInsight}"
                    StrokeThickness="0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16" />
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow
                            Brush="Black"
                            Opacity="0.06"
                            Radius="10"
                            Offset="0,3" />
                    </Border.Shadow>
                    <Grid>
                        <Grid
                            Padding="16,14"
                            ColumnDefinitions="Auto,*,Auto"
                            ColumnSpacing="12">
                            <!--  AI Icon with severity color  -->
                            <Border
                                Grid.Column="0"
                                Padding="8"
                                BackgroundColor="{Binding AiInsightSeverityColor}"
                                HeightRequest="40"
                                Opacity="0.15"
                                StrokeThickness="0"
                                WidthRequest="40">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12" />
                                </Border.StrokeShape>
                            </Border>
                            <Label
                                Grid.Column="0"
                                FontFamily="MaterialIconsRegular"
                                FontSize="20"
                                HorizontalOptions="Center"
                                Text="{Binding AiInsightIcon}"
                                TextColor="{Binding AiInsightSeverityColor}"
                                VerticalOptions="Center" />

                            <!--  Insight text  -->
                            <VerticalStackLayout
                                Grid.Column="1"
                                Spacing="4"
                                VerticalOptions="Center">
                                <HorizontalStackLayout Spacing="6">
                                    <Label
                                        FontAttributes="Bold"
                                        FontSize="11"
                                        Text="AI INSIGHT"
                                        TextColor="{Binding AiInsightSeverityColor}"
                                        VerticalOptions="Center" />
                                    <Border
                                        Padding="5,1"
                                        BackgroundColor="{Binding AiInsightSeverityColor}"
                                        StrokeThickness="0"
                                        VerticalOptions="Center">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="6" />
                                        </Border.StrokeShape>
                                        <Label
                                            FontAttributes="Bold"
                                            FontSize="8"
                                            Text="ON-DEVICE"
                                            TextColor="White" />
                                    </Border>
                                </HorizontalStackLayout>
                                <Label
                                    FontSize="13"
                                    LineBreakMode="WordWrap"
                                    MaxLines="3"
                                    Text="{Binding AiInsightText}"
                                    TextColor="{DynamicResource TextColor}" />
                            </VerticalStackLayout>

                            <!--  Action chevron  -->
                            <mi:MauiIcon
                                Grid.Column="2"
                                Icon="{mi:Material Icon=ChevronRight}"
                                IconColor="{DynamicResource TextTertiaryColor}"
                                IconSize="20"
                                VerticalOptions="Center" />
                        </Grid>
                        <Button
                            Padding="0"
                            BackgroundColor="Transparent"
                            BorderWidth="0"
                            Command="{Binding AiInsightTapCommand}"
                            CommandParameter="{Binding AiInsightActionPage}"
                            HorizontalOptions="Fill"
                            VerticalOptions="Fill" />
                    </Grid>
                </Border>

