                <!--  ═══ CATEGORIES ═══  -->
                <VerticalStackLayout Margin="16,20,16,0" Spacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label
                            Grid.Column="0"
                            FontAttributes="Bold"
                            FontSize="17"
                            Text="Categories"
                            TextColor="{DynamicResource TextColor}" />
                        <Button
                            Grid.Column="1"
                            Padding="0"
                            BackgroundColor="Transparent"
                            BorderWidth="0"
                            Command="{Binding NavigateCommand}"
                            CommandParameter="CredentialsPage"
                            FontSize="13"
                            Text="See all"
                            TextColor="{DynamicResource PrimaryColor}" />
                    </Grid>

                    <!--  Row 1: Logins + Cards  -->
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <Border
                            Grid.Column="0"
                            Padding="0"
                            BackgroundColor="{DynamicResource CardBackgroundColor}"
                            StrokeThickness="0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="16" />
                            </Border.StrokeShape>
                            <Border.Shadow>
                                <Shadow
                                    Brush="Black"
                                    Opacity="0.05"
                                    Radius="8"
                                    Offset="0,3" />
                            </Border.Shadow>
                            <Grid>
                                <VerticalStackLayout Padding="14,12" Spacing="10">
                                    <Border
                                        Padding="9"
                                        BackgroundColor="{DynamicResource PrimaryLightestColor}"
                                        HeightRequest="40"
                                        HorizontalOptions="Start"
                                        StrokeThickness="0"
                                        WidthRequest="40">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="10" />
                                        </Border.StrokeShape>
                                        <mi:MauiIcon
                                            HorizontalOptions="Center"
                                            Icon="{mi:Material Icon=Language}"
                                            IconColor="{DynamicResource PrimaryColor}"
                                            IconSize="20"
                                            VerticalOptions="Center" />
                                    </Border>
                                    <VerticalStackLayout Spacing="2">
                                        <Label
                                            FontAttributes="Bold"
                                            FontSize="14"
                                            Text="Logins"
                                            TextColor="{DynamicResource TextColor}" />
                                        <Label
                                            FontSize="12"
                                            Text="{Binding CredentialsCount, StringFormat='{0} items'}"
                                            TextColor="{DynamicResource TextSecondaryColor}" />
                                    </VerticalStackLayout>
                                </VerticalStackLayout>
                                <Button
                                    Padding="0"
                                    BackgroundColor="Transparent"
                                    BorderWidth="0"
                                    Command="{Binding NavigateCommand}"
                                    CommandParameter="CredentialsPage"
                                    HorizontalOptions="Fill"
                                    VerticalOptions="Fill" />
                            </Grid>
                        </Border>

                        <Border
                            Grid.Column="1"
                            Padding="0"
                            BackgroundColor="{DynamicResource CardBackgroundColor}"
                            StrokeThickness="0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="16" />
                            </Border.StrokeShape>
                            <Border.Shadow>
                                <Shadow
                                    Brush="Black"
                                    Opacity="0.05"
                                    Radius="8"
                                    Offset="0,3" />
                            </Border.Shadow>
                            <Grid>
                                <VerticalStackLayout Padding="14,12" Spacing="10">
                                    <Border
                                        Padding="9"
                                        BackgroundColor="{DynamicResource CardsTileBackground}"
                                        HeightRequest="40"
                                        HorizontalOptions="Start"
                                        StrokeThickness="0"
                                        WidthRequest="40">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="10" />
                                        </Border.StrokeShape>
                                        <mi:MauiIcon
                                            HorizontalOptions="Center"
                                            Icon="{mi:Material Icon=CreditCard}"
                                            IconColor="{DynamicResource CardsTileIcon}"
                                            IconSize="20"
                                            VerticalOptions="Center" />
                                    </Border>
                                    <VerticalStackLayout Spacing="2">
                                        <Label
                                            FontAttributes="Bold"
                                            FontSize="14"
                                            Text="Cards"
                                            TextColor="{DynamicResource TextColor}" />
                                        <Label
                                            FontSize="12"
                                            Text="{Binding CreditCardsCount, StringFormat='{0} items'}"
                                            TextColor="{DynamicResource TextSecondaryColor}" />
                                    </VerticalStackLayout>
                                </VerticalStackLayout>
                                <Button
                                    Padding="0"
                                    BackgroundColor="Transparent"
                                    BorderWidth="0"
                                    Command="{Binding NavigateCommand}"
                                    CommandParameter="CreditCardsPage"
                                    HorizontalOptions="Fill"
                                    VerticalOptions="Fill" />
                            </Grid>
                        </Border>
                    </Grid>

                    <!--  Row 2: Secure Items + Secure Notes  -->
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <!--  Secure Items  -->
                        <Border
                            Grid.Column="0"
                            Padding="0"
                            BackgroundColor="{DynamicResource CardBackgroundColor}"
                            StrokeThickness="0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="16" />
                            </Border.StrokeShape>
                            <Border.Shadow>
                                <Shadow
                                    Brush="Black"
                                    Opacity="0.05"
                                    Radius="8"
                                    Offset="0,3" />
                            </Border.Shadow>
                            <Grid>
                                <VerticalStackLayout Padding="14,12" Spacing="10">
                                    <Border
                                        Padding="9"
                                        BackgroundColor="#CCFBF1"
                                        HeightRequest="40"
                                        HorizontalOptions="Start"
                                        StrokeThickness="0"
                                        WidthRequest="40">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="10" />
                                        </Border.StrokeShape>
                                        <mi:MauiIcon
                                            HorizontalOptions="Center"
                                            Icon="{mi:Material Icon=Badge}"
                                            IconColor="#14B8A6"
                                            IconSize="20"
                                            VerticalOptions="Center" />
                                    </Border>
                                    <VerticalStackLayout Spacing="2">
                                        <Label
                                            FontAttributes="Bold"
                                            FontSize="14"
                                            Text="Secure Items"
                                            TextColor="{DynamicResource TextColor}" />
                                        <Label
                                            FontSize="12"
                                            Text="IDs, Wi-Fi, SSH &amp; more"
                                            TextColor="{DynamicResource TextSecondaryColor}" />
                                    </VerticalStackLayout>
                                </VerticalStackLayout>
                                <Button
                                    Padding="0"
                                    BackgroundColor="Transparent"
                                    BorderWidth="0"
                                    Command="{Binding NavigateCommand}"
                                    CommandParameter="SecureItemsPage"
                                    HorizontalOptions="Fill"
                                    VerticalOptions="Fill" />
                            </Grid>
                        </Border>

