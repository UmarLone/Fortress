<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Fortress.Views.CredentialDetailPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:converter="clr-namespace:Fortress.Converters"
    xmlns:ffimage="clr-namespace:FFImageLoading.Maui;assembly=FFImageLoading.Maui"
    xmlns:mi="http://www.aathifmahir.com/dotnet/2022/maui/icons"
    xmlns:prism="http://prismlibrary.com"
    xmlns:sfProgress="clr-namespace:Syncfusion.Maui.Toolkit.ProgressBar;assembly=Syncfusion.Maui.Toolkit"
    prism:ViewModelLocator.AutowireViewModel="Automatic"
    BackgroundColor="{DynamicResource PageBackgroundColor}"
    NavigationPage.HasNavigationBar="False">

    <ContentPage.Resources>
        <converter:StringToInitialsConverter x:Key="InitialsConverter" />
        <converter:StringNullOrEmptyToBoolConverter x:Key="NullOrEmptyToBool" />
        <converter:InverseStringNullOrEmptyConverter x:Key="NotNullOrEmptyToBool" />
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*">

        <!--  ═══ HERO HEADER ═══  -->
        <Border
            Grid.Row="0"
            Padding="20,16,20,28"
            StrokeThickness="0">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Offset="0.0" Color="{DynamicResource PrimaryColor}" />
                    <GradientStop Offset="1.0" Color="{DynamicResource PrimaryGradient}" />
                </LinearGradientBrush>
            </Border.Background>
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="0,0,28,28" />
            </Border.StrokeShape>

            <Grid RowDefinitions="Auto,Auto" RowSpacing="20">

                <!--  Nav row: back + edit  -->
                <Grid
                    Grid.Row="0"
                    ColumnDefinitions="Auto,*,Auto,Auto"
                    ColumnSpacing="12">

                    <!--  Back  -->
                    <Border
                        Grid.Column="0"
                        Padding="0"
                        BackgroundColor="#30FFFFFF"
                        HeightRequest="40"
                        StrokeThickness="0"
                        VerticalOptions="Center"
                        WidthRequest="40">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12" />
                        </Border.StrokeShape>
                        <Button
                            Padding="0"
                            BackgroundColor="Transparent"
                            BorderWidth="0"
                            Command="{Binding GoBackCommand}"
                            HeightRequest="40"
                            WidthRequest="40">
                            <Button.ImageSource>
                                <FontImageSource
                                    FontFamily="MaterialIconsRegular"
                                    Glyph="&#xE5C4;"
                                    Size="22"
                                    Color="White" />
                            </Button.ImageSource>
                        </Button>
                    </Border>

                    <!--  Title  -->
                    <VerticalStackLayout
                        Grid.Column="1"
                        Spacing="2"
                        VerticalOptions="Center">
                        <Label
                            FontSize="12"
                            Opacity="0.75"
                            Text="VAULT"
                            TextColor="White" />
                        <Label
                            FontAttributes="Bold"
                            FontSize="20"
                            LineBreakMode="TailTruncation"
                            Text="{Binding Domain}"
                            TextColor="White" />
                    </VerticalStackLayout>

                    <!--  Share button  -->
                    <Border
                        Grid.Column="2"
                        Padding="0"
                        BackgroundColor="#30FFFFFF"
                        HeightRequest="40"
                        StrokeThickness="0"
                        VerticalOptions="Center"
                        WidthRequest="40">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12" />
                        </Border.StrokeShape>
                        <Grid>
                            <Label
                                FontFamily="MaterialIconsRegular"
                                FontSize="20"
                                HorizontalOptions="Center"
                                InputTransparent="True"
                                Text="&#xE80D;"
                                TextColor="White"
                                VerticalOptions="Center" />
                            <Button
                                Padding="0"
                                BackgroundColor="Transparent"
                                BorderWidth="0"
                                Command="{Binding ShareCommand}"
                                HeightRequest="40"
                                WidthRequest="40" />
                        </Grid>
                    </Border>

                    <!--  Edit button  -->
                    <Border
                        Grid.Column="3"
                        Padding="0"
                        BackgroundColor="#30FFFFFF"
                        HeightRequest="40"
                        StrokeThickness="0"
                        VerticalOptions="Center"
                        WidthRequest="40">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12" />
                        </Border.StrokeShape>
                        <Grid>
                            <Label
                                FontFamily="MaterialIconsRegular"
                                FontSize="20"
                                HorizontalOptions="Center"
                                InputTransparent="True"
                                Text="&#xE3C9;"
                                TextColor="White"
                                VerticalOptions="Center" />
                            <Button
                                Padding="0"
                                BackgroundColor="Transparent"
                                BorderWidth="0"
                                Command="{Binding EditCommand}"
                                HeightRequest="40"
                                WidthRequest="40" />
                        </Grid>
                    </Border>
                </Grid>

                <!--  Icon + identity card  -->
                <Grid
                    Grid.Row="1"
                    ColumnDefinitions="Auto,*"
                    ColumnSpacing="16">

                    <!--  Favicon / initials tile — uses a Grid inside Border so both layers can coexist  -->
                    <Border
                        Grid.Column="0"
                        Padding="0"
                        BackgroundColor="{DynamicResource PrimaryLightestColor}"
                        HeightRequest="56"
                        StrokeThickness="0"
                        WidthRequest="56">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="16" />
                        </Border.StrokeShape>

                        <!--  Grid lets the initials label sit behind the favicon image  -->
                        <Grid>
                            <!--  Initials fallback — always rendered, hidden when favicon loads  -->
                            <Label
                                FontAttributes="Bold"
                                FontSize="20"
                                HorizontalOptions="Center"
                                IsVisible="{Binding IconUri, Converter={StaticResource NullOrEmptyToBool}}"
                                Text="{Binding Domain, Converter={StaticResource InitialsConverter}}"
                                TextColor="{DynamicResource PrimaryColor}"
                                VerticalOptions="Center" />

                            <!--  Favicon — only shown when IconUri is set  -->
                            <Border
                                Padding="10"
                                BackgroundColor="{DynamicResource PrimaryLightestColor}"
                                IsVisible="{Binding IconUri, Converter={StaticResource NotNullOrEmptyToBool}}"
                                StrokeThickness="0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="14" />
                                </Border.StrokeShape>
                                <ffimage:CachedImage
                                    Aspect="AspectFit"
                                    CacheType="All"
                                    DownsampleToViewSize="True"
                                    HeightRequest="36"
                                    HorizontalOptions="Center"
                                    Source="{Binding IconUri}"
                                    VerticalOptions="Center"
                                    WidthRequest="36" />
                            </Border>
                        </Grid>
                    </Border>

                    <VerticalStackLayout
                        Grid.Column="1"
                        Spacing="4"
                        VerticalOptions="Center">
                        <Label
                            FontSize="13"
                            Opacity="0.8"
                            Text="{Binding CredentialType}"
                            TextColor="White" />
                        <Label
                            FontSize="14"
                            Opacity="0.9"
                            Text="{Binding Username}"
                            TextColor="White" />
                    </VerticalStackLayout>
                </Grid>
            </Grid>
        </Border>

        <!--  ═══ CONTENT ═══  -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="16,20,16,40" Spacing="12">

                <!--  ── CREDENTIALS SECTION ──  -->
                <Label
                    Margin="4,0,0,0"
                    FontAttributes="Bold"
                    FontSize="13"
                    Opacity="0.55"
                    Text="CREDENTIALS"
                    TextColor="{DynamicResource TextSecondaryColor}" />

                <Border
                    Padding="0"
                    BackgroundColor="{DynamicResource CardBackgroundColor}"
                    StrokeThickness="0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16" />
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow
                            Brush="Black"
                            Opacity="0.05"
                            Radius="8"
                            Offset="0,3" />
                    </Border.Shadow>
                    <VerticalStackLayout Spacing="0">

                        <!--  Username row  -->
                        <Grid
                            Padding="16,14"
                            ColumnDefinitions="Auto,*,Auto"
                            ColumnSpacing="14">
                            <Border
                                Grid.Column="0"
                                Padding="8"
                                BackgroundColor="{DynamicResource PrimaryLightestColor}"
                                HeightRequest="36"
                                StrokeThickness="0"
                                WidthRequest="36">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="10" />
                                </Border.StrokeShape>
                                <mi:MauiIcon
                                    HorizontalOptions="Center"
                                    Icon="{mi:Material Icon=Person}"
                                    IconColor="{DynamicResource PrimaryColor}"
                                    IconSize="18"
                                    VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout
                                Grid.Column="1"
                                Spacing="2"
                                VerticalOptions="Center">
                                <Label
                                    FontSize="11"
                                    Text="USERNAME / EMAIL"
                                    TextColor="{DynamicResource TextTertiaryColor}" />
                                <Label
                                    FontAttributes="Bold"
                                    FontSize="15"
                                    LineBreakMode="TailTruncation"
                                    Text="{Binding Username}"
                                    TextColor="{DynamicResource TextColor}" />
                            </VerticalStackLayout>
                            <Border
                                Grid.Column="2"
                                Padding="0"
                                BackgroundColor="{DynamicResource Gray-100}"
                                HeightRequest="34"
                                StrokeThickness="0"
                                VerticalOptions="Center"
                                WidthRequest="34">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="10" />
                                </Border.StrokeShape>
                                <Grid>
                                    <mi:MauiIcon
                                        HorizontalOptions="Center"
                                        Icon="{mi:Material Icon=ContentCopy}"
                                        IconColor="{DynamicResource TextSecondaryColor}"
                                        IconSize="16"
                                        InputTransparent="True"
                                        VerticalOptions="Center" />
                                    <Button
                                        Padding="0"
                                        BackgroundColor="Transparent"
                                        BorderWidth="0"
                                        Command="{Binding CopyUsernameCommand}"
                                        HorizontalOptions="Fill"
                                        VerticalOptions="Fill" />
                                </Grid>
                            </Border>
                        </Grid>

                        <BoxView
                            Margin="16,0"
                            HeightRequest="1"
                            Color="{DynamicResource DividerColor}" />

                        <!--  Password row  -->
                        <Grid
                            Padding="16,14"
                            ColumnDefinitions="Auto,*,Auto,Auto"
                            ColumnSpacing="10">
                            <Border
                                Grid.Column="0"
                                Padding="8"
                                BackgroundColor="{DynamicResource PrimaryLightestColor}"
                                HeightRequest="36"
                                StrokeThickness="0"
                                WidthRequest="36">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="10" />
                                </Border.StrokeShape>
                                <mi:MauiIcon
                                    HorizontalOptions="Center"
                                    Icon="{mi:Material Icon=Lock}"
                                    IconColor="{DynamicResource PrimaryColor}"
                                    IconSize="18"
                                    VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout
                                Grid.Column="1"
                                Spacing="2"
                                VerticalOptions="Center">
                                <Label
                                    FontSize="11"
                                    Text="PASSWORD"
                                    TextColor="{DynamicResource TextTertiaryColor}" />
                                <Label
                                    FontAttributes="Bold"
                                    FontSize="15"
                                    LineBreakMode="TailTruncation"
                                    Text="{Binding PasswordDisplay}"
                                    TextColor="{DynamicResource TextColor}" />
                            </VerticalStackLayout>
                            <!--  Toggle visibility  -->
                            <Border
                                Grid.Column="2"
                                Padding="0"
                                BackgroundColor="{DynamicResource Gray-100}"
                                HeightRequest="34"
                                StrokeThickness="0"
                                VerticalOptions="Center"
                                WidthRequest="34">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="10" />
                                </Border.StrokeShape>
                                <Grid>
                                    <Label
                                        FontFamily="MaterialIconsRegular"
                                        FontSize="16"
                                        HorizontalOptions="Center"
                                        InputTransparent="True"
                                        Text="{Binding VisibilityIcon}"
                                        TextColor="{DynamicResource TextSecondaryColor}"
                                        VerticalOptions="Center" />
                                    <Button
                                        Padding="0"
                                        BackgroundColor="Transparent"
                                        BorderWidth="0"
                                        Command="{Binding TogglePasswordCommand}"
                                        HorizontalOptions="Fill"
                                        VerticalOptions="Fill" />
                                </Grid>
                            </Border>
                            <!--  Copy password  -->
                            <Border
                                Grid.Column="3"
                                Padding="0"
                                BackgroundColor="{DynamicResource Gray-100}"
                                HeightRequest="34"
                                StrokeThickness="0"
                                VerticalOptions="Center"
                                WidthRequest="34">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="10" />
                                </Border.StrokeShape>
                                <Grid>
                                    <mi:MauiIcon
                                        HorizontalOptions="Center"
                                        Icon="{mi:Material Icon=ContentCopy}"
                                        IconColor="{DynamicResource TextSecondaryColor}"
                                        IconSize="16"
                                        InputTransparent="True"
                                        VerticalOptions="Center" />
                                    <Button
                                        Padding="0"
                                        BackgroundColor="Transparent"
                                        BorderWidth="0"
                                        Command="{Binding CopyPasswordCommand}"
                                        HorizontalOptions="Fill"
                                        VerticalOptions="Fill" />
                                </Grid>
                            </Border>
                        </Grid>

                    </VerticalStackLayout>
                </Border>

                <!--  ── PASSWORD STRENGTH ──  -->
                <Border
                    Padding="16,14"
                    BackgroundColor="{DynamicResource CardBackgroundColor}"
                    StrokeThickness="0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16" />
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow
                            Brush="Black"
                            Opacity="0.05"
                            Radius="8"
                            Offset="0,3" />
                    </Border.Shadow>
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                        <Border
                            Grid.Column="0"
                            Padding="8"
                            BackgroundColor="{DynamicResource PrimaryLightestColor}"
                            HeightRequest="36"
                            StrokeThickness="0"
                            WidthRequest="36">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="10" />
                            </Border.StrokeShape>
                            <mi:MauiIcon
                                HorizontalOptions="Center"
                                Icon="{mi:Material Icon=Shield}"
                                IconColor="{DynamicResource PrimaryColor}"
                                IconSize="18"
                                VerticalOptions="Center" />
                        </Border>
                        <VerticalStackLayout
                            Grid.Column="1"
                            Spacing="6"
                            VerticalOptions="Center">
                            <Label
                                FontSize="11"
                                Text="PASSWORD STRENGTH"
                                TextColor="{DynamicResource TextTertiaryColor}" />
                            <sfProgress:SfLinearProgressBar
                                HeightRequest="6"
                                Maximum="100"
                                Minimum="0"
                                Progress="{Binding StrengthScore}"
                                ProgressFill="{Binding StrengthColor}"
                                TrackFill="{DynamicResource Gray-200}" />
                        </VerticalStackLayout>
                        <Border
                            Grid.Column="2"
                            Padding="8,4"
                            BackgroundColor="{DynamicResource Gray-100}"
                            StrokeThickness="0"
                            VerticalOptions="Center">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="8" />
                            </Border.StrokeShape>
                            <Label
                                FontAttributes="Bold"
                                FontSize="12"
                                Text="{Binding StrengthLabel}"
                                TextColor="{Binding StrengthColor}" />
                        </Border>
                    </Grid>
                </Border>

                <!--  ── AI RISK BADGE ──  -->
                <Border
                    Padding="14,12"
                    BackgroundColor="{DynamicResource CardBackgroundColor}"
                    IsVisible="{Binding HasRiskBadge}"
                    StrokeThickness="0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16" />
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow
                            Brush="Black"
                            Opacity="0.05"
                            Radius="8"
                            Offset="0,3" />
                    </Border.Shadow>
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                        <Label
                            Grid.Column="0"
                            FontFamily="MaterialIconsRegular"
                            FontSize="20"
                            HorizontalOptions="Center"
                            Text="{Binding RiskBadgeIcon}"
                            TextColor="{Binding RiskBadgeColor}"
                            VerticalOptions="Center" />
                        <VerticalStackLayout
                            Grid.Column="1"
                            Spacing="2"
                            VerticalOptions="Center">
                            <HorizontalStackLayout Spacing="6">
                                <Label
                                    FontAttributes="Bold"
                                    FontSize="11"
                                    Text="AI RISK ANALYSIS"
                                    TextColor="{Binding RiskBadgeColor}"
                                    VerticalOptions="Center" />
                                <Border
                                    Padding="5,1"
                                    BackgroundColor="{Binding RiskBadgeColor}"
                                    StrokeThickness="0"
                                    VerticalOptions="Center">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="6" />
                                    </Border.StrokeShape>
                                    <Label
                                        FontAttributes="Bold"
                                        FontSize="8"
                                        Text="ON-DEVICE"
                                        TextColor="White" />
                                </Border>
                            </HorizontalStackLayout>
                            <Label
                                FontSize="13"
                                Text="{Binding RiskBadgeText}"
                                TextColor="{DynamicResource TextColor}" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <!--  ── 2FA / OTP ──  -->
                <Border
                    Padding="16,14"
                    BackgroundColor="{DynamicResource CardBackgroundColor}"
                    IsVisible="{Binding HasOtp}"
                    StrokeThickness="0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16" />
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow
                            Brush="Black"
                            Opacity="0.05"
                            Radius="8"
                            Offset="0,3" />
                    </Border.Shadow>
                    <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="12">
                        <Border
                            Grid.Column="0"
                            Padding="8"
                            BackgroundColor="#EEF2FF"
                            HeightRequest="36"
                            StrokeThickness="0"
                            WidthRequest="36">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="10" />
                            </Border.StrokeShape>
                            <mi:MauiIcon
                                HorizontalOptions="Center"
                                Icon="{mi:Material Icon=Lock}"
                                IconColor="#6366F1"
                                IconSize="18"
                                VerticalOptions="Center" />
                        </Border>
                        <VerticalStackLayout
                            Grid.Column="1"
                            Spacing="3"
                            VerticalOptions="Center">
                            <Label
                                FontSize="11"
                                Text="2FA CODE"
                                TextColor="{DynamicResource TextTertiaryColor}" />
                            <Label
                                CharacterSpacing="4"
                                FontAttributes="Bold"
                                FontSize="22"
                                Text="{Binding OtpCode}"
                                TextColor="#6366F1" />
                        </VerticalStackLayout>
                        <!--  OTP progress ring  -->
                        <Grid
                            Grid.Column="2"
                            HeightRequest="40"
                            VerticalOptions="Center"
                            WidthRequest="40">
                            <sfProgress:SfCircularProgressBar
                                Background="Transparent"
                                HorizontalOptions="Fill"
                                IndeterminateAnimationDuration="0"
                                Maximum="{Binding OtpDuration}"
                                Minimum="0"
                                Progress="{Binding OtpProgress}"
                                ProgressFill="#6366F1"
                                StartAngle="-90"
                                TrackFill="{DynamicResource Gray-200}"
                                VerticalOptions="Fill" />
                            <Label
                                FontAttributes="Bold"
                                FontSize="10"
                                HorizontalOptions="Center"
                                Text="{Binding OtpProgress, StringFormat='{0:F0}'}"
                                TextColor="#6366F1"
                                VerticalOptions="Center" />
                        </Grid>
                        <Border
                            Grid.Column="3"
                            Padding="0"
                            BackgroundColor="{DynamicResource Gray-100}"
                            HeightRequest="34"
                            StrokeThickness="0"
                            VerticalOptions="Center"
                            WidthRequest="34">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="10" />
                            </Border.StrokeShape>
                            <Grid>
                                <mi:MauiIcon
                                    HorizontalOptions="Center"
                                    Icon="{mi:Material Icon=ContentCopy}"
                                    IconColor="{DynamicResource TextSecondaryColor}"
                                    IconSize="16"
                                    InputTransparent="True"
                                    VerticalOptions="Center" />
                                <Button
                                    Padding="0"
                                    BackgroundColor="Transparent"
                                    BorderWidth="0"
                                    Command="{Binding CopyOtpCommand}"
                                    HorizontalOptions="Fill"
                                    VerticalOptions="Fill" />
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <!--  ── NOTES ──  -->
                <Border
                    Padding="16,14"
                    BackgroundColor="{DynamicResource CardBackgroundColor}"
                    IsVisible="{Binding HasNotes}"
                    StrokeThickness="0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16" />
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow
                            Brush="Black"
                            Opacity="0.05"
                            Radius="8"
                            Offset="0,3" />
                    </Border.Shadow>
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                        <Border
                            Grid.Column="0"
                            Padding="8"
                            BackgroundColor="{DynamicResource WarningLightColor}"
                            HeightRequest="36"
                            StrokeThickness="0"
                            VerticalOptions="Start"
                            WidthRequest="36">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="10" />
                            </Border.StrokeShape>
                            <mi:MauiIcon
                                HorizontalOptions="Center"
                                Icon="{mi:Material Icon=StickyNote2}"
                                IconColor="{DynamicResource WarningColor}"
                                IconSize="18"
                                VerticalOptions="Center" />
                        </Border>
                        <VerticalStackLayout
                            Grid.Column="1"
                            Spacing="4"
                            VerticalOptions="Center">
                            <Label
                                FontSize="11"
                                Text="NOTES"
                                TextColor="{DynamicResource TextTertiaryColor}" />
                            <Label
                                FontSize="14"
                                LineBreakMode="WordWrap"
                                Text="{Binding Notes}"
                                TextColor="{DynamicResource TextColor}" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <!--  ── ITEM INFO ──  -->
                <Label
                    Margin="4,4,0,0"
                    FontAttributes="Bold"
                    FontSize="13"
                    Opacity="0.55"
                    Text="ITEM INFO"
                    TextColor="{DynamicResource TextSecondaryColor}" />

                <Border
                    Padding="0"
                    BackgroundColor="{DynamicResource CardBackgroundColor}"
                    StrokeThickness="0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16" />
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow
                            Brush="Black"
                            Opacity="0.05"
                            Radius="8"
                            Offset="0,3" />
                    </Border.Shadow>
                    <VerticalStackLayout Spacing="0">

                        <!--  Date added  -->
                        <Grid
                            Padding="16,12"
                            ColumnDefinitions="Auto,*,Auto"
                            ColumnSpacing="14">
                            <mi:MauiIcon
                                Grid.Column="0"
                                Icon="{mi:Material Icon=AddCircleOutline}"
                                IconColor="{DynamicResource TextTertiaryColor}"
                                IconSize="18"
                                VerticalOptions="Center" />
                            <Label
                                Grid.Column="1"
                                FontSize="14"
                                Text="Date Added"
                                TextColor="{DynamicResource TextColor}"
                                VerticalOptions="Center" />
                            <Label
                                Grid.Column="2"
                                FontSize="13"
                                Text="{Binding CreatedDisplay}"
                                TextColor="{DynamicResource TextSecondaryColor}"
                                VerticalOptions="Center" />
                        </Grid>

                        <BoxView
                            Margin="16,0"
                            HeightRequest="1"
                            Color="{DynamicResource DividerColor}" />

                        <!--  Last modified  -->
                        <Grid
                            Padding="16,12"
                            ColumnDefinitions="Auto,*,Auto"
                            ColumnSpacing="14">
                            <mi:MauiIcon
                                Grid.Column="0"
                                Icon="{mi:Material Icon=EditCalendar}"
                                IconColor="{DynamicResource TextTertiaryColor}"
                                IconSize="18"
                                VerticalOptions="Center" />
                            <Label
                                Grid.Column="1"
                                FontSize="14"
                                Text="Last Modified"
                                TextColor="{DynamicResource TextColor}"
                                VerticalOptions="Center" />
                            <Label
                                Grid.Column="2"
                                FontSize="13"
                                Text="{Binding UpdatedDisplay}"
                                TextColor="{DynamicResource TextSecondaryColor}"
                                VerticalOptions="Center" />
                        </Grid>

                        <BoxView
                            Margin="16,0"
                            HeightRequest="1"
                            Color="{DynamicResource DividerColor}" />

                        <!--  Type  -->
                        <Grid
                            Padding="16,12"
                            ColumnDefinitions="Auto,*,Auto"
                            ColumnSpacing="14">
                            <mi:MauiIcon
                                Grid.Column="0"
                                Icon="{mi:Material Icon=Category}"
                                IconColor="{DynamicResource TextTertiaryColor}"
                                IconSize="18"
                                VerticalOptions="Center" />
                            <Label
                                Grid.Column="1"
                                FontSize="14"
                                Text="Type"
                                TextColor="{DynamicResource TextColor}"
                                VerticalOptions="Center" />
                            <Label
                                Grid.Column="2"
                                FontSize="13"
                                Text="{Binding CredentialType}"
                                TextColor="{DynamicResource TextSecondaryColor}"
                                VerticalOptions="Center" />
                        </Grid>

                        <BoxView
                            Margin="16,0"
                            HeightRequest="1"
                            Color="{DynamicResource DividerColor}" />

                        <!--  2FA enabled  -->
                        <Grid
                            Padding="16,12"
                            ColumnDefinitions="Auto,*,Auto"
                            ColumnSpacing="14">
                            <mi:MauiIcon
                                Grid.Column="0"
                                Icon="{mi:Material Icon=VerifiedUser}"
                                IconColor="{DynamicResource TextTertiaryColor}"
                                IconSize="18"
                                VerticalOptions="Center" />
                            <Label
                                Grid.Column="1"
                                FontSize="14"
                                Text="Two-Factor Auth"
                                TextColor="{DynamicResource TextColor}"
                                VerticalOptions="Center" />
                            <Border
                                Grid.Column="2"
                                Padding="8,3"
                                StrokeThickness="0"
                                VerticalOptions="Center">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="8" />
                                </Border.StrokeShape>
                                <Border.Triggers>
                                    <DataTrigger
                                        Binding="{Binding HasOtp}"
                                        TargetType="Border"
                                        Value="True">
                                        <Setter Property="BackgroundColor" Value="{DynamicResource SuccessLightColor}" />
                                    </DataTrigger>
                                    <DataTrigger
                                        Binding="{Binding HasOtp}"
                                        TargetType="Border"
                                        Value="False">
                                        <Setter Property="BackgroundColor" Value="{DynamicResource Gray-100}" />
                                    </DataTrigger>
                                </Border.Triggers>
                                <Label FontAttributes="Bold" FontSize="12">
                                    <Label.Triggers>
                                        <DataTrigger
                                            Binding="{Binding HasOtp}"
                                            TargetType="Label"
                                            Value="True">
                                            <Setter Property="Text" Value="Enabled" />
                                            <Setter Property="TextColor" Value="{DynamicResource SuccessColor}" />
                                        </DataTrigger>
                                        <DataTrigger
                                            Binding="{Binding HasOtp}"
                                            TargetType="Label"
                                            Value="False">
                                            <Setter Property="Text" Value="Not set up" />
                                            <Setter Property="TextColor" Value="{DynamicResource TextSecondaryColor}" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                            </Border>
                        </Grid>

                        <BoxView
                            Margin="16,0"
                            HeightRequest="1"
                            Color="{DynamicResource DividerColor}" />

                        <!--  Require auth  -->
                        <Grid
                            Padding="16,12"
                            ColumnDefinitions="Auto,*,Auto"
                            ColumnSpacing="14">
                            <mi:MauiIcon
                                Grid.Column="0"
                                Icon="{mi:Material Icon=Fingerprint}"
                                IconColor="{DynamicResource TextTertiaryColor}"
                                IconSize="18"
                                VerticalOptions="Center" />
                            <Label
                                Grid.Column="1"
                                FontSize="14"
                                Text="Require Auth to Fill"
                                TextColor="{DynamicResource TextColor}"
                                VerticalOptions="Center" />
                            <Label
                                Grid.Column="2"
                                FontAttributes="Bold"
                                FontSize="13"
                                VerticalOptions="Center">
                                <Label.Triggers>
                                    <DataTrigger
                                        Binding="{Binding RequireAuth}"
                                        TargetType="Label"
                                        Value="True">
                                        <Setter Property="Text" Value="Yes" />
                                        <Setter Property="TextColor" Value="{DynamicResource WarningColor}" />
                                    </DataTrigger>
                                    <DataTrigger
                                        Binding="{Binding RequireAuth}"
                                        TargetType="Label"
                                        Value="False">
                                        <Setter Property="Text" Value="No" />
                                        <Setter Property="TextColor" Value="{DynamicResource TextSecondaryColor}" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                        </Grid>

                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
