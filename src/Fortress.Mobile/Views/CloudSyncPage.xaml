                                    FontAttributes="Bold"
                                    FontSize="16"
                                    Text="iCloud Drive"
                                    TextColor="{DynamicResource TextColor}" />
                                <Label
                                    FontSize="13"
                                    Text="Native Apple backup — no sign-in needed"
                                    TextColor="{DynamicResource TextSecondaryColor}" />
