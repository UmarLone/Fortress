                                    HorizontalOptions="Center"
                                    Icon="{mi:FontAwesomeBrand Icon=Apple}"
                                    IconColor="White"
                                    IconSize="24"
                                    VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout
                                Grid.Column="1"
                                Spacing="4"
                                VerticalOptions="Center">
