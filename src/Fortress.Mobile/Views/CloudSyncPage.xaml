<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Fortress.Views.CloudSyncPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ctrl="clr-namespace:Fortress.Controls"
    xmlns:mi="http://www.aathifmahir.com/dotnet/2022/maui/icons"
    xmlns:prism="http://prismlibrary.com"
    BackgroundColor="{DynamicResource PageBackgroundColor}"
    NavigationPage.HasNavigationBar="False">

    <Grid RowDefinitions="Auto,*">

        <!--  ═══ HERO HEADER ═══  -->
        <ctrl:VaultPageHero
            Title="Backups | Sync"
            Grid.Row="0"
            BackCommand="{Binding GoBackCommand}"
            CountText="Backup your encrypted vault"
            GradientEnd="{DynamicResource HeroGradientEnd}"
            GradientStart="{DynamicResource HeroGradientStart}"
            IconGlyph="&#xEB5F;"
            SearchEnabled="False"
            Subtitle="SETTINGS" />

        <!--  ═══ CONTENT ═══  -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="16,16,16,32" Spacing="14">

                <!--  Section label  -->
                <Label
                    Margin="4,4,0,0"
                    FontAttributes="Bold"
                    FontSize="13"
                    Opacity="0.55"
                    Text="CLOUD PROVIDERS"
                    TextColor="{DynamicResource TextSecondaryColor}" />

                <!--  ── Google Drive ──  -->
                <Border
                    Padding="0"
                    BackgroundColor="{DynamicResource CardBackgroundColor}"
                    StrokeThickness="0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16" />
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow
                            Brush="{DynamicResource GrayShadowColor}"
                            Opacity="0.06"
                            Radius="12"
                            Offset="0,4" />
                    </Border.Shadow>
                    <Grid>
                        <Grid
                            Padding="18"
                            ColumnDefinitions="Auto,*,Auto"
                            ColumnSpacing="14">
                            <Border
                                Grid.Column="0"
                                Padding="12"
                                HeightRequest="50"
                                InputTransparent="True"
                                StrokeThickness="0"
                                WidthRequest="50">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Offset="0.0" Color="#4285F4" />
                                        <GradientStop Offset="1.0" Color="#34A853" />
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12" />
                                </Border.StrokeShape>
                                <mi:MauiIcon
                                    HorizontalOptions="Center"
                                    Icon="{mi:FontAwesomeBrand Icon=Google}"
                                    IconColor="White"
                                    IconSize="24"
                                    InputTransparent="True"
                                    VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout
                                Grid.Column="1"
                                InputTransparent="True"
                                Spacing="4"
                                VerticalOptions="Center">
                                <Label
                                    FontAttributes="Bold"
                                    FontSize="16"
                                    InputTransparent="True"
                                    Text="Google Drive"
                                    TextColor="{DynamicResource TextColor}" />
                                <Label
                                    FontSize="13"
                                    InputTransparent="True"
                                    Text="Secure backup to your Google account"
                                    TextColor="{DynamicResource TextSecondaryColor}" />
                            </VerticalStackLayout>
                            <Grid
                                Grid.Column="2"
                                ColumnDefinitions="Auto,Auto"
                                ColumnSpacing="6"
                                InputTransparent="True"
                                VerticalOptions="Center">
                                <Border
                                    Grid.Column="0"
                                    Padding="8,4"
                                    BackgroundColor="{DynamicResource SuccessLightColor}"
                                    InputTransparent="True"
                                    IsVisible="{Binding IsGoogleDriveConnected}"
                                    StrokeThickness="0">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="8" />
                                    </Border.StrokeShape>
                                    <Label
                                        FontAttributes="Bold"
                                        FontSize="11"
                                        InputTransparent="True"
                                        Text="● ON"
                                        TextColor="{DynamicResource SuccessColor}" />
                                </Border>
                                <mi:MauiIcon
                                    Grid.Column="1"
                                    Icon="{mi:Material Icon=ChevronRight}"
                                    IconColor="{DynamicResource TextTertiaryColor}"
                                    IconSize="24"
                                    InputTransparent="True"
                                    VerticalOptions="Center" />
                            </Grid>
                        </Grid>
                        <Button
                            Padding="0"
                            BackgroundColor="Transparent"
                            BorderWidth="0"
                            Command="{Binding SelectProviderCommand}"
                            CommandParameter="GoogleDrive"
                            HorizontalOptions="Fill"
                            VerticalOptions="Fill" />
                    </Grid>
                </Border>

                <!--  ── Dropbox ──  -->
                <Border
                    Padding="0"
                    BackgroundColor="{DynamicResource CardBackgroundColor}"
                    StrokeThickness="0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16" />
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow
                            Brush="{DynamicResource GrayShadowColor}"
                            Opacity="0.06"
                            Radius="12"
                            Offset="0,4" />
                    </Border.Shadow>
                    <Grid>
                        <Grid
                            Padding="18"
                            ColumnDefinitions="Auto,*,Auto"
                            ColumnSpacing="14">
                            <Border
                                Grid.Column="0"
                                Padding="12"
                                BackgroundColor="#0061FF"
                                HeightRequest="50"
                                InputTransparent="True"
                                StrokeThickness="0"
                                WidthRequest="50">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12" />
                                </Border.StrokeShape>
                                <mi:MauiIcon
                                    HorizontalOptions="Center"
                                    Icon="{mi:FontAwesomeBrand Icon=Dropbox}"
                                    IconColor="White"
                                    IconSize="24"
                                    InputTransparent="True"
                                    VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout
                                Grid.Column="1"
                                InputTransparent="True"
                                Spacing="4"
                                VerticalOptions="Center">
                                <Label
                                    FontAttributes="Bold"
                                    FontSize="16"
                                    InputTransparent="True"
                                    Text="Dropbox"
                                    TextColor="{DynamicResource TextColor}" />
                                <Label
                                    FontSize="13"
                                    InputTransparent="True"
                                    Text="Backup to your Dropbox storage"
                                    TextColor="{DynamicResource TextSecondaryColor}" />
                            </VerticalStackLayout>
                            <Grid
                                Grid.Column="2"
                                ColumnDefinitions="Auto,Auto"
                                ColumnSpacing="6"
                                InputTransparent="True"
                                VerticalOptions="Center">

                                <Border
                                    Grid.Column="0"
                                    Padding="8,4"
                                    BackgroundColor="{DynamicResource SuccessLightColor}"
                                    InputTransparent="True"
                                    IsVisible="{Binding IsDropboxConnected}"
                                    StrokeThickness="0">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="8" />
                                    </Border.StrokeShape>
                                    <Label
                                        FontAttributes="Bold"
                                        FontSize="11"
                                        InputTransparent="True"
                                        Text="● ON"
                                        TextColor="{DynamicResource SuccessColor}" />
                                </Border>
                                <mi:MauiIcon
                                    Grid.Column="1"
                                    Icon="{mi:Material Icon=ChevronRight}"
                                    IconColor="{DynamicResource TextTertiaryColor}"
                                    IconSize="24"
                                    InputTransparent="True"
                                    VerticalOptions="Center" />
                            </Grid>
                        </Grid>
                        <Button
                            Padding="0"
                            BackgroundColor="Transparent"
                            BorderWidth="0"
                            Command="{Binding SelectProviderCommand}"
                            CommandParameter="Dropbox"
                            HorizontalOptions="Fill"
                            VerticalOptions="Fill" />
                    </Grid>
                </Border>

                <!--  ── OneDrive ──  -->
                <Border
                    Padding="0"
                    BackgroundColor="{DynamicResource CardBackgroundColor}"
                    StrokeThickness="0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16" />
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow
                            Brush="{DynamicResource GrayShadowColor}"
                            Opacity="0.06"
                            Radius="12"
                            Offset="0,4" />
                    </Border.Shadow>
                    <Grid>
                        <Grid
                            Padding="18"
                            ColumnDefinitions="Auto,*,Auto"
                            ColumnSpacing="14">
                            <Border
                                Grid.Column="0"
                                Padding="12"
                                HeightRequest="50"
                                StrokeThickness="0"
                                WidthRequest="50">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Offset="0.0" Color="#0078D4" />
                                        <GradientStop Offset="1.0" Color="#00BCF2" />
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12" />
                                </Border.StrokeShape>
                                <mi:MauiIcon
                                    HorizontalOptions="Center"
                                    Icon="{mi:FontAwesomeBrand Icon=Microsoft}"
                                    IconColor="White"
                                    IconSize="24"
                                    VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout
                                Grid.Column="1"
                                Spacing="4"
                                VerticalOptions="Center">
                                <Label
                                    FontAttributes="Bold"
                                    FontSize="16"
                                    Text="OneDrive"
                                    TextColor="{DynamicResource TextColor}" />
                                <Label
                                    FontSize="13"
                                    Text="Backup to your Microsoft OneDrive"
                                    TextColor="{DynamicResource TextSecondaryColor}" />
                            </VerticalStackLayout>
                            <Grid
                                Grid.Column="2"
                                ColumnDefinitions="Auto,Auto"
                                ColumnSpacing="6"
                                VerticalOptions="Center">
                                <Border
                                    Grid.Column="0"
                                    Padding="8,4"
                                    BackgroundColor="{DynamicResource SuccessLightColor}"
                                    InputTransparent="True"
                                    IsVisible="{Binding IsOneDriveConnected}"
                                    StrokeThickness="0">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="8" />
                                    </Border.StrokeShape>
                                    <Label
                                        FontAttributes="Bold"
                                        FontSize="11"
                                        InputTransparent="True"
                                        Text="● ON"
                                        TextColor="{DynamicResource SuccessColor}" />
                                </Border>
                                <mi:MauiIcon
                                    Grid.Column="1"
                                    Icon="{mi:Material Icon=ChevronRight}"
                                    IconColor="{DynamicResource TextTertiaryColor}"
                                    IconSize="24"
                                    VerticalOptions="Center" />
                            </Grid>
                        </Grid>
                        <Button
                            Padding="0"
                            BackgroundColor="Transparent"
                            BorderWidth="0"
                            Command="{Binding SelectProviderCommand}"
                            CommandParameter="OneDrive"
                            HorizontalOptions="Fill"
                            VerticalOptions="Fill" />
                    </Grid>
                </Border>

                <!--  ── iCloud Drive ──  -->
                <!--<Border
                    Padding="0"
                    BackgroundColor="{DynamicResource CardBackgroundColor}"
                    StrokeThickness="0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16" />
