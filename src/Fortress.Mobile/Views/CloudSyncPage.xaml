                <!--  Section label  -->
                <Label
                    Margin="4,8,0,0"
                    FontAttributes="Bold"
                    FontSize="13"
                    Opacity="0.55"
                    Text="OTHER"
                    TextColor="{DynamicResource TextSecondaryColor}" />

                <!--  ── USB / External Storage ──  -->
                <Border
                    Padding="0"
                    BackgroundColor="{DynamicResource CardBackgroundColor}"
                    StrokeThickness="0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16" />
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow
                            Brush="{DynamicResource GrayShadowColor}"
                            Opacity="0.06"
                            Radius="12"
                            Offset="0,4" />
                    </Border.Shadow>
                    <Grid>
                        <Grid
                            Padding="18"
                            ColumnDefinitions="Auto,*,Auto"
                            ColumnSpacing="14">
                            <Border
                                Grid.Column="0"
                                Padding="12"
                                HeightRequest="50"
                                InputTransparent="True"
                                StrokeThickness="0"
                                WidthRequest="50">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Offset="0.0" Color="#78716C" />
                                        <GradientStop Offset="1.0" Color="#44403C" />
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12" />
                                </Border.StrokeShape>
                                <!--  USB drive glyph &#xE1BC; = usb  -->
                                <Label
                                    FontFamily="MaterialIconsRegular"
                                    FontSize="24"
                                    HorizontalOptions="Center"
                                    InputTransparent="True"
                                    Text="&#xE1BC;"
                                    TextColor="White"
                                    VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout
                                Grid.Column="1"
                                InputTransparent="True"
                                Spacing="4"
                                VerticalOptions="Center">
                                <Label
                                    FontAttributes="Bold"
                                    FontSize="16"
                                    InputTransparent="True"
                                    Text="USB / External Storage"
                                    TextColor="{DynamicResource TextColor}" />
                                <Label
                                    FontSize="13"
                                    InputTransparent="True"
                                    Text="Export encrypted backup to a thumb drive or local file"
                                    TextColor="{DynamicResource TextSecondaryColor}" />
                            </VerticalStackLayout>
                            <mi:MauiIcon
                                Grid.Column="2"
                                Icon="{mi:Material Icon=ChevronRight}"
                                IconColor="{DynamicResource TextTertiaryColor}"
                                IconSize="24"
                                InputTransparent="True"
                                VerticalOptions="Center" />
                        </Grid>
                        <Button
                            Padding="0"
                            BackgroundColor="Transparent"
                            BorderWidth="0"
                            Command="{Binding SelectProviderCommand}"
                            CommandParameter="UsbExport"
                            HorizontalOptions="Fill"
                            VerticalOptions="Fill" />
                    </Grid>
                </Border>

                <!--  Info Banner  -->
                <Border
                    Margin="0,4,0,0"
                    Padding="16"
                    BackgroundColor="{DynamicResource InfoLightColor}"
                    StrokeThickness="0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12" />
                    </Border.StrokeShape>
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <mi:MauiIcon
                            Grid.Column="0"
                            Icon="{mi:Material Icon=Info}"
                            IconColor="{DynamicResource InfoColor}"
                            IconSize="24"
                            VerticalOptions="Start" />
                        <VerticalStackLayout Grid.Column="1" Spacing="4">
                            <Label
                                FontAttributes="Bold"
                                FontSize="14"
                                Text="Your Data is Always Encrypted"
                                TextColor="{DynamicResource InfoColor}" />
                            <Label
                                FontSize="13"
                                Text="All backups are encrypted with your master password before uploading. No one can access your data without it."
                                TextColor="{DynamicResource TextSecondaryColor}" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
