<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Fortress.Views.IdentitiesPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ctrl="clr-namespace:Fortress.Controls"
    xmlns:mi="http://www.aathifmahir.com/dotnet/2022/maui/icons"
    xmlns:prism="http://prismlibrary.com"
    xmlns:sfShimmer="clr-namespace:Syncfusion.Maui.Toolkit.Shimmer;assembly=Syncfusion.Maui.Toolkit"
    xmlns:vm="clr-namespace:Fortress.ViewModels"
    x:Name="Page"
    prism:ViewModelLocator.AutowireViewModel="Automatic"
    BackgroundColor="{DynamicResource PageBackgroundColor}"
    NavigationPage.HasNavigationBar="False">

    <!--  Row 0 = hero (always visible), Row 1 = selection bar, Row 2 = content + shimmer  -->
    <Grid RowDefinitions="Auto,Auto,*">

 <!--  Hero — never shimmer'd  -->
        <ctrl:VaultPageHero
   Grid.Row="0"
            Title="Identities"
            BackCommand="{Binding Source={x:Reference Page}, Path=BindingContext.GoBackCommand}"
  CountText="{Binding Source={x:Reference Page}, Path=BindingContext.IdentitiesCountText}"
      GradientEnd="{DynamicResource HeroGradientEnd}"
     GradientStart="{DynamicResource HeroGradientStart}"
        IconGlyph="&#xE7FD;"
            SearchText="{Binding Source={x:Reference Page}, Path=BindingContext.SearchText, Mode=TwoWay}"
            Subtitle="VAULT" />

     <!--  ═══ SELECTION MODE BAR ═══  -->
     <Border
  Grid.Row="1"
  Margin="16,8,16,4"
  Padding="14,10"
  BackgroundColor="{DynamicResource CardBackgroundColor}"
  IsVisible="{Binding Source={x:Reference Page}, Path=BindingContext.IsSelectionMode}"
  StrokeThickness="0">
  <Border.StrokeShape>
  <RoundRectangle CornerRadius="14" />
  </Border.StrokeShape>
  <Border.Shadow>
  <Shadow Brush="Black" Opacity="0.06" Radius="8" Offset="0,2" />
  </Border.Shadow>
  <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
  <VerticalStackLayout VerticalOptions="Center">
  <Label FontAttributes="Bold" FontSize="16"
      Text="{Binding Source={x:Reference Page}, Path=BindingContext.SelectedCountText}"
      TextColor="{DynamicResource TextColor}" />
  <Label FontSize="11" Text="Tap items to select"
      TextColor="{DynamicResource TextSecondaryColor}" />
  </VerticalStackLayout>
  <Button Grid.Column="1" Padding="12,8"
      BackgroundColor="{DynamicResource PrimaryLightestColor}"
   Command="{Binding Source={x:Reference Page}, Path=BindingContext.SelectAllCommand}"
   CornerRadius="10" FontAttributes="Bold" FontSize="12" HeightRequest="36"
      Text="Select All" TextColor="{DynamicResource PrimaryColor}" />
  <Button Grid.Column="2" Padding="12,8"
      BackgroundColor="{DynamicResource Gray-100}"
      Command="{Binding Source={x:Reference Page}, Path=BindingContext.ExitSelectionModeCommand}"
      CornerRadius="10" FontAttributes="Bold" FontSize="12" HeightRequest="36"
      Text="Cancel" TextColor="{DynamicResource TextSecondaryColor}" />
  </Grid>
  </Border>

    <!--  Content area  -->
   <Grid Grid.Row="2">

         <RefreshView
    Command="{Binding Source={x:Reference Page}, Path=BindingContext.RefreshCommand}"
       IsRefreshing="{Binding Source={x:Reference Page}, Path=BindingContext.IsRefreshing}">
       <CollectionView ItemsSource="{Binding Source={x:Reference Page}, Path=BindingContext.Identities}">

  <CollectionView.EmptyView>
    <VerticalStackLayout
            Padding="40"
         HorizontalOptions="Center"
           Spacing="16"
     VerticalOptions="Center">
  <Border
   Padding="24"
   BackgroundColor="{DynamicResource IdTileBackground}"
             HeightRequest="88"
           HorizontalOptions="Center"
  StrokeThickness="0"
           WidthRequest="88">
               <Border.StrokeShape>
     <RoundRectangle CornerRadius="44" />
  </Border.StrokeShape>
            <mi:MauiIcon
             HorizontalOptions="Center"
     Icon="{mi:Material Icon=PersonAdd}"
        IconColor="{DynamicResource IdTileIcon}"
        IconSize="40"
VerticalOptions="Center" />
         </Border>
              <Label
      FontAttributes="Bold"
          FontSize="20"
         HorizontalOptions="Center"
        Text="No identities yet"
             TextColor="{DynamicResource TextColor}" />
       <Label
           FontSize="14"
          HorizontalOptions="Center"
       HorizontalTextAlignment="Center"
    Text="Tap + to store your first identity or address."
       TextColor="{DynamicResource TextSecondaryColor}" />
     </VerticalStackLayout>
               </CollectionView.EmptyView>

         <CollectionView.ItemsLayout>
       <LinearItemsLayout ItemSpacing="0" Orientation="Vertical" />
     </CollectionView.ItemsLayout>

        <CollectionView.ItemTemplate>
     <DataTemplate x:DataType="vm:IdentityItemViewModel">
   <Grid Padding="16,6,16,0">
           <Border
      Padding="0"
      BackgroundColor="{DynamicResource CardBackgroundColor}"
         StrokeThickness="0">
<Border.StrokeShape>
   <RoundRectangle CornerRadius="16" />
     </Border.StrokeShape>
         <Border.Shadow>
                   <Shadow
      Brush="Black"
            Opacity="0.05"
    Radius="8"
    Offset="0,3" />
       </Border.Shadow>
           <Grid>
  <Grid
  Padding="16,14,16,14"
  ColumnDefinitions="Auto,Auto,*,Auto"
  ColumnSpacing="14">

  <!--  Checkbox (selection mode only) -->
  <ctrl:SelectionCheckMark
  Grid.Column="0"
  IsChecked="{Binding IsSelected, Mode=TwoWay}"
  IsVisible="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.IsSelectionMode}"
  VerticalOptions="Center" />

  <Border
  Grid.Column="1"
  Padding="10"
  BackgroundColor="{DynamicResource IdTileBackground}"
  HeightRequest="48"
  StrokeThickness="0"
  VerticalOptions="Center"
  WidthRequest="48">
  <Border.StrokeShape>
  <RoundRectangle CornerRadius="12" />
  </Border.StrokeShape>
  <mi:MauiIcon
  HorizontalOptions="Center"
  Icon="{mi:Material Icon=Person}"
  IconColor="{DynamicResource IdTileIcon}"
  IconSize="22"
  VerticalOptions="Center" />
  </Border>

  <VerticalStackLayout
  Grid.Column="2"
  Spacing="3"
  VerticalOptions="Center">
  <Label
  FontAttributes="Bold"
  FontSize="15"
  LineBreakMode="TailTruncation"
  Text="{Binding FullName}"
  TextColor="{DynamicResource TextColor}" />
  <Label
  FontSize="12"
  LineBreakMode="TailTruncation"
  Text="{Binding Label}"
  TextColor="{DynamicResource TextTertiaryColor}" />
  <Label
  FontSize="13"
  LineBreakMode="TailTruncation"
  Text="{Binding AddressSummary}"
  TextColor="{DynamicResource TextSecondaryColor}" />
  </VerticalStackLayout>

  <Border
  Grid.Column="3"
  Padding="6"
  BackgroundColor="{DynamicResource Gray-100}"
  HeightRequest="36"
  HorizontalOptions="Center"
  IsVisible="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.IsNotSelectionMode}"
  StrokeThickness="0"
  VerticalOptions="Center"
  WidthRequest="36">
  <Border.StrokeShape>
  <RoundRectangle CornerRadius="10" />
  </Border.StrokeShape>
<mi:MauiIcon
  HorizontalOptions="Center"
  Icon="{mi:Material Icon=MoreVert}"
  IconColor="{DynamicResource TextSecondaryColor}"
  IconSize="18"
  InputTransparent="True"
  VerticalOptions="Center" />
  </Border>
  </Grid>

  <!--  Normal mode: tap = options  -->
  <Button
  x:Name="ItemButton"
  Padding="0"
  BackgroundColor="Transparent"
  BorderWidth="0"
  Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.ShowOptionsCommand}"
  CommandParameter="{Binding .}"
  HorizontalOptions="Fill"
  IsVisible="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.IsNotSelectionMode}"
  Pressed="OnItemButtonPressed"
  Released="OnItemButtonReleased"
  VerticalOptions="Fill" />
  <!--  Selection mode: tap = toggle  -->
  <Button
  Padding="0"
  BackgroundColor="Transparent"
  BorderWidth="0"
  Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.ToggleItemSelectionCommand}"
  CommandParameter="{Binding .}"
  HorizontalOptions="Fill"
  IsVisible="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.IsSelectionMode}"
  VerticalOptions="Fill" />
  </Grid>
           </Border>
  </Grid>
</DataTemplate>
        </CollectionView.ItemTemplate>

   <CollectionView.Footer>
          <BoxView HeightRequest="100" Color="Transparent" />
    </CollectionView.Footer>
    </CollectionView>
  </RefreshView>

      <!--  Shimmer — covers only the list area, NOT the hero  -->
            <sfShimmer:SfShimmer
BackgroundColor="{DynamicResource PageBackgroundColor}"
       IsActive="{Binding Source={x:Reference Page}, Path=BindingContext.IsRefreshing}"
    IsVisible="{Binding Source={x:Reference Page}, Path=BindingContext.IsRefreshing}"
          Type="CirclePersona">
    <sfShimmer:SfShimmer.CustomView>
           <VerticalStackLayout Padding="16,8" Spacing="10">
            <BoxView CornerRadius="16" HeightRequest="72" Color="{DynamicResource Gray-200}" />
 <BoxView CornerRadius="16" HeightRequest="72" Color="{DynamicResource Gray-200}" />
           <BoxView CornerRadius="16" HeightRequest="72" Color="{DynamicResource Gray-200}" />
            <BoxView CornerRadius="16" HeightRequest="72" Color="{DynamicResource Gray-200}" />
            <BoxView CornerRadius="16" HeightRequest="72" Color="{DynamicResource Gray-200}" />
</VerticalStackLayout>
       </sfShimmer:SfShimmer.CustomView>
    </sfShimmer:SfShimmer>

        </Grid>

   <!--  FAB — Add (normal mode)  -->
        <Border
    Grid.RowSpan="3"
        Margin="0,0,20,20"
        Padding="0"
         BackgroundColor="{DynamicResource PrimaryColor}"
 HeightRequest="60"
        HorizontalOptions="End"
    IsVisible="{Binding IsNotSelectionMode}"
StrokeThickness="0"
   VerticalOptions="End"
    WidthRequest="60">
     <Border.StrokeShape>
           <RoundRectangle CornerRadius="30" />
         </Border.StrokeShape>
        <Border.Shadow>
        <Shadow
      Brush="{DynamicResource PrimaryColor}"
    Opacity="0.4"
        Radius="16"
    Offset="0,6" />
        </Border.Shadow>
        <Button
     Padding="0"
                BackgroundColor="Transparent"
    BorderWidth="0"
       Command="{Binding AddCommand}"
    HeightRequest="60"
       WidthRequest="60">
     <Button.ImageSource>
       <FontImageSource
      FontFamily="MaterialIconsRegular"
         Glyph="&#xE145;"
   Size="28"
     Color="White" />
        </Button.ImageSource>
       </Button>
      </Border>

  <!--  FAB — Delete (selection mode)  -->
        <Border
   Grid.RowSpan="3"
   Margin="16,0,16,20"
   Padding="0"
  BackgroundColor="#EF4444"
HeightRequest="56"
   HorizontalOptions="Fill"
  IsVisible="{Binding IsSelectionMode}"
   StrokeThickness="0"
  VerticalOptions="End">
  <Border.StrokeShape>
  <RoundRectangle CornerRadius="16" />
    </Border.StrokeShape>
            <Border.Shadow>
<Shadow Brush="#EF4444" Opacity="0.35" Radius="14" Offset="0,6" />
         </Border.Shadow>
  <Button
    Padding="0"
           BackgroundColor="Transparent"
   BorderWidth="0"
  Command="{Binding DeleteSelectedCommand}"
     FontAttributes="Bold"
  FontSize="16"
    HeightRequest="56"
     HorizontalOptions="Fill"
       IsEnabled="{Binding HasSelection}"
   Text="{Binding SelectedCount, StringFormat='Delete {0} selected'}"
TextColor="White"
 VerticalOptions="Fill" />
        </Border>

    </Grid>
</ContentPage>
