<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Fortress.Views.AuthenticatorsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:converter="clr-namespace:Fortress.Converters"
    xmlns:ctrl="clr-namespace:Fortress.Controls"
    xmlns:ffimage="clr-namespace:FFImageLoading.Maui;assembly=FFImageLoading.Maui"
    xmlns:mi="http://www.aathifmahir.com/dotnet/2022/maui/icons"
    xmlns:models="clr-namespace:Fortress.Mobile.Core.Models;assembly=Fortress.Mobile.Core"
    xmlns:prism="http://prismlibrary.com"
    xmlns:sfProgress="clr-namespace:Syncfusion.Maui.Toolkit.ProgressBar;assembly=Syncfusion.Maui.Toolkit"
    xmlns:sfShimmer="clr-namespace:Syncfusion.Maui.Toolkit.Shimmer;assembly=Syncfusion.Maui.Toolkit"
    Title="Authenticators"
    prism:ViewModelLocator.AutowireViewModel="Automatic"
    BackgroundColor="{DynamicResource PageBackgroundColor}"
    NavigationPage.HasNavigationBar="False">

    <ContentPage.Resources>
        <converter:StringToInitialsConverter x:Key="InitialsConverter" />
        <converter:StringNullOrEmptyToBoolConverter x:Key="NullOrEmptyToBool" />
        <converter:InverseStringNullOrEmptyConverter x:Key="NotNullOrEmptyToBool" />
    </ContentPage.Resources>

    <!--  Row 0 = hero (always visible), Row 1 = selection bar, Row 2 = content + shimmer  -->
    <Grid RowDefinitions="Auto,Auto,*">

        <!--  Hero — never shimmer'd  -->
        <ctrl:VaultPageHero
            Title="Authenticators"
            Grid.Row="0"
            BackCommand="{Binding GoBackCommand}"
            CountText="{Binding AuthenticatorsCountText}"
            GradientEnd="{DynamicResource HeroGradientEnd}"
            GradientStart="{DynamicResource HeroGradientStart}"
            IconGlyph="&#xF06A;"
            SearchCommand="{Binding ApplySearchCommand}"
            SearchText="{Binding SearchText, Mode=TwoWay}"
            Subtitle="VAULT" />

        <!--  ═══ SELECTION MODE BAR ═══  -->
        <Border
            Grid.Row="1"
            Margin="16,8,16,4"
            Padding="14,10"
            BackgroundColor="{DynamicResource CardBackgroundColor}"
            IsVisible="{Binding IsSelectionMode}"
            StrokeThickness="0">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="14" />
            </Border.StrokeShape>
            <Border.Shadow>
                <Shadow
                    Brush="Black"
                    Opacity="0.06"
                    Radius="8"
                    Offset="0,2" />
            </Border.Shadow>
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                <VerticalStackLayout VerticalOptions="Center">
                    <Label
                        FontAttributes="Bold"
                        FontSize="16"
                        Text="{Binding SelectedCountText}"
                        TextColor="{DynamicResource TextColor}" />
                    <Label
                        FontSize="11"
                        Text="Tap items to select"
                        TextColor="{DynamicResource TextSecondaryColor}" />
                </VerticalStackLayout>
                <Button
                    Grid.Column="1"
                    Padding="12,8"
                    BackgroundColor="{DynamicResource PrimaryLightestColor}"
                    Command="{Binding SelectAllCommand}"
                    CornerRadius="10"
                    FontAttributes="Bold"
                    FontSize="12"
                    HeightRequest="36"
                    Text="Select All"
                    TextColor="{DynamicResource PrimaryColor}" />
                <Button
                    Grid.Column="2"
                    Padding="12,8"
                    BackgroundColor="{DynamicResource Gray-100}"
                    Command="{Binding ExitSelectionModeCommand}"
                    CornerRadius="10"
                    FontAttributes="Bold"
                    FontSize="12"
                    HeightRequest="36"
                    Text="Cancel"
                    TextColor="{DynamicResource TextSecondaryColor}" />
            </Grid>
        </Border>

        <!--  Content area  -->
        <Grid Grid.Row="2">

            <RefreshView Command="{Binding RefreshCommand}" IsRefreshing="{Binding IsRefreshing}">
                <CollectionView
                    x:Name="AuthenticatorsCollectionView"
                    ItemSizingStrategy="MeasureFirstItem"
                    ItemsSource="{Binding AuthenticatorsView}"
                    SelectionMode="None">

                    <CollectionView.EmptyView>
                        <VerticalStackLayout
                            Padding="40"
                            HorizontalOptions="Center"
                            Spacing="16"
                            VerticalOptions="Center">
                            <Border
                                Padding="24"
                                BackgroundColor="{DynamicResource PrimaryLightestColor}"
                                HeightRequest="88"
                                HorizontalOptions="Center"
                                StrokeThickness="0"
                                WidthRequest="88">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="44" />
                                </Border.StrokeShape>
                                <mi:MauiIcon
                                    HorizontalOptions="Center"
                                    Icon="{mi:Material Icon=QrCodeScanner}"
                                    IconColor="{DynamicResource PrimaryColor}"
                                    IconSize="40"
                                    VerticalOptions="Center" />
                            </Border>
                            <Label
                                FontAttributes="Bold"
                                FontSize="20"
                                HorizontalOptions="Center"
                                Text="No authenticators yet"
                                TextColor="{DynamicResource TextColor}" />
                            <Label
                                FontSize="14"
                                HorizontalOptions="Center"
                                HorizontalTextAlignment="Center"
                                Text="Tap the + button to scan a QR code and add your first 2FA account."
                                TextColor="{DynamicResource TextSecondaryColor}" />
                        </VerticalStackLayout>
                    </CollectionView.EmptyView>

                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout ItemSpacing="0" Orientation="Vertical" />
                    </CollectionView.ItemsLayout>

                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:Authenticator">
                            <Grid Padding="16,6,16,0">
                                <Border
                                    Padding="0"
                                    BackgroundColor="{DynamicResource CardBackgroundColor}"
                                    StrokeThickness="0">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="16" />
                                    </Border.StrokeShape>
                                    <Border.Shadow>
                                        <Shadow
                                            Brush="Black"
                                            Opacity="0.05"
                                            Radius="8"
                                            Offset="0,3" />
                                    </Border.Shadow>
                                    <Grid>
                                        <Grid
                                            Padding="16,14,16,14"
                                            ColumnDefinitions="Auto,Auto,*,Auto"
                                            ColumnSpacing="14">

                                            <!--  Checkbox (selection mode only)-->
                                            <ctrl:SelectionCheckMark
     Grid.Column="0"
         IsChecked="{Binding IsSelected, Mode=TwoWay}"
     IsVisible="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.IsSelectionMode}"
         VerticalOptions="Center" />

                                            <Grid
                                                Grid.Column="1"
                                                HeightRequest="48"
                                                WidthRequest="48">
                                                <Border
                                                    Padding="0"
                                                    BackgroundColor="{DynamicResource AuthTileBackground}"
                                                    HeightRequest="48"
                                                    StrokeThickness="0"
                                                    WidthRequest="48">
                                                    <Border.StrokeShape>
                                                        <RoundRectangle CornerRadius="12" />
                                                    </Border.StrokeShape>
                                                    <Label
                                                        FontAttributes="Bold"
                                                        FontSize="15"
                                                        HorizontalOptions="Center"
                                                        IsVisible="{Binding IconUri, Converter={StaticResource NullOrEmptyToBool}}"
                                                        Text="{Binding Issuer, Converter={StaticResource InitialsConverter}}"
                                                        TextColor="{DynamicResource AuthTileIcon}"
                                                        VerticalOptions="Center" />
                                                </Border>
                                                <Border
                                                    Padding="8"
                                                    BackgroundColor="{DynamicResource AuthTileBackground}"
                                                    HeightRequest="48"
                                                    IsVisible="{Binding IconUri, Converter={StaticResource NotNullOrEmptyToBool}}"
                                                    StrokeThickness="0"
                                                    WidthRequest="48">
                                                    <Border.StrokeShape>
                                                        <RoundRectangle CornerRadius="12" />
                                                    </Border.StrokeShape>
                                                    <ffimage:CachedImage
                                                        Aspect="AspectFit"
                                                        CacheType="All"
                                                        DownsampleToViewSize="True"
                                                        HeightRequest="32"
                                                        HorizontalOptions="Center"
                                                        Source="{Binding IconUri}"
                                                        VerticalOptions="Center"
                                                        WidthRequest="32" />
                                                </Border>
                                            </Grid>

                                            <VerticalStackLayout
                                                Grid.Column="2"
                                                Spacing="3"
                                                VerticalOptions="Center">
                                                <Label
                                                    FontAttributes="Bold"
                                                    FontSize="15"
                                                    LineBreakMode="TailTruncation"
                                                    Text="{Binding Issuer}"
                                                    TextColor="{DynamicResource TextColor}" />
                                                <Label
                                                    FontSize="12"
                                                    LineBreakMode="TailTruncation"
                                                    Text="{Binding Username}"
                                                    TextColor="{DynamicResource TextSecondaryColor}" />
                                                <Label
                                                    CharacterSpacing="4"
                                                    FontAttributes="Bold"
                                                    FontSize="22"
                                                    Text="{Binding Code}"
                                                    TextColor="{DynamicResource AuthTileIcon}" />
                                            </VerticalStackLayout>

                                            <VerticalStackLayout
                                                Grid.Column="3"
                                                Spacing="6"
                                                VerticalOptions="Center">
                                                <Grid HeightRequest="44" WidthRequest="44">
                                                    <sfProgress:SfCircularProgressBar
                                                        Background="Transparent"
                                                        HorizontalOptions="Fill"
                                                        IndeterminateAnimationDuration="0"
                                                        Maximum="{Binding Duration}"
                                                        Minimum="0"
                                                        Progress="{Binding Progress}"
                                                        ProgressFill="{DynamicResource AuthTileIcon}"
                                                        StartAngle="-90"
                                                        TrackFill="{DynamicResource Gray-200}"
                                                        VerticalOptions="Fill" />
                                                    <Label
                                                        FontAttributes="Bold"
                                                        FontSize="10"
                                                        HorizontalOptions="Center"
                                                        Text="{Binding Progress, StringFormat='{0:F0}'}"
                                                        TextColor="{DynamicResource AuthTileIcon}"
                                                        VerticalOptions="Center" />
                                                </Grid>
                                                <Border
                                                    Padding="6"
                                                    BackgroundColor="{DynamicResource Gray-100}"
                                                    HeightRequest="36"
                                                    HorizontalOptions="Center"
                                                    IsVisible="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.IsNotSelectionMode}"
                                                    StrokeThickness="0"
                                                    WidthRequest="36">
                                                    <Border.StrokeShape>
                                                        <RoundRectangle CornerRadius="10" />
                                                    </Border.StrokeShape>
                                                    <mi:MauiIcon
                                                        HorizontalOptions="Center"
                                                        Icon="{mi:Material Icon=MoreVert}"
                                                        IconColor="{DynamicResource TextSecondaryColor}"
                                                        IconSize="18"
                                                        InputTransparent="True"
                                                        VerticalOptions="Center" />
                                                </Border>
                                            </VerticalStackLayout>
                                        </Grid>

                                        <!--  Normal mode: tap = options  -->
                                        <Button
                                            x:Name="ItemButton"
                                            Padding="0"
                                            BackgroundColor="Transparent"
                                            BorderWidth="0"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.ShowOptionsCommand}"
                                            CommandParameter="{Binding .}"
                                            HorizontalOptions="Fill"
                                            IsVisible="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.IsNotSelectionMode}"
                                            Pressed="OnItemButtonPressed"
                                            Released="OnItemButtonReleased"
                                            VerticalOptions="Fill" />
                                        <!--  Selection mode: tap = toggle selection  -->
                                        <Button
                                            Padding="0"
                                            BackgroundColor="Transparent"
                                            BorderWidth="0"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.ToggleItemSelectionCommand}"
                                            CommandParameter="{Binding .}"
                                            HorizontalOptions="Fill"
                                            IsVisible="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.IsSelectionMode}"
                                            VerticalOptions="Fill" />
                                    </Grid>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>

                    <CollectionView.Footer>
                        <BoxView HeightRequest="100" Color="Transparent" />
                    </CollectionView.Footer>
                </CollectionView>
            </RefreshView>

            <!--  Shimmer — covers only the list area, NOT the hero  -->
            <sfShimmer:SfShimmer
                BackgroundColor="{DynamicResource PageBackgroundColor}"
                IsActive="{Binding IsRefreshing}"
                IsVisible="{Binding IsRefreshing}"
                Type="CirclePersona">
                <sfShimmer:SfShimmer.CustomView>
                    <VerticalStackLayout Padding="16,8" Spacing="10">
                        <BoxView
                            CornerRadius="16"
                            HeightRequest="80"
                            Color="{DynamicResource Gray-200}" />
                        <BoxView
                            CornerRadius="16"
                            HeightRequest="80"
                            Color="{DynamicResource Gray-200}" />
                        <BoxView
                            CornerRadius="16"
                            HeightRequest="80"
                            Color="{DynamicResource Gray-200}" />
                        <BoxView
                            CornerRadius="16"
                            HeightRequest="80"
                            Color="{DynamicResource Gray-200}" />
                        <BoxView
                            CornerRadius="16"
                            HeightRequest="80"
                            Color="{DynamicResource Gray-200}" />
                    </VerticalStackLayout>
                </sfShimmer:SfShimmer.CustomView>
            </sfShimmer:SfShimmer>

        </Grid>

        <!--  FAB — Add button (normal mode) ──────────────────────────────  -->
        <Border
            Grid.RowSpan="3"
            Margin="0,0,20,20"
            Padding="0"
            BackgroundColor="{DynamicResource PrimaryColor}"
            HeightRequest="60"
            HorizontalOptions="End"
            IsVisible="{Binding IsNotSelectionMode}"
            StrokeThickness="0"
            VerticalOptions="End"
            WidthRequest="60">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="30" />
            </Border.StrokeShape>
            <Border.Shadow>
                <Shadow
                    Brush="{DynamicResource PrimaryColor}"
                    Opacity="0.4"
                    Radius="16"
                    Offset="0,6" />
            </Border.Shadow>
            <Button
                Padding="0"
                BackgroundColor="Transparent"
                BorderWidth="0"
                Command="{Binding ScanCommand}"
                HeightRequest="60"
                WidthRequest="60">
                <Button.ImageSource>
                    <FontImageSource
                        FontFamily="MaterialIconsRegular"
                        Glyph="&#xE145;"
                        Size="28"
                        Color="White" />
                </Button.ImageSource>
            </Button>
        </Border>

        <!--  FAB — Delete button (selection mode) ─────────────────────────  -->
        <Border
            Grid.RowSpan="3"
            Margin="16,0,16,20"
            Padding="0"
            BackgroundColor="#EF4444"
            HeightRequest="56"
            HorizontalOptions="Fill"
            IsVisible="{Binding IsSelectionMode}"
            StrokeThickness="0"
            VerticalOptions="End">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="16" />
            </Border.StrokeShape>
            <Border.Shadow>
                <Shadow
                    Brush="#EF4444"
                    Opacity="0.35"
                    Radius="14"
                    Offset="0,6" />
            </Border.Shadow>
            <Button
                Padding="0"
                BackgroundColor="Transparent"
                BorderWidth="0"
                Command="{Binding DeleteSelectedCommand}"
                FontAttributes="Bold"
                FontSize="16"
                HeightRequest="56"
                HorizontalOptions="Fill"
                IsEnabled="{Binding HasSelection}"
                Text="{Binding SelectedCount, StringFormat='Delete {0} selected'}"
                TextColor="White"
                VerticalOptions="Fill" />
        </Border>

    </Grid>
</ContentPage>
