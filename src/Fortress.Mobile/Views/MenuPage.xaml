<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Fortress.Views.MenuPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ctrl="clr-namespace:Fortress.Controls"
    xmlns:mi="http://www.aathifmahir.com/dotnet/2022/maui/icons"
    xmlns:models="clr-namespace:Fortress.Models"
    xmlns:prism="http://prismlibrary.com"
    prism:ViewModelLocator.AutowireViewModel="Automatic"
    BackgroundColor="{DynamicResource PageBackgroundColor}"
    NavigationPage.HasNavigationBar="False">

    <ContentPage.Resources>

        <!--  ── Template selector ────────────────────────────────────────  -->
        <ctrl:SettingItemTemplateSelector x:Key="SettingSelector">

            <!--  SECTION HEADER: label + opens the card  -->
            <ctrl:SettingItemTemplateSelector.SectionHeaderTemplate>
                <DataTemplate x:DataType="models:SettingItem">
                    <VerticalStackLayout IsVisible="{Binding IsVisible}">
                        <Label
                            Margin="20,20,16,6"
                            FontAttributes="Bold"
                            FontSize="13"
                            Text="{Binding SectionTitle}"
                            TextColor="{DynamicResource TextTertiaryColor}" />
                        <Border
                            Margin="16,0"
                            Padding="0,4,0,0"
                            BackgroundColor="{DynamicResource CardBackgroundColor}"
                            StrokeThickness="0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="16,16,0,0" />
                            </Border.StrokeShape>
                            <Border.Shadow>
                                <Shadow
                                    Brush="{DynamicResource GrayShadowColor}"
                                    Opacity="0.06"
                                    Radius="12"
                                    Offset="0,4" />
                            </Border.Shadow>
                            <BoxView HeightRequest="1" Color="Transparent" />
                        </Border>
                    </VerticalStackLayout>
                </DataTemplate>
            </ctrl:SettingItemTemplateSelector.SectionHeaderTemplate>

            <!--  TOGGLE ROW  -->
            <ctrl:SettingItemTemplateSelector.ToggleTemplate>
                <DataTemplate x:DataType="models:SettingItem">
                    <VerticalStackLayout IsVisible="{Binding IsVisible}">
                        <Grid
                            Margin="16,0"
                            Padding="16,12"
                            BackgroundColor="{DynamicResource CardBackgroundColor}"
                            ColumnDefinitions="Auto,*,Auto"
                            ColumnSpacing="14">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding TapCommand}" />
                            </Grid.GestureRecognizers>

                            <Border
                                Grid.Column="0"
                                Padding="8"
                                BackgroundColor="{Binding IconBg}"
                                HeightRequest="40"
                                StrokeThickness="0"
                                VerticalOptions="Center"
                                WidthRequest="40">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="10" />
                                </Border.StrokeShape>
                                <Label
                                    FontFamily="MaterialIconsRegular"
                                    FontSize="20"
                                    HorizontalOptions="Center"
                                    Text="{Binding IconGlyph}"
                                    TextColor="{Binding IconFg}"
                                    VerticalOptions="Center" />
                            </Border>

                            <VerticalStackLayout
                                Grid.Column="1"
                                Spacing="2"
                                VerticalOptions="Center">
                                <Label
                                    FontSize="15"
                                    Text="{Binding Title}"
                                    TextColor="{DynamicResource TextColor}" />
                                <Label
                                    FontSize="12"
                                    IsVisible="{Binding HasSubtitle}"
                                    Text="{Binding EffectiveSubtitle}"
                                    TextColor="{DynamicResource TextSecondaryColor}" />
                            </VerticalStackLayout>

                            <!--  Custom pill toggle  -->
                            <Grid
                                Grid.Column="2"
                                HeightRequest="30"
                                InputTransparent="True"
                                VerticalOptions="Center"
                                WidthRequest="52">
                                <BoxView
                                    CornerRadius="15"
                                    HeightRequest="30"
                                    HorizontalOptions="Fill"
                                    VerticalOptions="Fill"
                                    WidthRequest="52"
                                    Color="#CBD5E1">
                                    <BoxView.Triggers>
                                        <DataTrigger
                                            Binding="{Binding IsToggled}"
                                            TargetType="BoxView"
                                            Value="True">
                                            <Setter Property="Color" Value="{DynamicResource PrimaryColor}" />
                                        </DataTrigger>
                                    </BoxView.Triggers>
                                </BoxView>
                                <Border
                                    Margin="3,0,0,0"
                                    BackgroundColor="White"
                                    HeightRequest="24"
                                    HorizontalOptions="Start"
                                    StrokeThickness="0"
                                    VerticalOptions="Center"
                                    WidthRequest="24">
                                    <Border.StrokeShape>
                                        <Ellipse />
                                    </Border.StrokeShape>
                                    <Border.Shadow>
                                        <Shadow
                                            Brush="Black"
                                            Opacity="0.25"
                                            Radius="4"
                                            Offset="0,1" />
                                    </Border.Shadow>
                                    <Border.Triggers>
                                        <DataTrigger
                                            Binding="{Binding IsToggled}"
                                            TargetType="Border"
                                            Value="True">
                                            <Setter Property="HorizontalOptions" Value="End" />
                                            <Setter Property="Margin" Value="0,0,3,0" />
                                        </DataTrigger>
                                    </Border.Triggers>
                                </Border>
                            </Grid>
                        </Grid>
                        <!--  Separator is CardBackgroundColor so it's invisible when this is the last row  -->
                        <BoxView
                            Margin="72,0,16,0"
                            HeightRequest="1"
                            Color="{DynamicResource SeparatorColor}" />
                    </VerticalStackLayout>
                </DataTemplate>
            </ctrl:SettingItemTemplateSelector.ToggleTemplate>

            <!--  NAV ROW (chevron)  -->
            <ctrl:SettingItemTemplateSelector.NavTemplate>
                <DataTemplate x:DataType="models:SettingItem">
                    <VerticalStackLayout IsVisible="{Binding IsVisible}">
                        <Grid
                            Margin="16,0"
                            Padding="16,12"
                            BackgroundColor="{DynamicResource CardBackgroundColor}"
                            ColumnDefinitions="Auto,*,Auto"
                            ColumnSpacing="14">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding TapCommand}" />
                            </Grid.GestureRecognizers>

                            <Border
                                Grid.Column="0"
                                Padding="8"
                                BackgroundColor="{Binding IconBg}"
                                HeightRequest="40"
                                StrokeThickness="0"
                                VerticalOptions="Center"
                                WidthRequest="40">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="10" />
                                </Border.StrokeShape>
                                <Label
                                    FontFamily="MaterialIconsRegular"
                                    FontSize="20"
                                    HorizontalOptions="Center"
                                    Text="{Binding IconGlyph}"
                                    TextColor="{Binding IconFg}"
                                    VerticalOptions="Center" />
                            </Border>

                            <VerticalStackLayout
                                Grid.Column="1"
                                Spacing="2"
                                VerticalOptions="Center">
                                <Label
                                    FontSize="15"
                                    Text="{Binding Title}"
                                    TextColor="{DynamicResource TextColor}" />
                                <Label
                                    FontSize="12"
                                    IsVisible="{Binding HasSubtitle}"
                                    Text="{Binding EffectiveSubtitle}"
                                    TextColor="{DynamicResource TextSecondaryColor}" />
                            </VerticalStackLayout>

                            <Label
                                Grid.Column="2"
                                FontFamily="MaterialIconsRegular"
                                FontSize="20"
                                HorizontalOptions="End"
                                Text="&#xe5c8;"
                                TextColor="{DynamicResource TextTertiaryColor}"
                                VerticalOptions="Center" />
                        </Grid>
                        <!--  Separator is CardBackgroundColor so it's invisible when this is the last row  -->
                        <BoxView
                            Margin="72,0,16,0"
                            HeightRequest="1"
                            Color="{DynamicResource SeparatorColor}" />
                    </VerticalStackLayout>
                </DataTemplate>
            </ctrl:SettingItemTemplateSelector.NavTemplate>

            <!--  SPACER: closes the card — overlaps the last separator with CardBackgroundColor  -->
            <ctrl:SettingItemTemplateSelector.SpacerTemplate>
                <DataTemplate x:DataType="models:SettingItem">
                    <Grid
                        Margin="16,-1,16,12"
                        BackgroundColor="{DynamicResource CardBackgroundColor}"
                        MinimumHeightRequest="16">
                        <!--  Overlap the 1px separator of the last visible row above  -->
                        <BoxView
                            HeightRequest="2"
                            VerticalOptions="Start"
                            Color="{DynamicResource CardBackgroundColor}" />
                        <!--  Rounded bottom cap  -->
                        <Border
                            BackgroundColor="{DynamicResource CardBackgroundColor}"
                            HeightRequest="16"
                            StrokeThickness="0"
                            VerticalOptions="End">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="0,0,16,16" />
                            </Border.StrokeShape>
                            <Border.Shadow>
                                <Shadow
                                    Brush="{DynamicResource GrayShadowColor}"
                                    Opacity="0.06"
                                    Radius="12"
                                    Offset="0,4" />
                            </Border.Shadow>
                        </Border>
                    </Grid>
                </DataTemplate>
            </ctrl:SettingItemTemplateSelector.SpacerTemplate>

        </ctrl:SettingItemTemplateSelector>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*">

        <!--  Hero  -->
        <ctrl:VaultPageHero
            Title="Settings"
            Grid.Row="0"
            BackCommand="{Binding GoBackCommand}"
            CountText="Manage your vault &amp; preferences"
            GradientEnd="{DynamicResource PrimaryGradient}"
            GradientStart="{DynamicResource PrimaryColor}"
            IconGlyph="&#xE8B8;"
            SearchEnabled="False" />

        <!--  Single virtualised list — all sections + rows  -->
        <CollectionView
            Grid.Row="1"
            ItemTemplate="{StaticResource SettingSelector}"
            ItemsSource="{Binding SettingItems}">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout ItemSpacing="0" Orientation="Vertical" />
            </CollectionView.ItemsLayout>
            <CollectionView.Footer>
                <BoxView HeightRequest="32" Color="Transparent" />
            </CollectionView.Footer>
        </CollectionView>

    </Grid>
</ContentPage>

