<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Fortress.Views.AddEditCredentialPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ctrl="clr-namespace:Fortress.Controls"
    xmlns:mi="http://www.aathifmahir.com/dotnet/2022/maui/icons"
    xmlns:prism="http://prismlibrary.com"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    prism:ViewModelLocator.AutowireViewModel="Automatic"
    BackgroundColor="{DynamicResource PageBackgroundColor}"
    NavigationPage.HasNavigationBar="False">

    <Grid RowDefinitions="Auto,*,Auto">

        <!--  Header  -->
        <Border
            Grid.Row="0"
            Padding="20,16,20,24"
            BackgroundColor="{DynamicResource PrimaryColor}"
            StrokeThickness="0">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="0,0,24,24" />
            </Border.StrokeShape>
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                <!--  Back  -->
                <Border
                    Grid.Column="0"
                    Padding="0"
                    BackgroundColor="#30FFFFFF"
                    HeightRequest="40"
                    StrokeThickness="0"
                    VerticalOptions="Center"
                    WidthRequest="40">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12" />
                    </Border.StrokeShape>
                    <Button
                        Padding="0"
                        BackgroundColor="Transparent"
                        BorderWidth="0"
                        Command="{Binding GoBackCommand}"
                        HeightRequest="40"
                        WidthRequest="40">
                        <Button.ImageSource>
                            <FontImageSource
                                FontFamily="MaterialIconsRegular"
                                Glyph="&#xE5C4;"
                                Size="22"
                                Color="White" />
                        </Button.ImageSource>
                    </Button>
                </Border>
                <!--  Title  -->
                <Label
                    Grid.Column="1"
                    FontAttributes="Bold"
                    FontSize="20"
                    Text="{Binding FormTitle}"
                    TextColor="White"
                    VerticalOptions="Center" />

            </Grid>
        </Border>

        <!--  Form body  -->
        <ScrollView Grid.Row="1" Padding="20,16,20,0">
            <VerticalStackLayout Spacing="14">

                <!--  Type selector  -->
                <!--
                <ScrollView
                    Margin="-4,0"
                    HorizontalScrollBarVisibility="Never"
                    Orientation="Horizontal">
                    <HorizontalStackLayout Padding="4,4" Spacing="8">
                        <ctrl:VaultFilterChip
                            Command="{Binding SetTypeCommand}"
                            CommandParameter="Web"
                            IsActive="{Binding IsTypeWeb}"
                            Label="Website" />
                        <ctrl:VaultFilterChip
                            Command="{Binding SetTypeCommand}"
                            CommandParameter="PhoneApplication"
                            IsActive="{Binding IsTypeMobile}"
                            Label="Mobile App" />
                        <ctrl:VaultFilterChip
                            Command="{Binding SetTypeCommand}"
                            CommandParameter="Application"
                            IsActive="{Binding IsTypeDesktop}"
                            Label="Desktop App" />
                    </HorizontalStackLayout>
                </ScrollView>-->

                <!--  Domain / Name  -->
                <ctrl:VaultFormField
                    x:Name="FieldDomain"
                    ErrorMessage="{Binding DomainError}"
                    FieldLabel="WEBSITE / APP NAME"
                    HasError="{Binding HasDomainError}"
                    IconBackgroundColor="{DynamicResource PrimaryLightestColor}"
                    IconColor="{DynamicResource PrimaryColor}"
                    IconGlyph="&#xE80B;"
                    Placeholder="e.g. google.com"
                    Text="{Binding FormDomain}" />

                <!--  Username  -->
                <ctrl:VaultFormField
                    x:Name="FieldUsername"
                    ErrorMessage="{Binding UsernameError}"
                    FieldLabel="USERNAME / EMAIL"
                    HasError="{Binding HasUsernameError}"
                    IconBackgroundColor="{DynamicResource PrimaryLightestColor}"
                    IconColor="{DynamicResource PrimaryColor}"
                    IconGlyph="&#xE7FF;"
                    Keyboard="Email"
                    Placeholder="e.g. user@email.com"
                    Text="{Binding FormUsername}" />

                <!--  Password  -->
                <VerticalStackLayout Spacing="4">
                    <Border
                        Padding="16,14"
                        BackgroundColor="{DynamicResource CardBackgroundColor}"
                        StrokeThickness="0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="14" />
                        </Border.StrokeShape>
                        <Border.Shadow>
                            <Shadow
                                Brush="Black"
                                Opacity="0.04"
                                Radius="6"
                                Offset="0,2" />
                        </Border.Shadow>
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                            <Border
                                Grid.Column="0"
                                Padding="8"
                                BackgroundColor="{DynamicResource PrimaryLightestColor}"
                                HeightRequest="36"
                                StrokeThickness="0"
                                WidthRequest="36">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="10" />
                                </Border.StrokeShape>
                                <mi:MauiIcon
                                    HorizontalOptions="Center"
                                    Icon="{mi:Material Icon=Lock}"
                                    IconColor="{DynamicResource PrimaryColor}"
                                    IconSize="18"
                                    VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="2">
                                <Label
                                    FontSize="11"
                                    Text="PASSWORD"
                                    TextColor="{DynamicResource TextTertiaryColor}" />
                                <Entry
                                    x:Name="FieldPassword"
                                    FontSize="15"
                                    IsPassword="{Binding IsPasswordHidden}"
                                    Placeholder="Enter password"
                                    PlaceholderColor="{DynamicResource TextTertiaryColor}"
                                    Text="{Binding FormPassword}"
                                    TextColor="{DynamicResource TextColor}" />
                            </VerticalStackLayout>
                            <Border
                                Grid.Column="2"
                                Padding="0"
                                BackgroundColor="{DynamicResource Gray-100}"
                                HeightRequest="36"
                                StrokeThickness="0"
                                VerticalOptions="Center"
                                WidthRequest="36">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="10" />
                                </Border.StrokeShape>
                                <Grid>
                                    <mi:MauiIcon
                                        HorizontalOptions="Center"
                                        Icon="{mi:Material Icon=VisibilityOff}"
                                        IconColor="{DynamicResource TextTertiaryColor}"
                                        IconSize="18"
                                        InputTransparent="True"
                                        VerticalOptions="Center">
                                        <mi:MauiIcon.Triggers>
                                            <DataTrigger
                                                Binding="{Binding IsPasswordHidden}"
                                                TargetType="mi:MauiIcon"
                                                Value="False">
                                                <Setter Property="Icon" Value="{mi:Material Icon=Visibility}" />
                                            </DataTrigger>
                                        </mi:MauiIcon.Triggers>
                                    </mi:MauiIcon>
                                    <Button
                                        Padding="0"
                                        BackgroundColor="Transparent"
                                        BorderWidth="0"
                                        Command="{Binding TogglePasswordVisibilityCommand}"
                                        HorizontalOptions="Fill"
                                        VerticalOptions="Fill" />
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>
                    <Label
                        Margin="4,0,0,0"
                        FontSize="12"
                        IsVisible="{Binding HasPasswordError}"
                        Text="{Binding PasswordError}"
                        TextColor="#EF4444" />
                </VerticalStackLayout>

                <!--  2FA / OTP Section  -->
                <Border
                    Padding="16,14"
                    BackgroundColor="{DynamicResource CardBackgroundColor}"
                    StrokeThickness="0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="14" />
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow
                            Brush="Black"
                            Opacity="0.04"
                            Radius="6"
                            Offset="0,2" />
                    </Border.Shadow>
                    <VerticalStackLayout Spacing="12">
                        <ctrl:VaultToggleRow
                            Title="Two-Factor Authentication"
                            IconBackgroundColor="#EEF2FF"
                            IconColor="#6366F1"
                            IconGlyph="&#xE98B;"
                            IsToggled="{Binding FormHasOtp}"
                            ShowSeparator="False"
                            Subtitle="Link a TOTP 2FA code to this password" />
                        <VerticalStackLayout IsVisible="{Binding FormHasOtp}" Spacing="10">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                <Border
                                    Padding="14,12"
                                    BackgroundColor="{DynamicResource Gray-100}"
                                    StrokeThickness="0">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="12" />
                                    </Border.StrokeShape>
                                    <VerticalStackLayout Spacing="2">
                                        <Label
                                            FontSize="11"
                                            Text="SECRET KEY"
                                            TextColor="{DynamicResource TextTertiaryColor}" />
                                        <Entry
                                            x:Name="FieldOtpSecret"
                                            FontAttributes="Bold"
                                            FontSize="14"
                                            Placeholder="Paste or type secret key"
                                            PlaceholderColor="{DynamicResource TextTertiaryColor}"
                                            Text="{Binding FormOtpSecret}"
                                            TextColor="{DynamicResource TextColor}" />
                                    </VerticalStackLayout>
                                </Border>
                                <Border
                                    Grid.Column="1"
                                    Padding="0"
                                    BackgroundColor="{DynamicResource PrimaryColor}"
                                    HeightRequest="52"
                                    StrokeThickness="0"
                                    WidthRequest="52">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="14" />
                                    </Border.StrokeShape>
                                    <Grid>
                                        <mi:MauiIcon
                                            HorizontalOptions="Center"
                                            Icon="{mi:Material Icon=QrCodeScanner}"
                                            IconColor="White"
                                            IconSize="22"
                                            InputTransparent="True"
                                            VerticalOptions="Center" />
                                        <Button
                                            Padding="0"
                                            BackgroundColor="Transparent"
                                            BorderWidth="0"
                                            Command="{Binding ScanOtpCommand}"
                                            HorizontalOptions="Fill"
                                            VerticalOptions="Fill" />
                                    </Grid>
                                </Border>
                            </Grid>
                            <Label
                                FontSize="12"
                                Text="Tap the QR button to scan a code or enter manually"
                                TextColor="{DynamicResource TextSecondaryColor}" />
                            <Label
                                Margin="4,0,0,0"
                                FontSize="12"
                                IsVisible="{Binding HasOtpSecretError}"
                                Text="{Binding OtpSecretError}"
                                TextColor="#EF4444" />
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!--  Require Auth to Autofill  -->
                <Border
                    Padding="16,14"
                    BackgroundColor="{DynamicResource CardBackgroundColor}"
                    StrokeThickness="0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="14" />
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow
                            Brush="Black"
                            Opacity="0.04"
                            Radius="6"
                            Offset="0,2" />
                    </Border.Shadow>
                    <VerticalStackLayout Spacing="8">
                        <ctrl:VaultToggleRow
                            Title="Require Authentication to Autofill"
                            IconBackgroundColor="#FEF2F2"
                            IconColor="#EF4444"
                            IconGlyph="&#xE897;"
                            IsToggled="{Binding FormRequireAuth}"
                            ShowSeparator="False"
                            Subtitle="Require biometric or PIN before this password can be filled" />
                        <!--  Warning shown when no auth method is set up  -->
                        <Border
                            Padding="12,8"
                            BackgroundColor="{DynamicResource WarningLightColor}"
                            IsVisible="{Binding NoAuthMethodConfigured}"
                            StrokeThickness="0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="10" />
                            </Border.StrokeShape>
                            <HorizontalStackLayout Spacing="8">
                                <mi:MauiIcon
                                    Icon="{mi:Material Icon=Warning}"
                                    IconColor="{DynamicResource AccentOrange}"
                                    IconSize="16"
                                    VerticalOptions="Center" />
                                <Label
                                    FontSize="12"
                                    HorizontalOptions="Fill"
                                    LineBreakMode="WordWrap"
                                    Text="No PIN or biometric lock is set up. Go to Settings → Security to configure one."
                                    TextColor="{DynamicResource TextColor}"
                                    VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </Border>
                    </VerticalStackLayout>
                </Border>

                <BoxView HeightRequest="24" Color="Transparent" />
            </VerticalStackLayout>
        </ScrollView>

        <!--  Save footer  -->
        <Grid
            Grid.Row="2"
            Padding="20,12,20,28"
            BackgroundColor="{DynamicResource CardBackgroundColor}">
            <Grid.Shadow>
                <Shadow
                    Brush="Black"
                    Opacity="0.06"
                    Radius="12"
                    Offset="0,-4" />
            </Grid.Shadow>
            <ctrl:VaultGradientButton
                Command="{Binding SaveCommand}"
                HeightRequest="52"
                IsEnabled="{Binding CanSave}"
                IsLoading="{Binding IsSaving}"
                Text="Save Password" />
        </Grid>
    </Grid>
</ContentPage>
