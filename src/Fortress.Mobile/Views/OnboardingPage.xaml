<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Fortress.Views.OnboardingPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:mi="http://www.aathifmahir.com/dotnet/2022/maui/icons"
    xmlns:prism="http://prismlibrary.com"
    xmlns:skia="clr-namespace:SkiaSharp.Extended.UI.Controls;assembly=SkiaSharp.Extended.UI"
    x:Name="MainPage"
    prism:ViewModelLocator.AutowireViewModel="Automatic"
    BackgroundColor="{DynamicResource PageBackgroundColor}"
    NavigationPage.HasNavigationBar="False">

    <Grid RowDefinitions="*,Auto">

        <!--  Swipeable Pages  -->
        <ScrollView
            x:Name="OnboardingScroll"
            Grid.Row="0"
            HorizontalScrollBarVisibility="Never"
            Orientation="Horizontal"
            Scrolled="OnScrolled"
            VerticalScrollBarVisibility="Never">
            <HorizontalStackLayout Spacing="0">

                <!--  PAGE 1: Welcome  -->
                <Grid Padding="32,60,32,24" WidthRequest="{Binding Source={x:Reference MainPage}, Path=Width}">
                    <VerticalStackLayout Spacing="28" VerticalOptions="Center">

                        <!--  Logo + Lottie circle  -->
                        <Border
                            Padding="22"
                            BackgroundColor="{DynamicResource PrimaryColor}"
                            HeightRequest="220"
                            HorizontalOptions="Center"
                            StrokeThickness="0"
                            WidthRequest="220">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="110" />
                            </Border.StrokeShape>
                            <Border.Shadow>
                                <Shadow
                                    Brush="{DynamicResource PrimaryColor}"
                                    Opacity="0.35"
                                    Radius="32"
                                    Offset="0,12" />
                            </Border.Shadow>
                            <Image
                                Aspect="AspectFit"
                                HeightRequest="150"
                                HorizontalOptions="Center"
                                Source="logowhite.png"
                                VerticalOptions="Center"
                                WidthRequest="150" />
                        </Border>

                        <!--  App name under circle  -->
                        <Label
                            CharacterSpacing="3"
                            FontAttributes="Bold"
                            FontFamily="Audiowide"
                            FontSize="22"
                            HorizontalOptions="Center"
                            Text="FORTRESS"
                            TextColor="{DynamicResource TextColor}" />

                        <!--  Text block  -->
                        <VerticalStackLayout HorizontalOptions="Center" Spacing="10">
                            <Label
                                CharacterSpacing="3"
                                FontAttributes="Bold"
                                FontFamily="MichromaRegular"
                                FontSize="11"
                                HorizontalTextAlignment="Center"
                                Text="WELCOME"
                                TextColor="{DynamicResource PrimaryColor}" />
                            <Label
                                FontAttributes="Bold"
                                FontSize="30"
                                HorizontalTextAlignment="Center"
                                Text="Meet Fortress"
                                TextColor="{DynamicResource TextColor}" />
                            <Label
                                FontSize="16"
                                HorizontalTextAlignment="Center"
                                LineBreakMode="WordWrap"
                                LineHeight="1.45"
                                Opacity="0.80"
                                Text="Your personal security vault. Passwords, cards, identities and 2FA codes, all encrypted and yours alone."
                                TextColor="{DynamicResource TextSecondaryColor}" />
                        </VerticalStackLayout>

                        <!--  3 feature pills  -->
                        <FlexLayout
                            HorizontalOptions="Center"
                            JustifyContent="Center"
                            Wrap="Wrap">
                            <Border
                                Margin="4"
                                Padding="12,6"
                                BackgroundColor="{DynamicResource PrimaryLightestColor}"
                                StrokeThickness="0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12" />
                                </Border.StrokeShape>
                                <HorizontalStackLayout Spacing="5">
                                    <mi:MauiIcon
                                        Icon="{mi:Material Icon=Lock}"
                                        IconColor="{DynamicResource PrimaryColor}"
                                        IconSize="14"
                                        VerticalOptions="Center" />
                                    <Label
                                        FontSize="12"
                                        Text="AES-256 Encrypted"
                                        TextColor="{DynamicResource PrimaryColor}"
                                        VerticalOptions="Center" />
                                </HorizontalStackLayout>
                            </Border>
                            <Border
                                Margin="4"
                                Padding="12,6"
                                BackgroundColor="#DCFCE7"
                                StrokeThickness="0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12" />
                                </Border.StrokeShape>
                                <HorizontalStackLayout Spacing="5">
                                    <mi:MauiIcon
                                        Icon="{mi:Material Icon=PhoneAndroid}"
                                        IconColor="#16A34A"
                                        IconSize="14"
                                        VerticalOptions="Center" />
                                    <Label
                                        FontSize="12"
                                        Text="100% Offline-First"
                                        TextColor="#16A34A"
                                        VerticalOptions="Center" />
                                </HorizontalStackLayout>
                            </Border>
                            <Border
                                Margin="4"
                                Padding="12,6"
                                BackgroundColor="#FEF3C7"
                                StrokeThickness="0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12" />
                                </Border.StrokeShape>
                                <HorizontalStackLayout Spacing="5">
                                    <mi:MauiIcon
                                        Icon="{mi:Material Icon=VisibilityOff}"
                                        IconColor="#D97706"
                                        IconSize="14"
                                        VerticalOptions="Center" />
                                    <Label
                                        FontSize="12"
                                        Text="Zero-Knowledge"
                                        TextColor="#D97706"
                                        VerticalOptions="Center" />
                                </HorizontalStackLayout>
                            </Border>
                        </FlexLayout>

                    </VerticalStackLayout>
                </Grid>


                <Grid Padding="32,60,32,24" WidthRequest="{Binding Source={x:Reference MainPage}, Path=Width}">
                    <VerticalStackLayout Spacing="28" VerticalOptions="Center">

                        <Border
                            Padding="22"
                            BackgroundColor="{DynamicResource PrimaryLightestColor}"
                            HeightRequest="220"
                            HorizontalOptions="Center"
                            StrokeThickness="0"
                            WidthRequest="220">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="110" />
                            </Border.StrokeShape>
                            <Border.Shadow>
                                <Shadow
                                    Brush="{DynamicResource PrimaryColor}"
                                    Opacity="0.18"
                                    Radius="32"
                                    Offset="0,12" />
                            </Border.Shadow>
                            <skia:SKLottieView
                                HeightRequest="174"
                                RepeatCount="-1"
                                Source="PasswordVault.json"
                                WidthRequest="174" />
                        </Border>

                        <VerticalStackLayout HorizontalOptions="Center" Spacing="10">
                            <Label
                                CharacterSpacing="2"
                                FontAttributes="Bold"
                                FontSize="11"
                                HorizontalTextAlignment="Center"
                                Text="VAULT"
                                TextColor="{DynamicResource PrimaryColor}" />
                            <Label
                                FontAttributes="Bold"
                                FontSize="30"
                                HorizontalTextAlignment="Center"
                                Text="Password Vault"
                                TextColor="{DynamicResource TextColor}" />
                            <Label
                                FontSize="16"
                                HorizontalTextAlignment="Center"
                                LineBreakMode="WordWrap"
                                LineHeight="1.45"
                                Opacity="0.80"
                                Text="Store unlimited logins for websites, apps, desktop software and more. Organised, searchable, and always at hand."
                                TextColor="{DynamicResource TextSecondaryColor}" />
                        </VerticalStackLayout>

                        <!--  Credential type chips  -->
                        <FlexLayout
                            HorizontalOptions="Center"
                            JustifyContent="Center"
                            Wrap="Wrap">
                            <Border
                                Margin="4"
                                Padding="12,6"
                                BackgroundColor="{DynamicResource PrimaryLightestColor}"
                                StrokeThickness="0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12" />
                                </Border.StrokeShape>
                                <HorizontalStackLayout Spacing="5">
                                    <mi:MauiIcon
                                        Icon="{mi:Material Icon=Language}"
                                        IconColor="{DynamicResource PrimaryColor}"
                                        IconSize="14"
                                        VerticalOptions="Center" />
                                    <Label
                                        FontSize="12"
                                        Text="Websites"
                                        TextColor="{DynamicResource PrimaryColor}"
                                        VerticalOptions="Center" />
                                </HorizontalStackLayout>
                            </Border>
                            <Border
                                Margin="4"
                                Padding="12,6"
                                BackgroundColor="#CFFAFE"
                                StrokeThickness="0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12" />
                                </Border.StrokeShape>
                                <HorizontalStackLayout Spacing="5">
                                    <mi:MauiIcon
                                        Icon="{mi:Material Icon=PhoneAndroid}"
                                        IconColor="#0E7490"
                                        IconSize="14"
                                        VerticalOptions="Center" />
                                    <Label
                                        FontSize="12"
                                        Text="Phone Apps"
                                        TextColor="#0E7490"
                                        VerticalOptions="Center" />
                                </HorizontalStackLayout>
                            </Border>
                            <Border
                                Margin="4"
                                Padding="12,6"
                                BackgroundColor="#EDE9FE"
                                StrokeThickness="0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12" />
                                </Border.StrokeShape>
                                <HorizontalStackLayout Spacing="5">
                                    <mi:MauiIcon
                                        Icon="{mi:Material Icon=Computer}"
                                        IconColor="#6D28D9"
                                        IconSize="14"
                                        VerticalOptions="Center" />
                                    <Label
                                        FontSize="12"
                                        Text="Desktop Apps"
                                        TextColor="#6D28D9"
                                        VerticalOptions="Center" />
                                </HorizontalStackLayout>
                            </Border>
                            <Border
                                Margin="4"
                                Padding="12,6"
                                BackgroundColor="#FEF3C7"
                                StrokeThickness="0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12" />
                                </Border.StrokeShape>
                                <HorizontalStackLayout Spacing="5">
                                    <mi:MauiIcon
                                        Icon="{mi:Material Icon=CreditCard}"
                                        IconColor="#B45309"
                                        IconSize="14"
                                        VerticalOptions="Center" />
                                    <Label
                                        FontSize="12"
                                        Text="Credit Cards"
                                        TextColor="#B45309"
                                        VerticalOptions="Center" />
                                </HorizontalStackLayout>
                            </Border>
                        </FlexLayout>

                    </VerticalStackLayout>
                </Grid>

                <!--  PAGE 3: 2FA TOTP  -->
                <Grid Padding="32,60,32,24" WidthRequest="{Binding Source={x:Reference MainPage}, Path=Width}">
                    <VerticalStackLayout Spacing="28" VerticalOptions="Center">

                        <Border
                            Padding="22"
                            BackgroundColor="#DCFCE7"
                            HeightRequest="220"
                            HorizontalOptions="Center"
                            StrokeThickness="0"
                            WidthRequest="220">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="110" />
                            </Border.StrokeShape>
                            <Border.Shadow>
                                <Shadow
                                    Brush="#16A34A"
                                    Opacity="0.18"
                                    Radius="32"
                                    Offset="0,12" />
                            </Border.Shadow>
                            <skia:SKLottieView
                                HeightRequest="174"
                                RepeatCount="-1"
                                Source="Totp.json"
                                WidthRequest="174" />
                        </Border>

                        <VerticalStackLayout HorizontalOptions="Center" Spacing="10">
                            <Label
                                CharacterSpacing="2"
                                FontAttributes="Bold"
                                FontSize="11"
                                HorizontalTextAlignment="Center"
                                Text="2FA AUTHENTICATOR"
                                TextColor="#16A34A" />
                            <Label
                                FontAttributes="Bold"
                                FontSize="30"
                                HorizontalTextAlignment="Center"
                                Text="Built-in 2FA Codes"
                                TextColor="{DynamicResource TextColor}" />
                            <Label
                                FontSize="16"
                                HorizontalTextAlignment="Center"
                                LineBreakMode="WordWrap"
                                LineHeight="1.45"
                                Opacity="0.80"
                                Text="Generate TOTP codes with a live countdown ring. Scan a QR code once - Fortress handles the rest alongside your passwords."
                                TextColor="{DynamicResource TextSecondaryColor}" />
                        </VerticalStackLayout>

                        <VerticalStackLayout HorizontalOptions="Center" Spacing="8">
                            <HorizontalStackLayout HorizontalOptions="Center" Spacing="8">
                                <mi:MauiIcon
                                    Icon="{mi:Material Icon=CheckCircle}"
                                    IconColor="#16A34A"
                                    IconSize="18"
                                    VerticalOptions="Center" />
                                <Label
                                    FontSize="14"
                                    Text="30-second rotating codes"
                                    TextColor="{DynamicResource TextSecondaryColor}"
                                    VerticalOptions="Center" />
                            </HorizontalStackLayout>
                            <HorizontalStackLayout HorizontalOptions="Center" Spacing="8">
                                <mi:MauiIcon
                                    Icon="{mi:Material Icon=CheckCircle}"
                                    IconColor="#16A34A"
                                    IconSize="18"
                                    VerticalOptions="Center" />
                                <Label
                                    FontSize="14"
                                    Text="QR code or manual entry"
                                    TextColor="{DynamicResource TextSecondaryColor}"
                                    VerticalOptions="Center" />
                            </HorizontalStackLayout>
                            <HorizontalStackLayout HorizontalOptions="Center" Spacing="8">
                                <mi:MauiIcon
                                    Icon="{mi:Material Icon=CheckCircle}"
                                    IconColor="#16A34A"
                                    IconSize="18"
                                    VerticalOptions="Center" />
                                <Label
                                    FontSize="14"
                                    Text="Works offline, no internet needed"
                                    TextColor="{DynamicResource TextSecondaryColor}"
                                    VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </VerticalStackLayout>

                    </VerticalStackLayout>
                </Grid>


                <Grid Padding="32,60,32,24" WidthRequest="{Binding Source={x:Reference MainPage}, Path=Width}">
                    <VerticalStackLayout Spacing="28" VerticalOptions="Center">

                        <Border
                            Padding="22"
                            BackgroundColor="#FEF3C7"
                            HeightRequest="220"
                            HorizontalOptions="Center"
                            StrokeThickness="0"
                            WidthRequest="220">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="110" />
                            </Border.StrokeShape>
                            <Border.Shadow>
                                <Shadow
                                    Brush="#F59E0B"
                                    Opacity="0.18"
                                    Radius="32"
                                    Offset="0,12" />
                            </Border.Shadow>
                            <skia:SKLottieView
                                HeightRequest="174"
                                RepeatCount="-1"
                                Source="Autofill.json"
                                WidthRequest="174" />
                        </Border>

                        <VerticalStackLayout HorizontalOptions="Center" Spacing="10">
                            <Label
                                CharacterSpacing="2"
                                FontAttributes="Bold"
                                FontSize="11"
                                HorizontalTextAlignment="Center"
                                Text="SMART AUTOFILL"
                                TextColor="#D97706" />
                            <Label
                                FontAttributes="Bold"
                                FontSize="30"
                                HorizontalTextAlignment="Center"
                                Text="Fill in One Tap"
                                TextColor="{DynamicResource TextColor}" />
                            <Label
                                FontSize="16"
                                HorizontalTextAlignment="Center"
                                LineBreakMode="WordWrap"
                                LineHeight="1.45"
                                Opacity="0.80"
                                Text="Fortress detects the app or website you're using and suggests the right credentials. Tap once - username, password and OTP are filled instantly."
                                TextColor="{DynamicResource TextSecondaryColor}" />
                        </VerticalStackLayout>

                        <FlexLayout
                            HorizontalOptions="Center"
                            JustifyContent="Center"
                            Wrap="Wrap">
                            <Border
                                Margin="4"
                                Padding="12,6"
                                BackgroundColor="#FEF3C7"
                                StrokeThickness="0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12" />
                                </Border.StrokeShape>
                                <HorizontalStackLayout Spacing="5">
                                    <mi:MauiIcon
                                        Icon="{mi:Material Icon=Android}"
                                        IconColor="#D97706"
                                        IconSize="14"
                                        VerticalOptions="Center" />
                                    <Label
                                        FontSize="12"
                                        Text="Android Autofill"
                                        TextColor="#D97706"
                                        VerticalOptions="Center" />
                                </HorizontalStackLayout>
                            </Border>
                            <Border
                                Margin="4"
                                Padding="12,6"
                                BackgroundColor="{DynamicResource PrimaryLightestColor}"
                                StrokeThickness="0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12" />
                                </Border.StrokeShape>
                                <HorizontalStackLayout Spacing="5">
                                    <mi:MauiIcon
                                        Icon="{mi:Material Icon=Apple}"
                                        IconColor="{DynamicResource PrimaryColor}"
                                        IconSize="14"
                                        VerticalOptions="Center" />
                                    <Label
                                        FontSize="12"
                                        Text="iOS Password AutoFill"
                                        TextColor="{DynamicResource PrimaryColor}"
                                        VerticalOptions="Center" />
                                </HorizontalStackLayout>
                            </Border>
                            <Border
                                Margin="4"
                                Padding="12,6"
                                BackgroundColor="#DCFCE7"
                                StrokeThickness="0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12" />
                                </Border.StrokeShape>
                                <HorizontalStackLayout Spacing="5">
                                    <mi:MauiIcon
                                        Icon="{mi:Material Icon=QrCodeScanner}"
                                        IconColor="#16A34A"
                                        IconSize="14"
                                        VerticalOptions="Center" />
                                    <Label
                                        FontSize="12"
                                        Text="OTP Auto-Copy"
                                        TextColor="#16A34A"
                                        VerticalOptions="Center" />
                                </HorizontalStackLayout>
                            </Border>
                        </FlexLayout>

                    </VerticalStackLayout>
                </Grid>


                <Grid Padding="32,60,32,24" WidthRequest="{Binding Source={x:Reference MainPage}, Path=Width}">
                    <VerticalStackLayout Spacing="28" VerticalOptions="Center">

                        <Border
                            Padding="22"
                            BackgroundColor="#CCFBF1"
                            HeightRequest="220"
                            HorizontalOptions="Center"
                            StrokeThickness="0"
                            WidthRequest="220">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="110" />
                            </Border.StrokeShape>
                            <Border.Shadow>
                                <Shadow
                                    Brush="#14B8A6"
                                    Opacity="0.18"
                                    Radius="32"
                                    Offset="0,12" />
                            </Border.Shadow>
                            <skia:SKLottieView
                                HeightRequest="174"
                                RepeatCount="-1"
                                Source="Health.json"
                                WidthRequest="174" />
                        </Border>

                        <VerticalStackLayout HorizontalOptions="Center" Spacing="10">
                            <Label
                                CharacterSpacing="2"
                                FontAttributes="Bold"
                                FontSize="11"
                                HorizontalTextAlignment="Center"
                                Text="AI-POWERED"
                                TextColor="#0F766E" />
                            <Label
                                FontAttributes="Bold"
                                FontSize="30"
                                HorizontalTextAlignment="Center"
                                Text="Vault Health Score"
                                TextColor="{DynamicResource TextColor}" />
                            <Label
                                FontSize="16"
                                HorizontalTextAlignment="Center"
                                LineBreakMode="WordWrap"
                                LineHeight="1.45"
                                Opacity="0.80"
                                Text="Fortress analyses every password in your vault, detects weak, reused or compromised ones, and gives you a real-time security score."
                                TextColor="{DynamicResource TextSecondaryColor}" />
                        </VerticalStackLayout>

                        <VerticalStackLayout HorizontalOptions="Center" Spacing="8">
                            <HorizontalStackLayout HorizontalOptions="Center" Spacing="8">
                                <mi:MauiIcon
                                    Icon="{mi:Material Icon=Warning}"
                                    IconColor="#F59E0B"
                                    IconSize="18"
                                    VerticalOptions="Center" />
                                <Label
                                    FontSize="14"
                                    Text="Detects weak passwords"
                                    TextColor="{DynamicResource TextSecondaryColor}"
                                    VerticalOptions="Center" />
                            </HorizontalStackLayout>
                            <HorizontalStackLayout HorizontalOptions="Center" Spacing="8">
                                <mi:MauiIcon
                                    Icon="{mi:Material Icon=ContentCopy}"
                                    IconColor="#EF4444"
                                    IconSize="18"
                                    VerticalOptions="Center" />
                                <Label
                                    FontSize="14"
                                    Text="Finds reused passwords"
                                    TextColor="{DynamicResource TextSecondaryColor}"
                                    VerticalOptions="Center" />
                            </HorizontalStackLayout>
                            <HorizontalStackLayout HorizontalOptions="Center" Spacing="8">
                                <mi:MauiIcon
                                    Icon="{mi:Material Icon=HealthAndSafety}"
                                    IconColor="#14B8A6"
                                    IconSize="18"
                                    VerticalOptions="Center" />
                                <Label
                                    FontSize="14"
                                    Text="Live 0-100 health score"
                                    TextColor="{DynamicResource TextSecondaryColor}"
                                    VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </VerticalStackLayout>

                    </VerticalStackLayout>
                </Grid>


                <Grid Padding="32,60,32,24" WidthRequest="{Binding Source={x:Reference MainPage}, Path=Width}">
                    <VerticalStackLayout Spacing="28" VerticalOptions="Center">

                        <Border
                            Padding="22"
                            BackgroundColor="#EDE9FE"
                            HeightRequest="220"
                            HorizontalOptions="Center"
                            StrokeThickness="0"
                            WidthRequest="220">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="110" />
                            </Border.StrokeShape>
                            <Border.Shadow>
                                <Shadow
                                    Brush="#8B5CF6"
                                    Opacity="0.18"
                                    Radius="32"
                                    Offset="0,12" />
                            </Border.Shadow>
                            <skia:SKLottieView
                                HeightRequest="174"
                                RepeatCount="-1"
                                Source="Voice.json"
                                WidthRequest="174" />
                        </Border>

                        <VerticalStackLayout HorizontalOptions="Center" Spacing="10">
                            <Label
                                CharacterSpacing="2"
                                FontAttributes="Bold"
                                FontSize="11"
                                HorizontalTextAlignment="Center"
                                Text="VOICE ASSISTANT"
                                TextColor="#7C3AED" />
                            <Label
                                FontAttributes="Bold"
                                FontSize="30"
                                HorizontalTextAlignment="Center"
                                Text="Voice Commands"
                                TextColor="{DynamicResource TextColor}" />
                            <Label
                                FontSize="16"
                                HorizontalTextAlignment="Center"
                                LineBreakMode="WordWrap"
                                LineHeight="1.45"
                                Opacity="0.80"
                                Text="Use the microphone button on the home screen to control Fortress with your voice. Add passwords, navigate or trigger a sync - hands free."
                                TextColor="{DynamicResource TextSecondaryColor}" />
                        </VerticalStackLayout>

                        <FlexLayout
                            HorizontalOptions="Center"
                            JustifyContent="Center"
                            Wrap="Wrap">
                            <Border
                                Margin="4"
                                Padding="12,6"
                                BackgroundColor="#EDE9FE"
                                StrokeThickness="0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12" />
                                </Border.StrokeShape>
                                <Label
                                    FontSize="12"
                                    Text="&quot;Add a password&quot;"
                                    TextColor="#7C3AED" />
                            </Border>
                            <Border
                                Margin="4"
                                Padding="12,6"
                                BackgroundColor="#FEF3C7"
                                StrokeThickness="0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12" />
                                </Border.StrokeShape>
                                <Label
                                    FontSize="12"
                                    Text="&quot;Show health score&quot;"
                                    TextColor="#B45309" />
                            </Border>
                            <Border
                                Margin="4"
                                Padding="12,6"
                                BackgroundColor="#DCFCE7"
                                StrokeThickness="0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12" />
                                </Border.StrokeShape>
                                <Label
                                    FontSize="12"
                                    Text="&quot;Sync my vault&quot;"
                                    TextColor="#15803D" />
                            </Border>
                            <Border
                                Margin="4"
                                Padding="12,6"
                                BackgroundColor="#CFFAFE"
                                StrokeThickness="0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12" />
                                </Border.StrokeShape>
                                <Label
                                    FontSize="12"
                                    Text="&quot;Add 2FA authenticator&quot;"
                                    TextColor="#0E7490" />
                            </Border>
                        </FlexLayout>

                    </VerticalStackLayout>
                </Grid>


                <Grid Padding="32,60,32,24" WidthRequest="{Binding Source={x:Reference MainPage}, Path=Width}">
                    <VerticalStackLayout Spacing="28" VerticalOptions="Center">

                        <Border
                            Padding="22"
                            BackgroundColor="#FCE7F3"
                            HeightRequest="220"
                            HorizontalOptions="Center"
                            StrokeThickness="0"
                            WidthRequest="220">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="110" />
                            </Border.StrokeShape>
                            <Border.Shadow>
                                <Shadow
                                    Brush="#EC4899"
                                    Opacity="0.18"
                                    Radius="32"
                                    Offset="0,12" />
                            </Border.Shadow>
                            <skia:SKLottieView
                                HeightRequest="174"
                                RepeatCount="-1"
                                Source="AuthenticationLock.json"
                                WidthRequest="174" />
                        </Border>

                        <VerticalStackLayout HorizontalOptions="Center" Spacing="10">
                            <Label
                                CharacterSpacing="2"
                                FontAttributes="Bold"
                                FontSize="11"
                                HorizontalTextAlignment="Center"
                                Text="APP SECURITY"
                                TextColor="#BE185D" />
                            <Label
                                FontAttributes="Bold"
                                FontSize="30"
                                HorizontalTextAlignment="Center"
                                Text="PIN &amp; Biometric Lock"
                                TextColor="{DynamicResource TextColor}" />
                            <Label
                                FontSize="16"
                                HorizontalTextAlignment="Center"
                                LineBreakMode="WordWrap"
                                LineHeight="1.45"
                                Opacity="0.80"
                                Text="Protect your vault with a 4-digit PIN or your fingerprint and Face ID. Quick to unlock, impossible to bypass without your credentials."
                                TextColor="{DynamicResource TextSecondaryColor}" />
                        </VerticalStackLayout>

                        <VerticalStackLayout HorizontalOptions="Center" Spacing="8">
                            <HorizontalStackLayout HorizontalOptions="Center" Spacing="8">
                                <mi:MauiIcon
                                    Icon="{mi:Material Icon=Fingerprint}"
                                    IconColor="#BE185D"
                                    IconSize="18"
                                    VerticalOptions="Center" />
                                <Label
                                    FontSize="14"
                                    Text="Face ID &amp; fingerprint unlock"
                                    TextColor="{DynamicResource TextSecondaryColor}"
                                    VerticalOptions="Center" />
                            </HorizontalStackLayout>
                            <HorizontalStackLayout HorizontalOptions="Center" Spacing="8">
                                <mi:MauiIcon
                                    Icon="{mi:Material Icon=Pin}"
                                    IconColor="#BE185D"
                                    IconSize="18"
                                    VerticalOptions="Center" />
                                <Label
                                    FontSize="14"
                                    Text="4-digit PIN fallback"
                                    TextColor="{DynamicResource TextSecondaryColor}"
                                    VerticalOptions="Center" />
                            </HorizontalStackLayout>
                            <HorizontalStackLayout HorizontalOptions="Center" Spacing="8">
                                <mi:MauiIcon
                                    Icon="{mi:Material Icon=Block}"
                                    IconColor="#BE185D"
                                    IconSize="18"
                                    VerticalOptions="Center" />
                                <Label
                                    FontSize="14"
                                    Text="Auto-lock after 5 wrong attempts"
                                    TextColor="{DynamicResource TextSecondaryColor}"
                                    VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </VerticalStackLayout>

                    </VerticalStackLayout>
                </Grid>

                <Grid Padding="32,60,32,24" WidthRequest="{Binding Source={x:Reference MainPage}, Path=Width}">
                    <VerticalStackLayout Spacing="28" VerticalOptions="Center">

                        <Border
                            Padding="22"
                            BackgroundColor="#CFFAFE"
                            HeightRequest="220"
                            HorizontalOptions="Center"
                            StrokeThickness="0"
                            WidthRequest="220">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="110" />
                            </Border.StrokeShape>
                            <Border.Shadow>
                                <Shadow
                                    Brush="#06B6D4"
                                    Opacity="0.18"
                                    Radius="32"
                                    Offset="0,12" />
                            </Border.Shadow>
                            <skia:SKLottieView
                                HeightRequest="174"
                                RepeatCount="-1"
                                Source="Backups.json"
                                WidthRequest="174" />
                        </Border>

                        <VerticalStackLayout HorizontalOptions="Center" Spacing="10">
                            <Label
                                CharacterSpacing="2"
                                FontAttributes="Bold"
                                FontSize="11"
                                HorizontalTextAlignment="Center"
                                Text="CLOUD BACKUP"
                                TextColor="#0E7490" />
                            <Label
                                FontAttributes="Bold"
                                FontSize="30"
                                HorizontalTextAlignment="Center"
                                Text="You're All Set!"
                                TextColor="{DynamicResource TextColor}" />
                            <Label
                                FontSize="16"
                                HorizontalTextAlignment="Center"
                                LineBreakMode="WordWrap"
                                LineHeight="1.45"
                                Opacity="0.80"
                                Text="Optionally back up your encrypted vault to Google Drive or Dropbox. Your data is encrypted before upload - only you can decrypt it."
                                TextColor="{DynamicResource TextSecondaryColor}" />
                        </VerticalStackLayout>

                        <!--  Summary pills — everything in the app  -->
                        <FlexLayout
                            HorizontalOptions="Center"
                            JustifyContent="Center"
                            Wrap="Wrap">
                            <Border
                                Margin="4"
                                Padding="12,6"
                                BackgroundColor="{DynamicResource PrimaryLightestColor}"
                                StrokeThickness="0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12" />
                                </Border.StrokeShape>
                                <HorizontalStackLayout Spacing="5">
                                    <mi:MauiIcon
                                        Icon="{mi:Material Icon=CheckCircle}"
                                        IconColor="{DynamicResource PrimaryColor}"
                                        IconSize="13"
                                        VerticalOptions="Center" />
                                    <Label
                                        FontSize="12"
                                        Text="Passwords"
                                        TextColor="{DynamicResource PrimaryColor}"
                                        VerticalOptions="Center" />
                                </HorizontalStackLayout>
                            </Border>
                            <Border
                                Margin="4"
                                Padding="12,6"
                                BackgroundColor="#DCFCE7"
                                StrokeThickness="0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12" />
                                </Border.StrokeShape>
                                <HorizontalStackLayout Spacing="5">
                                    <mi:MauiIcon
                                        Icon="{mi:Material Icon=CheckCircle}"
                                        IconColor="#16A34A"
                                        IconSize="13"
                                        VerticalOptions="Center" />
                                    <Label
                                        FontSize="12"
                                        Text="2FA Codes"
                                        TextColor="#16A34A"
                                        VerticalOptions="Center" />
                                </HorizontalStackLayout>
                            </Border>
                            <Border
                                Margin="4"
                                Padding="12,6"
                                BackgroundColor="#FEF3C7"
                                StrokeThickness="0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12" />
                                </Border.StrokeShape>
                                <HorizontalStackLayout Spacing="5">
                                    <mi:MauiIcon
                                        Icon="{mi:Material Icon=CheckCircle}"
                                        IconColor="#D97706"
                                        IconSize="13"
                                        VerticalOptions="Center" />
                                    <Label
                                        FontSize="12"
                                        Text="Autofill"
                                        TextColor="#D97706"
                                        VerticalOptions="Center" />
                                </HorizontalStackLayout>
                            </Border>
                            <Border
                                Margin="4"
                                Padding="12,6"
                                BackgroundColor="#CCFBF1"
                                StrokeThickness="0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12" />
                                </Border.StrokeShape>
                                <HorizontalStackLayout Spacing="5">
                                    <mi:MauiIcon
                                        Icon="{mi:Material Icon=CheckCircle}"
                                        IconColor="#0F766E"
                                        IconSize="13"
                                        VerticalOptions="Center" />
                                    <Label
                                        FontSize="12"
                                        Text="Health Score"
                                        TextColor="#0F766E"
                                        VerticalOptions="Center" />
                                </HorizontalStackLayout>
                            </Border>
                            <Border
                                Margin="4"
                                Padding="12,6"
                                BackgroundColor="#EDE9FE"
                                StrokeThickness="0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12" />
                                </Border.StrokeShape>
                                <HorizontalStackLayout Spacing="5">
                                    <mi:MauiIcon
                                        Icon="{mi:Material Icon=CheckCircle}"
                                        IconColor="#7C3AED"
                                        IconSize="13"
                                        VerticalOptions="Center" />
                                    <Label
                                        FontSize="12"
                                        Text="Voice Commands"
                                        TextColor="#7C3AED"
                                        VerticalOptions="Center" />
                                </HorizontalStackLayout>
                            </Border>
                            <Border
                                Margin="4"
                                Padding="12,6"
                                BackgroundColor="#FCE7F3"
                                StrokeThickness="0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12" />
                                </Border.StrokeShape>
                                <HorizontalStackLayout Spacing="5">
                                    <mi:MauiIcon
                                        Icon="{mi:Material Icon=CheckCircle}"
                                        IconColor="#BE185D"
                                        IconSize="13"
                                        VerticalOptions="Center" />
                                    <Label
                                        FontSize="12"
                                        Text="Biometric Lock"
                                        TextColor="#BE185D"
                                        VerticalOptions="Center" />
                                </HorizontalStackLayout>
                            </Border>
                            <Border
                                Margin="4"
                                Padding="12,6"
                                BackgroundColor="#CFFAFE"
                                StrokeThickness="0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12" />
                                </Border.StrokeShape>
                                <HorizontalStackLayout Spacing="5">
                                    <mi:MauiIcon
                                        Icon="{mi:Material Icon=CheckCircle}"
                                        IconColor="#0E7490"
                                        IconSize="13"
                                        VerticalOptions="Center" />
                                    <Label
                                        FontSize="12"
                                        Text="Backups | Sync"
                                        TextColor="#0E7490"
                                        VerticalOptions="Center" />
                                </HorizontalStackLayout>
                            </Border>
                        </FlexLayout>

                    </VerticalStackLayout>
                </Grid>

            </HorizontalStackLayout>
        </ScrollView>

        <!--  Bottom Navigation  -->
        <Border
            Grid.Row="1"
            Padding="24,20,24,32"
            BackgroundColor="{DynamicResource CardBackgroundColor}"
            StrokeThickness="0">
            <Border.Shadow>
                <Shadow
                    Brush="{DynamicResource GrayShadowColor}"
                    Opacity="0.08"
                    Radius="16"
                    Offset="0,-4" />
            </Border.Shadow>
            <VerticalStackLayout Spacing="18">
                <HorizontalStackLayout
                    x:Name="IndicatorsStack"
                    HorizontalOptions="Center"
                    Spacing="8" />
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                    <Border
                        x:Name="SkipButton"
                        Grid.Column="0"
                        Padding="16,12"
                        BackgroundColor="Transparent"
                        HeightRequest="52"
                        StrokeThickness="0"
                        WidthRequest="80">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnSkipClicked" />
                        </Border.GestureRecognizers>
                        <Label
                            FontAttributes="Bold"
                            FontSize="15"
                            HorizontalOptions="Center"
                            Text="Skip"
                            TextColor="{DynamicResource TextTertiaryColor}"
                            VerticalOptions="Center" />
                    </Border>
                    <Border
                        x:Name="NextButton"
                        Grid.Column="2"
                        Padding="18,14"
                        BackgroundColor="{DynamicResource PrimaryColor}"
                        HeightRequest="52"
                        MinimumWidthRequest="140"
                        StrokeThickness="0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="26" />
                        </Border.StrokeShape>
                        <Border.Shadow>
                            <Shadow
                                Brush="{DynamicResource PrimaryColor}"
                                Opacity="0.30"
                                Radius="20"
                                Offset="0,8" />
                        </Border.Shadow>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnNextClicked" />
                        </Border.GestureRecognizers>
                        <HorizontalStackLayout
                            HorizontalOptions="Center"
                            Spacing="10"
                            VerticalOptions="Center">
                            <Label
                                x:Name="NextButtonText"
                                FontAttributes="Bold"
                                FontSize="17"
                                Text="Next"
                                TextColor="White"
                                VerticalOptions="Center" />
                            <mi:MauiIcon
                                x:Name="NextArrowIcon"
                                Icon="{mi:Material Icon=ArrowForward}"
                                IconColor="White"
                                IconSize="22"
                                VerticalOptions="Center" />
                            <mi:MauiIcon
                                x:Name="NextRocketIcon"
                                Icon="{mi:Material Icon=RocketLaunch}"
                                IconColor="White"
                                IconSize="22"
                                IsVisible="False"
                                VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </Border>
                </Grid>
            </VerticalStackLayout>
        </Border>

    </Grid>
</ContentPage>
