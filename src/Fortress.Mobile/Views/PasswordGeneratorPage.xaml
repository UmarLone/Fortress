<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Fortress.Views.PasswordGeneratorPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ctrl="clr-namespace:Fortress.Controls"
    xmlns:mi="http://www.aathifmahir.com/dotnet/2022/maui/icons"
    xmlns:prism="http://prismlibrary.com"
    prism:ViewModelLocator.AutowireViewModel="Automatic"
    BackgroundColor="{DynamicResource PageBackgroundColor}"
    NavigationPage.HasNavigationBar="False">

    <Grid RowDefinitions="Auto,*">

        <!--  ═══ HERO + PASSWORD CARD (one seamless gradient block) ═══  -->
        <Border
            Grid.Row="0"
            Padding="20,16,20,28"
            StrokeThickness="0">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Offset="0.0" Color="{DynamicResource PrimaryColor}" />
                    <GradientStop Offset="1.0" Color="{DynamicResource PrimaryGradient}" />
                </LinearGradientBrush>
            </Border.Background>
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="0,0,28,28" />
            </Border.StrokeShape>

            <VerticalStackLayout Spacing="0">

                <!--  Navigation row  -->
                <Grid
                    Margin="0,0,0,20"
                    ColumnDefinitions="Auto,*,Auto"
                    ColumnSpacing="12">

                    <!--  Back button  -->
                    <Border
                        Grid.Column="0"
                        Padding="0"
                        BackgroundColor="#30FFFFFF"
                        HeightRequest="40"
                        StrokeThickness="0"
                        VerticalOptions="Center"
                        WidthRequest="40">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12" />
                        </Border.StrokeShape>
                        <Button
                            Padding="0"
                            BackgroundColor="Transparent"
                            BorderWidth="0"
                            Command="{Binding GoBackCommand}"
                            HeightRequest="40"
                            WidthRequest="40">
                            <Button.ImageSource>
                                <FontImageSource
                                    FontFamily="MaterialIconsRegular"
                                    Glyph="&#xE5C4;"
                                    Size="22"
                                    Color="White" />
                            </Button.ImageSource>
                        </Button>
                    </Border>

                    <!--  Title stack  -->
                    <VerticalStackLayout
                        Grid.Column="1"
                        Spacing="2"
                        VerticalOptions="Center">
                        <Label
                            FontSize="13"
                            Opacity="0.75"
                            Text="TOOLS"
                            TextColor="White" />
                        <Label
                            FontAttributes="Bold"
                            FontSize="22"
                            Text="Password Generator"
                            TextColor="White" />
                    </VerticalStackLayout>

                    <!--  Icon badge  -->
                    <Border
                        Grid.Column="2"
                        Padding="12"
                        BackgroundColor="#30FFFFFF"
                        HeightRequest="48"
                        StrokeThickness="0"
                        VerticalOptions="Center"
                        WidthRequest="48">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="24" />
                        </Border.StrokeShape>
                        <Label
                            FontFamily="MaterialIconsRegular"
                            FontSize="24"
                            HorizontalOptions="Center"
                            Text="&#xE73C;"
                            TextColor="White"
                            VerticalOptions="Center" />
                    </Border>
                </Grid>

                <!--  Subtitle  -->
                <Label
                    Margin="0,0,0,20"
                    FontSize="14"
                    Opacity="0.85"
                    Text="Create strong, unique passwords instantly"
                    TextColor="White" />

                <!--  Generated password card  -->
                <ctrl:VaultGeneratedPasswordCard
                    CopyCommand="{Binding CopyToClipboardCommand}"
                    Password="{Binding GeneratedPassword}"
                    RefreshCommand="{Binding GenerateCommand}" />

                <!--  Strength bar  -->
                <ctrl:VaultPasswordStrengthBar Margin="0,16,0,0" Score="{Binding Score}" />

            </VerticalStackLayout>
        </Border>

        <!--  ═══ OPTIONS SECTION ═══  -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="16,20,16,32" Spacing="12">

                <Label
                    Margin="4,0,0,4"
                    FontAttributes="Bold"
                    FontSize="13"
                    Text="CUSTOMISE"
                    TextColor="{DynamicResource TextTertiaryColor}" />

                <ctrl:VaultLengthSlider
                    DecreaseCommand="{Binding DecreaseLengthCommand}"
                    IncreaseCommand="{Binding IncreaseLengthCommand}"
                    Length="{Binding NumberOfLetters}" />

                <!--  Character type toggles  -->
                <Border
                    Padding="8,4"
                    BackgroundColor="{DynamicResource CardBackgroundColor}"
                    StrokeThickness="0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16" />
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow
                            Brush="Black"
                            Opacity="0.05"
                            Radius="8"
                            Offset="0,2" />
                    </Border.Shadow>
                    <VerticalStackLayout Spacing="0">
                        <ctrl:VaultToggleRow
                            Title="Uppercase"
                            IconBackgroundColor="#EFF6FF"
                            IconColor="#3B82F6"
                            IconGlyph="A"
                            IsToggled="{Binding IncludeUppercase}"
                            ShowSeparator="True"
                            Subtitle="A B C D … Z" />
                        <ctrl:VaultToggleRow
                            Title="Lowercase"
                            IconBackgroundColor="#F0FDF4"
                            IconColor="#16A34A"
                            IconGlyph="&#x1D4B6;"
                            IsToggled="{Binding IncludeLowercase}"
                            ShowSeparator="True"
                            Subtitle="a b c d … z" />
                        <ctrl:VaultToggleRow
                            Title="Numbers"
                            IconBackgroundColor="#FFF7ED"
                            IconColor="#EA580C"
                            IconGlyph="⑨"
                            IsToggled="{Binding IncludeNumbers}"
                            ShowSeparator="True"
                            Subtitle="0 1 2 3 … 9" />
                        <ctrl:VaultToggleRow
                            Title="Special Characters"
                            IconBackgroundColor="#FDF4FF"
                            IconColor="#9333EA"
                            IconGlyph="!@"
                            IsToggled="{Binding IncludeSymbols}"
                            ShowSeparator="False"
                            Subtitle="! @ # $ % ^ &amp; * ? _" />
                    </VerticalStackLayout>
                </Border>

                <!--  Tip  -->
                <Border
                    Padding="16,14"
                    BackgroundColor="{DynamicResource PrimaryLightestColor}"
                    StrokeThickness="0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="14" />
                    </Border.StrokeShape>
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <Label
                            Grid.Column="0"
                            FontFamily="MaterialIconsRegular"
                            FontSize="20"
                            Text="&#xE0F0;"
                            TextColor="{DynamicResource PrimaryColor}"
                            VerticalOptions="Start" />
                        <Label
                            Grid.Column="1"
                            FontSize="13"
                            LineBreakMode="WordWrap"
                            Text="Use at least 16 characters with a mix of uppercase, numbers and symbols for the strongest passwords."
                            TextColor="{DynamicResource PrimaryDarkColor}" />
                    </Grid>
                </Border>

                <!--  Generate button  -->
                <ctrl:VaultGradientButton
                    Margin="0,4,0,0"
                    Command="{Binding GenerateCommand}"
                    Text="Generate New Password" />

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
