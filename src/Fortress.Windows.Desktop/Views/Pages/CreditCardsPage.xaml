<Page
  x:Class="Fortress.Windows.Desktop.Views.Pages.CreditCardsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="clr-namespace:Fortress.Windows.Desktop.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:local="clr-namespace:Fortress.Windows.Desktop.Views.Pages"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Credit Cards"
    d:DataContext="{d:DesignInstance local:CreditCardsPage, IsDesignTimeCreatable=False}"
    d:DesignHeight="800"
    d:DesignWidth="1300"
    ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
    ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    mc:Ignorable="d">

    <Page.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
        <conv:InverseBoolToVisibilityConverter x:Key="InvBoolToVis" />
 <conv:HexColorToBrushConverter x:Key="HexToBrush" />
   <conv:LabelToAccentColorConverter x:Key="LabelColor" />
        <conv:StringToInitialsConverter x:Key="Initials" />
        <conv:NullOrEmptyToVisibilityConverter x:Key="NotEmptyToVis" />
    </Page.Resources>

    <Grid>

 <!-- LIST + DETAIL -->
   <Grid>
    <Grid.ColumnDefinitions>
<ColumnDefinition Width="*" />
    <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

    <!-- LIST -->
    <ScrollViewer Grid.Column="0" Margin="30,24,24,0" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
   <StackPanel Margin="0,0,0,40">

      <!-- Header -->
         <Grid Margin="0,0,0,20">
     <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
          <StackPanel>
     <TextBlock FontSize="26" FontWeight="SemiBold" Text="Credit Cards" />
            <TextBlock Margin="0,4,0,0" FontSize="13" Opacity="0.6" Text="Stored payment cards" />
         </StackPanel>
     <ui:Button Grid.Column="1" VerticalAlignment="Center" Appearance="Primary"
     Command="{Binding ViewModel.OpenAddDrawerCommand}"
    Content="Add Card" Icon="{ui:SymbolIcon Symbol=Add24}" />
     </Grid>

        <!-- Hero -->
           <Border Margin="0,0,0,24" Padding="28,20" ClipToBounds="True" CornerRadius="14">
              <Border.Background>
              <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
           <GradientStop Offset="0" Color="#1E3A5F" />
     <GradientStop Offset="0.55" Color="#1D4ED8" />
         <GradientStop Offset="1" Color="#7C3AED" />
          </LinearGradientBrush>
         </Border.Background>
   <Border.Effect>
         <DropShadowEffect BlurRadius="28" Opacity="0.22" ShadowDepth="0" Color="#1D4ED8" />
       </Border.Effect>
   <Grid>
         <Grid.ColumnDefinitions>
       <ColumnDefinition Width="Auto" />
  <ColumnDefinition Width="*" />
               </Grid.ColumnDefinitions>
     <Border Width="52" Height="52" Margin="0,0,16,0" CornerRadius="13">
         <Border.Background><SolidColorBrush Color="#30FFFFFF" /></Border.Background>
    <ui:SymbolIcon FontSize="26" Foreground="White" Symbol="CreditCardPerson24" />
   </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
    <TextBlock FontSize="17" FontWeight="Bold" Foreground="White" Text="Payment Cards" />
             <TextBlock Margin="0,4,0,0" FontSize="12" Foreground="White" Opacity="0.78"
    Text="Card numbers are encrypted and masked by default." TextWrapping="Wrap" />
           </StackPanel>
               </Grid>
     </Border>

           <!-- Search -->
        <ui:AutoSuggestBox Margin="0,0,0,20" PlaceholderText="Search cards..."
           Text="{Binding ViewModel.SearchText, UpdateSourceTrigger=PropertyChanged}">
            <ui:AutoSuggestBox.Icon>
<ui:IconSourceElement><ui:SymbolIconSource Symbol="Search24" /></ui:IconSourceElement>
         </ui:AutoSuggestBox.Icon>
       </ui:AutoSuggestBox>

                    <TextBlock Margin="0,0,0,12" FontSize="11" FontWeight="SemiBold" Opacity="0.45" Text="YOUR CARDS" />

            <ui:ProgressRing Width="48" Height="48" HorizontalAlignment="Center"
         IsIndeterminate="True"
       Visibility="{Binding ViewModel.IsLoading, Converter={StaticResource BoolToVis}}" />

        <!-- Card grid -->
         <ItemsControl ItemsSource="{Binding ViewModel.Items}"
     Visibility="{Binding ViewModel.IsLoading, Converter={StaticResource InvBoolToVis}}">
                <ItemsControl.ItemsPanel>
               <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
             <ItemsControl.ItemTemplate>
          <DataTemplate>
       <Border Width="310" Height="185" Margin="0,0,16,16" CornerRadius="16"
                  Cursor="Hand" MouseLeftButtonUp="OnCardClicked">
      <Border.Background>
       <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
          <GradientStop Offset="0" Color="#1E3A5F" />
            <GradientStop Offset="1" Color="#2563EB" />
     </LinearGradientBrush>
</Border.Background>
<Border.Effect>
   <DropShadowEffect BlurRadius="20" Opacity="0.25" ShadowDepth="4" Color="#000000" />
        </Border.Effect>
            <Grid Margin="24">
   <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
       <RowDefinition Height="*" />
       <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
       </Grid.RowDefinitions>
          <TextBlock Grid.Row="0" HorizontalAlignment="Right" FontSize="14" FontWeight="Bold" Foreground="White" Opacity="0.9" Text="{Binding CardNetwork}" />
             <StackPanel Grid.Row="1" VerticalAlignment="Bottom">
   <Border Width="36" Height="28" CornerRadius="4" Opacity="0.8">
          <Border.Background><SolidColorBrush Color="#D4A017" /></Border.Background>
 </Border>
        </StackPanel>
             <TextBlock Grid.Row="2" Margin="0,12,0,6" FontFamily="Consolas" FontSize="16" FontWeight="Medium" Foreground="White" Text="{Binding DisplayNumber}" />
   <Grid Grid.Row="3">
       <Grid.ColumnDefinitions>
   <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
           </Grid.ColumnDefinitions>
                   <StackPanel>
    <TextBlock FontSize="9" Foreground="White" Opacity="0.6" Text="CARDHOLDER" />
   <TextBlock FontSize="12" FontWeight="Medium" Foreground="White" Text="{Binding CardholderName}" />
      </StackPanel>
         <StackPanel HorizontalAlignment="Right">
 <TextBlock FontSize="9" Foreground="White" Opacity="0.6" Text="EXPIRES" />
         <TextBlock FontSize="12" FontWeight="Medium" Foreground="White" Text="{Binding ExpiryDisplay}" />
      </StackPanel>
     </Grid>
              </Grid>
        </Border>
    </DataTemplate>
            </ItemsControl.ItemTemplate>
         </ItemsControl>
     </StackPanel>
        </ScrollViewer>

            <!-- DETAIL PANEL -->
        <Border Grid.Column="1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
      BorderThickness="1,0,0,0"
    Visibility="{Binding ViewModel.IsDetailOpen, Converter={StaticResource BoolToVis}}">
     <Grid Width="320">
        <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
           </Grid.RowDefinitions>
            <Border Grid.Row="0" Padding="24,16,24,16"
       BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
          BorderThickness="0,0,0,1">
  <Grid>
     <Grid.ColumnDefinitions>
           <ColumnDefinition Width="*" />
  <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
           <TextBlock VerticalAlignment="Center" FontSize="17" FontWeight="SemiBold" Text="{Binding ViewModel.SelectedItem.Label}" />
             <ui:Button Grid.Column="1" Appearance="Transparent" Command="{Binding ViewModel.CloseDetailCommand}" Icon="{ui:SymbolIcon Symbol=Dismiss24}" />
    </Grid>
  </Border>
              <ScrollViewer Grid.Row="1" Padding="24,20,24,20" VerticalScrollBarVisibility="Auto">
   <StackPanel DataContext="{Binding ViewModel.SelectedItem}">
            <TextBlock Margin="0,0,0,4" FontSize="11" FontWeight="SemiBold" Opacity="0.45" Text="CARD NUMBER" />
     <Border Margin="0,0,0,16" Padding="12,10" CornerRadius="8"
   Background="{DynamicResource ControlFillColorDefaultBrush}">
        <Grid>
  <Grid.ColumnDefinitions>
           <ColumnDefinition Width="*" />
     <ColumnDefinition Width="Auto" />
             <ColumnDefinition Width="Auto" />
</Grid.ColumnDefinitions>
<TextBlock Grid.Column="0" VerticalAlignment="Center" FontFamily="Consolas" Text="{Binding DisplayNumber}" />
         <ui:Button Grid.Column="1" Padding="4" Appearance="Transparent"
                ToolTip="Toggle visibility"
    Command="{Binding ToggleNumberVisibilityCommand}" Icon="{ui:SymbolIcon Symbol=Eye24}" />
      <ui:Button Grid.Column="2" Padding="4" Appearance="Transparent"
 ToolTip="Copy number"
       Command="{Binding DataContext.ViewModel.CopyNumberCommand, RelativeSource={RelativeSource AncestorType=Page}}" Icon="{ui:SymbolIcon Symbol=Copy24}" />
               </Grid>
                </Border>
  <TextBlock Margin="0,0,0,4" FontSize="11" FontWeight="SemiBold" Opacity="0.45" Text="CARDHOLDER" />
         <TextBlock Margin="0,0,0,16" Text="{Binding CardholderName}" />
      <TextBlock Margin="0,0,0,4" FontSize="11" FontWeight="SemiBold" Opacity="0.45" Text="EXPIRY" />
     <TextBlock Margin="0,0,0,16" Text="{Binding ExpiryDisplay}" />
           <TextBlock Margin="0,0,0,4" FontSize="11" FontWeight="SemiBold" Opacity="0.45" Text="NETWORK" />
               <TextBlock Margin="0,0,0,24" Text="{Binding CardNetwork}" />
                 <StackPanel Orientation="Horizontal">
  <ui:Button Margin="0,0,8,0" Padding="16,8" Appearance="Primary" Content="Edit" Icon="{ui:SymbolIcon Symbol=Edit24}"
        Command="{Binding DataContext.ViewModel.OpenEditDrawerCommand, RelativeSource={RelativeSource AncestorType=Page}}"
           CommandParameter="{Binding DataContext.ViewModel.SelectedItem, RelativeSource={RelativeSource AncestorType=Page}}" />
       <ui:Button Padding="16,8" Appearance="Danger" Content="Delete" Icon="{ui:SymbolIcon Symbol=Delete24}"
             Command="{Binding DataContext.ViewModel.DeleteAsyncCommand, RelativeSource={RelativeSource AncestorType=Page}}"
          CommandParameter="{Binding DataContext.ViewModel.SelectedItem, RelativeSource={RelativeSource AncestorType=Page}}" />
   </StackPanel>
  </StackPanel>
          </ScrollViewer>
                </Grid>
            </Border>
</Grid>

        <!-- DRAWER -->
        <hc:Drawer
          Dock="Right"
     IsOpen="{Binding ViewModel.IsDrawerOpen, Mode=TwoWay}"
        ShowMode="Cover"
         MaskCanClose="True">
          <Grid Width="440" Background="{DynamicResource ApplicationBackgroundBrush}">
         <Grid.RowDefinitions>
   <RowDefinition Height="Auto" />
         <RowDefinition Height="*" />
     <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

 <!-- Header -->
  <Border Grid.Row="0" Padding="24,20" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
           <Grid>
       <Grid.ColumnDefinitions>
  <ColumnDefinition Width="*" />
<ColumnDefinition Width="Auto" />
     </Grid.ColumnDefinitions>
              <StackPanel VerticalAlignment="Center">
     <TextBlock FontSize="18" FontWeight="SemiBold">
       <TextBlock.Style>
  <Style TargetType="TextBlock">
            <Setter Property="Text" Value="Add Card" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding ViewModel.IsEditMode}" Value="True">
      <Setter Property="Text" Value="Edit Card" />
           </DataTrigger>
    </Style.Triggers>
               </Style>
        </TextBlock.Style>
        </TextBlock>
       <TextBlock Margin="0,2,0,0" FontSize="12" Opacity="0.55" Text="Fill in card details below and press Save." />
             </StackPanel>
        <ui:Button Grid.Column="1" Appearance="Transparent" Command="{Binding ViewModel.CloseDrawerCommand}" Icon="{ui:SymbolIcon Symbol=Dismiss24}" />
 </Grid>
        </Border>

    <!-- Form -->
     <ScrollViewer Grid.Row="1" Padding="24,20" VerticalScrollBarVisibility="Auto">
 <StackPanel>
       <TextBlock Margin="0,0,0,4" FontSize="11" FontWeight="SemiBold" Opacity="0.45" Text="LABEL *" />
   <ui:TextBox Margin="0,0,0,16" PlaceholderText="e.g. Visa Platinum" Text="{Binding ViewModel.FormLabel, UpdateSourceTrigger=PropertyChanged}" />
           <TextBlock Margin="0,0,0,4" FontSize="11" FontWeight="SemiBold" Opacity="0.45" Text="CARDHOLDER NAME" />
    <ui:TextBox Margin="0,0,0,16" PlaceholderText="Full name on card" Text="{Binding ViewModel.FormCardholderName, UpdateSourceTrigger=PropertyChanged}" />
 <TextBlock Margin="0,0,0,4" FontSize="11" FontWeight="SemiBold" Opacity="0.45" Text="CARD NUMBER *" />
   <ui:TextBox Margin="0,0,0,16" PlaceholderText="0000 0000 0000 0000" Text="{Binding ViewModel.FormNumber, UpdateSourceTrigger=PropertyChanged}" />
            <Grid Margin="0,0,0,16">
     <Grid.ColumnDefinitions>
         <ColumnDefinition Width="*" />
         <ColumnDefinition Width="8" />
     <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
    <StackPanel Grid.Column="0">
     <TextBlock Margin="0,0,0,4" FontSize="11" FontWeight="SemiBold" Opacity="0.45" Text="EXPIRY MONTH" />
           <ui:TextBox PlaceholderText="MM" Text="{Binding ViewModel.FormExpiryMonth, UpdateSourceTrigger=PropertyChanged}" />
  </StackPanel>
    <StackPanel Grid.Column="2">
         <TextBlock Margin="0,0,0,4" FontSize="11" FontWeight="SemiBold" Opacity="0.45" Text="EXPIRY YEAR" />
 <ui:TextBox PlaceholderText="YYYY" Text="{Binding ViewModel.FormExpiryYear, UpdateSourceTrigger=PropertyChanged}" />
               </StackPanel>
   </Grid>
    <TextBlock Margin="0,0,0,4" FontSize="11" FontWeight="SemiBold" Opacity="0.45" Text="CVV" />
   <ui:TextBox Margin="0,0,0,16" PlaceholderText="123" Text="{Binding ViewModel.FormCvv, UpdateSourceTrigger=PropertyChanged}" />
      <TextBlock Margin="0,0,0,4" FontSize="11" FontWeight="SemiBold" Opacity="0.45" Text="CARD NETWORK" />
     <ComboBox Margin="0,0,0,16" HorizontalAlignment="Stretch" SelectedItem="{Binding ViewModel.FormCardNetwork}">
 <ComboBoxItem>Visa</ComboBoxItem>
 <ComboBoxItem>Mastercard</ComboBoxItem>
        <ComboBoxItem>Amex</ComboBoxItem>
     <ComboBoxItem>Discover</ComboBoxItem>
      <ComboBoxItem>Unknown</ComboBoxItem>
 </ComboBox>
      <TextBlock Margin="0,0,0,4" FontSize="11" FontWeight="SemiBold" Opacity="0.45" Text="BILLING ADDRESS" />
   <ui:TextBox Height="60" Margin="0,0,0,8" AcceptsReturn="True"
    Text="{Binding ViewModel.FormBillingAddress, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" />
    <!-- Validation error — only shows when FormError is non-empty -->
   <Border Margin="0,4,0,0" Padding="12,10" CornerRadius="8"
      Visibility="{Binding ViewModel.FormError, Converter={StaticResource NotEmptyToVis}}">
       <Border.Background><SolidColorBrush Color="#1FEF4444" /></Border.Background>
      <StackPanel Orientation="Horizontal">
         <ui:SymbolIcon Margin="0,0,8,0" FontSize="14" Foreground="#EF4444" Symbol="ErrorCircle24" />
  <TextBlock VerticalAlignment="Center" FontSize="12" Foreground="#EF4444"
   Text="{Binding ViewModel.FormError}" TextWrapping="Wrap" />
                </StackPanel>
          </Border>
         </StackPanel>
     </ScrollViewer>

                <!-- Footer -->
      <Border Grid.Row="2" Padding="24,16" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
<Grid>
         <Grid.ColumnDefinitions>
               <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
           <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
            Visibility="{Binding ViewModel.IsSaving, Converter={StaticResource BoolToVis}}">
        <ui:ProgressRing Width="16" Height="16" Margin="0,0,8,0" IsIndeterminate="True" />
    <TextBlock FontSize="12" Opacity="0.6" VerticalAlignment="Center" Text="Saving..." />
     </StackPanel>
      <StackPanel Grid.Column="1" HorizontalAlignment="Right" Orientation="Horizontal">
           <ui:Button Margin="0,0,10,0" Padding="20,10" Appearance="Secondary"
     Command="{Binding ViewModel.CloseDrawerCommand}" Content="Cancel" />
      <ui:Button Padding="20,10" Appearance="Primary"
      Command="{Binding ViewModel.SaveAsyncCommand}"
      Content="Save" Icon="{ui:SymbolIcon Symbol=Save24}" />
    </StackPanel>
          </Grid>
     </Border>
            </Grid>
        </hc:Drawer>
    </Grid>
</Page>
