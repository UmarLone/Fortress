<Page
    x:Class="Fortress.Windows.Desktop.Views.Pages.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="clr-namespace:Fortress.Windows.Desktop.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Fortress.Windows.Desktop.Views.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Dashboard"
    Margin="30"
    d:DataContext="{d:DesignInstance local:DashboardPage,
                                     IsDesignTimeCreatable=False}"
    d:DesignHeight="900"
    d:DesignWidth="1200"
    ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
    ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    mc:Ignorable="d">

    <Page.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
        <conv:InverseBoolToVisibilityConverter x:Key="InvBoolToVis" />
        <conv:HexColorToBrushConverter x:Key="HexToBrush" />
        <conv:DateTimeToAgoConverter x:Key="TimeAgo" />
        <conv:LabelToAccentColorConverter x:Key="LabelColor" />
        <conv:StringToInitialsConverter x:Key="Initials" />
    </Page.Resources>

    <!--  Root scroll — this must be the direct child of the Page  -->
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,0,40">

            <!--  ══ HERO BANNER ══════════════════════════════════════════════════  -->
            <Border
                Margin="0,0,0,24"
                Padding="32,28"
                CornerRadius="16">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Offset="0" Color="#1E3A8A" />
                        <GradientStop Offset="0.5" Color="#1D4ED8" />
                        <GradientStop Offset="1" Color="#7C3AED" />
                    </LinearGradientBrush>
                </Border.Background>
                <Border.Effect>
                    <DropShadowEffect BlurRadius="32" Opacity="0.3" ShadowDepth="0" Color="#1D4ED8" />
                </Border.Effect>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!--  Left: greeting  -->
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock
                            FontSize="28"
                            FontWeight="Bold"
                            Foreground="White"
                            Text="{Binding ViewModel.Greeting}" />
                        <TextBlock
                            Margin="0,6,0,20"
                            FontSize="14"
                            Foreground="White"
                            Opacity="0.75"
                            Text="Here's your vault security overview for today." />
                        <!--  Inline health pill  -->
                        <StackPanel Orientation="Horizontal">
                            <Border
                                Margin="0,0,10,0"
                                Padding="14,6"
                                CornerRadius="20">
                                <Border.Background>
                                    <SolidColorBrush Color="#30FFFFFF" />
                                </Border.Background>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse
                                        Width="8"
                                        Height="8"
                                        Margin="0,0,8,0"
                                        VerticalAlignment="Center"
                                        Fill="{Binding ViewModel.HealthStatusColor, Converter={StaticResource HexToBrush}}" />
                                    <TextBlock
                                        FontSize="13"
                                        FontWeight="SemiBold"
                                        Foreground="White"
                                        Text="{Binding ViewModel.HealthStatusLabel}" />
                                    <TextBlock
                                        Margin="6,0,0,0"
                                        FontSize="13"
                                        Foreground="White"
                                        Opacity="0.7"
                                        Text="{Binding ViewModel.HealthScore, StringFormat='· {0}/100'}" />
                                </StackPanel>
                            </Border>
                            <Border Padding="14,6" CornerRadius="20">
                                <Border.Background>
                                    <SolidColorBrush Color="#30FFFFFF" />
                                </Border.Background>
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon
                                        Margin="0,0,6,0"
                                        FontSize="14"
                                        Foreground="White"
                                        Symbol="Shield24" />
                                    <TextBlock
                                        FontSize="13"
                                        Foreground="White"
                                        Text="{Binding ViewModel.CredentialsCount, StringFormat='{}{0} credentials'}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>

                    <!--  Right: logo icon  -->
                    <Border Grid.Column="1" Width="80" Height="80" CornerRadius="20" VerticalAlignment="Center">
                        <Border.Background>
                            <SolidColorBrush Color="#25FFFFFF" />
                        </Border.Background>
                        <ui:SymbolIcon FontSize="40" Foreground="White" Symbol="ShieldLock24" />
                    </Border>
                </Grid>
            </Border>

            <!--  ══ UNREAD NOTIFICATIONS BANNER ════════════════════════════════  -->
            <ui:InfoBar
                Title="You have unread notifications"
                Margin="0,0,0,20"
                IsClosable="True"
                IsOpen="{Binding ViewModel.HasUnreadNotifications}"
                Message="Check the Notifications section for breach alerts and security warnings."
                Severity="Warning" />

            <!--  ══ BREACH ALERT ════════════════════════════════════════════════  -->
            <Border
                Margin="0,0,0,24"
                Padding="18,14"
                CornerRadius="12"
                Visibility="{Binding ViewModel.HasWarnings, Converter={StaticResource BoolToVis}}">
                <Border.Background>
                    <SolidColorBrush Color="#1FEF4444" />
                </Border.Background>
                <Border.BorderBrush>
                    <SolidColorBrush Color="#40EF4444" />
                </Border.BorderBrush>
                <Border.BorderThickness>1</Border.BorderThickness>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border
                        Width="36"
                        Height="36"
                        Margin="0,0,14,0"
                        CornerRadius="18">
                        <Border.Background>
                            <SolidColorBrush Color="#30EF4444" />
                        </Border.Background>
                        <ui:SymbolIcon
                            FontSize="18"
                            Foreground="#EF4444"
                            Symbol="Warning24" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock
                            FontSize="14"
                            FontWeight="SemiBold"
                            Text="Action Required">
                            <TextBlock.Foreground>
                                <SolidColorBrush Color="#EF4444" />
                            </TextBlock.Foreground>
                        </TextBlock>
                        <TextBlock
                            FontSize="12"
                            Opacity="0.8"
                            Text="{Binding ViewModel.WarningText}" />
                    </StackPanel>
                    <Border
                        Grid.Column="2"
                        Padding="12,6"
                        VerticalAlignment="Center"
                        CornerRadius="8"
                        Cursor="Hand">
                        <Border.Background>
                            <SolidColorBrush Color="#EF4444" />
                        </Border.Background>
                        <TextBlock
                            FontSize="12"
                            FontWeight="SemiBold"
                            Foreground="White"
                            Text="Fix Now" />
                    </Border>
                </Grid>
            </Border>

            <!--  ══ STAT CARDS ROW ══════════════════════════════════════════════  -->
            <TextBlock
                Margin="0,0,0,12"
                FontSize="11"
                FontWeight="SemiBold"
                Opacity="0.45"
                Text="VAULT OVERVIEW" />
            <UniformGrid
                Margin="0,0,0,28"
                Columns="6"
                Rows="1">

                <!--  Credentials  -->
                <Border
                    Margin="0,0,10,0"
                    Padding="18,16"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    CornerRadius="14">
                    <Border.Effect>
                        <DropShadowEffect
                            BlurRadius="12"
                            Opacity="0.07"
                            ShadowDepth="2" />
                    </Border.Effect>
                    <StackPanel>
                        <Border
                            Width="38"
                            Height="38"
                            Margin="0,0,0,12"
                            HorizontalAlignment="Left"
                            CornerRadius="10">
                            <Border.Background>
                                <SolidColorBrush Color="#1A3B82F6" />
                            </Border.Background>
                            <ui:SymbolIcon
                                FontSize="18"
                                Foreground="#3B82F6"
                                Symbol="Key24" />
                        </Border>
                        <TextBlock
                            FontSize="30"
                            FontWeight="Bold"
                            Text="{Binding ViewModel.CredentialsCount}" />
                        <TextBlock
                            Margin="0,2,0,0"
                            FontSize="12"
                            Opacity="0.55"
                            Text="Credentials" />
                    </StackPanel>
                </Border>

                <!--  Credit Cards  -->
                <Border
                    Margin="0,0,10,0"
                    Padding="18,16"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    CornerRadius="14">
                    <Border.Effect>
                        <DropShadowEffect
                            BlurRadius="12"
                            Opacity="0.07"
                            ShadowDepth="2" />
                    </Border.Effect>
                    <StackPanel>
                        <Border
                            Width="38"
                            Height="38"
                            Margin="0,0,0,12"
                            HorizontalAlignment="Left"
                            CornerRadius="10">
                            <Border.Background>
                                <SolidColorBrush Color="#1A10B981" />
                            </Border.Background>
                            <ui:SymbolIcon
                                FontSize="18"
                                Foreground="#10B981"
                                Symbol="CreditCardPerson24" />
                        </Border>
                        <TextBlock
                            FontSize="30"
                            FontWeight="Bold"
                            Text="{Binding ViewModel.CreditCardsCount}" />
                        <TextBlock
                            Margin="0,2,0,0"
                            FontSize="12"
                            Opacity="0.55"
                            Text="Credit Cards" />
                    </StackPanel>
                </Border>

                <!--  Authenticators  -->
                <Border
                    Margin="0,0,10,0"
                    Padding="18,16"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    CornerRadius="14">
                    <Border.Effect>
                        <DropShadowEffect
                            BlurRadius="12"
                            Opacity="0.07"
                            ShadowDepth="2" />
                    </Border.Effect>
                    <StackPanel>
                        <Border
                            Width="38"
                            Height="38"
                            Margin="0,0,0,12"
                            HorizontalAlignment="Left"
                            CornerRadius="10">
                            <Border.Background>
                                <SolidColorBrush Color="#1A8B5CF6" />
                            </Border.Background>
                            <ui:SymbolIcon
                                FontSize="18"
                                Foreground="#8B5CF6"
                                Symbol="ShieldKeyhole24" />
                        </Border>
                        <TextBlock
                            FontSize="30"
                            FontWeight="Bold"
                            Text="{Binding ViewModel.AuthenticatorsCount}" />
                        <TextBlock
                            Margin="0,2,0,0"
                            FontSize="12"
                            Opacity="0.55"
                            Text="Authenticators" />
                    </StackPanel>
                </Border>

                <!--  Identities  -->
                <Border
                    Margin="0,0,10,0"
                    Padding="18,16"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    CornerRadius="14">
                    <Border.Effect>
                        <DropShadowEffect
                            BlurRadius="12"
                            Opacity="0.07"
                            ShadowDepth="2" />
                    </Border.Effect>
                    <StackPanel>
                        <Border
                            Width="38"
                            Height="38"
                            Margin="0,0,0,12"
                            HorizontalAlignment="Left"
                            CornerRadius="10">
                            <Border.Background>
                                <SolidColorBrush Color="#1AF59E0B" />
                            </Border.Background>
                            <ui:SymbolIcon
                                FontSize="18"
                                Foreground="#F59E0B"
                                Symbol="Person24" />
                        </Border>
                        <TextBlock
                            FontSize="30"
                            FontWeight="Bold"
                            Text="{Binding ViewModel.IdentitiesCount}" />
                        <TextBlock
                            Margin="0,2,0,0"
                            FontSize="12"
                            Opacity="0.55"
                            Text="Identities" />
                    </StackPanel>
                </Border>

                <!--  Secure Items  -->
                <Border
                    Margin="0,0,10,0"
                    Padding="18,16"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    CornerRadius="14">
                    <Border.Effect>
                        <DropShadowEffect
                            BlurRadius="12"
                            Opacity="0.07"
                            ShadowDepth="2" />
                    </Border.Effect>
                    <StackPanel>
                        <Border
                            Width="38"
                            Height="38"
                            Margin="0,0,0,12"
                            HorizontalAlignment="Left"
                            CornerRadius="10">
                            <Border.Background>
                                <SolidColorBrush Color="#1AEF4444" />
                            </Border.Background>
                            <ui:SymbolIcon
                                FontSize="18"
                                Foreground="#EF4444"
                                Symbol="ShieldLock24" />
                        </Border>
                        <TextBlock
                            FontSize="30"
                            FontWeight="Bold"
                            Text="{Binding ViewModel.SecureItemsCount}" />
                        <TextBlock
                            Margin="0,2,0,0"
                            FontSize="12"
                            Opacity="0.55"
                            Text="Secure Items" />
                    </StackPanel>
                </Border>

                <!--  Passkeys  -->
                <Border
                    Padding="18,16"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    CornerRadius="14">
                    <Border.Effect>
                        <DropShadowEffect
                            BlurRadius="12"
                            Opacity="0.07"
                            ShadowDepth="2" />
                    </Border.Effect>
                    <StackPanel>
                        <Border
                            Width="38"
                            Height="38"
                            Margin="0,0,0,12"
                            HorizontalAlignment="Left"
                            CornerRadius="10">
                            <Border.Background>
                                <SolidColorBrush Color="#1AEC4899" />
                            </Border.Background>
                            <ui:SymbolIcon
                                FontSize="18"
                                Foreground="#EC4899"
                                Symbol="Fingerprint24" />
                        </Border>
                        <TextBlock
                            FontSize="30"
                            FontWeight="Bold"
                            Text="{Binding ViewModel.PasskeysCount}" />
                        <TextBlock
                            Margin="0,2,0,0"
                            FontSize="12"
                            Opacity="0.55"
                            Text="Passkeys" />
                    </StackPanel>
                </Border>

            </UniformGrid>

            <!--  ══ RECENT LOGINS + SECURITY SIDEBAR ═══════════════════════════  -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="300" />
                </Grid.ColumnDefinitions>

                <!--  Recent Logins  -->
                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="16"
                            FontWeight="SemiBold"
                            Text="Recent Activity" />
                        <Border
                            Grid.Column="1"
                            Padding="10,5"
                            CornerRadius="8"
                            Cursor="Hand">
                            <Border.Background>
                                <SolidColorBrush Color="#0A000000" />
                            </Border.Background>
                            <TextBlock
                                FontSize="12"
                                Opacity="0.6"
                                Text="View all →" />
                        </Border>
                    </Grid>

                    <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" CornerRadius="14">
                        <Border.Effect>
                            <DropShadowEffect
                                BlurRadius="12"
                                Opacity="0.06"
                                ShadowDepth="2" />
                        </Border.Effect>
                        <ItemsControl ItemsSource="{Binding ViewModel.RecentLogins}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="18,12,18,12" Cursor="Hand">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background">
                                                            <Setter.Value>
                                                                <SolidColorBrush Color="#08000000" />
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="42" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <!--  Avatar  -->
                                            <Border
                                                Grid.Column="0"
                                                Width="38"
                                                Height="38"
                                                Background="{Binding Label, Converter={StaticResource LabelColor}}"
                                                CornerRadius="10">
                                                <TextBlock
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    FontSize="13"
                                                    FontWeight="Bold"
                                                    Foreground="White"
                                                    Text="{Binding Label, Converter={StaticResource Initials}}" />
                                            </Border>
                                            <!--  Info  -->
                                            <StackPanel
                                                Grid.Column="1"
                                                Margin="12,0,0,0"
                                                VerticalAlignment="Center">
                                                <TextBlock
                                                    FontSize="14"
                                                    FontWeight="SemiBold"
                                                    Text="{Binding Label}" />
                                                <TextBlock
                                                    Margin="0,1,0,0"
                                                    FontSize="12"
                                                    Opacity="0.5"
                                                    Text="{Binding Username}" />
                                            </StackPanel>
                                            <!--  Time badge  -->
                                            <Border
                                                Grid.Column="2"
                                                Padding="8,3"
                                                VerticalAlignment="Center"
                                                CornerRadius="6">
                                                <Border.Background>
                                                    <SolidColorBrush Color="#0A000000" />
                                                </Border.Background>
                                                <TextBlock
                                                    FontSize="11"
                                                    Opacity="0.5"
                                                    Text="{Binding UpdatedAt, Converter={StaticResource TimeAgo}}" />
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                </StackPanel>

                <!--  Security Sidebar  -->
                <StackPanel Grid.Column="1">

                    <!--  Health Score Card  -->
                    <TextBlock
                        Margin="0,0,0,14"
                        FontSize="16"
                        FontWeight="SemiBold"
                        Text="Security Score" />
                    <Border
                        Margin="0,0,0,16"
                        Padding="20"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        CornerRadius="14">
                        <Border.Effect>
                            <DropShadowEffect
                                BlurRadius="12"
                                Opacity="0.06"
                                ShadowDepth="2" />
                        </Border.Effect>
                        <StackPanel>
                            <!--  Score bar  -->
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock
                                        FontSize="42"
                                        FontWeight="Bold"
                                        Foreground="{Binding ViewModel.HealthStatusColor, Converter={StaticResource HexToBrush}}"
                                        Text="{Binding ViewModel.HealthScore}" />
                                    <TextBlock
                                        FontSize="13"
                                        FontWeight="SemiBold"
                                        Foreground="{Binding ViewModel.HealthStatusColor, Converter={StaticResource HexToBrush}}"
                                        Text="{Binding ViewModel.HealthStatusLabel}" />
                                </StackPanel>
                                <Border
                                    Grid.Column="1"
                                    Padding="10,6"
                                    VerticalAlignment="Center"
                                    CornerRadius="8">
                                    <Border.Background>
                                        <SolidColorBrush Color="#0A3B82F6" />
                                    </Border.Background>
                                    <TextBlock
                                        FontSize="14"
                                        FontWeight="SemiBold"
                                        Opacity="0.5"
                                        Text="/100" />
                                </Border>
                            </Grid>
                            <ProgressBar
                                Height="8"
                                Margin="0,0,0,16"
                                Background="{DynamicResource ControlFillColorDefaultBrush}"
                                Foreground="{Binding ViewModel.HealthStatusColor, Converter={StaticResource HexToBrush}}"
                                Maximum="100"
                                Value="{Binding ViewModel.HealthScore, Mode=OneWay}" />
                            <!--  Mini stats  -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                    <Border Padding="12,10" CornerRadius="10">
                                        <Border.Background>
                                            <SolidColorBrush Color="#1AEF4444" />
                                        </Border.Background>
                                        <StackPanel>
                                            <TextBlock
                                                FontSize="22"
                                                FontWeight="Bold"
                                                Text="{Binding ViewModel.WeakPasswordsCount}">
                                                <TextBlock.Foreground>
                                                    <SolidColorBrush Color="#EF4444" />
                                                </TextBlock.Foreground>
                                            </TextBlock>
                                            <TextBlock
                                                FontSize="11"
                                                Opacity="0.6"
                                                Text="Weak" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                    <Border Padding="12,10" CornerRadius="10">
                                        <Border.Background>
                                            <SolidColorBrush Color="#1AF97316" />
                                        </Border.Background>
                                        <StackPanel>
                                            <TextBlock
                                                FontSize="22"
                                                FontWeight="Bold"
                                                Text="{Binding ViewModel.ReusedPasswordsCount}">
                                                <TextBlock.Foreground>
                                                    <SolidColorBrush Color="#F97316" />
                                                </TextBlock.Foreground>
                                            </TextBlock>
                                            <TextBlock
                                                FontSize="11"
                                                Opacity="0.6"
                                                Text="Reused" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!--  Quick Actions  -->
                    <TextBlock
                        Margin="0,0,0,14"
                        FontSize="16"
                        FontWeight="SemiBold"
                        Text="Quick Actions" />
                    <Border
                        Padding="6"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        CornerRadius="14">
                        <Border.Effect>
                            <DropShadowEffect
                                BlurRadius="12"
                                Opacity="0.06"
                                ShadowDepth="2" />
                        </Border.Effect>
                        <StackPanel>

                            <Border
                                Margin="2,2,2,0"
                                Padding="14,12"
                                CornerRadius="10"
                                Cursor="Hand">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background">
                                                    <Setter.Value>
                                                        <SolidColorBrush Color="#0A3B82F6" />
                                                    </Setter.Value>
                                                </Setter>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel Orientation="Horizontal">
                                    <Border
                                        Width="34"
                                        Height="34"
                                        Margin="0,0,12,0"
                                        CornerRadius="8">
                                        <Border.Background>
                                            <SolidColorBrush Color="#1A3B82F6" />
                                        </Border.Background>
                                        <ui:SymbolIcon
                                            FontSize="16"
                                            Foreground="#3B82F6"
                                            Symbol="Password24" />
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock
                                            FontSize="13"
                                            FontWeight="SemiBold"
                                            Text="Generate Password" />
                                        <TextBlock
                                            FontSize="11"
                                            Opacity="0.5"
                                            Text="Create a strong password" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border
                                Margin="2,0,2,0"
                                Padding="14,12"
                                CornerRadius="10"
                                Cursor="Hand">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background">
                                                    <Setter.Value>
                                                        <SolidColorBrush Color="#0A10B981" />
                                                    </Setter.Value>
                                                </Setter>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel Orientation="Horizontal">
                                    <Border
                                        Width="34"
                                        Height="34"
                                        Margin="0,0,12,0"
                                        CornerRadius="8">
                                        <Border.Background>
                                            <SolidColorBrush Color="#1A10B981" />
                                        </Border.Background>
                                        <ui:SymbolIcon
                                            FontSize="16"
                                            Foreground="#10B981"
                                            Symbol="HeartPulse24" />
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock
                                            FontSize="13"
                                            FontWeight="SemiBold"
                                            Text="Vault Health" />
                                        <TextBlock
                                            FontSize="11"
                                            Opacity="0.5"
                                            Text="Review security issues" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border
                                Margin="2,0,2,0"
                                Padding="14,12"
                                CornerRadius="10"
                                Cursor="Hand">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background">
                                                    <Setter.Value>
                                                        <SolidColorBrush Color="#0A8B5CF6" />
                                                    </Setter.Value>
                                                </Setter>
                                            </Trigger>
