<Page
    x:Class="Fortress.Windows.Desktop.Views.Pages.PasswordGeneratorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="clr-namespace:Fortress.Windows.Desktop.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Fortress.Windows.Desktop.Views.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Password Generator"
    Margin="30"
    d:DataContext="{d:DesignInstance local:PasswordGeneratorPage,
                                     IsDesignTimeCreatable=False}"
    d:DesignHeight="800"
    d:DesignWidth="1100"
    ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
    ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    mc:Ignorable="d">

    <Page.Resources>
        <conv:HexColorToBrushConverter x:Key="HexToBrush" />
    </Page.Resources>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,0,40">

            <!--  ══ Page header ══════════════════════════════════════════════  -->
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock FontSize="26" FontWeight="SemiBold" Text="Password Generator" />
                    <TextBlock Margin="0,4,0,0" FontSize="13" Opacity="0.6" Text="Generate cryptographically strong passwords" />
                </StackPanel>
            </Grid>

            <!--  ══ Hero banner ══════════════════════════════════════════════  -->
            <Border
                Margin="0,0,0,24"
                Padding="28,22"
                ClipToBounds="True"
                CornerRadius="16">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Offset="0" Color="#4C1D95" />
                        <GradientStop Offset="0.55" Color="#7C3AED" />
                        <GradientStop Offset="1" Color="#6D28D9" />
                    </LinearGradientBrush>
                </Border.Background>
                <Border.Effect>
                    <DropShadowEffect
                        BlurRadius="28"
                        Opacity="0.28"
                        ShadowDepth="0"
                        Color="#7C3AED" />
                </Border.Effect>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border
                        Width="56"
                        Height="56"
                        Margin="0,0,20,0"
                        CornerRadius="14">
                        <Border.Background>
                            <SolidColorBrush Color="#30FFFFFF" />
                        </Border.Background>
                        <ui:SymbolIcon
                            FontSize="28"
                            Foreground="White"
                            Symbol="Password24" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock
                            FontSize="18"
                            FontWeight="Bold"
                            Foreground="White"
                            Text="Strong Password Generator" />
                        <TextBlock
                            Margin="0,4,0,0"
                            FontSize="13"
                            Foreground="White"
                            Opacity="0.78"
                            Text="Use the options below to customise length and character sets. Passwords are generated locally and never transmitted."
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Border>

            <!--  Content capped at 680 so controls don't stretch too wide  -->
            <StackPanel MaxWidth="680" HorizontalAlignment="Center">

                <!--  ══ Generated password ══════════════════════════════════════  -->
                <TextBlock
                    Margin="0,0,0,12"
                    FontSize="11"
                    FontWeight="SemiBold"
                    Opacity="0.45"
                    Text="GENERATED PASSWORD" />
                <ui:Card Margin="0,0,0,24" Padding="20">
                    <StackPanel>
                        <Border
                            Margin="0,0,0,12"
                            Padding="18,14"
                            Background="{DynamicResource ControlFillColorSecondaryBrush}"
                            CornerRadius="10">
                            <TextBlock
                                FontFamily="Consolas"
                                FontSize="22"
                                FontWeight="Medium"
                                Text="{Binding ViewModel.GeneratedPassword}"
                                TextWrapping="Wrap" />
                        </Border>

                        <!--  Strength bar  -->
                        <StackPanel Margin="0,0,0,14">
                            <ProgressBar
                                Height="8"
                                Margin="0,0,0,6"
                                Background="{DynamicResource ControlFillColorDefaultBrush}"
                                Foreground="{Binding ViewModel.StrengthColor, Converter={StaticResource HexToBrush}}"
                                Maximum="100"
                                Value="{Binding ViewModel.StrengthScore}" />
                            <StackPanel Orientation="Horizontal">
                                <TextBlock
                                    FontSize="12"
                                    Opacity="0.6"
                                    Text="Strength: " />
                                <TextBlock
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    Foreground="{Binding ViewModel.StrengthColor, Converter={StaticResource HexToBrush}}"
                                    Text="{Binding ViewModel.StrengthLabel}" />
                                <TextBlock
                                    FontSize="12"
                                    Opacity="0.4"
                                    Text="  |  " />
                                <TextBlock
                                    FontSize="12"
                                    Opacity="0.6"
                                    Text="{Binding ViewModel.PasswordLength, StringFormat='{}{0} characters'}" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal">
                            <ui:Button
                                Margin="0,0,8,0"
                                Padding="16,8"
                                Appearance="Primary"
                                Command="{Binding ViewModel.GenerateNewPasswordCommand}"
                                Content="Regenerate"
                                Icon="{ui:SymbolIcon Symbol=ArrowSync24}" />
                            <ui:Button
                                Padding="16,8"
                                Appearance="Secondary"
                                Command="{Binding ViewModel.CopyPasswordCommand}"
                                Content="Copy"
                                Icon="{ui:SymbolIcon Symbol=Copy24}" />
                        </StackPanel>
                    </StackPanel>
                </ui:Card>

                <!--  ══ Options ═════════════════════════════════════════════════  -->
                <TextBlock
                    Margin="0,0,0,12"
                    FontSize="11"
                    FontWeight="SemiBold"
                    Opacity="0.45"
                    Text="OPTIONS" />
                <ui:Card Margin="0,0,0,24" Padding="20">
                    <StackPanel>
                        <!--  Length slider  -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="52" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock
                                    Margin="0,0,0,8"
                                    FontWeight="Medium"
                                    Text="Length" />
                                <Slider
                                    IsSnapToTickEnabled="True"
                                    Maximum="64"
                                    Minimum="8"
                                    TickFrequency="1"
                                    Value="{Binding ViewModel.PasswordLength, Mode=TwoWay}" />
                            </StackPanel>
                            <Border
                                Grid.Column="1"
                                Margin="12,0,0,0"
                                Padding="6,4"
                                VerticalAlignment="Bottom"
                                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                CornerRadius="6">
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    FontWeight="SemiBold"
                                    Text="{Binding ViewModel.PasswordLength}" />
                            </Border>
                        </Grid>
                        <Separator Margin="0,0,0,16" />
                        <!--  Character sets  -->
                        <UniformGrid Columns="2" Rows="3">
                            <CheckBox
                                Margin="0,0,0,10"
                                Content="Uppercase (A-Z)"
                                IsChecked="{Binding ViewModel.IncludeUppercase, Mode=TwoWay}" />
                            <CheckBox
                                Margin="0,0,0,10"
                                Content="Lowercase (a-z)"
                                IsChecked="{Binding ViewModel.IncludeLowercase, Mode=TwoWay}" />
                            <CheckBox
                                Margin="0,0,0,10"
                                Content="Numbers (0-9)"
                                IsChecked="{Binding ViewModel.IncludeNumbers, Mode=TwoWay}" />
                            <CheckBox
                                Margin="0,0,0,10"
                                Content="Symbols (!@#...)"
                                IsChecked="{Binding ViewModel.IncludeSymbols, Mode=TwoWay}" />
                            <CheckBox Content="Exclude Ambiguous (0,O,l,1)" IsChecked="{Binding ViewModel.ExcludeAmbiguous, Mode=TwoWay}" />
                        </UniformGrid>
                    </StackPanel>
                </ui:Card>

                <!--  ══ Recent passwords ════════════════════════════════════════  -->
                <TextBlock
                    Margin="0,0,0,12"
                    FontSize="11"
                    FontWeight="SemiBold"
                    Opacity="0.45"
                    Text="RECENT PASSWORDS" />
                <ui:Card Padding="20">
                    <ItemsControl ItemsSource="{Binding ViewModel.History}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        Grid.Column="0"
                                        VerticalAlignment="Center"
                                        FontFamily="Consolas"
                                        FontSize="13"
                                        Opacity="0.8"
                                        Text="{Binding}"
                                        TextTrimming="CharacterEllipsis" />
                                    <ui:Button
                                        Grid.Column="1"
                                        Padding="4"
                                        Appearance="Transparent"
                                        Command="{Binding DataContext.ViewModel.UsePasswordCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                        CommandParameter="{Binding}"
                                        Icon="{ui:SymbolIcon Symbol=Copy24}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ui:Card>

            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
