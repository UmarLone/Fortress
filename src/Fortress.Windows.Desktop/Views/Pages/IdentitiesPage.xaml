<Page
    x:Class="Fortress.Windows.Desktop.Views.Pages.IdentitiesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="clr-namespace:Fortress.Windows.Desktop.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:local="clr-namespace:Fortress.Windows.Desktop.Views.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Identities"
    Margin="30"
    d:DataContext="{d:DesignInstance local:IdentitiesPage,
                                     IsDesignTimeCreatable=False}"
    d:DesignHeight="800"
    d:DesignWidth="1100"
    ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
    ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    mc:Ignorable="d">

    <Page.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
        <conv:InverseBoolToVisibilityConverter x:Key="InvBoolToVis" />
        <conv:LabelToAccentColorConverter x:Key="LabelColor" />
        <conv:StringToInitialsConverter x:Key="Initials" />
        <conv:NullOrEmptyToVisibilityConverter x:Key="NotEmptyToVis" />
    </Page.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition x:Name="DetailCol" Width="0" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0">
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock
                        FontSize="26"
                        FontWeight="SemiBold"
                        Text="Identities" />
                    <TextBlock
                        Margin="0,4,0,0"
                        FontSize="13"
                        Opacity="0.6"
                        Text="Personal &amp; work profiles" />
                </StackPanel>
                <ui:Button
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Appearance="Primary"
                    Command="{Binding ViewModel.OpenAddDrawerCommand}"
                    Content="Add Identity"
                    Icon="{ui:SymbolIcon Symbol=Add24}" />
            </Grid>

            <!--  ?? Hero banner ??  -->
            <Border Margin="0,0,0,24" Padding="28,22" ClipToBounds="True" CornerRadius="16">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Offset="0" Color="#451A03" />
                        <GradientStop Offset="0.55" Color="#B45309" />
                        <GradientStop Offset="1" Color="#F59E0B" />
                    </LinearGradientBrush>
                </Border.Background>
                <Border.Effect>
                    <DropShadowEffect BlurRadius="28" Opacity="0.28" ShadowDepth="0" Color="#B45309" />
                </Border.Effect>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="56" Height="56" Margin="0,0,20,0" CornerRadius="14">
                        <Border.Background><SolidColorBrush Color="#30FFFFFF" /></Border.Background>
                        <ui:SymbolIcon FontSize="28" Foreground="White" Symbol="Person24" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock FontSize="18" FontWeight="Bold" Foreground="White" Text="Personal &amp; Work Profiles" />
                        <TextBlock Margin="0,4,0,0" FontSize="13" Foreground="White" Opacity="0.78"
                                   Text="Store names, addresses, emails and phone numbers. Auto-fill forms in seconds." TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Border>

            <ui:AutoSuggestBox
                Margin="0,0,0,20"
                PlaceholderText="Search identities..."
                Text="{Binding ViewModel.SearchText, UpdateSourceTrigger=PropertyChanged}">
                <ui:AutoSuggestBox.Icon>
                    <ui:IconSourceElement>
                        <ui:SymbolIconSource Symbol="Search24" />
                    </ui:IconSourceElement>
                </ui:AutoSuggestBox.Icon>
            </ui:AutoSuggestBox>

            <ui:ProgressRing
                Width="48"
                Height="48"
                HorizontalAlignment="Center"
                IsIndeterminate="True"
                Visibility="{Binding ViewModel.IsLoading, Converter={StaticResource BoolToVis}}" />

            <ItemsControl ItemsSource="{Binding ViewModel.Items}" Visibility="{Binding ViewModel.IsLoading, Converter={StaticResource InvBoolToVis}}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <ui:Card
                            Width="300"
                            Margin="0,0,16,16"
                            Padding="20"
                            Cursor="Hand">
                            <ui:Card.InputBindings>
                                <MouseBinding
                                    Command="{Binding DataContext.ViewModel.SelectItemCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                    CommandParameter="{Binding}"
                                    MouseAction="LeftClick" />
                            </ui:Card.InputBindings>
                            <StackPanel>
                                <StackPanel Margin="0,0,0,12" Orientation="Horizontal">
                                    <Border
                                        Width="44"
                                        Height="44"
                                        Background="{Binding Label, Converter={StaticResource LabelColor}}"
                                        CornerRadius="22">
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontSize="16"
                                            FontWeight="SemiBold"
                                            Foreground="White"
                                            Text="{Binding Label, Converter={StaticResource Initials}}" />
                                    </Border>
                                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                        <TextBlock
                                            FontSize="15"
                                            FontWeight="SemiBold"
                                            Text="{Binding Label}" />
                                        <TextBlock FontSize="12" Opacity="0.6">
                                            <TextBlock.Text>
                                                <MultiBinding StringFormat="{}{0} {1}">
                                                    <Binding Path="FirstName" />
                                                    <Binding Path="LastName" />
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                    </StackPanel>
                                </StackPanel>
                                <Separator Margin="0,0,0,12" />
                                <StackPanel>
                                    <TextBlock
                                        FontSize="12"
                                        Opacity="0.7"
                                        Text="{Binding Email}" />
                                    <TextBlock
                                        Margin="0,4,0,0"
                                        FontSize="12"
                                        Opacity="0.7"
                                        Text="{Binding Phone}" />
                                    <TextBlock
                                        Margin="0,4,0,0"
                                        FontSize="12"
                                        Opacity="0.6">
                                        <TextBlock.Text>
                                            <MultiBinding StringFormat="{}{0}, {1}, {2}">
                                                <Binding Path="City" />
                                                <Binding Path="State" />
                                                <Binding Path="Country" />
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                </StackPanel>
                            </StackPanel>
                        </ui:Card>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <Border
            Grid.Column="1"
            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
            BorderThickness="1,0,0,0"
            Visibility="{Binding ViewModel.IsDetailOpen, Converter={StaticResource BoolToVis}}">
            <ScrollViewer Width="320" Margin="24,0,0,0">
                <StackPanel DataContext="{Binding ViewModel.SelectedItem}">
                    <TextBlock
                        Margin="0,0,0,20"
                        FontSize="20"
                        FontWeight="SemiBold"
                        Text="{Binding Label}" />
                    <!--  Fields  -->
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="11"
                        FontWeight="SemiBold"
                        Opacity="0.5"
                        Text="FULL NAME" />
                    <TextBlock Margin="0,0,0,12">
                        <TextBlock.Text>
                            <MultiBinding StringFormat="{}{0} {1}">
                                <Binding Path="FirstName" />
                                <Binding Path="LastName" />
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="11"
                        FontWeight="SemiBold"
                        Opacity="0.5"
                        Text="EMAIL" />
                    <TextBlock Margin="0,0,0,12" Text="{Binding Email}" />
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="11"
                        FontWeight="SemiBold"
                        Opacity="0.5"
                        Text="PHONE" />
                    <TextBlock Margin="0,0,0,12" Text="{Binding Phone}" />
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="11"
                        FontWeight="SemiBold"
                        Opacity="0.5"
                        Text="COMPANY" />
                    <TextBlock Margin="0,0,0,12" Text="{Binding Company}" />
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="11"
                        FontWeight="SemiBold"
                        Opacity="0.5"
                        Text="ADDRESS" />
                    <TextBlock Margin="0,0,0,4" Text="{Binding AddressLine1}" />
                    <TextBlock Margin="0,0,0,12">
                        <TextBlock.Text>
                            <MultiBinding StringFormat="{}{0}, {1} {2}, {3}">
                                <Binding Path="City" />
                                <Binding Path="State" />
                                <Binding Path="PostalCode" />
                                <Binding Path="Country" />
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                    <StackPanel Margin="0,12,0,0" Orientation="Horizontal">
                        <ui:Button
                            Margin="0,0,8,0"
                            Padding="16,8"
                            Appearance="Primary"
                            Command="{Binding DataContext.ViewModel.OpenEditDrawerCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                            CommandParameter="{Binding DataContext.ViewModel.SelectedItem, RelativeSource={RelativeSource AncestorType=Page}}"
                            Content="Edit"
                            Icon="{ui:SymbolIcon Symbol=Edit24}" />
                        <ui:Button
                            Padding="16,8"
                            Appearance="Danger"
                            Command="{Binding DataContext.ViewModel.DeleteAsyncCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                            CommandParameter="{Binding DataContext.ViewModel.SelectedItem, RelativeSource={RelativeSource AncestorType=Page}}"
                            Content="Delete"
                            Icon="{ui:SymbolIcon Symbol=Delete24}" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!--  DRAWER (add / edit)  -->
        <hc:Drawer
            Grid.Column="0"
            Grid.ColumnSpan="2"
            Dock="Right"
            IsOpen="{Binding ViewModel.IsDrawerOpen, Mode=TwoWay}"
            MaskCanClose="True"
            ShowMode="Cover">
            <Grid Width="440" Background="{DynamicResource ApplicationBackgroundBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!--  Header  -->
                <Border
                    Grid.Row="0"
                    Padding="24,20"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock FontSize="18" FontWeight="SemiBold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="Add Identity" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ViewModel.IsEditMode}" Value="True">
                                                <Setter Property="Text" Value="Edit Identity" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock
                                Margin="0,2,0,0"
                                FontSize="12"
                                Opacity="0.55"
                                Text="Fill in profile details below and press Save." />
                        </StackPanel>
                        <ui:Button
                            Grid.Column="1"
                            Appearance="Transparent"
                            Command="{Binding ViewModel.CloseDrawerCommand}"
                            Icon="{ui:SymbolIcon Symbol=Dismiss24}" />
                    </Grid>
                </Border>

                <!--  Form  -->
                <ScrollViewer
                    Grid.Row="1"
                    Padding="24,20"
                    VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Margin="0,0,0,4" FontSize="11" FontWeight="SemiBold" Opacity="0.45" Text="LABEL *" />
                        <ui:TextBox Margin="0,0,0,16" PlaceholderText="e.g. Personal, Work, Travel" Text="{Binding ViewModel.FormLabel, UpdateSourceTrigger=PropertyChanged}" />

                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Margin="0,0,0,4" FontSize="11" FontWeight="SemiBold" Opacity="0.45" Text="FIRST NAME *" />
                                <ui:TextBox PlaceholderText="First name" Text="{Binding ViewModel.FormFirstName, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Margin="0,0,0,4" FontSize="11" FontWeight="SemiBold" Opacity="0.45" Text="LAST NAME" />
                                <ui:TextBox PlaceholderText="Last name" Text="{Binding ViewModel.FormLastName, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Margin="0,0,0,4" FontSize="11" FontWeight="SemiBold" Opacity="0.45" Text="EMAIL" />
                        <ui:TextBox Margin="0,0,0,16" PlaceholderText="email@example.com" Text="{Binding ViewModel.FormEmail, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Margin="0,0,0,4" FontSize="11" FontWeight="SemiBold" Opacity="0.45" Text="PHONE" />
                        <ui:TextBox Margin="0,0,0,16" PlaceholderText="+1 555 1234" Text="{Binding ViewModel.FormPhone, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Margin="0,0,0,4" FontSize="11" FontWeight="SemiBold" Opacity="0.45" Text="COMPANY" />
                        <ui:TextBox Margin="0,0,0,16" PlaceholderText="Company / organization" Text="{Binding ViewModel.FormCompany, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Margin="0,0,0,4" FontSize="11" FontWeight="SemiBold" Opacity="0.45" Text="ADDRESS LINE 1" />
                        <ui:TextBox Margin="0,0,0,8" PlaceholderText="Street address" Text="{Binding ViewModel.FormAddressLine1, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Margin="0,0,0,4" FontSize="11" FontWeight="SemiBold" Opacity="0.45" Text="ADDRESS LINE 2" />
                        <ui:TextBox Margin="0,0,0,16" PlaceholderText="Apartment, suite, etc. (optional)" Text="{Binding ViewModel.FormAddressLine2, UpdateSourceTrigger=PropertyChanged}" />

                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Margin="0,0,0,4" FontSize="11" FontWeight="SemiBold" Opacity="0.45" Text="CITY" />
                                <ui:TextBox PlaceholderText="City" Text="{Binding ViewModel.FormCity, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Margin="0,0,0,4" FontSize="11" FontWeight="SemiBold" Opacity="0.45" Text="STATE" />
                                <ui:TextBox PlaceholderText="State" Text="{Binding ViewModel.FormState, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Margin="0,0,0,4" FontSize="11" FontWeight="SemiBold" Opacity="0.45" Text="COUNTRY" />
                                <ui:TextBox PlaceholderText="Country" Text="{Binding ViewModel.FormCountry, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Margin="0,0,0,4" FontSize="11" FontWeight="SemiBold" Opacity="0.45" Text="POSTAL CODE" />
                                <ui:TextBox PlaceholderText="ZIP / Postal" Text="{Binding ViewModel.FormPostalCode, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Margin="0,0,0,4" FontSize="11" FontWeight="SemiBold" Opacity="0.45" Text="NOTES" />
                        <ui:TextBox
                            Height="60"
                            Margin="0,0,0,8"
                            AcceptsReturn="True"
                            Text="{Binding ViewModel.FormNotes, UpdateSourceTrigger=PropertyChanged}"
                            TextWrapping="Wrap" />

                        <!--  Validation error — only visible when FormError is non-empty  -->
                        <Border
                            Margin="0,4,0,0"
                            Padding="12,10"
                            CornerRadius="8"
                            Visibility="{Binding ViewModel.FormError, Converter={StaticResource NotEmptyToVis}}">
                            <Border.Background>
                                <SolidColorBrush Color="#1FEF4444" />
                            </Border.Background>
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon
                                    Margin="0,0,8,0"
                                    FontSize="14"
                                    Foreground="#EF4444"
                                    Symbol="ErrorCircle24" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="12"
                                    Foreground="#EF4444"
                                    Text="{Binding ViewModel.FormError}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!--  Footer  -->
                <Border
                    Grid.Row="2"
                    Padding="24,16"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="0,1,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Visibility="{Binding ViewModel.IsSaving, Converter={StaticResource BoolToVis}}">
                            <ui:ProgressRing
                                Width="16"
                                Height="16"
                                Margin="0,0,8,0"
                                IsIndeterminate="True" />
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="12"
                                Opacity="0.6"
                                Text="Saving..." />
                        </StackPanel>
                        <StackPanel
                            Grid.Column="1"
                            HorizontalAlignment="Right"
                            Orientation="Horizontal">
                            <ui:Button
                                Margin="0,0,10,0"
                                Padding="20,10"
                                Appearance="Secondary"
                                Command="{Binding ViewModel.CloseDrawerCommand}"
                                Content="Cancel" />
                            <ui:Button
                                Padding="20,10"
                                Appearance="Primary"
                                Command="{Binding ViewModel.SaveAsyncCommand}"
                                Content="Save"
                                Icon="{ui:SymbolIcon Symbol=Save24}" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </hc:Drawer>
    </Grid>
</Page>
