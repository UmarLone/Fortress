<Page
x:Class="Fortress.Windows.Desktop.Views.Pages.SecureItemsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="clr-namespace:Fortress.Windows.Desktop.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:local="clr-namespace:Fortress.Windows.Desktop.Views.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Secure Items"
    d:DataContext="{d:DesignInstance local:SecureItemsPage, IsDesignTimeCreatable=False}"
    d:DesignHeight="800"
    d:DesignWidth="1300"
 ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
    ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    mc:Ignorable="d">

    <Page.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
        <conv:InverseBoolToVisibilityConverter x:Key="InvBoolToVis" />
        <conv:LabelToAccentColorConverter x:Key="LabelColor" />
 <conv:StringToInitialsConverter x:Key="Initials" />
   <conv:SecureItemTypeToLabelConverter x:Key="TypeLabel" />
        <conv:NullOrEmptyToVisibilityConverter x:Key="NotEmptyToVis" />
    </Page.Resources>

    <Grid>

        <!-- ══ LIST ══ -->
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
       <StackPanel Margin="30,24,30,40">

       <!-- Header -->
          <Grid Margin="0,0,0,20">
      <Grid.ColumnDefinitions>
       <ColumnDefinition Width="*" />
 <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock FontSize="26" FontWeight="SemiBold" Text="Secure Items" />
        <TextBlock Margin="0,4,0,0" FontSize="13" Opacity="0.6" Text="Documents, keys &amp; secrets" />
    </StackPanel>
 <ui:Button
   Grid.Column="1"
                VerticalAlignment="Center"
          Appearance="Primary"
    Command="{Binding ViewModel.OpenAddDrawerCommand}"
            Content="Add Item"
            Icon="{ui:SymbolIcon Symbol=Add24}" />
            </Grid>

                <!-- Hero banner -->
 <Border Margin="0,0,0,24" Padding="28,20" ClipToBounds="True" CornerRadius="14">
          <Border.Background>
<LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                 <GradientStop Offset="0" Color="#1A0533" />
    <GradientStop Offset="0.55" Color="#7C2D92" />
             <GradientStop Offset="1" Color="#EF4444" />
      </LinearGradientBrush>
         </Border.Background>
       <Border.Effect>
         <DropShadowEffect BlurRadius="28" Opacity="0.22" ShadowDepth="0" Color="#7C2D92" />
           </Border.Effect>
            <Grid>
    <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
<ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border Width="52" Height="52" Margin="0,0,16,0" CornerRadius="13">
        <Border.Background>
 <SolidColorBrush Color="#30FFFFFF" />
      </Border.Background>
       <ui:SymbolIcon FontSize="26" Foreground="White" Symbol="ShieldLock24" />
     </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
    <TextBlock FontSize="17" FontWeight="Bold" Foreground="White" Text="Documents, Keys &amp; Secrets" />
      <TextBlock
      Margin="0,4,0,0"
       FontSize="12"
      Foreground="White"
   Opacity="0.78"
                Text="Encrypted storage for API keys, SSH keys, recovery codes, and private documents."
 TextWrapping="Wrap" />
       </StackPanel>
        </Grid>
       </Border>

        <!-- Filter chips -->
    <ScrollViewer Margin="0,0,0,14" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
           <ItemsControl ItemsSource="{Binding ViewModel.Filters}">
          <ItemsControl.ItemsPanel>
     <ItemsPanelTemplate>
  <StackPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
               </ItemsControl.ItemsPanel>
         <ItemsControl.ItemTemplate>
        <DataTemplate>
    <ui:Button
            Margin="0,0,8,0"
       Padding="14,6"
          Appearance="Secondary"
       Command="{Binding DataContext.ViewModel.SetFilterCommand, RelativeSource={RelativeSource AncestorType=Page}}"
  CommandParameter="{Binding}"
          Content="{Binding}" />
                 </DataTemplate>
            </ItemsControl.ItemTemplate>
           </ItemsControl>
      </ScrollViewer>

         <!-- Search -->
         <ui:AutoSuggestBox
          Margin="0,0,0,20"
      PlaceholderText="Search secure items..."
  Text="{Binding ViewModel.SearchText, UpdateSourceTrigger=PropertyChanged}">
            <ui:AutoSuggestBox.Icon>
         <ui:IconSourceElement>
        <ui:SymbolIconSource Symbol="Search24" />
   </ui:IconSourceElement>
            </ui:AutoSuggestBox.Icon>
      </ui:AutoSuggestBox>

    <!-- Loading -->
          <ui:ProgressRing
       Width="48"
        Height="48"
         HorizontalAlignment="Center"
      IsIndeterminate="True"
   Visibility="{Binding ViewModel.IsLoading, Converter={StaticResource BoolToVis}}" />

     <!-- Items grid -->
    <ItemsControl
   ItemsSource="{Binding ViewModel.Items}"
                 Visibility="{Binding ViewModel.IsLoading, Converter={StaticResource InvBoolToVis}}">
  <ItemsControl.ItemsPanel>
       <ItemsPanelTemplate>
      <WrapPanel Orientation="Horizontal" />
         </ItemsPanelTemplate>
     </ItemsControl.ItemsPanel>
  <ItemsControl.ItemTemplate>
    <DataTemplate>
          <ui:Card Width="260" Margin="0,0,16,16" Padding="20" Cursor="Hand">
             <StackPanel>
         <StackPanel Margin="0,0,0,12" Orientation="Horizontal">
     <Border
   Width="40"
   Height="40"
    Background="{Binding Label, Converter={StaticResource LabelColor}}"
      CornerRadius="10">
               <TextBlock
        Margin="2"
    HorizontalAlignment="Center"
    VerticalAlignment="Center"
 FontSize="9"
  Foreground="White"
  Text="{Binding ItemType, Converter={StaticResource TypeLabel}}"
        TextAlignment="Center"
          TextWrapping="Wrap" />
          </Border>
        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
    <TextBlock FontWeight="SemiBold" Text="{Binding Label}" />
               <TextBlock FontSize="12" Opacity="0.6" Text="{Binding ItemType, Converter={StaticResource TypeLabel}}" />
                 </StackPanel>
    </StackPanel>
              <Separator />
        <TextBlock
        MaxHeight="36"
    Margin="0,8,0,0"
         FontSize="12"
          Opacity="0.6"
            Text="{Binding Notes}"
       TextTrimming="CharacterEllipsis" />
     <StackPanel Margin="0,10,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
       <ui:Button
      Margin="0,0,4,0"
          Padding="8"
       Appearance="Secondary"
         Command="{Binding DataContext.ViewModel.OpenEditDrawerCommand, RelativeSource={RelativeSource AncestorType=Page}}"
 CommandParameter="{Binding}"
             Icon="{ui:SymbolIcon Symbol=Edit24}"
                 ToolTip="Edit" />
      <ui:Button
       Padding="8"
          Appearance="Danger"
   Command="{Binding DataContext.ViewModel.DeleteAsyncCommand, RelativeSource={RelativeSource AncestorType=Page}}"
 CommandParameter="{Binding}"
  Icon="{ui:SymbolIcon Symbol=Delete24}"
 ToolTip="Delete" />
              </StackPanel>
      </StackPanel>
    </ui:Card>
         </DataTemplate>
       </ItemsControl.ItemTemplate>
 </ItemsControl>

  </StackPanel>
        </ScrollViewer>

        <!-- ══ DRAWER — slides over the list from the right ══ -->
        <hc:Drawer
        Dock="Right"
 IsOpen="{Binding ViewModel.IsDrawerOpen, Mode=TwoWay}"
            MaskCanClose="True"
      ShowMode="Cover">
            <Grid Width="460" Background="{DynamicResource ApplicationBackgroundBrush}">
       <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
   <RowDefinition Height="*" />
       <RowDefinition Height="Auto" />
 </Grid.RowDefinitions>

          <!-- Drawer header -->
      <Border
           Grid.Row="0"
 Padding="24,20"
      BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
        BorderThickness="0,0,0,1">
    <Grid>
         <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="Auto" />
         </Grid.ColumnDefinitions>
           <StackPanel VerticalAlignment="Center">
             <TextBlock FontSize="18" FontWeight="SemiBold">
   <TextBlock.Style>
     <Style TargetType="TextBlock">
                    <Setter Property="Text" Value="Add Secure Item" />
         <Style.Triggers>
              <DataTrigger Binding="{Binding ViewModel.IsEditMode}" Value="True">
   <Setter Property="Text" Value="Edit Secure Item" />
  </DataTrigger>
    </Style.Triggers>
              </Style>
          </TextBlock.Style>
                   </TextBlock>
     <TextBlock
        Margin="0,2,0,0"
       FontSize="12"
           Opacity="0.55"
        Text="Fill in the item details below and press Save." />
</StackPanel>
             <ui:Button
           Grid.Column="1"
             Appearance="Transparent"
    Command="{Binding ViewModel.CloseDrawerCommand}"
  Icon="{ui:SymbolIcon Symbol=Dismiss24}" />
         </Grid>
        </Border>

  <!-- Form -->
 <ScrollViewer Grid.Row="1" Padding="24,20" VerticalScrollBarVisibility="Auto">
   <StackPanel>
         <TextBlock Margin="0,0,0,4" FontSize="11" FontWeight="SemiBold" Opacity="0.45" Text="LABEL *" />
    <ui:TextBox
         Margin="0,0,0,16"
    PlaceholderText="e.g. My Passport"
 Text="{Binding ViewModel.FormLabel, UpdateSourceTrigger=PropertyChanged}" />

    <TextBlock Margin="0,0,0,4" FontSize="11" FontWeight="SemiBold" Opacity="0.45" Text="ITEM TYPE" />
       <ComboBox
       Margin="0,0,0,20"
         HorizontalAlignment="Stretch"
      ItemsSource="{Binding ViewModel.SecureItemTypes}"
        SelectedItem="{Binding ViewModel.FormItemType}" />

     <!-- Document fields -->
         <StackPanel>
      <StackPanel.Style>
         <Style TargetType="StackPanel">
             <Setter Property="Visibility" Value="Collapsed" />
       <Style.Triggers>
         <DataTrigger Binding="{Binding ViewModel.FormItemType}" Value="IdCard"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
      <DataTrigger Binding="{Binding ViewModel.FormItemType}" Value="Passport"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
           <DataTrigger Binding="{Binding ViewModel.FormItemType}" Value="DriversLicense"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
            <DataTrigger Binding="{Binding ViewModel.FormItemType}" Value="SocialSecurity"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
        <DataTrigger Binding="{Binding ViewModel.FormItemType}" Value="TaxNumber"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
     </Style.Triggers>
 </Style>
   </StackPanel.Style>
                <TextBlock Margin="0,0,0,4" FontSize="11" FontWeight="SemiBold" Opacity="0.45" Text="FULL NAME" />
          <ui:TextBox Margin="0,0,0,16" PlaceholderText="As on document" Text="{Binding ViewModel.FormFullName, UpdateSourceTrigger=PropertyChanged}" />
        <TextBlock Margin="0,0,0,4" FontSize="11" FontWeight="SemiBold" Opacity="0.45" Text="DOCUMENT NUMBER" />
   <ui:TextBox Margin="0,0,0,16" PlaceholderText="Number" Text="{Binding ViewModel.FormNumber, UpdateSourceTrigger=PropertyChanged}" />
     <Grid Margin="0,0,0,16">
      <Grid.ColumnDefinitions>
  <ColumnDefinition Width="*" />
   <ColumnDefinition Width="8" />
       <ColumnDefinition Width="*" />
   </Grid.ColumnDefinitions>
      <StackPanel Grid.Column="0">
    <TextBlock Margin="0,0,0,4" FontSize="11" FontWeight="SemiBold" Opacity="0.45" Text="ISSUED DATE" />
 <ui:TextBox PlaceholderText="YYYY-MM-DD" Text="{Binding ViewModel.FormIssuedDate, UpdateSourceTrigger=PropertyChanged}" />
</StackPanel>
            <StackPanel Grid.Column="2">
        <TextBlock Margin="0,0,0,4" FontSize="11" FontWeight="SemiBold" Opacity="0.45" Text="EXPIRY DATE" />
      <ui:TextBox PlaceholderText="YYYY-MM-DD" Text="{Binding ViewModel.FormExpiryDate, UpdateSourceTrigger=PropertyChanged}" />
       </StackPanel>
 </Grid>
   <TextBlock Margin="0,0,0,4" FontSize="11" FontWeight="SemiBold" Opacity="0.45" Text="ISSUING COUNTRY" />
     <ui:TextBox Margin="0,0,0,16" PlaceholderText="Country" Text="{Binding ViewModel.FormIssuingCountry, UpdateSourceTrigger=PropertyChanged}" />
     </StackPanel>

       <!-- Wi-Fi fields -->
  <StackPanel>
     <StackPanel.Style>
              <Style TargetType="StackPanel">
     <Setter Property="Visibility" Value="Collapsed" />
  <Style.Triggers>
      <DataTrigger Binding="{Binding ViewModel.FormItemType}" Value="WiFi"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                 </Style.Triggers>
      </Style>
            </StackPanel.Style>
           <TextBlock Margin="0,0,0,4" FontSize="11" FontWeight="SemiBold" Opacity="0.45" Text="NETWORK NAME (SSID)" />
                   <ui:TextBox Margin="0,0,0,16" PlaceholderText="MyWiFi" Text="{Binding ViewModel.FormSsid, UpdateSourceTrigger=PropertyChanged}" />
  <TextBlock Margin="0,0,0,4" FontSize="11" FontWeight="SemiBold" Opacity="0.45" Text="PASSWORD" />
            <ui:PasswordBox Margin="0,0,0,16" Password="{Binding ViewModel.FormWifiPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Wi-Fi password" />
    <TextBlock Margin="0,0,0,4" FontSize="11" FontWeight="SemiBold" Opacity="0.45" Text="SECURITY TYPE" />
         <ComboBox Margin="0,0,0,16" HorizontalAlignment="Stretch" SelectedItem="{Binding ViewModel.FormWifiSecurity}">
    <ComboBoxItem>WPA2</ComboBoxItem>
   <ComboBoxItem>WPA3</ComboBoxItem>
         <ComboBoxItem>WEP</ComboBoxItem>
      <ComboBoxItem>Open</ComboBoxItem>
          </ComboBox>
          </StackPanel>

       <!-- SSH fields -->
   <StackPanel>
 <StackPanel.Style>
         <Style TargetType="StackPanel">
     <Setter Property="Visibility" Value="Collapsed" />
        <Style.Triggers>
<DataTrigger Binding="{Binding ViewModel.FormItemType}" Value="Ssh"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
           </Style.Triggers>
       </Style>
    </StackPanel.Style>
   <TextBlock Margin="0,0,0,4" FontSize="11" FontWeight="SemiBold" Opacity="0.45" Text="HOST" />
<ui:TextBox Margin="0,0,0,16" PlaceholderText="192.168.1.1 or hostname" Text="{Binding ViewModel.FormHost, UpdateSourceTrigger=PropertyChanged}" />
           <Grid Margin="0,0,0,16">
              <Grid.ColumnDefinitions>
  <ColumnDefinition Width="*" />
        <ColumnDefinition Width="8" />
           <ColumnDefinition Width="80" />
          </Grid.ColumnDefinitions>
  <StackPanel Grid.Column="0">
   <TextBlock Margin="0,0,0,4" FontSize="11" FontWeight="SemiBold" Opacity="0.45" Text="USERNAME" />
                  <ui:TextBox PlaceholderText="root" Text="{Binding ViewModel.FormSshUsername, UpdateSourceTrigger=PropertyChanged}" />
 </StackPanel>
       <StackPanel Grid.Column="2">
        <TextBlock Margin="0,0,0,4" FontSize="11" FontWeight="SemiBold" Opacity="0.45" Text="PORT" />
     <ui:TextBox PlaceholderText="22" Text="{Binding ViewModel.FormPort, UpdateSourceTrigger=PropertyChanged}" />
          </StackPanel>
       </Grid>
              <TextBlock Margin="0,0,0,4" FontSize="11" FontWeight="SemiBold" Opacity="0.45" Text="PASSWORD / PASSPHRASE" />
        <ui:PasswordBox Margin="0,0,0,16" Password="{Binding ViewModel.FormSshPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="SSH password" />
          </StackPanel>

         <!-- Secure Note -->
   <StackPanel>
           <StackPanel.Style>
    <Style TargetType="StackPanel">
         <Setter Property="Visibility" Value="Collapsed" />
 <Style.Triggers>
    <DataTrigger Binding="{Binding ViewModel.FormItemType}" Value="SecureNote"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
            </Style.Triggers>
    </Style>
</StackPanel.Style>
  <TextBlock Margin="0,0,0,4" FontSize="11" FontWeight="SemiBold" Opacity="0.45" Text="NOTE CONTENT" />
          <ui:TextBox
Height="120"
     Margin="0,0,0,16"
           AcceptsReturn="True"
      Text="{Binding ViewModel.FormNoteContent, UpdateSourceTrigger=PropertyChanged}"
             TextWrapping="Wrap" />
               </StackPanel>

    <!-- Notes -->
      <TextBlock Margin="0,0,0,4" FontSize="11" FontWeight="SemiBold" Opacity="0.45" Text="NOTES" />
   <ui:TextBox
         Height="60"
    Margin="0,0,0,8"
  AcceptsReturn="True"
           Text="{Binding ViewModel.FormNotes, UpdateSourceTrigger=PropertyChanged}"
        TextWrapping="Wrap" />

     <!-- Validation error -->
  <Border
    Margin="0,4,0,0"
              Padding="12,10"
                  CornerRadius="8"
      Visibility="{Binding ViewModel.FormError, Converter={StaticResource NotEmptyToVis}}">
          <Border.Background>
        <SolidColorBrush Color="#1FEF4444" />
                   </Border.Background>
        <StackPanel Orientation="Horizontal">
          <ui:SymbolIcon
              Margin="0,0,8,0"
              FontSize="14"
         Foreground="#EF4444"
      Symbol="ErrorCircle24" />
        <TextBlock
        VerticalAlignment="Center"
  FontSize="12"
     Foreground="#EF4444"
              Text="{Binding ViewModel.FormError}"
   TextWrapping="Wrap" />
   </StackPanel>
        </Border>
    </StackPanel>
  </ScrollViewer>

 <!-- Footer -->
     <Border
             Grid.Row="2"
      Padding="24,16"
        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
             BorderThickness="0,1,0,0">
    <Grid>
     <Grid.ColumnDefinitions>
       <ColumnDefinition Width="*" />
     <ColumnDefinition Width="Auto" />
   </Grid.ColumnDefinitions>
       <StackPanel
        Orientation="Horizontal"
        VerticalAlignment="Center"
       Visibility="{Binding ViewModel.IsSaving, Converter={StaticResource BoolToVis}}">
            <ui:ProgressRing Width="16" Height="16" Margin="0,0,8,0" IsIndeterminate="True" />
                 <TextBlock FontSize="12" Opacity="0.6" VerticalAlignment="Center" Text="Saving..." />
      </StackPanel>
         <StackPanel Grid.Column="1" HorizontalAlignment="Right" Orientation="Horizontal">
                    <ui:Button
       Margin="0,0,10,0"
        Padding="20,10"
     Appearance="Secondary"
                   Command="{Binding ViewModel.CloseDrawerCommand}"
         Content="Cancel" />
 <ui:Button
                 Padding="20,10"
   Appearance="Primary"
             Command="{Binding ViewModel.SaveAsyncCommand}"
          Content="Save"
   Icon="{ui:SymbolIcon Symbol=Save24}" />
        </StackPanel>
         </Grid>
          </Border>
         </Grid>
        </hc:Drawer>

  </Grid>
</Page>
