<Page
    x:Class="Fortress.Windows.Desktop.Views.Pages.CredentialsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="clr-namespace:Fortress.Windows.Desktop.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:local="clr-namespace:Fortress.Windows.Desktop.Views.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Logins"
    d:DataContext="{d:DesignInstance local:CredentialsPage,
                                     IsDesignTimeCreatable=False}"
    d:DesignHeight="800"
    d:DesignWidth="1300"
    ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
    ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    mc:Ignorable="d">

    <Page.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
        <conv:InverseBoolToVisibilityConverter x:Key="InvBoolToVis" />
        <conv:StrengthLevelToColorConverter x:Key="StrengthColor" />
        <conv:StrengthLevelToLabelConverter x:Key="StrengthLabel" />
        <conv:LabelToAccentColorConverter x:Key="LabelColor" />
        <conv:StringToInitialsConverter x:Key="Initials" />
        <conv:DateTimeToAgoConverter x:Key="TimeAgo" />
        <conv:LoginTypeToLabelConverter x:Key="LoginTypeLabel" />
        <conv:PasswordMaskConverter x:Key="PwMask" />
        <conv:HexColorToBrushConverter x:Key="HexToBrush" />
        <conv:NullOrEmptyToVisibilityConverter x:Key="NotEmptyToVis" />
    </Page.Resources>

    <!--  Root: list in full width, two drawers overlay from the right  -->
    <Grid>

        <!--  ══ LIST (full width) ══  -->
        <Grid Margin="30,24,30,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!--  Header  -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!--  Normal header (hidden in selection mode)  -->
                <StackPanel Visibility="{Binding ViewModel.IsSelectionMode, Converter={StaticResource InvBoolToVis}}">
                    <TextBlock
                        FontSize="26"
                        FontWeight="SemiBold"
                        Text="Logins" />
                    <TextBlock
                        Margin="0,4,0,0"
                        FontSize="13"
                        Opacity="0.6"
                        Text="{Binding ViewModel.TotalCount, StringFormat='{}{0} logins stored'}" />
                </StackPanel>

                <!--  Selection mode header  -->
                <StackPanel Visibility="{Binding ViewModel.IsSelectionMode, Converter={StaticResource BoolToVis}}">
                    <TextBlock
                        FontSize="20"
                        FontWeight="SemiBold"
                        Text="{Binding ViewModel.SelectedCount, StringFormat='{}{0} selected'}" />
                    <TextBlock
                        Margin="0,2,0,0"
                        FontSize="12"
                        Opacity="0.5"
                        Text="Tap items to select or deselect" />
                </StackPanel>

                <!--  Select All button (selection mode)  -->
                <ui:Button
                    Grid.Column="1"
                    Margin="0,0,8,0"
                    VerticalAlignment="Center"
                    Appearance="Secondary"
                    Command="{Binding ViewModel.SelectAllCommand}"
                    Content="{Binding ViewModel.SelectAllButtonText}"
                    Visibility="{Binding ViewModel.IsSelectionMode, Converter={StaticResource BoolToVis}}" />

                <!--  Cancel / Select toggle  -->
                <ui:Button
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    Appearance="Secondary"
                    Command="{Binding ViewModel.ExitSelectionModeCommand}"
                    Content="Cancel"
                    Icon="{ui:SymbolIcon Symbol=Dismiss24}"
                    Visibility="{Binding ViewModel.IsSelectionMode, Converter={StaticResource BoolToVis}}" />

                <!--  Normal buttons (hidden in selection mode)  -->
                <StackPanel
                    Grid.Column="1"
                    Grid.ColumnSpan="2"
                    Orientation="Horizontal"
                    Visibility="{Binding ViewModel.IsSelectionMode, Converter={StaticResource InvBoolToVis}}">
                    <ui:Button
                        Margin="0,0,8,0"
                        VerticalAlignment="Center"
                        Appearance="Secondary"
                        Command="{Binding ViewModel.EnterSelectionModeCommand}"
                        Content="Select"
                        Icon="{ui:SymbolIcon Symbol=CheckboxChecked24}" />
                    <ui:Button
                        VerticalAlignment="Center"
                        Appearance="Primary"
                        Command="{Binding ViewModel.OpenAddDrawerCommand}"
                        Content="Add New"
                        Icon="{ui:SymbolIcon Symbol=Add24}" />
                </StackPanel>
            </Grid>

            <!--  Hero banner  -->
            <Border
                Grid.Row="1"
                Margin="0,0,0,20"
                Padding="28,20"
                ClipToBounds="True"
                CornerRadius="14">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Offset="0" Color="#1E3A8A" />
                        <GradientStop Offset="0.55" Color="#2563EB" />
                        <GradientStop Offset="1" Color="#0EA5E9" />
                    </LinearGradientBrush>
                </Border.Background>
                <Border.Effect>
                    <DropShadowEffect
                        BlurRadius="28"
                        Opacity="0.22"
                        ShadowDepth="0"
                        Color="#2563EB" />
                </Border.Effect>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border
                        Width="52"
                        Height="52"
                        Margin="0,0,16,0"
                        CornerRadius="13">
                        <Border.Background>
                            <SolidColorBrush Color="#30FFFFFF" />
                        </Border.Background>
                        <ui:SymbolIcon
                            FontSize="26"
                            Foreground="White"
                            Symbol="Key24" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock
                            FontSize="17"
                            FontWeight="Bold"
                            Foreground="White"
                            Text="Password Vault" />
                        <TextBlock
                            Margin="0,4,0,0"
                            FontSize="12"
                            Foreground="White"
                            Opacity="0.78"
                            Text="All credentials are encrypted with AES-256. Passwords are never stored in plain text."
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Border>

            <!--  Search  -->
            <ui:AutoSuggestBox
                Grid.Row="2"
                Margin="0,0,0,10"
                PlaceholderText="Search logins..."
                Text="{Binding ViewModel.SearchText, UpdateSourceTrigger=PropertyChanged}">
                <ui:AutoSuggestBox.Icon>
                    <ui:IconSourceElement>
                        <ui:SymbolIconSource Symbol="Search24" />
                    </ui:IconSourceElement>
                </ui:AutoSuggestBox.Icon>
            </ui:AutoSuggestBox>

            <!--  Filter chips  -->
            <ScrollViewer
                Grid.Row="3"
                Margin="0,0,0,14"
                HorizontalScrollBarVisibility="Auto"
                VerticalScrollBarVisibility="Hidden">
                <ItemsControl ItemsSource="{Binding ViewModel.FilterChips}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border
                                Margin="0,0,8,0"
                                Padding="14,6"
                                Background="{Binding ChipBackground}"
                                BorderBrush="{Binding ChipBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="20"
                                Cursor="Hand">
                                <Border.InputBindings>
                                    <MouseBinding
                                        Command="{Binding DataContext.ViewModel.SelectChipCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                        CommandParameter="{Binding}"
                                        MouseAction="LeftClick" />
                                </Border.InputBindings>
                                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                    <Ellipse
                                        Width="7"
                                        Height="7"
                                        Margin="0,0,6,0"
                                        VerticalAlignment="Center"
                                        Fill="{Binding DotBrush}"
                                        Visibility="{Binding HasGroupColor, Converter={StaticResource BoolToVis}}" />
                                    <TextBlock
                                        FontSize="12"
                                        FontWeight="Medium"
                                        Foreground="{Binding ChipForeground}"
                                        Text="{Binding Label}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!--  Loading spinner  -->
            <ui:ProgressRing
                Grid.Row="4"
                Width="48"
                Height="48"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                IsIndeterminate="True"
                Visibility="{Binding ViewModel.IsLoading, Converter={StaticResource BoolToVis}}" />

            <!--  Empty state  -->
            <StackPanel
                Grid.Row="4"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding ViewModel.IsLoading}" Value="False" />
                                    <Condition Binding="{Binding ViewModel.Items.Count}" Value="0" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible" />
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <ui:SymbolIcon
                    HorizontalAlignment="Center"
                    FontSize="48"
                    Opacity="0.2"
                    Symbol="Key24" />
                <TextBlock
                    Margin="0,12,0,4"
                    HorizontalAlignment="Center"
                    FontSize="16"
                    FontWeight="SemiBold"
                    Opacity="0.5"
                    Text="No logins found" />
                <TextBlock
                    HorizontalAlignment="Center"
                    FontSize="13"
                    Opacity="0.4"
                    Text="Add a new login or adjust your search filter." />
            </StackPanel>

            <!--  Login list  -->
            <ListView
                Grid.Row="4"
                Background="Transparent"
                BorderThickness="0"
                ItemsSource="{Binding ViewModel.Items}"
                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                SelectedItem="{Binding ViewModel.SelectedItem, Mode=TwoWay}"
                VirtualizingPanel.IsVirtualizing="True"
                VirtualizingPanel.ScrollUnit="Item"
                VirtualizingPanel.VirtualizationMode="Recycling">
                <ListView.Style>
                    <Style TargetType="ListView">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ViewModel.IsLoading}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ListView.Style>
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0,0,0,4" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListViewItem">
                                    <ContentPresenter />
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border
                            Padding="14,11"
                            CornerRadius="10"
                            Cursor="Hand"
                            MouseLeftButtonUp="OnItemClicked">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
                                    <Setter Property="BorderThickness" Value="1" />
                                    <Setter Property="BorderBrush" Value="Transparent" />
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                                        </Trigger>
                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColorPrimaryBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Border.Effect>
                                <DropShadowEffect
                                    BlurRadius="8"
                                    Opacity="0.05"
                                    ShadowDepth="1" />
                            </Border.Effect>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="44" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="88" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!--  Checkbox (selection mode only)  -->
                                <CheckBox
                                    Grid.Column="0"
                                    Margin="0,0,10,0"
                                    VerticalAlignment="Center"
                                    IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                    Visibility="{Binding DataContext.ViewModel.IsSelectionMode, RelativeSource={RelativeSource AncestorType=Page}, Converter={StaticResource BoolToVis}}" />

                                <!--  Avatar  -->
                                <Grid
                                    Grid.Column="1"
                                    Width="38"
                                    Height="38">
                                    <Border
                                        Width="38"
                                        Height="38"
                                        Background="{Binding Label, Converter={StaticResource LabelColor}}"
                                        CornerRadius="10">
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontSize="13"
                                            FontWeight="Bold"
                                            Foreground="White"
                                            Text="{Binding Label, Converter={StaticResource Initials}}" />
                                    </Border>
                                    <Border
                                        x:Name="FaviconBorder"
                                        Width="38"
                                        Height="38"
                                        ClipToBounds="True"
                                        CornerRadius="10">
                                        <Image
                                            ImageFailed="OnFaviconFailed"
                                            RenderOptions.BitmapScalingMode="HighQuality"
                                            Source="{Binding FaviconUrl}"
                                            Stretch="UniformToFill" />
                                    </Border>
                                </Grid>

                                <!--  Label + username  -->
                                <StackPanel
                                    Grid.Column="2"
                                    Margin="12,0,0,0"
                                    VerticalAlignment="Center">
                                    <TextBlock
                                        FontSize="14"
                                        FontWeight="SemiBold"
                                        Text="{Binding Label}" />
                                    <StackPanel Margin="0,2,0,0" Orientation="Horizontal">
                                        <TextBlock
                                            MaxWidth="200"
                                            FontSize="12"
                                            Opacity="0.55"
                                            Text="{Binding Username}"
                                            TextTrimming="CharacterEllipsis" />
                                        <Border
                                            Margin="8,0,0,0"
                                            Padding="5,1"
                                            Background="{DynamicResource ControlFillColorDefaultBrush}"
                                            CornerRadius="4">
                                            <TextBlock
                                                FontSize="10"
                                                Opacity="0.65"
                                                Text="{Binding LoginType, Converter={StaticResource LoginTypeLabel}}" />
                                        </Border>
                                    </StackPanel>
                                </StackPanel>

                                <!--  Strength bar  -->
                                <StackPanel
                                    Grid.Column="3"
                                    Margin="8,0,8,0"
                                    VerticalAlignment="Center">
                                    <ProgressBar
                                        Height="4"
                                        Background="{DynamicResource ControlFillColorDefaultBrush}"
                                        Foreground="{Binding PasswordStrengthLevel, Converter={StaticResource StrengthColor}}"
                                        Maximum="100"
                                        Value="{Binding PasswordStrengthScore, Mode=OneWay}" />
                                    <TextBlock
                                        Margin="0,2,0,0"
                                        HorizontalAlignment="Center"
                                        FontSize="10"
                                        Opacity="0.55"
                                        Text="{Binding PasswordStrengthLevel, Converter={StaticResource StrengthLabel}}" />
                                </StackPanel>

                                <!--  Badges  -->
                                <StackPanel
                                    Grid.Column="4"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal">
                                    <ui:SymbolIcon
                                        Margin="0,0,6,0"
                                        FontSize="14"
                                        Foreground="#22C55E"
                                        Symbol="ShieldKeyhole24"
                                        Visibility="{Binding HasOtp, Converter={StaticResource BoolToVis}}" />
                                    <ui:SymbolIcon
                                        FontSize="14"
                                        Foreground="#F59E0B"
                                        Symbol="Star24"
                                        Visibility="{Binding IsFavorite, Converter={StaticResource BoolToVis}}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!--  ══ SELECTION ACTION BAR ══  -->
            <!--  Floats at the bottom when items are selected  -->
            <Border
                Grid.Row="4"
                VerticalAlignment="Bottom"
                HorizontalAlignment="Stretch"
                Margin="0,0,0,16"
                Padding="16,12"
                CornerRadius="12"
                Visibility="{Binding ViewModel.IsSelectionMode, Converter={StaticResource BoolToVis}}">
                <Border.Background>
                    <SolidColorBrush Color="{DynamicResource SystemAccentColor}" Opacity="0.12" />
                </Border.Background>
                <Border.Effect>
                    <DropShadowEffect
                        BlurRadius="16"
                        Opacity="0.15"
                        ShadowDepth="2" />
                </Border.Effect>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="13"
                        FontWeight="Medium"
                        Opacity="0.7">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="No items selected" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ViewModel.SelectedCount}" Value="1">
                                        <Setter Property="Text" Value="1 item selected" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="13"
                        FontWeight="Medium"
                        Opacity="0.7"
                        Text="{Binding ViewModel.SelectedCount, StringFormat='{}{0} items selected'}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ViewModel.SelectedCount}" Value="0">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ViewModel.SelectedCount}" Value="1">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <ui:Button
                        Grid.Column="1"
                        Padding="20,10"
                        Appearance="Danger"
                        Command="{Binding ViewModel.DeleteSelectedAsyncCommand}"
                        Icon="{ui:SymbolIcon Symbol=Delete24}">
                        <ui:Button.Content>
                            <TextBlock Text="{Binding ViewModel.SelectedCount, StringFormat='Delete {0}'}" />
                        </ui:Button.Content>
                        <ui:Button.Style>
                            <Style TargetType="ui:Button">
                                <Setter Property="IsEnabled" Value="True" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ViewModel.SelectedCount}" Value="0">
                                        <Setter Property="IsEnabled" Value="False" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ui:Button.Style>
                    </ui:Button>
                </Grid>
            </Border>
        </Grid>

        <!--  ══ DETAIL DRAWER — slides in from the right on item click ══  -->
        <hc:Drawer
            Dock="Right"
            IsOpen="{Binding ViewModel.IsDetailOpen, Mode=TwoWay}"
            MaskCanClose="True"
            ShowMode="Cover">
            <Grid Width="400" Background="{DynamicResource ApplicationBackgroundBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!--  Drawer header  -->
                <Border
                    Grid.Row="0"
                    Padding="24,20"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="18"
                            FontWeight="SemiBold"
                            Text="Login Details" />
                        <ui:Button
                            Grid.Column="1"
                            Appearance="Transparent"
                            Command="{Binding ViewModel.CloseDetailCommand}"
                            Icon="{ui:SymbolIcon Symbol=Dismiss24}" />
                    </Grid>
                </Border>

                <!--  Detail content  -->
                <ScrollViewer
                    Grid.Row="1"
                    Padding="24,20"
                    VerticalScrollBarVisibility="Auto">
                    <StackPanel DataContext="{Binding ViewModel.SelectedItem}">

                        <!--  Avatar + label  -->
                        <StackPanel Margin="0,0,0,24" HorizontalAlignment="Center">
                            <Grid
                                Width="80"
                                Height="80"
                                HorizontalAlignment="Center">
                                <Border
                                    Width="80"
                                    Height="80"
                                    Background="{Binding Label, Converter={StaticResource LabelColor}}"
                                    CornerRadius="20">
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontSize="30"
                                        FontWeight="Bold"
                                        Foreground="White"
                                        Text="{Binding Label, Converter={StaticResource Initials}}" />
                                </Border>
                                <Border
                                    Width="80"
                                    Height="80"
                                    ClipToBounds="True"
                                    CornerRadius="20">
                                    <Image
                                        ImageFailed="OnDetailFaviconFailed"
                                        RenderOptions.BitmapScalingMode="HighQuality"
                                        Source="{Binding FaviconUrl}"
                                        Stretch="UniformToFill" />
                                </Border>
                            </Grid>
                            <TextBlock
                                Margin="0,14,0,4"
                                HorizontalAlignment="Center"
                                FontSize="20"
                                FontWeight="SemiBold"
                                Text="{Binding Label}" />
                            <TextBlock
                                HorizontalAlignment="Center"
                                FontSize="12"
                                Opacity="0.5"
                                Text="{Binding Domain}" />
                        </StackPanel>

                        <!--  2FA badge  -->
                        <Border
                            Margin="0,0,0,20"
                            Padding="14,10"
                            CornerRadius="10"
                            Visibility="{Binding HasOtp, Converter={StaticResource BoolToVis}}">
                            <Border.Background>
                                <SolidColorBrush Color="#1422C55E" />
                            </Border.Background>
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon
                                    Margin="0,0,8,0"
                                    Foreground="#22C55E"
                                    Symbol="ShieldKeyhole24" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="12"
                                    FontWeight="Medium"
                                    Foreground="#22C55E"
                                    Text="Two-Factor Authentication Enabled" />
                            </StackPanel>
                        </Border>

                        <!--  USERNAME  -->
                        <TextBlock
                            Margin="0,0,0,4"
                            FontSize="11"
                            FontWeight="SemiBold"
                            Opacity="0.45"
                            Text="USERNAME" />
                        <Border
                            Margin="0,0,0,16"
                            Padding="14,11"
                            Background="{DynamicResource ControlFillColorDefaultBrush}"
                            CornerRadius="8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="13"
                                    Text="{Binding Username}"
                                    TextTrimming="CharacterEllipsis" />
                                <ui:Button
                                    Grid.Column="1"
                                    Padding="4"
                                    Appearance="Transparent"
                                    Command="{Binding DataContext.ViewModel.CopyUsernameCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                    Icon="{ui:SymbolIcon Symbol=Copy24}"
                                    ToolTip="Copy username" />
                            </Grid>
                        </Border>

                        <!--  PASSWORD  -->
                        <TextBlock
                            Margin="0,0,0,4"
                            FontSize="11"
                            FontWeight="SemiBold"
                            Opacity="0.45"
                            Text="PASSWORD" />
                        <Border
                            Margin="0,0,0,16"
                            Padding="14,11"
                            Background="{DynamicResource ControlFillColorDefaultBrush}"
                            CornerRadius="8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontFamily="Consolas"
                                    FontSize="13"
                                    Text="{Binding DisplayPassword}" />
                                <ui:Button
                                    Grid.Column="1"
                                    Padding="4"
                                    Appearance="Transparent"
                                    Command="{Binding TogglePasswordVisibilityCommand}"
                                    ToolTip="Toggle visibility">
                                    <ui:Button.Style>
                                        <Style TargetType="ui:Button">
                                            <Setter Property="Icon" Value="{ui:SymbolIcon Symbol=Eye24}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsPasswordVisible}" Value="True">
                                                    <Setter Property="Icon" Value="{ui:SymbolIcon Symbol=EyeOff24}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ui:Button.Style>
                                </ui:Button>
                                <ui:Button
                                    Grid.Column="2"
                                    Padding="4"
                                    Appearance="Transparent"
                                    Command="{Binding DataContext.ViewModel.CopyPasswordCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                    Icon="{ui:SymbolIcon Symbol=Copy24}"
                                    ToolTip="Copy password" />
                            </Grid>
                        </Border>

                        <!--  PASSWORD STRENGTH  -->
                        <TextBlock
                            Margin="0,0,0,4"
                            FontSize="11"
                            FontWeight="SemiBold"
                            Opacity="0.45"
                            Text="PASSWORD STRENGTH" />
                        <StackPanel Margin="0,0,0,20">
                            <ProgressBar
                                Height="6"
                                Margin="0,0,0,4"
                                Background="{DynamicResource ControlFillColorDefaultBrush}"
                                Foreground="{Binding PasswordStrengthLevel, Converter={StaticResource StrengthColor}}"
                                Maximum="100"
                                Value="{Binding PasswordStrengthScore, Mode=OneWay}" />
                            <TextBlock
                                FontSize="12"
                                FontWeight="SemiBold"
                                Foreground="{Binding PasswordStrengthLevel, Converter={StaticResource StrengthColor}}"
                                Text="{Binding PasswordStrengthLevel, Converter={StaticResource StrengthLabel}}" />
                        </StackPanel>

                        <!--  WEBSITE  -->
                        <TextBlock
                            Margin="0,0,0,4"
                            FontSize="11"
                            FontWeight="SemiBold"
                            Opacity="0.45"
                            Text="WEBSITE" />
                        <Border
                            Margin="0,0,0,16"
                            Padding="14,11"
                            Background="{DynamicResource ControlFillColorDefaultBrush}"
                            CornerRadius="8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="12"
                                    Opacity="0.75"
                                    Text="{Binding Url}"
                                    TextTrimming="CharacterEllipsis" />
                                <ui:Button
                                    Grid.Column="1"
                                    Padding="4"
                                    Appearance="Transparent"
                                    Command="{Binding DataContext.ViewModel.OpenUrlCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                    Icon="{ui:SymbolIcon Symbol=Open24}"
                                    ToolTip="Open in browser" />
                            </Grid>
                        </Border>

                        <!--  NOTES (only when non-empty)  -->
                        <TextBlock
                            Margin="0,0,0,4"
                            FontSize="11"
                            FontWeight="SemiBold"
                            Opacity="0.45"
                            Text="NOTES"
                            Visibility="{Binding Notes, Converter={StaticResource NotEmptyToVis}}" />
                        <Border
                            Margin="0,0,0,8"
                            Padding="14,11"
                            Background="{DynamicResource ControlFillColorDefaultBrush}"
                            CornerRadius="8"
                            Visibility="{Binding Notes, Converter={StaticResource NotEmptyToVis}}">
                            <TextBlock
                                FontSize="12"
                                Opacity="0.75"
                                Text="{Binding Notes}"
                                TextWrapping="Wrap" />
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!--  Footer actions  -->
                <Border
                    Grid.Row="2"
                    Padding="24,16"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="0,1,0,0">
                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                        <ui:Button
                            Margin="0,0,8,0"
                            Padding="20,10"
                            Appearance="Primary"
                            Command="{Binding ViewModel.OpenEditDrawerCommand}"
                            CommandParameter="{Binding ViewModel.SelectedItem}"
                            Content="Edit"
                            Icon="{ui:SymbolIcon Symbol=Edit24}" />
                        <ui:Button
                            Padding="20,10"
                            Appearance="Danger"
                            Command="{Binding ViewModel.DeleteAsyncCommand}"
                            CommandParameter="{Binding ViewModel.SelectedItem}"
                            Content="Delete"
                            Icon="{ui:SymbolIcon Symbol=Delete24}" />
                    </StackPanel>
                </Border>
            </Grid>
        </hc:Drawer>

        <!--  ══ ADD / EDIT DRAWER ══  -->
        <hc:Drawer
            Dock="Right"
            IsOpen="{Binding ViewModel.IsDrawerOpen, Mode=TwoWay}"
            MaskCanClose="True"
            ShowMode="Cover">
            <!--  ...existing drawer content unchanged...  -->

        </hc:Drawer>
    </Grid>
</Page>
