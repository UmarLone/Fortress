<Page
    x:Class="Fortress.Windows.Desktop.Views.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="clr-namespace:Fortress.Windows.Desktop.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helpers="clr-namespace:Fortress.Windows.Desktop.Helpers"
    xmlns:local="clr-namespace:Fortress.Windows.Desktop.Views.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Settings"
    Margin="30"
    d:DataContext="{d:DesignInstance local:SettingsPage,
                                     IsDesignTimeCreatable=False}"
    d:DesignHeight="900"
    d:DesignWidth="1100"
    ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
    ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    mc:Ignorable="d">

    <Page.Resources>
        <helpers:EnumToBooleanConverter x:Key="EnumToBooleanConverter" />
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
        <conv:InverseBoolToVisibilityConverter x:Key="InvBoolToVis" />
        <conv:NullOrEmptyToVisibilityConverter x:Key="NullToCollapsed" />
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,0,40">

            <!--  Page header  -->
            <TextBlock
                Margin="0,0,0,4"
                FontSize="26"
                FontWeight="SemiBold"
                Text="Settings" />
            <TextBlock
                Margin="0,0,0,28"
                FontSize="13"
                Opacity="0.6"
                Text="Manage your Fortress preferences" />

            <!--  Hero banner  -->
            <Border
                Margin="0,0,0,28"
                Padding="28,22"
                ClipToBounds="True"
                CornerRadius="16">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Offset="0" Color="#1E3A5F" />
                        <GradientStop Offset="0.55" Color="#3730A3" />
                        <GradientStop Offset="1" Color="#4F46E5" />
                    </LinearGradientBrush>
                </Border.Background>
                <Border.Effect>
                    <DropShadowEffect
                        BlurRadius="28"
                        Opacity="0.28"
                        ShadowDepth="0"
                        Color="#4F46E5" />
                </Border.Effect>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border
                        Width="56"
                        Height="56"
                        Margin="0,0,20,0"
                        Background="#30FFFFFF"
                        CornerRadius="14">
                        <ui:SymbolIcon
                            FontSize="28"
                            Foreground="White"
                            Symbol="Settings24" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock
                            FontSize="18"
                            FontWeight="Bold"
                            Foreground="White"
                            Text="Preferences" />
                        <TextBlock
                            Margin="0,4,0,0"
                            FontSize="13"
                            Foreground="White"
                            Opacity="0.78"
                            Text="Customise Fortress to your liking. Changes take effect immediately."
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Border>

            <!--  Status feedback  -->
            <Border
                Margin="0,0,0,16"
                Padding="14,10"
                CornerRadius="10"
                Visibility="{Binding ViewModel.StatusMessage, Converter={StaticResource NullToCollapsed}}">
                <Border.Background>
                    <SolidColorBrush Color="#1A22C55E" />
                </Border.Background>
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon
                        Margin="0,0,10,0"
                        FontSize="16"
                        Foreground="#22C55E"
                        Symbol="CheckmarkCircle24"
                        Visibility="{Binding ViewModel.IsStatusError, Converter={StaticResource InvBoolToVis}}" />
                    <ui:SymbolIcon
                        Margin="0,0,10,0"
                        FontSize="16"
                        Foreground="#EF4444"
                        Symbol="ErrorCircle24"
                        Visibility="{Binding ViewModel.IsStatusError, Converter={StaticResource BoolToVis}}" />
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="13"
                        Text="{Binding ViewModel.StatusMessage}" />
                </StackPanel>
            </Border>

            <!--  ══ APPEARANCE ══════════════════════════════════════════════════  -->
            <TextBlock
                Margin="0,0,0,10"
                FontSize="11"
                FontWeight="SemiBold"
                Opacity="0.45"
                Text="APPEARANCE" />
            <ui:Card Margin="0,0,0,24" Padding="20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock FontWeight="Medium" Text="Theme" />
                        <TextBlock
                            FontSize="12"
                            Opacity="0.6"
                            Text="Choose your preferred colour scheme" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <RadioButton
                            Margin="0,0,16,0"
                            Command="{Binding ViewModel.ChangeThemeCommand}"
                            CommandParameter="theme_light"
                            Content="Light"
                            GroupName="themeSelect"
                            IsChecked="{Binding ViewModel.CurrentTheme, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Light, Mode=OneWay}" />
                        <RadioButton
                            Command="{Binding ViewModel.ChangeThemeCommand}"
                            CommandParameter="theme_dark"
                            Content="Dark"
                            GroupName="themeSelect"
                            IsChecked="{Binding ViewModel.CurrentTheme, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Dark, Mode=OneWay}" />
                    </StackPanel>
                </Grid>
            </ui:Card>

            <!--  ══ SECURITY ═══════════════════════════════════════════════════  -->
            <TextBlock
                Margin="0,0,0,10"
                FontSize="11"
                FontWeight="SemiBold"
                Opacity="0.45"
                Text="SECURITY" />
            <ui:Card Margin="0,0,0,24" Padding="20">
                <StackPanel>

                    <!--  Auto-lock timeout  -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock FontWeight="Medium" Text="Auto-lock Timeout" />
                            <TextBlock
                                FontSize="12"
                                Opacity="0.6"
                                Text="Lock vault after a period of inactivity" />
                        </StackPanel>
                        <ComboBox
                            Grid.Column="1"
                            Width="160"
                            SelectedIndex="{Binding ViewModel.AutoLockIndex, Mode=TwoWay}">
                            <ComboBoxItem Content="Never" />
                            <ComboBoxItem Content="1 minute" />
                            <ComboBoxItem Content="5 minutes" />
                            <ComboBoxItem Content="15 minutes" />
                            <ComboBoxItem Content="30 minutes" />
                            <ComboBoxItem Content="1 hour" />
                        </ComboBox>
                    </Grid>
                    <Separator Margin="0,0,0,16" />

                    <!--  Lock on minimise  -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock FontWeight="Medium" Text="Lock on Minimise" />
                            <TextBlock
                                FontSize="12"
                                Opacity="0.6"
                                Text="Lock the vault when the app window is minimised" />
                        </StackPanel>
                        <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding ViewModel.LockOnMinimise, Mode=TwoWay}" />
                    </Grid>
                    <Separator Margin="0,0,0,16" />

                    <!--  PIN Unlock — clicking opens PinSetupDialog  -->
                    <Border
                      x:Name="PinRow"
                        Margin="0,0,0,16"
                       Padding="14,12"
               Background="{DynamicResource ControlFillColorSecondaryBrush}"
   BorderBrush="{Binding ViewModel.PinCardBorderBrush}"
              BorderThickness="{Binding ViewModel.PinCardBorderThickness}"
      CornerRadius="12"
            Cursor="Hand"
    MouseLeftButtonUp="OnPinRowClicked">
     <Grid>
   <Grid.ColumnDefinitions>
       <ColumnDefinition Width="Auto" />
   <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
         </Grid.ColumnDefinitions>
     <Border Width="38" Height="38" Margin="0,0,12,0" Background="#DBEAFE" CornerRadius="10">
          <ui:SymbolIcon FontSize="18" Foreground="#2563EB" Symbol="Password24" />
        </Border>
     <StackPanel Grid.Column="1" VerticalAlignment="Center">
     <TextBlock FontWeight="SemiBold" Text="PIN Unlock" />
  <TextBlock FontSize="12" Opacity="0.55" Text="Unlock vault with a 4–6 digit PIN instead of master password" />
      </StackPanel>
   <Border Grid.Column="2" Width="22" Height="22" Padding="3" VerticalAlignment="Center" BorderBrush="#CBD5E1" BorderThickness="2" CornerRadius="11">
    <Border Background="#4F46E5" CornerRadius="6" Visibility="{Binding ViewModel.PinEnabled, Converter={StaticResource BoolToVis}}" />
         </Border>
        </Grid>
         </Border>

      <Separator Margin="0,0,0,16" />

            <!--  Windows Hello — clicking toggles biometric  -->
          <StackPanel>
                <Border
     x:Name="HelloRow"
        Padding="14,12"
      Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{Binding ViewModel.BiometricCardBorderBrush}"
      BorderThickness="{Binding ViewModel.BiometricCardBorderThickness}"
      CornerRadius="12"
      Cursor="Hand"
        MouseLeftButtonUp="OnHelloRowClicked"
         Visibility="{Binding ViewModel.IsBiometricAvailable, Converter={StaticResource BoolToVis}}">
   <StackPanel>
               <Grid>
          <Grid.ColumnDefinitions>
       <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
          <Border Width="38" Height="38" Margin="0,0,12,0" Background="#F3E8FF" CornerRadius="10">
           <ui:SymbolIcon FontSize="18" Foreground="#7C3AED" Symbol="Fingerprint24" />
           </Border>
       <StackPanel Grid.Column="1" VerticalAlignment="Center">
        <TextBlock FontWeight="SemiBold" Text="Windows Hello" />
        <TextBlock FontSize="12" Opacity="0.55" Text="Use fingerprint, face or Windows PIN to unlock" />
  </StackPanel>
      <Border Grid.Column="2" Width="22" Height="22" Padding="3" VerticalAlignment="Center" BorderBrush="#CBD5E1" BorderThickness="2" CornerRadius="11">
         <Border Background="#7C3AED" CornerRadius="7" Visibility="{Binding ViewModel.BiometricEnabled, Converter={StaticResource BoolToVis}}" />
     </Border>
                </Grid>
     <!--  Busy spinner  -->
   <StackPanel Margin="0,10,0,0" HorizontalAlignment="Center" Orientation="Horizontal" Visibility="{Binding ViewModel.IsBiometricBusy, Converter={StaticResource BoolToVis}}">
         <ui:ProgressRing Width="16" Height="16" Margin="0,0,8,0" IsIndeterminate="True" />
        <TextBlock FontSize="12" Opacity="0.65" Text="Waiting for Windows Hello..." />
     </StackPanel>
           <!--  Status text  -->
     <TextBlock Margin="0,6,0,0" HorizontalAlignment="Center" FontSize="12" Foreground="#22C55E" Text="{Binding ViewModel.BiometricStatusText}" Visibility="{Binding ViewModel.BiometricStatusText, Converter={StaticResource NullToCollapsed}}" />
         </StackPanel>
         </Border>

     <!--  Not-available notice  -->
             <Border Padding="12,8" Background="#1AF59E0B" CornerRadius="8" Visibility="{Binding ViewModel.IsBiometricAvailable, Converter={StaticResource InvBoolToVis}}">
     <StackPanel Orientation="Horizontal">
    <ui:SymbolIcon Margin="0,0,8,0" FontSize="16" Foreground="#D97706" Symbol="Warning24" />
       <TextBlock FontSize="12" Opacity="0.8" Text="Windows Hello is not configured on this device." />
            </StackPanel>
            </Border>
     </StackPanel>

           </StackPanel>
            </ui:Card>

            <!--  ══ CLIPBOARD ════════════════════════════════════════════════════  -->
            <TextBlock
                Margin="0,0,0,10"
                FontSize="11"
                FontWeight="SemiBold"
                Opacity="0.45"
                Text="CLIPBOARD" />
            <ui:Card Margin="0,0,0,24" Padding="20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock FontWeight="Medium" Text="Clear Clipboard Automatically" />
                        <TextBlock
                            FontSize="12"
                            Opacity="0.6"
                            Text="Wipe clipboard 30 seconds after copying a password" />
                    </StackPanel>
                    <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding ViewModel.ClearClipboard, Mode=TwoWay}" />
                </Grid>
            </ui:Card>

            <!--  ══ ABOUT ════════════════════════════════════════════════════════  -->
            <TextBlock
                Margin="0,0,0,10"
                FontSize="11"
                FontWeight="SemiBold"
                Opacity="0.45"
                Text="ABOUT" />
            <ui:Card Padding="20">
                <StackPanel>
                    <StackPanel Margin="0,0,0,14" Orientation="Horizontal">
                        <Border
                            Width="44"
                            Height="44"
                            Margin="0,0,14,0"
                            CornerRadius="10">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Offset="0" Color="#1E40AF" />
                                    <GradientStop Offset="1" Color="#3B82F6" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <ui:SymbolIcon
                                FontSize="22"
                                Foreground="White"
                                Symbol="ShieldLock24" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock
                                FontSize="18"
                                FontWeight="Bold"
                                Text="Fortress" />
                            <TextBlock
                                FontSize="12"
                                Opacity="0.6"
                                Text="{Binding ViewModel.AppVersion}" />
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Opacity="0.7" Text="A secure, local-first password manager for Windows." />
                </StackPanel>
            </ui:Card>

        </StackPanel>
    </ScrollViewer>
</Page>
