<Page
    x:Class="Fortress.Windows.Desktop.Views.Pages.GroupsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="clr-namespace:Fortress.Windows.Desktop.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Fortress.Windows.Desktop.Views.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Groups"
    Margin="30"
    d:DataContext="{d:DesignInstance local:GroupsPage,
                                     IsDesignTimeCreatable=False}"
    d:DesignHeight="800"
    d:DesignWidth="1100"
    ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
    ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    mc:Ignorable="d">

    <Page.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
        <conv:InverseBoolToVisibilityConverter x:Key="InvBoolToVis" />
        <conv:HexColorToBrushConverter x:Key="HexToBrush" />
    </Page.Resources>

    <StackPanel>
        <!--  Header  -->
        <Grid Margin="0,0,0,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock
                    FontSize="26"
                    FontWeight="SemiBold"
                    Text="Groups" />
                <TextBlock
                    Margin="0,4,0,0"
                    FontSize="13"
                    Opacity="0.6"
                    Text="Organise your vault into groups" />
            </StackPanel>
            <ui:Button
                Grid.Column="1"
                VerticalAlignment="Center"
                Appearance="Primary"
                Content="New Group"
                Icon="{ui:SymbolIcon Symbol=FolderAdd24}" />
        </Grid>

        <!--  ?? Hero banner ??  -->
        <Border Margin="0,0,0,24" Padding="28,22" ClipToBounds="True" CornerRadius="16">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Offset="0" Color="#14532D" />
                    <GradientStop Offset="0.55" Color="#16A34A" />
                    <GradientStop Offset="1" Color="#0D9488" />
                </LinearGradientBrush>
            </Border.Background>
            <Border.Effect>
                <DropShadowEffect BlurRadius="28" Opacity="0.28" ShadowDepth="0" Color="#16A34A" />
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Width="56" Height="56" Margin="0,0,20,0" CornerRadius="14">
                    <Border.Background>
                        <SolidColorBrush Color="#30FFFFFF" />
                    </Border.Background>
                    <ui:SymbolIcon FontSize="28" Foreground="White" Symbol="Folder24" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock FontSize="18" FontWeight="Bold" Foreground="White" Text="Organise Your Vault" />
                    <TextBlock Margin="0,4,0,0" FontSize="13" Foreground="White" Opacity="0.78"
                               Text="Group credentials, cards and identities to find them faster. Filter your vault by group on any page." TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </Border>

        <!--  Loading  -->
        <ui:ProgressRing
            Width="48"
            Height="48"
            HorizontalAlignment="Center"
            IsIndeterminate="True"
            Visibility="{Binding ViewModel.IsLoading, Converter={StaticResource BoolToVis}}" />

        <!--  Groups grid  -->
        <ItemsControl ItemsSource="{Binding ViewModel.Items}" Visibility="{Binding ViewModel.IsLoading, Converter={StaticResource InvBoolToVis}}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <ui:Card
                        Width="220"
                        Margin="0,0,16,16"
                        Padding="20"
                        Cursor="Hand">
                        <StackPanel>
                            <!--  Colour dot + icon  -->
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border
                                    Width="44"
                                    Height="44"
                                    Background="{Binding Color, Converter={StaticResource HexToBrush}}"
                                    CornerRadius="12">
                                    <ui:SymbolIcon
                                        FontSize="22"
                                        Foreground="White"
                                        Symbol="Folder24" />
                                </Border>
                                <ui:Button
                                    Grid.Column="2"
                                    Padding="4"
                                    VerticalAlignment="Center"
                                    Appearance="Transparent"
                                    Icon="{ui:SymbolIcon Symbol=MoreHorizontal24}" />
                            </Grid>
                            <TextBlock
                                FontSize="16"
                                FontWeight="SemiBold"
                                Text="{Binding Name}" />
                            <StackPanel Margin="0,4,0,0" Orientation="Horizontal">
                                <Border
                                    Width="10"
                                    Height="10"
                                    Margin="0,0,6,0"
                                    Background="{Binding Color, Converter={StaticResource HexToBrush}}"
                                    CornerRadius="5" />
                                <TextBlock
                                    FontSize="12"
                                    Opacity="0.6"
                                    Text="View items ?" />
                            </StackPanel>
                        </StackPanel>
                    </ui:Card>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</Page>
