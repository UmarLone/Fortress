<Page
    x:Class="Fortress.Windows.Desktop.Views.Pages.NotificationsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="clr-namespace:Fortress.Windows.Desktop.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Fortress.Windows.Desktop.Views.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Notifications"
    Margin="30"
    d:DataContext="{d:DesignInstance local:NotificationsPage,
                                     IsDesignTimeCreatable=False}"
    d:DesignHeight="800"
    d:DesignWidth="1100"
    ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
    ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    mc:Ignorable="d">

    <Page.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
        <conv:InverseBoolToVisibilityConverter x:Key="InvBoolToVis" />
        <conv:NotificationTypeToColorConverter x:Key="NoteTypeColor" />
        <conv:DateTimeToAgoConverter x:Key="TimeAgo" />
    </Page.Resources>

    <StackPanel>
        <!--  Header  -->
        <Grid Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock
                    FontSize="26"
                    FontWeight="SemiBold"
                    Text="Notifications" />
                <TextBlock
                    Margin="0,4,0,0"
                    FontSize="13"
                    Opacity="0.6"
                    Text="{Binding ViewModel.UnreadCount, StringFormat='{}{0} unread'}" />
            </StackPanel>
            <ui:Button
                Grid.Column="1"
                VerticalAlignment="Center"
                Appearance="Secondary"
                Content="Mark All Read"
                Icon="{ui:SymbolIcon Symbol=CheckmarkCircle24}" />
        </Grid>

        <!--  ?? Hero banner ??  -->
        <Border Margin="0,0,0,24" Padding="28,22" ClipToBounds="True" CornerRadius="16">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Offset="0" Color="#0F172A" />
                    <GradientStop Offset="0.55" Color="#0369A1" />
                    <GradientStop Offset="1" Color="#0EA5E9" />
                </LinearGradientBrush>
            </Border.Background>
            <Border.Effect>
                <DropShadowEffect BlurRadius="28" Opacity="0.28" ShadowDepth="0" Color="#0369A1" />
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Width="56" Height="56" Margin="0,0,20,0" CornerRadius="14">
                    <Border.Background><SolidColorBrush Color="#30FFFFFF" /></Border.Background>
                    <ui:SymbolIcon FontSize="28" Foreground="White" Symbol="Alert24" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock FontSize="18" FontWeight="Bold" Foreground="White" Text="Breach Alerts &amp; Security Warnings" />
                    <TextBlock Margin="0,4,0,0" FontSize="13" Foreground="White" Opacity="0.78"
                               Text="Stay informed about credential breaches, weak passwords and vault health changes." TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </Border>

        <!--  Loading  -->
        <ui:ProgressRing
            Width="48"
            Height="48"
            HorizontalAlignment="Center"
            IsIndeterminate="True"
            Visibility="{Binding ViewModel.IsLoading, Converter={StaticResource BoolToVis}}" />

        <!--  Notifications list  -->
        <ItemsControl ItemsSource="{Binding ViewModel.Items}" Visibility="{Binding ViewModel.IsLoading, Converter={StaticResource InvBoolToVis}}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <ui:Card Margin="0,0,0,8" Padding="16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="6" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!--  Type colour bar  -->
                            <Border
                                Grid.Column="0"
                                Width="4"
                                Margin="0,0,14,0"
                                Background="{Binding Type, Converter={StaticResource NoteTypeColor}}"
                                CornerRadius="2" />

                            <!--  Content  -->
                            <StackPanel Grid.Column="1">
                                <StackPanel Margin="0,0,0,4" Orientation="Horizontal">
                                    <TextBlock
                                        FontSize="14"
                                        FontWeight="SemiBold"
                                        Text="{Binding Title}" />
                                    <!--  Unread dot  -->
                                    <Ellipse
                                        Width="8"
                                        Height="8"
                                        Margin="8,0,0,0"
                                        VerticalAlignment="Center"
                                        Fill="#3B82F6">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSeen}" Value="False">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                </StackPanel>
                                <TextBlock
                                    FontSize="13"
                                    Opacity="0.7"
                                    Text="{Binding Message}"
                                    TextWrapping="Wrap" />
                            </StackPanel>

                            <!--  Time  -->
                            <TextBlock
                                Grid.Column="2"
                                Margin="16,0,0,0"
                                VerticalAlignment="Top"
                                FontSize="11"
                                Opacity="0.5"
                                Text="{Binding CreationDateTime, Converter={StaticResource TimeAgo}}" />
                        </Grid>
                    </ui:Card>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</Page>
