<Page
    x:Class="Fortress.Windows.Desktop.Views.Pages.AuthenticatorsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="clr-namespace:Fortress.Windows.Desktop.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:local="clr-namespace:Fortress.Windows.Desktop.Views.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Authenticators"
    Margin="30"
    d:DataContext="{d:DesignInstance local:AuthenticatorsPage,
                                     IsDesignTimeCreatable=False}"
    d:DesignHeight="800"
    d:DesignWidth="1300"
    ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
    ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    mc:Ignorable="d">

    <Page.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
        <conv:InverseBoolToVisibilityConverter x:Key="InvBoolToVis" />
        <conv:LabelToAccentColorConverter x:Key="LabelColor" />
        <conv:StringToInitialsConverter x:Key="Initials" />
        <conv:NullOrEmptyToVisibilityConverter x:Key="NotEmptyToVis" />
    </Page.Resources>

    <!--
        Root Grid. The hc:Drawer overlays the list using ShowMode=Cover.
        The Drawer's own Content is the form panel; the list sits behind it.
    -->
    <Grid>

        <!--  LIST  -->
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,0,40">

                <!--  Header  -->
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock
                            FontSize="26"
                            FontWeight="SemiBold"
                            Text="Authenticators" />
                        <TextBlock
                            Margin="0,4,0,0"
                            FontSize="13"
                            Opacity="0.6"
                            Text="Time-based one-time passwords" />
                    </StackPanel>
                    <ui:Button
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Appearance="Primary"
                        Command="{Binding ViewModel.OpenAddDrawerCommand}"
                        Content="Add Account"
                        Icon="{ui:SymbolIcon Symbol=Add24}" />
                </Grid>

                <!--  Hero  -->
                <Border
                    Margin="0,0,0,24"
                    Padding="28,22"
                    ClipToBounds="True"
                    CornerRadius="16">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Offset="0" Color="#064E3B" />
                            <GradientStop Offset="0.55" Color="#059669" />
                            <GradientStop Offset="1" Color="#0D9488" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.Effect>
                        <DropShadowEffect
                            BlurRadius="28"
                            Opacity="0.28"
                            ShadowDepth="0"
                            Color="#059669" />
                    </Border.Effect>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border
                            Width="56"
                            Height="56"
                            Margin="0,0,20,0"
                            CornerRadius="14">
                            <Border.Background>
                                <SolidColorBrush Color="#30FFFFFF" />
                            </Border.Background>
                            <ui:SymbolIcon
                                FontSize="28"
                                Foreground="White"
                                Symbol="ShieldKeyhole24" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock
                                FontSize="18"
                                FontWeight="Bold"
                                Foreground="White"
                                Text="Two-Factor Authentication" />
                            <TextBlock
                                Margin="0,4,0,0"
                                FontSize="13"
                                Foreground="White"
                                Opacity="0.78"
                                Text="TOTP codes refresh every 30 seconds. Copy a code before it expires."
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!--  Search  -->
                <ui:AutoSuggestBox
                    Margin="0,0,0,20"
                    PlaceholderText="Search authenticators..."
                    Text="{Binding ViewModel.SearchText, UpdateSourceTrigger=PropertyChanged}">
                    <ui:AutoSuggestBox.Icon>
                        <ui:IconSourceElement>
                            <ui:SymbolIconSource Symbol="Search24" />
                        </ui:IconSourceElement>
                    </ui:AutoSuggestBox.Icon>
                </ui:AutoSuggestBox>

                <TextBlock
                    Margin="0,0,0,12"
                    FontSize="11"
                    FontWeight="SemiBold"
                    Opacity="0.45"
                    Text="YOUR ACCOUNTS" />

                <ui:ProgressRing
                    Width="48"
                    Height="48"
                    HorizontalAlignment="Center"
                    IsIndeterminate="True"
                    Visibility="{Binding ViewModel.IsLoading, Converter={StaticResource BoolToVis}}" />

                <!--  OTP cards  -->
                <ItemsControl ItemsSource="{Binding ViewModel.Items}" Visibility="{Binding ViewModel.IsLoading, Converter={StaticResource InvBoolToVis}}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border
                                Width="272"
                                Margin="0,0,16,16"
                                Padding="20"
                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                CornerRadius="14">
                                <Border.Effect>
                                    <DropShadowEffect
                                        BlurRadius="12"
                                        Opacity="0.07"
                                        ShadowDepth="2" />
                                </Border.Effect>
                                <StackPanel>
                                    <!--  Issuer row  -->
                                    <StackPanel Margin="0,0,0,16" Orientation="Horizontal">
                                        <Grid Width="42" Height="42">
                                            <Border
                                                Width="42"
                                                Height="42"
                                                Background="{Binding Issuer, Converter={StaticResource LabelColor}}"
                                                CornerRadius="10">
                                                <TextBlock
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    FontSize="14"
                                                    FontWeight="Bold"
                                                    Foreground="White"
                                                    Text="{Binding Issuer, Converter={StaticResource Initials}}" />
                                            </Border>
                                            <Border
                                                Width="42"
                                                Height="42"
                                                ClipToBounds="True"
                                                CornerRadius="10">
                                                <Image
                                                    ImageFailed="OnFaviconFailed"
                                                    RenderOptions.BitmapScalingMode="HighQuality"
                                                    Source="{Binding IconUrl}"
                                                    Stretch="UniformToFill" />
                                            </Border>
                                        </Grid>
                                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                            <TextBlock
                                                FontSize="15"
                                                FontWeight="SemiBold"
                                                Text="{Binding Issuer}" />
                                            <TextBlock
                                                MaxWidth="170"
                                                FontSize="12"
                                                Opacity="0.55"
                                                Text="{Binding Username}"
                                                TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </StackPanel>
                                    <!--  OTP code  -->
                                    <TextBlock
                                        Margin="0,0,0,8"
                                        HorizontalAlignment="Center"
                                        FontFamily="Consolas"
                                        FontSize="36"
                                        FontWeight="Bold"
                                        Text="{Binding CurrentCode}" />
                                    <!--  Countdown progress — custom template strips the
                                         percentage overlay that WPF-UI's default ProgressBar
                                         theme paints on top of the fill.  -->
                                    <ProgressBar
                                        Height="5"
                                        Margin="0,0,0,4"
                                        Background="{DynamicResource ControlFillColorDefaultBrush}"
                                        Foreground="#059669"
                                        Maximum="{Binding Period}"
                                        Value="{Binding SecondsRemaining, Mode=OneWay}">
                                        <ProgressBar.Template>
                                            <ControlTemplate TargetType="ProgressBar">
                                                <Border
                                                    Background="{TemplateBinding Background}"
                                                    CornerRadius="3"
                                                    SnapsToDevicePixels="True">
                                                    <Grid x:Name="PART_Track" ClipToBounds="True">
                                                        <Rectangle
                                                            x:Name="PART_Indicator"
                                                            HorizontalAlignment="Left"
                                                            Fill="{TemplateBinding Foreground}"
                                                            RadiusX="3"
                                                            RadiusY="3" />
                                                    </Grid>
                                                </Border>
                                            </ControlTemplate>
                                        </ProgressBar.Template>
                                    </ProgressBar>
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        FontSize="11"
                                        Opacity="0.5"
                                        Text="{Binding SecondsRemaining, StringFormat='{}{0}s remaining'}" />
                                    <!--  Actions  -->
                                    <Grid Margin="0,12,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ui:Button
                                            Grid.Column="0"
                                            HorizontalAlignment="Stretch"
                                            Command="{Binding DataContext.ViewModel.CopyCodeCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                            CommandParameter="{Binding}"
                                            Content="Copy Code"
                                            Icon="{ui:SymbolIcon Symbol=Copy24}" />
                                        <ui:Button
                                            Grid.Column="1"
                                            Margin="8,0,0,0"
                                            Padding="8"
                                            Appearance="Secondary"
                                            Command="{Binding DataContext.ViewModel.OpenEditDrawerCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                            CommandParameter="{Binding}"
                                            Icon="{ui:SymbolIcon Symbol=Edit24}"
                                            ToolTip="Edit" />
                                        <ui:Button
                                            Grid.Column="2"
                                            Margin="4,0,0,0"
                                            Padding="8"
                                            Appearance="Danger"
                                            Command="{Binding DataContext.ViewModel.DeleteAsyncCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                            CommandParameter="{Binding}"
                                            Icon="{ui:SymbolIcon Symbol=Delete24}"
                                            ToolTip="Delete" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <!--  DRAWER — slides over the list from the right  -->
        <hc:Drawer
            Dock="Right"
            IsOpen="{Binding ViewModel.IsDrawerOpen, Mode=TwoWay}"
            ShowMode="Cover"
            MaskCanClose="True">
            <!--  Drawer form panel  -->
            <Grid Width="420" Background="{DynamicResource ApplicationBackgroundBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!--  Header  -->
                <Border
                    Grid.Row="0"
                    Padding="24,20"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock FontSize="18" FontWeight="SemiBold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="Add Authenticator" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ViewModel.IsEditMode}" Value="True">
                                                <Setter Property="Text" Value="Edit Authenticator" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock
                                Margin="0,2,0,0"
                                FontSize="12"
                                Opacity="0.55"
                                Text="Configure your TOTP account below." />
                        </StackPanel>
                        <ui:Button
                            Grid.Column="1"
                            Appearance="Transparent"
                            Command="{Binding ViewModel.CloseDrawerCommand}"
                            Icon="{ui:SymbolIcon Symbol=Dismiss24}" />
                    </Grid>
                </Border>

                <!--  Form  -->
                <ScrollViewer
                    Grid.Row="1"
                    Padding="24,20"
                    VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock
                            Margin="0,0,0,4"
                            FontSize="11"
                            FontWeight="SemiBold"
                            Opacity="0.45"
                            Text="ISSUER *" />
                        <ui:TextBox
                            Margin="0,0,0,16"
                            PlaceholderText="e.g. Google, GitHub"
                            Text="{Binding ViewModel.FormIssuer, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock
                            Margin="0,0,0,4"
                            FontSize="11"
                            FontWeight="SemiBold"
                            Opacity="0.45"
                            Text="ACCOUNT / EMAIL" />
                        <ui:TextBox
                            Margin="0,0,0,16"
                            PlaceholderText="user@example.com"
                            Text="{Binding ViewModel.FormUsername, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock
                            Margin="0,0,0,4"
                            FontSize="11"
                            FontWeight="SemiBold"
                            Opacity="0.45"
                            Text="SECRET KEY *" />
                        <ui:PasswordBox
                            Margin="0,0,0,16"
                            Password="{Binding ViewModel.FormSecret, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            PlaceholderText="Base-32 TOTP secret" />

                        <TextBlock
                            Margin="0,0,0,4"
                            FontSize="11"
                            FontWeight="SemiBold"
                            Opacity="0.45"
                            Text="TYPE" />
                        <ComboBox
                            Margin="0,0,0,16"
                            HorizontalAlignment="Stretch"
                            ItemsSource="{Binding ViewModel.AuthenticatorTypes}"
                            SelectedItem="{Binding ViewModel.FormType}" />

                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock
                                    Margin="0,0,0,4"
                                    FontSize="11"
                                    FontWeight="SemiBold"
                                    Opacity="0.45"
                                    Text="PERIOD (s)" />
                                <ui:NumberBox
                                    Maximum="120"
                                    Minimum="15"
                                    Value="{Binding ViewModel.FormPeriod, Mode=TwoWay}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock
                                    Margin="0,0,0,4"
                                    FontSize="11"
                                    FontWeight="SemiBold"
                                    Opacity="0.45"
                                    Text="DIGITS" />
                                <ui:NumberBox
                                    Maximum="8"
                                    Minimum="6"
                                    Value="{Binding ViewModel.FormDigits, Mode=TwoWay}" />
                            </StackPanel>
                        </Grid>

                        <CheckBox
                            Margin="0,0,0,16"
                            Content="Mark as favourite"
                            IsChecked="{Binding ViewModel.FormIsFavorite}" />

                        <Border
                            Margin="0,4,0,0"
                            Padding="12,10"
                            CornerRadius="8"
                            Visibility="{Binding ViewModel.FormError, Converter={StaticResource NotEmptyToVis}}">
                            <Border.Background>
                                <SolidColorBrush Color="#1FEF4444" />
                            </Border.Background>
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon
                                    Margin="0,0,8,0"
                                    FontSize="14"
                                    Foreground="#EF4444"
                                    Symbol="ErrorCircle24" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="12"
                                    Foreground="#EF4444"
                                    Text="{Binding ViewModel.FormError}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!--  Footer  -->
                <Border
                    Grid.Row="2"
                    Padding="24,16"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="0,1,0,0">
                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                        <ui:Button
                            Margin="0,0,10,0"
                            Padding="20,10"
                            Appearance="Secondary"
                            Command="{Binding ViewModel.CloseDrawerCommand}"
                            Content="Cancel" />
                        <ui:Button
                            Padding="20,10"
                            Appearance="Primary"
                            Command="{Binding ViewModel.SaveAsyncCommand}"
                            Content="Save"
                            Icon="{ui:SymbolIcon Symbol=Save24}" />
                    </StackPanel>
                </Border>
            </Grid>
        </hc:Drawer>
    </Grid>
</Page>
