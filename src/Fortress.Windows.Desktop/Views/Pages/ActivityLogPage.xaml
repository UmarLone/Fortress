<Page
    x:Class="Fortress.Windows.Desktop.Views.Pages.ActivityLogPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="clr-namespace:Fortress.Windows.Desktop.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Fortress.Windows.Desktop.Views.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Activity Log"
    Margin="30"
    d:DataContext="{d:DesignInstance local:ActivityLogPage,
                                     IsDesignTimeCreatable=False}"
    d:DesignHeight="800"
    d:DesignWidth="1100"
    ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
    ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    mc:Ignorable="d">

    <Page.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
        <conv:InverseBoolToVisibilityConverter x:Key="InvBoolToVis" />
        <conv:EventTypeToLabelConverter x:Key="EventLabel" />
        <conv:EventTypeToColorConverter x:Key="EventColor" />
    </Page.Resources>

    <StackPanel>
        <!--  Header  -->
        <Grid Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock FontSize="26" FontWeight="SemiBold" Text="Activity Log" />
                <TextBlock Margin="0,4,0,0" FontSize="13" Opacity="0.6" Text="Recent vault activity" />
            </StackPanel>
            <ui:Button Grid.Column="1" VerticalAlignment="Center" Appearance="Secondary"
                       Content="Export" Icon="{ui:SymbolIcon Symbol=ArrowExportLtr24}" />
        </Grid>

        <!--  ?? Hero banner ??  -->
        <Border Margin="0,0,0,24" Padding="28,22" ClipToBounds="True" CornerRadius="16">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Offset="0" Color="#0F172A" />
                    <GradientStop Offset="0.55" Color="#1E40AF" />
                    <GradientStop Offset="1" Color="#3B82F6" />
                </LinearGradientBrush>
            </Border.Background>
            <Border.Effect>
                <DropShadowEffect BlurRadius="28" Opacity="0.28" ShadowDepth="0" Color="#1E40AF" />
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Width="56" Height="56" Margin="0,0,20,0" CornerRadius="14">
                    <Border.Background><SolidColorBrush Color="#30FFFFFF" /></Border.Background>
                    <ui:SymbolIcon FontSize="28" Foreground="White" Symbol="History24" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock FontSize="18" FontWeight="Bold" Foreground="White" Text="Vault Activity" />
                    <TextBlock Margin="0,4,0,0" FontSize="13" Foreground="White" Opacity="0.78"
                               Text="Every copy, view, edit and delete is logged locally so you can spot unusual access." TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </Border>

        <ui:AutoSuggestBox
            Margin="0,0,0,16"
            PlaceholderText="Search activity..."
            Text="{Binding ViewModel.SearchText, UpdateSourceTrigger=PropertyChanged}">
            <ui:AutoSuggestBox.Icon>
                <ui:IconSourceElement>
                    <ui:SymbolIconSource Symbol="Search24" />
                </ui:IconSourceElement>
            </ui:AutoSuggestBox.Icon>
        </ui:AutoSuggestBox>

        <ui:ProgressRing
            Width="48"
            Height="48"
            HorizontalAlignment="Center"
            IsIndeterminate="True"
            Visibility="{Binding ViewModel.IsLoading, Converter={StaticResource BoolToVis}}" />

        <ui:Card Padding="0" Visibility="{Binding ViewModel.IsLoading, Converter={StaticResource InvBoolToVis}}">
            <ItemsControl ItemsSource="{Binding ViewModel.Items}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="16,12,16,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="80" />
                            </Grid.ColumnDefinitions>

                            <!--  Event type colour bar  -->
                            <Border
                                Grid.Column="0"
                                Width="4"
                                Margin="0,0,14,0"
                                Background="{Binding EventType, Converter={StaticResource EventColor}}"
                                CornerRadius="2" />
                            <!--  Label + detail  -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock FontWeight="Medium" Text="{Binding CredentialLabel}" />
                                <TextBlock
                                    FontSize="12"
                                    Opacity="0.6"
                                    Text="{Binding Detail}" />
                            </StackPanel>
                            <!--  Event type  -->
                            <TextBlock
                                Grid.Column="2"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="12"
                                FontWeight="Medium"
                                Foreground="{Binding EventType, Converter={StaticResource EventColor}}"
                                Text="{Binding EventType, Converter={StaticResource EventLabel}}" />
                            <!--  Time  -->
                            <TextBlock
                                Grid.Column="3"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                FontSize="11"
                                Opacity="0.5"
                                Text="{Binding TimeAgo}" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ui:Card>
    </StackPanel>
</Page>
