<ui:FluentWindow
    x:Class="Fortress.Windows.Desktop.Views.Windows.OnboardingWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="clr-namespace:Fortress.Windows.Desktop.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:lottie="clr-namespace:LottieSharp.WPF;assembly=LottieSharp"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:Fortress.Windows.Desktop.ViewModels.Windows"
    Title="Fortress"
    Width="520"
    Height="700"
    d:DataContext="{d:DesignInstance vm:OnboardingViewModel}"
    ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
    ExtendsContentIntoTitleBar="True"
    ResizeMode="NoResize"
    WindowBackdropType="Mica"
    WindowCornerPreference="Round"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">

    <ui:FluentWindow.Resources>
        <conv:IntToStepVisibilityConverter x:Key="SlideToVis" />
        <conv:IntToStepOpacityConverter x:Key="SlideOpacity" />
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
        <conv:InverseBoolToVisibilityConverter x:Key="InvBoolToVis" />
    </ui:FluentWindow.Resources>

    <Grid>
        <ui:TitleBar Title="Fortress">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Assets/applogo.png" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <Grid Margin="0,32,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">

                <!--  Slide 0 — Welcome (logo image, no Lottie)  -->
                <StackPanel
                    Margin="40,32,40,0"
                    VerticalAlignment="Center"
                    Visibility="{Binding CurrentSlide, Converter={StaticResource SlideToVis}, ConverterParameter=0}">
                    <Border
                        Width="180"
                        Height="180"
                        Margin="0,0,0,28"
                        HorizontalAlignment="Center"
                        CornerRadius="90">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Offset="0" Color="#2B64A3" />
                                <GradientStop Offset="1" Color="#6D28D9" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <Border.Effect>
                            <DropShadowEffect
                                BlurRadius="32"
                                Opacity="0.35"
                                ShadowDepth="0"
                                Color="#2B64A3" />
                        </Border.Effect>
                        <ui:Image
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Source="/Assets/logowhite.png" />
                    </Border>
                    <TextBlock
                        Margin="0,0,0,8"
                        HorizontalAlignment="Center"
                        FontSize="11"
                        FontWeight="Bold"
                        Foreground="#6366F1"
                        Text="WELCOME" />
                    <TextBlock
                        Margin="0,0,0,10"
                        HorizontalAlignment="Center"
                        FontSize="30"
                        FontWeight="Bold"
                        Text="Meet Fortress" />
                    <TextBlock
                        MaxWidth="360"
                        HorizontalAlignment="Center"
                        FontSize="15"
                        LineHeight="22"
                        Opacity="0.7"
                        Text="Your personal security vault. Passwords, cards, identities and 2FA codes — all encrypted and yours alone."
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                    <WrapPanel Margin="0,20,0,0" HorizontalAlignment="Center">
                        <Border
                            Margin="4"
                            Padding="12,6"
                            Background="#1A6366F1"
                            CornerRadius="12">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon
                                    Margin="0,0,5,0"
                                    FontSize="13"
                                    Foreground="#6366F1"
                                    Symbol="LockClosed24" />
                                <TextBlock
                                    FontSize="12"
                                    Foreground="#6366F1"
                                    Text="AES-256 Encrypted" />
                            </StackPanel>
                        </Border>
                        <Border
                            Margin="4"
                            Padding="12,6"
                            Background="#1A16A34A"
                            CornerRadius="12">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon
                                    Margin="0,0,5,0"
                                    FontSize="13"
                                    Foreground="#16A34A"
                                    Symbol="Desktop24" />
                                <TextBlock
                                    FontSize="12"
                                    Foreground="#16A34A"
                                    Text="100% Offline-First" />
                            </StackPanel>
                        </Border>
                        <Border
                            Margin="4"
                            Padding="12,6"
                            Background="#1AD97706"
                            CornerRadius="12">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon
                                    Margin="0,0,5,0"
                                    FontSize="13"
                                    Foreground="#D97706"
                                    Symbol="Eye24" />
                                <TextBlock
                                    FontSize="12"
                                    Foreground="#D97706"
                                    Text="Zero-Knowledge" />
                            </StackPanel>
                        </Border>
                    </WrapPanel>
                </StackPanel>

                <!--  Slide 1 — Password Vault  -->
                <StackPanel
                    Margin="40,32,40,0"
                    VerticalAlignment="Center"
                    Visibility="{Binding CurrentSlide, Converter={StaticResource SlideToVis}, ConverterParameter=1}">
                    <Border
                        Width="180"
                        Height="180"
                        Margin="0,0,0,28"
                        HorizontalAlignment="Center"
                        Background="#EEF2FF"
                        CornerRadius="90">
                        <Border.Effect>
                            <DropShadowEffect
                                BlurRadius="28"
                                Opacity="0.18"
                                ShadowDepth="0"
                                Color="#6366F1" />
                        </Border.Effect>
                        <lottie:LottieAnimationView
                            x:Name="LottieVault"
                            Width="140"
                            Height="140"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            AutoPlay="True"
                            RepeatCount="-1" />
                    </Border>
                    <TextBlock
                        Margin="0,0,0,8"
                        HorizontalAlignment="Center"
                        FontSize="11"
                        FontWeight="Bold"
                        Foreground="#4F46E5"
                        Text="VAULT" />
                    <TextBlock
                        Margin="0,0,0,10"
                        HorizontalAlignment="Center"
                        FontSize="30"
                        FontWeight="Bold"
                        Text="Password Vault" />
                    <TextBlock
                        MaxWidth="360"
                        HorizontalAlignment="Center"
                        FontSize="15"
                        LineHeight="22"
                        Opacity="0.7"
                        Text="Store unlimited logins for websites, apps and desktop software. Organised, searchable, and always at hand."
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                    <WrapPanel Margin="0,20,0,0" HorizontalAlignment="Center">
                        <Border
                            Margin="4"
                            Padding="12,6"
                            Background="#1A4F46E5"
                            CornerRadius="12">
                            <TextBlock
                                FontSize="12"
                                Foreground="#4F46E5"
                                Text="Websites" />
                        </Border>
                        <Border
                            Margin="4"
                            Padding="12,6"
                            Background="#1A0E7490"
                            CornerRadius="12">
                            <TextBlock
                                FontSize="12"
                                Foreground="#0E7490"
                                Text="Desktop Apps" />
                        </Border>
                        <Border
                            Margin="4"
                            Padding="12,6"
                            Background="#1AB45309"
                            CornerRadius="12">
                            <TextBlock
                                FontSize="12"
                                Foreground="#B45309"
                                Text="Credit Cards" />
                        </Border>
                    </WrapPanel>
                </StackPanel>

                <!--  Slide 2 — Built-in 2FA  -->
                <StackPanel
                    Margin="40,32,40,0"
                    VerticalAlignment="Center"
                    Visibility="{Binding CurrentSlide, Converter={StaticResource SlideToVis}, ConverterParameter=2}">
                    <Border
                        Width="180"
                        Height="180"
                        Margin="0,0,0,28"
                        HorizontalAlignment="Center"
                        Background="#DCFCE7"
                        CornerRadius="90">
                        <Border.Effect>
                            <DropShadowEffect
                                BlurRadius="28"
                                Opacity="0.18"
                                ShadowDepth="0"
                                Color="#16A34A" />
                        </Border.Effect>
                        <lottie:LottieAnimationView
                            x:Name="LottieTotp"
                            Width="140"
                            Height="140"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            AutoPlay="True"
                            RepeatCount="-1" />
                    </Border>
                    <TextBlock
                        Margin="0,0,0,8"
                        HorizontalAlignment="Center"
                        FontSize="11"
                        FontWeight="Bold"
                        Foreground="#16A34A"
                        Text="2FA AUTHENTICATOR" />
                    <TextBlock
                        Margin="0,0,0,10"
                        HorizontalAlignment="Center"
                        FontSize="30"
                        FontWeight="Bold"
                        Text="Built-in 2FA Codes" />
                    <TextBlock
                        MaxWidth="360"
                        HorizontalAlignment="Center"
                        FontSize="15"
                        LineHeight="22"
                        Opacity="0.7"
                        Text="Generate TOTP codes with a live countdown. Scan a QR code once — Fortress handles the rest alongside your passwords."
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                    <StackPanel Margin="0,16,0,0" HorizontalAlignment="Center">
                        <StackPanel
                            Margin="0,0,0,8"
                            HorizontalAlignment="Center"
                            Orientation="Horizontal">
                            <ui:SymbolIcon
                                Margin="0,0,8,0"
                                FontSize="16"
                                Foreground="#16A34A"
                                Symbol="Checkmark24" />
                            <TextBlock
                                FontSize="13"
                                Opacity="0.7"
                                Text="30-second rotating codes" />
                        </StackPanel>
                        <StackPanel
                            Margin="0,0,0,8"
                            HorizontalAlignment="Center"
                            Orientation="Horizontal">
                            <ui:SymbolIcon
                                Margin="0,0,8,0"
                                FontSize="16"
                                Foreground="#16A34A"
                                Symbol="Checkmark24" />
                            <TextBlock
                                FontSize="13"
                                Opacity="0.7"
                                Text="QR code or manual entry" />
                        </StackPanel>
                        <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                            <ui:SymbolIcon
                                Margin="0,0,8,0"
                                FontSize="16"
                                Foreground="#16A34A"
                                Symbol="Checkmark24" />
                            <TextBlock
                                FontSize="13"
                                Opacity="0.7"
                                Text="Works offline, no internet needed" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!--  Slide 3 — Vault Health  -->
                <StackPanel
                    Margin="40,32,40,0"
                    VerticalAlignment="Center"
                    Visibility="{Binding CurrentSlide, Converter={StaticResource SlideToVis}, ConverterParameter=3}">
                    <Border
                        Width="180"
                        Height="180"
                        Margin="0,0,0,28"
                        HorizontalAlignment="Center"
                        Background="#CCFBF1"
                        CornerRadius="90">
                        <Border.Effect>
                            <DropShadowEffect
                                BlurRadius="28"
                                Opacity="0.18"
                                ShadowDepth="0"
                                Color="#14B8A6" />
                        </Border.Effect>
                        <lottie:LottieAnimationView
                            x:Name="LottieHealth"
                            Width="140"
                            Height="140"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            AutoPlay="True"
                            RepeatCount="-1" />
                    </Border>
                    <TextBlock
                        Margin="0,0,0,8"
                        HorizontalAlignment="Center"
                        FontSize="11"
                        FontWeight="Bold"
                        Foreground="#0F766E"
                        Text="AI-POWERED" />
                    <TextBlock
                        Margin="0,0,0,10"
                        HorizontalAlignment="Center"
                        FontSize="30"
                        FontWeight="Bold"
                        Text="Vault Health Score" />
                    <TextBlock
                        MaxWidth="360"
                        HorizontalAlignment="Center"
                        FontSize="15"
                        LineHeight="22"
                        Opacity="0.7"
                        Text="Fortress analyses every password, detects weak, reused or compromised ones, and gives you a real-time security score."
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                    <StackPanel Margin="0,16,0,0" HorizontalAlignment="Center">
                        <StackPanel
                            Margin="0,0,0,8"
                            HorizontalAlignment="Center"
                            Orientation="Horizontal">
                            <ui:SymbolIcon
                                Margin="0,0,8,0"
                                FontSize="16"
                                Foreground="#F59E0B"
                                Symbol="Warning24" />
                            <TextBlock
                                FontSize="13"
                                Opacity="0.7"
                                Text="Detects weak passwords" />
                        </StackPanel>
                        <StackPanel
                            Margin="0,0,0,8"
                            HorizontalAlignment="Center"
                            Orientation="Horizontal">
                            <ui:SymbolIcon
                                Margin="0,0,8,0"
                                FontSize="16"
                                Foreground="#EF4444"
                                Symbol="Copy24" />
                            <TextBlock
                                FontSize="13"
                                Opacity="0.7"
                                Text="Finds reused passwords" />
                        </StackPanel>
                        <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                            <ui:SymbolIcon
                                Margin="0,0,8,0"
                                FontSize="16"
                                Foreground="#14B8A6"
                                Symbol="ShieldCheckmark24" />
                            <TextBlock
                                FontSize="13"
                                Opacity="0.7"
                                Text="Live 0-100 health score" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!--  Slide 4 — PIN and Biometric  -->
                <StackPanel
                    Margin="40,32,40,0"
                    VerticalAlignment="Center"
                    Visibility="{Binding CurrentSlide, Converter={StaticResource SlideToVis}, ConverterParameter=4}">
                    <Border
                        Width="180"
                        Height="180"
                        Margin="0,0,0,28"
                        HorizontalAlignment="Center"
                        Background="#FCE7F3"
                        CornerRadius="90">
                        <Border.Effect>
                            <DropShadowEffect
                                BlurRadius="28"
                                Opacity="0.18"
                                ShadowDepth="0"
                                Color="#EC4899" />
                        </Border.Effect>
                        <lottie:LottieAnimationView
                            x:Name="LottieAuth"
                            Width="140"
                            Height="140"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            AutoPlay="True"
                            RepeatCount="-1" />
                    </Border>
                    <TextBlock
                        Margin="0,0,0,8"
                        HorizontalAlignment="Center"
                        FontSize="11"
                        FontWeight="Bold"
                        Foreground="#BE185D"
                        Text="APP SECURITY" />
                    <TextBlock
                        Margin="0,0,0,10"
                        HorizontalAlignment="Center"
                        FontSize="30"
                        FontWeight="Bold"
                        Text="PIN &amp; Biometric Lock" />
                    <TextBlock
                        MaxWidth="360"
                        HorizontalAlignment="Center"
                        FontSize="15"
                        LineHeight="22"
                        Opacity="0.7"
                        Text="Protect your vault with a 4-digit PIN or Windows Hello. Quick to unlock, impossible to bypass without your credentials."
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                    <StackPanel Margin="0,16,0,0" HorizontalAlignment="Center">
                        <StackPanel
                            Margin="0,0,0,8"
                            HorizontalAlignment="Center"
                            Orientation="Horizontal">
                            <ui:SymbolIcon
                                Margin="0,0,8,0"
                                FontSize="16"
                                Foreground="#BE185D"
                                Symbol="Fingerprint24" />
                            <TextBlock
                                FontSize="13"
                                Opacity="0.7"
                                Text="Windows Hello biometric unlock" />
                        </StackPanel>
                        <StackPanel
                            Margin="0,0,0,8"
                            HorizontalAlignment="Center"
                            Orientation="Horizontal">
                            <ui:SymbolIcon
                                Margin="0,0,8,0"
                                FontSize="16"
                                Foreground="#BE185D"
                                Symbol="Password24" />
                            <TextBlock
                                FontSize="13"
                                Opacity="0.7"
                                Text="4-digit PIN fallback" />
                        </StackPanel>
                        <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                            <ui:SymbolIcon
                                Margin="0,0,8,0"
                                FontSize="16"
                                Foreground="#BE185D"
                                Symbol="Prohibited24" />
                            <TextBlock
                                FontSize="13"
                                Opacity="0.7"
                                Text="Auto-lock after 5 wrong attempts" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!--  Slide 5 — Cloud Backup  -->
                <StackPanel
                    Margin="40,32,40,0"
                    VerticalAlignment="Center"
                    Visibility="{Binding CurrentSlide, Converter={StaticResource SlideToVis}, ConverterParameter=5}">
                    <Border
                        Width="180"
                        Height="180"
                        Margin="0,0,0,28"
                        HorizontalAlignment="Center"
                        Background="#CFFAFE"
                        CornerRadius="90">
                        <Border.Effect>
                            <DropShadowEffect
                                BlurRadius="28"
                                Opacity="0.18"
                                ShadowDepth="0"
                                Color="#06B6D4" />
                        </Border.Effect>
                        <lottie:LottieAnimationView
                            x:Name="LottieBackups"
                            Width="140"
                            Height="140"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            AutoPlay="True"
                            RepeatCount="-1" />
                    </Border>
                    <TextBlock
                        Margin="0,0,0,8"
                        HorizontalAlignment="Center"
                        FontSize="11"
                        FontWeight="Bold"
                        Foreground="#0E7490"
                        Text="CLOUD BACKUP" />
                    <TextBlock
                        Margin="0,0,0,10"
                        HorizontalAlignment="Center"
                        FontSize="30"
                        FontWeight="Bold"
                        Text="You're All Set!" />
                    <TextBlock
                        MaxWidth="360"
                        HorizontalAlignment="Center"
                        FontSize="15"
                        LineHeight="22"
                        Opacity="0.7"
                        Text="Optionally back up your encrypted vault to OneDrive or Google Drive. Your data is encrypted before upload — only you can decrypt it."
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                    <WrapPanel Margin="0,20,0,0" HorizontalAlignment="Center">
                        <Border
                            Margin="4"
                            Padding="12,6"
                            Background="#1A4F46E5"
                            CornerRadius="12">
                            <TextBlock
                                FontSize="12"
                                Foreground="#4F46E5"
                                Text="Passwords" />
                        </Border>
                        <Border
                            Margin="4"
                            Padding="12,6"
                            Background="#1A16A34A"
                            CornerRadius="12">
                            <TextBlock
                                FontSize="12"
                                Foreground="#16A34A"
                                Text="2FA Codes" />
                        </Border>
                        <Border
                            Margin="4"
                            Padding="12,6"
                            Background="#1A0F766E"
                            CornerRadius="12">
                            <TextBlock
                                FontSize="12"
                                Foreground="#0F766E"
                                Text="Health Score" />
                        </Border>
                        <Border
                            Margin="4"
                            Padding="12,6"
                            Background="#1ABE185D"
                            CornerRadius="12">
                            <TextBlock
                                FontSize="12"
                                Foreground="#BE185D"
                                Text="Biometric Lock" />
                        </Border>
                        <Border
                            Margin="4"
                            Padding="12,6"
                            Background="#1A0E7490"
                            CornerRadius="12">
                            <TextBlock
                                FontSize="12"
                                Foreground="#0E7490"
                                Text="Backups &amp; Sync" />
                        </Border>
                    </WrapPanel>
                </StackPanel>

            </Grid>

            <!--  ══ Bottom bar  ══  -->
            <Border
                Grid.Row="1"
                Padding="24,18,24,28"
                Background="{DynamicResource ApplicationBackgroundBrush}"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0">
                <StackPanel>
                    <StackPanel
                        Margin="0,0,0,18"
                        HorizontalAlignment="Center"
                        Orientation="Horizontal">
                        <Ellipse
                            Width="10"
                            Height="10"
                            Margin="5,0"
                            Opacity="{Binding CurrentSlide, Converter={StaticResource SlideOpacity}, ConverterParameter=0}">
                            <Ellipse.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#4F46E5" />
                                    <GradientStop Offset="1" Color="#7C3AED" />
                                </LinearGradientBrush>
                            </Ellipse.Fill>
                        </Ellipse>
                        <Ellipse
                            Width="10"
                            Height="10"
                            Margin="5,0"
                            Opacity="{Binding CurrentSlide, Converter={StaticResource SlideOpacity}, ConverterParameter=1}">
                            <Ellipse.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#4F46E5" />
                                    <GradientStop Offset="1" Color="#7C3AED" />
                                </LinearGradientBrush>
                            </Ellipse.Fill>
                        </Ellipse>
                        <Ellipse
                            Width="10"
                            Height="10"
                            Margin="5,0"
                            Opacity="{Binding CurrentSlide, Converter={StaticResource SlideOpacity}, ConverterParameter=2}">
                            <Ellipse.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#4F46E5" />
                                    <GradientStop Offset="1" Color="#7C3AED" />
                                </LinearGradientBrush>
                            </Ellipse.Fill>
                        </Ellipse>
                        <Ellipse
                            Width="10"
                            Height="10"
                            Margin="5,0"
                            Opacity="{Binding CurrentSlide, Converter={StaticResource SlideOpacity}, ConverterParameter=3}">
                            <Ellipse.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#4F46E5" />
                                    <GradientStop Offset="1" Color="#7C3AED" />
                                </LinearGradientBrush>
                            </Ellipse.Fill>
                        </Ellipse>
                        <Ellipse
                            Width="10"
                            Height="10"
                            Margin="5,0"
                            Opacity="{Binding CurrentSlide, Converter={StaticResource SlideOpacity}, ConverterParameter=4}">
                            <Ellipse.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#4F46E5" />
                                    <GradientStop Offset="1" Color="#7C3AED" />
                                </LinearGradientBrush>
                            </Ellipse.Fill>
                        </Ellipse>
                        <Ellipse
                            Width="10"
                            Height="10"
                            Margin="5,0"
                            Opacity="{Binding CurrentSlide, Converter={StaticResource SlideOpacity}, ConverterParameter=5}">
                            <Ellipse.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#4F46E5" />
                                    <GradientStop Offset="1" Color="#7C3AED" />
                                </LinearGradientBrush>
                            </Ellipse.Fill>
                        </Ellipse>
                    </StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button
                            Grid.Column="0"
                            Padding="16,12"
                            Background="Transparent"
                            BorderThickness="0"
                            Command="{Binding SkipCommand}"
                            Content="Skip"
                            Cursor="Hand"
                            FontSize="15"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Visibility="{Binding IsLastSlide, Converter={StaticResource InvBoolToVis}}" />
                        <Border
                            Grid.Column="2"
                            MinWidth="150"
                            Padding="22,13"
                            CornerRadius="26"
                            Cursor="Hand">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Offset="0" Color="#4F46E5" />
                                    <GradientStop Offset="1" Color="#7C3AED" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.Effect>
                                <DropShadowEffect
                                    BlurRadius="20"
                                    Opacity="0.30"
                                    ShadowDepth="0"
                                    Color="#6366F1" />
                            </Border.Effect>
                            <Border.InputBindings>
                                <MouseBinding Command="{Binding NextCommand}" MouseAction="LeftClick" />
                            </Border.InputBindings>
                            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="16"
                                    FontWeight="Bold"
                                    Foreground="White"
                                    Text="{Binding NextButtonText}" />
                                <ui:SymbolIcon
                                    Margin="8,0,0,0"
                                    VerticalAlignment="Center"
                                    FontSize="18"
                                    Foreground="White"
                                    Symbol="ArrowRight24"
                                    Visibility="{Binding IsLastSlide, Converter={StaticResource InvBoolToVis}}" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</ui:FluentWindow>
