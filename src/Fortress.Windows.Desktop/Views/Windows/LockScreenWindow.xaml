<ui:FluentWindow
    x:Class="Fortress.Windows.Desktop.Views.Windows.LockScreenWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="clr-namespace:Fortress.Windows.Desktop.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:Fortress.Windows.Desktop.ViewModels.Windows"
    Title="Fortress - Locked"
    Width="450"
    Height="650"
    ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
    ExtendsContentIntoTitleBar="True"
    ResizeMode="NoResize"
    WindowBackdropType="Mica"
    WindowCornerPreference="Round"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">

    <ui:FluentWindow.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
        <conv:InverseBoolToVisibilityConverter x:Key="InvBoolToVis" />
        <conv:NullOrEmptyToVisibilityConverter x:Key="NullToCollapsed" />
        <!--  Returns bool (not Visibility) — required for IsEnabled bindings  -->
        <conv:InverseBoolConverter x:Key="InvBool" />

        <!--  Audiowide font  -->
        <FontFamily x:Key="Audiowide">pack://application:,,,/Assets/Fonts/#Audiowide</FontFamily>

        <!--  PIN pad button  -->
        <Style x:Key="PinButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="Root"
                            Background="{TemplateBinding Background}"
                            CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#1A6366F1" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#336366F1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  Gradient unlock button — proper Button so Click fires reliably  -->
        <Style x:Key="UnlockButtonStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Height" Value="56" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" CornerRadius="16">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Offset="0" Color="#4F46E5" />
                                    <GradientStop Offset="1" Color="#7C3AED" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.Effect>
                                <DropShadowEffect
                                    BlurRadius="22"
                                    Opacity="0.45"
                                    ShadowDepth="6"
                                    Color="#6366F1" />
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.88" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.70" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.40" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </ui:FluentWindow.Resources>

    <Grid>
        <ui:TitleBar Title="Fortress">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Assets/applogo.png" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <StackPanel
            Width="340"
            Margin="0,44,0,0"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">

            <!--  Logo  -->
            <Border
                Width="72"
                Height="72"
                Margin="0,0,0,20"
                HorizontalAlignment="Center"
                CornerRadius="20">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Offset="0" Color="#1E3A8A" />
                        <GradientStop Offset="1" Color="#6D28D9" />
                    </LinearGradientBrush>
                </Border.Background>
                <ui:Image
                    FontSize="36"
                    Foreground="White"
                    Source="/Assets/logowhite.png" />
            </Border>

            <!--  Title — Audiowide font, 3-unit letter spacing  -->
            <TextBlock
                Margin="0,0,0,4"
                HorizontalAlignment="Center"
                FontFamily="{StaticResource Audiowide}"
                FontSize="26"
                FontWeight="Bold"
                Text="FORTRESS" />
            <TextBlock
                Margin="0,0,0,32"
                HorizontalAlignment="Center"
                FontSize="13"
                Opacity="0.55"
                Text="Your vault is locked" />
            <!--  Error message  -->
            <TextBlock
                Margin="0,14,0,0"
                HorizontalAlignment="Center"
                FontSize="12"
                Foreground="#EF4444"
                Text="{Binding ErrorMessage}"
                TextWrapping="Wrap"
                Visibility="{Binding ErrorMessage, Converter={StaticResource NullToCollapsed}}" />
            <!--  ── PIN pad ──  -->
            <StackPanel Visibility="{Binding ShowPinPad, Converter={StaticResource BoolToVis}}">
                <TextBlock
                    Margin="0,0,0,16"
                    HorizontalAlignment="Center"
                    FontSize="11"
                    FontWeight="SemiBold"
                    Opacity="0.45"
                    Text="ENTER PIN" />

                <StackPanel
                    Margin="0,0,0,24"
                    HorizontalAlignment="Center"
                    Orientation="Horizontal">
                    <Ellipse
                        Width="14"
                        Height="14"
                        Margin="8,0"
                        Fill="{Binding PinDot1}" />
                    <Ellipse
                        Width="14"
                        Height="14"
                        Margin="8,0"
                        Fill="{Binding PinDot2}" />
                    <Ellipse
                        Width="14"
                        Height="14"
                        Margin="8,0"
                        Fill="{Binding PinDot3}" />
                    <Ellipse
                        Width="14"
                        Height="14"
                        Margin="8,0"
                        Fill="{Binding PinDot4}" />
                </StackPanel>

                <UniformGrid
                    Margin="30,0"
                    Columns="3"
                    Rows="4">
                    <Button
                        Height="58"
                        Command="{Binding PinDigitCommand}"
                        CommandParameter="1"
                        Content="1"
                        FontSize="22"
                        FontWeight="Light"
                        Style="{StaticResource PinButtonStyle}" />
                    <Button
                        Height="58"
                        Command="{Binding PinDigitCommand}"
                        CommandParameter="2"
                        Content="2"
                        FontSize="22"
                        FontWeight="Light"
                        Style="{StaticResource PinButtonStyle}" />
                    <Button
                        Height="58"
                        Command="{Binding PinDigitCommand}"
                        CommandParameter="3"
                        Content="3"
                        FontSize="22"
                        FontWeight="Light"
                        Style="{StaticResource PinButtonStyle}" />
                    <Button
                        Height="58"
                        Command="{Binding PinDigitCommand}"
                        CommandParameter="4"
                        Content="4"
                        FontSize="22"
                        FontWeight="Light"
                        Style="{StaticResource PinButtonStyle}" />
                    <Button
                        Height="58"
                        Command="{Binding PinDigitCommand}"
                        CommandParameter="5"
                        Content="5"
                        FontSize="22"
                        FontWeight="Light"
                        Style="{StaticResource PinButtonStyle}" />
                    <Button
                        Height="58"
                        Command="{Binding PinDigitCommand}"
                        CommandParameter="6"
                        Content="6"
                        FontSize="22"
                        FontWeight="Light"
                        Style="{StaticResource PinButtonStyle}" />
                    <Button
                        Height="58"
                        Command="{Binding PinDigitCommand}"
                        CommandParameter="7"
                        Content="7"
                        FontSize="22"
                        FontWeight="Light"
                        Style="{StaticResource PinButtonStyle}" />
                    <Button
                        Height="58"
                        Command="{Binding PinDigitCommand}"
                        CommandParameter="8"
                        Content="8"
                        FontSize="22"
                        FontWeight="Light"
                        Style="{StaticResource PinButtonStyle}" />
                    <Button
                        Height="58"
                        Command="{Binding PinDigitCommand}"
                        CommandParameter="9"
                        Content="9"
                        FontSize="22"
                        FontWeight="Light"
                        Style="{StaticResource PinButtonStyle}" />
                    <Button
                        Height="58"
                        Command="{Binding UnlockWithBiometricAsyncCommand}"
                        Style="{StaticResource PinButtonStyle}"
                        Visibility="{Binding ShowBiometricButton, Converter={StaticResource BoolToVis}}">
                        <ui:SymbolIcon
                            FontSize="22"
                            Foreground="#7C3AED"
                            Symbol="Fingerprint24" />
                    </Button>
                    <Button
                        Height="58"
                        Style="{StaticResource PinButtonStyle}"
                        Visibility="{Binding ShowBiometricButton, Converter={StaticResource InvBoolToVis}}" />
                    <Button
                        Height="58"
                        Command="{Binding PinDigitCommand}"
                        CommandParameter="0"
                        Content="0"
                        FontSize="22"
                        FontWeight="Light"
                        Style="{StaticResource PinButtonStyle}" />
                    <Button
                        Height="58"
                        Command="{Binding PinBackspaceCommand}"
                        Style="{StaticResource PinButtonStyle}">
                        <ui:SymbolIcon
                            FontSize="20"
                            Foreground="#6B7280"
                            Symbol="Backspace24" />
                    </Button>
                </UniformGrid>

                <StackPanel
                    Margin="0,16,0,0"
                    HorizontalAlignment="Center"
                    Orientation="Horizontal">
                    <Button
                        Padding="8,4"
                        Background="Transparent"
                        BorderThickness="0"
                        Command="{Binding SwitchToPasswordCommand}"
                        Content="Use master password"
                        Cursor="Hand"
                        FontSize="12"
                        Opacity="0.55" />
                    <TextBlock
                        Margin="2,0"
                        VerticalAlignment="Center"
                        Opacity="0.25"
                        Text="|" />
                    <Button
                        Padding="8,4"
                        Background="Transparent"
                        BorderThickness="0"
                        Command="{Binding UnlockWithBiometricAsyncCommand}"
                        Content="Windows Hello"
                        Cursor="Hand"
                        FontSize="12"
                        Opacity="0.55"
                        Visibility="{Binding ShowBiometricButton, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
            </StackPanel>

            <!--  ── Password box ──  -->
            <StackPanel Visibility="{Binding ShowPasswordBox, Converter={StaticResource BoolToVis}}">
                <TextBlock
                    Margin="0,0,0,8"
                    FontSize="11"
                    FontWeight="SemiBold"
                    Opacity="0.45"
                    Text="MASTER PASSWORD" />

                <ui:PasswordBox
                    x:Name="PasswordInput"
                    Margin="0,0,0,16"
                    PlaceholderText="Enter your master password...">
                    <ui:PasswordBox.InputBindings>
                        <KeyBinding Key="Return" Command="{Binding UnlockWithPasswordAsyncCommand}" />
                    </ui:PasswordBox.InputBindings>
                </ui:PasswordBox>

                <!--
                    IMPORTANT: Use a real Button with a proper Style — NOT Border+MouseBinding.
                    MouseBinding on a Border is swallowed by child hit-testing and never fires.
                -->
                <Button
                    Margin="0,0,0,14"
                    HorizontalAlignment="Stretch"
                    Command="{Binding UnlockWithPasswordAsyncCommand}"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InvBool}}"
                    Style="{StaticResource UnlockButtonStyle}">
                    <Grid Width="200">
                        <StackPanel
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Visibility="{Binding IsBusy, Converter={StaticResource InvBoolToVis}}">
                            <ui:SymbolIcon
                                Margin="0,0,10,0"
                                FontSize="17"
                                Foreground="White"
                                Symbol="LockOpen24" />
                            <TextBlock
                                FontFamily="{StaticResource Audiowide}"
                                FontSize="14"
                                FontWeight="Bold"
                                Foreground="White"
                                Text="UNLOCK" />
                        </StackPanel>
                        <StackPanel
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
                            <ui:ProgressRing
                                Width="18"
                                Height="18"
                                Margin="0,0,10,0"
                                IsIndeterminate="True" />
                            <TextBlock
                                FontSize="14"
                                FontWeight="Bold"
                                Foreground="White"
                                Text="Unlocking..." />
                        </StackPanel>
                    </Grid>
                </Button>

                <!--  Alternate unlock links  -->
                <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                    <Button
                        Padding="8,4"
                        Background="Transparent"
                        BorderThickness="0"
                        Command="{Binding SwitchToPinCommand}"
                        Content="Use PIN"
                        Cursor="Hand"
                        FontSize="12"
                        Opacity="0.55"
                        Visibility="{Binding PinEnabled, Converter={StaticResource BoolToVis}}" />
                    <TextBlock
                        Margin="2,0"
                        VerticalAlignment="Center"
                        Opacity="0.25"
                        Text="|"
                        Visibility="{Binding HasBiometric, Converter={StaticResource BoolToVis}}" />
                    <Button
                        Padding="8,4"
                        Background="Transparent"
                        BorderThickness="0"
                        Command="{Binding UnlockWithBiometricAsyncCommand}"
                        Cursor="Hand"
                        FontSize="12"
                        Opacity="0.55"
                        Visibility="{Binding HasBiometric, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon
                                Margin="0,0,5,0"
                                FontSize="13"
                                Foreground="#7C3AED"
                                Symbol="Fingerprint24" />
                            <TextBlock Text="Windows Hello" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </StackPanel>


        </StackPanel>
    </Grid>
</ui:FluentWindow>
