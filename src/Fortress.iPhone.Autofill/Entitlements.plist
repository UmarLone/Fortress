<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
  
   

    <!-- REQUIRED: UI entitlement (since ShowsConfigurationUI = true) -->
    <key>com.apple.developer.authentication-services.autofill-credential-provider</key>
    <true/>

    <!-- REQUIRED: App Group for data sharing -->
    <key>com.apple.security.application-groups</key>
    <array>
      <string>group.com.fortress.app</string>
    </array>

    <!-- REQUIRED: Keychain sharing -->
    <key>keychain-access-groups</key>
    <array>
      <string>$(AppIdentifierPrefix)com.fortress.app</string>
    </array>

  </dict>
</plist>
