{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "Fortress": "Information",
      "Fortress.Service.Pipes": "Information",
      "Fortress.Service.Infrastructure": "Information"
    },
    "Console": {
